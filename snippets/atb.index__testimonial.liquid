      "info": ""
    },
    {
      "type": "color",
      "id": "atb_card_text",
      "label": "Quote text",
      "default": "rgba(0,0,0,0)",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_card_background",
      "label": "Quote background",
