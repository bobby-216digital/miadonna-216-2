{% comment %}
ATB-SCHEMA{
  "name": "Trending Style",
  "id": "designer_style",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_preheading",
      "label": "Pre Heading",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_heading",
      "label": "Heading",
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 20,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 20,
      "unit": "px",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Style"
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "repeatable": "Style",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Title",
      "repeatable": "Style",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_link",
      "label": "Link",
      "repeatable": "Style",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_preheading' -%}
{%- assign atb_preheading = val -%}
{%- include 'atb-render' field:'atb_heading' -%}
{%- assign atb_heading = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_link' -%}
{%- assign block_link = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
{{ 'prime.scss.css' | asset_url | stylesheet_tag }}
{{ 'page-custom.css' | asset_url | stylesheet_tag }}
<div class="diamond-landing-template-content">
  <section
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' and atb_show_gutter == false %}
      equal-columns--outside-trim
    {% endif %}
    lgd-trending-styles
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
    <header>
      <div class="_inner">
        <h4>
          <span class="block-pre-header">{{ atb_preheading }}</span>
          <span class="block-header">{{ atb_heading }}</span>
        </h4>
        <i class="ornamental-break -dark"></i>
      </div>
    </header>

    <div class="pure-g body-cell trending-collections">
    {% for block0 in blocks %}   
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      <div class="pure-u-1 pure-u-sm-1-4" style="" aria-hidden="true" tabindex="-1" role="option" aria-describedby="slick-slide00">
        <a href="{{ block_link[forloop.index0] }}" class="collection collection-solitaire" tabindex="-1">
          <span>{{ block_title[forloop.index0] }}</span>
           {%- render 'image-element',
                image: my_image0,
                alt: block_title[forloop.index0],
                stretch_width: true, -%}
        </a>
      </div>
    {% endfor %}
    </div>
  </section>
</div>


<style>
</style>

<script type="application/javascript">
</script></section>