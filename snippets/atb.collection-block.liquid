<section id="shopify-section-{{section_id}}" class="shopify-section collection-blocks jsCollectionBlocks">
<style>
  #shopify-section-{{ section_id }} .collection-block--slider{
    width: 85%;
  }
  {% comment %} #shopify-section-{{ section_id }} .flickity-viewport{
    margin-left: -5px;
  } {% endcomment %}
  #shopify-section-{{ section_id }} .flickity-button{
    top: 45%;
    padding: 0;
    outline: none;
    box-shadow: none;
    background-color: transparent;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button .flickity-button-icon{
    margin: 0;
    fill: {{ atb_text_color }};
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button.previous{
    left: -20px;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button.next{
    right: -30px;
  }
  #shopify-section-{{ section_id }} .column{
    margin-left: 10px;
    margin-right: 10px;
  }
  #shopify-section-{{ section_id }} .collection-block-wrapper h2,
  #shopify-section-{{ section_id }} .collection-block-wrapper h3{
    width: 100%;
    font-weight: 600;
    /* line-height: 29px; */
    text-align: center;
    margin-bottom: 32px;
    /* letter-spacing: 1.4px; */
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} .collection-block .image-element__wrap{
    border-radius: 50%;
  }
  #shopify-section-{{ section_id }} .collection-block--slider.no-slider .image-element__wrap{
    margin: 0;
  }
  #shopify-section-{{ section_id }} .collection-block .image-element__wrap {
    height: auto;
    /* max-width: 100% !important; */
  }
  #shopify-section-{{ section_id }} .collection-block img {
    max-width: 100%;
    height: auto;
    margin-bottom: 0;
  }
  #shopify-section-{{ section_id }} .collection-block .block--title{
    text-align: center;
    margin-top: 15px;
    /* font-style: italic;
    font-family: 'Playfair Display', serif;
    font-size: 18px; */
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section_id }} .flickity-prev-next-button.previous{
      left: -50px;
    }
    #shopify-section-{{ section_id }} .flickity-prev-next-button.next{
      right: -50px;
    }
  }
  @media screen and (max-width: 767px){
    /* #shopify-section-{{ section_id }} .collection-block-wrapper h2{
      font-size: 20px;
    }
    #shopify-section-{{ section_id }} .collection-block h3{
      font-size: 16px;
    } */
    #shopify-section-{{ section_id }} .flickity-prev-next-button .flickity-button-icon {
      width: 20px;
      height: 20px;
    }
  }
</style>

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .collection-block--slider.no-slider:after {
    content: "flickity";
    display: none; /* hide :after */
  }
  @media screen and (min-width: 1025px) {
    /* disable Flickity for large devices */
    #shopify-section-{{ section_id }} .collection-block--slider.no-slider:after {
      content: "";
    }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-collection-blocks
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="collection-block-wrapper">
    {% if atb_main_title != blank %}
      {% if atb_background_color == 'transparent' or atb_background_color == '#ffffff' %}
        <h2 class="section--title" style="color: {{ atb_text_color }};">
          {{ atb_main_title }}
        </h2>
      {% else %}
        <style>
          #shopify-section-{{ section_id }} .collection-block-wrapper h3 {
            max-width: 65%;
            margin: 0 auto 32px;
          }
        </style>
        <h3 class="section--title" style="color: {{ atb_text_color }};">
          {{ atb_main_title }}
        </h3>
      {% endif %}
    {% endif %}
    <div
      class="container collection-block--slider {% if blocks.size <= 5 %}no-slider{% endif %}"
      style="flex-wrap: nowrap;"
      data-products-per-slide="5"
      data-products-limit="{% if blocks.size > 5 %}15{% else %}5{% endif %}"
      data-products-available="{% if blocks.size > 5 %}15{% else %}5{% endif %}"
    >
      {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        <div class="collection-block one-fifth column large-down--one-fourth medium-down--one-third small-down--one-half">
          {% if block_url[forloop.index0] != blank %}
            <a
              href="{{ block_url[forloop.index0] }}"
              class="collection-link"
              style="color: {{ atb_text_color }};"
              tabindex="-1"
            >
          {% endif %}
          {% if my_image0 != blank %}
            {%
              render 'image-element',
              image: my_image0,
              alt: block_image_alt[forloop.index0],
            %}
          {% else %}
            <div class="image-element__wrap" style="height: auto;">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block_title[forloop.index0] != blank %}
            <h4 class="block--title" style="color: {{ atb_text_color }};">{{ block_title[forloop.index0] }}</h4>
          {% endif %}
          {% if block_url[forloop.index0] != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsCollectionBlocks.js' | asset_url }}"></script>


</section>