{% comment %}
ATB-SCHEMA{
  "name": "Slideshow - gallery",
  "class": "jsSlideshowGallery overlaid-header-option slideshow-section under-menu",
  "id": "slideshow-gallery",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "select",
      "id": "atb_image_transition",
      "label": "Image transition",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "default": "slide",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_image_slideshow_speed",
      "label": "Change image every",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 8,
      "unit": "sec",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_arrows",
      "label": "Show arrows",
      "default": true,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_nav_buttons",
      "label": "Show navigation dots",
      "default": true,
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "wide",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Slide"
    },
    {
      "type": "text",
      "id": "block_link",
      "label": "Link",
      "info": "Links entire image",
      "repeatable": "Slide"
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "info": "1800 x 900px recommended",
      "repeatable": "Slide"
    },
    {
      "type": "image_picker",
      "id": "block_mobile_image",
      "label": "Mobile Image",
      "info": "900 x 1800px recommended",
      "repeatable": "Slide"
    },
    {
      "type": "text",
      "label": "Title",
      "id": "block_title",
      "repeatable": "Slide",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_image_transition' -%}
{%- assign atb_image_transition = val -%}
{%- include 'atb-render' field:'atb_image_slideshow_speed' -%}
{%- assign atb_image_slideshow_speed = val -%}
{%- include 'atb-render' field:'atb_show_arrows' -%}
{%- assign atb_show_arrows = val -%}
{%- include 'atb-render' field:'atb_show_nav_buttons' -%}
{%- assign atb_show_nav_buttons = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_link' -%}
{%- assign block_link = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_mobile_image' -%}
{%- assign block_mobile_image = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- if atb_show_arrows == blank -%}
{%- assign atb_show_arrows = false -%}
{%- else -%}
{%- assign atb_show_arrows = true -%}
{%- endif -%}
{%- if atb_show_nav_buttons == blank -%}
{%- assign atb_show_nav_buttons = false -%}
{%- else -%}
{%- assign atb_show_nav_buttons = true -%}
{%- endif -%}
{%- assign atb_image_slideshow_speed = atb_image_slideshow_speed | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section jsSlideshowGallery overlaid-header-option slideshow-section under-menu">
{% comment %}
  ** Slideshow gallery **
{% endcomment %}

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  #shopify-section-{{ section_id }} .desktop-image,
  #shopify-section-{{ section_id }} .mobile-image {
    width: 100%;
  }

  #shopify-section-{{ section_id }} .gallery-cell{
    width: 34%;
  }

  @media screen and (max-width: 768px){
    #shopify-section-{{ section_id }} .slideshow-classic{
      margin-left: 0 !important;
      width: 100% !important;
    }
  }

  @media screen and (max-width: 575px){
    #shopify-section-{{ section_id }} .gallery-cell{
      width: 100%;
    }
  }

  {%
    render 'css-loop',
    css: section_css,
    id: section_id
  %}

  {%
    render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    slideshow-section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    under-overlay-menu
    {% if atb_mobile_text_below_image == true %}
      mobile-text--below-media
      {% else %}
      mobile-text--over-media
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="
      slideshow-classic
      image-slideshow
      image-slideshow--{{ atb_image_transition  }}
      page-dots--{{ atb_show_nav_buttons }}
    "
    data-slideshow-classic
  >
    {% for block in blocks %}
      {% comment %} Content settings {% endcomment %}
      {%- assign image = my_image0 -%}
      {%- assign link = block_link[forloop.index0] -%}
      {%- assign mobile_image = my_image1 -%}
      {% comment %} Ends content settings {% endcomment %}

      <div
        class="
          gallery-cell
          image-slideshow__slide
          slideshow-classic__banner
          {% if atb_mobile_text_below_image == true %}
            mobile-text--below-media
          {% else %}
            mobile-text--over-media
          {% endif %}
        "
        id="shopify-section-{{ blocks[forloop.index0] }}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% if mobile_image != blank %}
          {%- assign hide_mobile = 'is-hidden-mobile-only' -%}
        {% endif %}

        {% if image != blank %}
          {%
            render 'image-element',
            image: image,
            alt: image.alt,
            stretch_width: true,
            additional_classes: hide_mobile,
            focal_point: image.presentation.focal_point,
          %}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        {% if mobile_image != blank %}
          <div class="is-hidden-desktop-only">
            {%
              render 'image-element',
              image: mobile_image,
              alt: mobile_image.alt,
              stretch_width: true,
              focal_point: mobile_image.presentation.focal_point,
            %}
          </div>
        {% endif %}

        {% if link != blank %}
          <a class="banner--full-link" href="{{ link }}"></a>
        {% endif %}

        {% if block_title[forloop.index0] %}
          <p class="" style="margin-top: 15px; text-align: center;">{{ block_title[forloop.index0] }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
<script>
  setTimeout(function(){
    $('.custom-slider .flickity-button .flickity-button-icon path').attr('d', 'M 10,50 L 60,100 L 70,90 L 30,50  L 70,10 L 60,0 Z')
  }, 3000);
</script>

{% comment %}JavaScript{% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data
>
  {
    "image_transition": {{ atb_image_transition | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "image_slideshow_speed": {{ atb_image_slideshow_speed | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "show_arrows": {{ atb_show_arrows | json }},
    "show_nav_buttons": {{ atb_show_nav_buttons | json }},
    "number_of_slides": {{ blocks.size | json }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsSlideshowGallery.js' | asset_url }}"></script>


</section>