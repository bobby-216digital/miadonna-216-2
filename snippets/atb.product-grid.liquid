{% comment %}
ATB-SCHEMA{
  "name": "Product Grid",
  "class": "product-grid",
  "id": "product-grid",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "text",
      "label": "Main Title",
      "id": "atb_main_title",
      "default": "Find your perfect Wedding Ring",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "label": "Main Subheading",
      "id": "atb_main_subheading",
      "default": "<p>Add subtitle here</p>",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_hide_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "image_block",
          "label": "image_block"
        },
        {
          "value": "big_image_block",
          "label": "big_image_block"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "image_picker",
      "label": "Image",
      "id": "block_image",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image_block"
    },
    {
      "type": "text",
      "label": "Image Alt Text",
      "id": "block_image_alt",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image_block,big_image_block"
    },
    {
      "type": "text",
      "label": "Title",
      "id": "block_title",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image_block"
    },
    {
      "type": "text",
      "label": "Link",
      "id": "block_link",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image_block,big_image_block"
    },
    {
      "type": "select",
      "label": "Text Position",
      "id": "block_text_position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image_block"
    },
    {
      "type": "image_picker",
      "label": "Image",
      "id": "block_main_image",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:big_image_block"
    },
    {
      "type": "select",
      "label": "Image Position",
      "id": "block_main_image_position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:big_image_block"
    },
    {
      "type": "wysiwyg",
      "label": "Image Text",
      "id": "block_main_image_text",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:big_image_block"
    },
    {
      "type": "select",
      "label": "Image Text Position",
      "id": "block_main_image_text_position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:big_image_block"
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled",
    "some fields may be named the same"
  ]
}ATB-SCHEMA
{% endcomment %}


