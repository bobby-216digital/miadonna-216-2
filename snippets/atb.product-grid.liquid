{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section product-grid">
<style>
  #shopify-section-{{ section_id }} .section-heading{
    margin-bottom: 30px;
  }
  #shopify-section-{{ section_id }} .section-heading h3{
    margin-top: 0;
    font-weight: 600;
    margin-bottom: 18px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} .section-heading .main-subheading{
    font-size: 22px;
    font-style: italic;
    line-height: 28.71px;
    letter-spacing: 0.35px;
    font-family: 'Playfair Display';
  }
  #shopify-section-{{ section_id }} h3 {
    margin: 0;
  }
  #shopify-section-{{ section_id }} .images-container figure.column,
  #shopify-section-{{ section_id }} .large-image-container figure.column{
    position: relative;
  }
  #shopify-section-{{ section_id }} .images-container figure.column:nth-child(1),
  #shopify-section-{{ section_id }} .images-container figure.column:nth-child(2){
    margin-bottom: 10px;
  }
  #shopify-section-{{ section_id }} .images-container figure .image-text--small,
  #shopify-section-{{ section_id }} .large-image-container figure .image-text{
    font-size: {{ settings.regular_font_size | times: 0.95 | floor | append: 'px' }};
    font-weight: 500;
    position: absolute;
    bottom: 15px;
    left: 12px;
  }
  #shopify-section-{{ section_id }} .large-image-container figure .image-text{
    left: 0;
    width: 260px;
    padding: 10px 20px;
    background-color: #fff;
  }
  #shopify-section-{{ section_id }} .large-image-container figure .image-text > *{
    font-weight: 600;
    /* line-height: 30px;
    letter-spacing: 1.4px;
    font-size: {{ settings.heading_size | times: 0.5 | floor | append: 'px' }}; */
  }
  #shopify-section-{{ section_id }} .large-image-container .image-text em{
    font-weight: 400;
    font-family: 'Playfair Display';
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section_id }} .large-image-container,
    #shopify-section-{{ section_id }} .images-container,
    #shopify-section-{{ section_id }} .images-container figure{
      width: calc(50% - 10px);
    }
    #shopify-section-{{ section_id }} .images-container figure.column{
      margin: 0 5px;
    }
  }
  @media screen and (min-width: 1024px){
    #shopify-section-{{ section_id }} .images-container figure .image-text--small,
    #shopify-section-{{ section_id }} .large-image-container figure .image-text{
      font-size: {{ settings.regular_font_size | append: 'px' }};
      bottom: 35px;
    }
    #shopify-section-{{ section_id }} .large-image-container figure .image-text{
      width: 350px;
      padding: 15px 30px;
    }
    /* #shopify-section-{{ section_id }} .large-image-container figure .image-text > *{
      font-size: {{ settings.heading_size | times: 0.6 | floor | append: 'px' }};
    } */
  }
  @media screen and (max-width: 767px){
    /* #shopify-section-{{ section_id }} .section-heading h3{
      font-size: 18px;
    } */
    #shopify-section-{{ section_id }} .section-heading .main-subheading{
      font-size: 15px;
    }
    #shopify-section-{{ section_id }} .images-container,
    #shopify-section-{{ section_id }} .images-container figure{
      margin: 0 5px !important;
      width: calc(50% - 10px);
    }
    #shopify-section-{{ section_id }} .images-container figure{
      margin-bottom: 10px !important;
    }
    #shopify-section-{{ section_id }} .large-image-container{
      order: -1 !important;
      margin: 0 10px !important;
    }
  }
</style>
{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  {% if atb_main_title != blank %}
    <div class="section-heading text-center">
      <h3>{{ atb_main_title }}</h3>
      {% if atb_main_subheading != blank %}
        <div class="main-subheading">
          {{ atb_main_subheading }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="container">
    {% for block0 in blocks %}
{%- assign my_image_key1 = block_main_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      {% if block_type[forloop.index0] == 'big_image_block' %}
        <div
          class="large-image-container one-half column medium-down--one-whole has-no-side-gutter"
          style="order: {% if block_main_image_position[forloop.index0] == 'right' %}1{% else %}0{% endif %};margin: 0 5px;"
        >
          <figure class="one-whole column">
            {% if block_link[forloop.index0] != blank %}
            <a href="{{ block_link[forloop.index0] }}">
              {% endif %}
              {% if my_image1 != blank %}
                {%
                  render 'image-element',
                  image: my_image1,
                  alt: block_image_alt[forloop.index0],
                %}
              {% else %}
                <div class="image-element__wrap">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
              {% if block_main_image_text[forloop.index0] != blank %}
                <div
                  class="image-text text-{{ block_main_image_text_position[forloop.index0] }}"
                  style="{% if block_main_image_text_position[forloop.index0] == 'right' %}left: auto;right: 0;{% endif %}"
                >
                  {{ block_main_image_text[forloop.index0] }}
                </div>
              {% endif %}
            {% if block_link[forloop.index0] != blank %}
            </a>
            {% endif %}
          </figure>
        </div>
      {% endif %}
    {% endfor %}

    {% assign bigImageBlock = false %}
    {% for block0 in blocks %}
{%- assign my_image_key1 = block_main_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      {% if block_type[forloop.index0] == 'big_image_block' %}
        {% assign bigImageBlock = true %}
      {% endif %}
    {% endfor %}

    <div
      class="container images-container {% if bigImageBlock %}one-half{% else %}one-whole{% endif %} column medium-down--one-whole"
      style="margin: 0;"
    >
      {% for block0 in blocks %}
{%- assign my_image_key1 = block_main_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        {% if block_type[forloop.index0] == 'image_block' %}
          <figure class="one-half column medium-down--one-half">
            {% if block_link[forloop.index0] != blank %}
            <a href="{{ block_link[forloop.index0] }}">
            {% endif %}
              <div class="small-image">
                {% if my_image0 != blank %}
                  {%
                    render 'image-element',
                    image: my_image0,
                    alt: block_image_alt[forloop.index0],
                  %}
                {% else %}
                  <div class="image-element__wrap">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
                {% if block_title[forloop.index0] != blank %}
                  <p
                    class="image-text--small"
                    style="{% if block_text_position[forloop.index0] == 'right' %}left: auto;right: 12px;{% endif %}"
                  >
                    {{ block_title[forloop.index0] }}
                  </p>
                {% endif %}
              </div>
            {% if block_link[forloop.index0] != blank %}
            </a>
            {% endif %}
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>


</section>