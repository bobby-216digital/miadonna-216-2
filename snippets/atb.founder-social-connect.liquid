{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_subtitle1' -%}
{%- assign atb_subtitle1 = val -%}
{%- include 'atb-render' field:'atb_subtitle2' -%}
{%- assign atb_subtitle2 = val -%}
{%- include 'atb-render' field:'atb_subtitle3' -%}
{%- assign atb_subtitle3 = val -%}
{%- include 'atb-render' field:'atb_email' -%}
{%- assign atb_email = val -%}
{%- include 'atb-render' field:'atb_linkedin_name' -%}
{%- assign atb_linkedin_name = val -%}
{%- include 'atb-render' field:'atb_linkedin_link' -%}
{%- assign atb_linkedin_link = val -%}
{%- include 'atb-render' field:'atb_facebook_name' -%}
