{%- assign atb_background = val -%}
{%- include 'atb-render' field:'atb_gradient' -%}
{%- assign atb_gradient = val -%}
{%- include 'atb-render' field:'atb_gradient_rotation' -%}
{%- assign atb_gradient_rotation = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_padding_left' -%}
{%- assign atb_padding_left = val -%}
{%- include 'atb-render' field:'atb_padding_right' -%}
{%- assign atb_padding_right = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- assign atb_gradient_rotation = atb_gradient_rotation | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_padding_left = atb_padding_left | plus: 0 -%}
{%- assign atb_padding_right = atb_padding_right | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section content-page">
{% comment %}
** Content page **
{% endcomment %}

{%- assign content_page = pages[atb_content_page] -%}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign background_alpha = atb_background | color_extract: 'alpha' -%}
{%- assign gradient_alpha = atb_gradient | color_extract: 'alpha' -%}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}
  .section {
    background-image: linear-gradient({{ atb_gradient_rotation }}deg, rgba(255,255,255,0), {{ atb_gradient }});
    background-color: {%- if background_alpha != 0 -%}{{ atb_background }}{%- endif -%};
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- elsif atb_width == 'half' -%}
      width: 50%;
    {%- endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section class="section
              {{ atb_css_class }}
              is-width-{{ atb_width }}
              {% if background_alpha != 0 or gradient_alpha != 0  %}
                has-background
              {% endif %}
              has-padding-top
              has-padding-bottom
              "
        {% if atb_animation != "none" %}
          data-scroll-class="{{ atb_animation }}"
        {% endif %}>
  <div class="container
              has-limit
              content
              ">
    {% if content_page != blank %}
      {% render 'page-multi-column', content: content_page.content %}
    {% else %}
      <div class="one-whole column">
        <p class="text-align-center">
          {{ 'homepage.onboarding.no_content' | t }}
        </p>
      </div>
    {% endif %}
  </div>
</section>


</section>