{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_padding_left' -%}
{%- assign atb_padding_left = val -%}
{%- include 'atb-render' field:'atb_padding_right' -%}
{%- assign atb_padding_right = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'block_type' -%}
{%- assign block_type = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_button_text' -%}
{%- assign block_button_text = val -%}
{%- include 'atb-render' field:'block_recent_products' -%}
{%- assign block_recent_products = val -%}
{%- include 'atb-render' field:'block_frequently_bought_together' -%}
{%- assign block_frequently_bought_together = val -%}
{%- include 'atb-render' field:'block_you_may_also_like' -%}
{%- assign block_you_may_also_like = val -%}
{%- include 'atb-render' field:'block_complementary-products' -%}
{%- assign block_complementary-products = val -%}
{%- include 'atb-render' field:'block_liquid_content' -%}
{%- assign block_liquid_content = val -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_padding_left = atb_padding_left | plus: 0 -%}
{%- assign atb_padding_right = atb_padding_right | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section recommended-products-section jsRecommendedProducts">
{% comment %} Section specific CSS {% endcomment %}

{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}</noscript>

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- elsif atb_width == 'half' -%}
      width: 50%;
    {%- endif %}
  }
  #shopify-section-{{ section_id }} .product-content-wrapper{
    justify-content: flex-start;
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-setting-tabs
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    has-no-side-gutter
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="container">
    <setting-tabs class="setting-tabs-wrapper one-whole js-related-products-slider">
      <div class="setting-tabs-buttons">
        {%- for block0 in blocks -%}
{%- if block_complementary-products[forloop.index0] == blank -%}
{%- assign my_checkbox3 = false -%}
{%- else -%}
{%- assign my_checkbox3 = true -%}
{%- endif -%}
{%- if block_you_may_also_like[forloop.index0] == blank -%}
{%- assign my_checkbox2 = false -%}
{%- else -%}
{%- assign my_checkbox2 = true -%}
{%- endif -%}
{%- if block_frequently_bought_together[forloop.index0] == blank -%}
{%- assign my_checkbox1 = false -%}
{%- else -%}
{%- assign my_checkbox1 = true -%}
{%- endif -%}
{%- if block_recent_products[forloop.index0] == blank -%}
{%- assign my_checkbox0 = false -%}
{%- else -%}
{%- assign my_checkbox0 = true -%}
{%- endif -%}
          {% if block_type[forloop.index0] == 'tab' %}
            {% assign buttonID = block_button_text[forloop.index0] | replace: ' ', '-' | downcase %}
            {% assign buttonTitle = block_button_text[forloop.index0] %}
          {% endif %}
          {% if block_type[forloop.index0] == '@app' %}
            {% assign buttonID = block_type[forloop.index0] | replace: '@', '' | downcase %}
            {% assign buttonTitle = '@Miadonnadiamond' %}
          {% endif %}
          <button
            id="{{ buttonID }}"
            class="setting-tab-button{% if buttonID contains 'recently' %} recently-viewed-heading{% endif %} {{ buttonID }}{% if forloop.first %} button-active{% endif %}"
            {% if buttonID contains 'recently' %}
               style="display: none;"
            {% endif %}
          >
            {{ buttonTitle }}
          </button>
        {% endfor %}
      </div>

      {%- for block0 in blocks -%}
{%- if block_complementary-products[forloop.index0] == blank -%}
{%- assign my_checkbox3 = false -%}
{%- else -%}
{%- assign my_checkbox3 = true -%}
{%- endif -%}
{%- if block_you_may_also_like[forloop.index0] == blank -%}
{%- assign my_checkbox2 = false -%}
{%- else -%}
{%- assign my_checkbox2 = true -%}
{%- endif -%}
{%- if block_frequently_bought_together[forloop.index0] == blank -%}
{%- assign my_checkbox1 = false -%}
{%- else -%}
{%- assign my_checkbox1 = true -%}
{%- endif -%}
{%- if block_recent_products[forloop.index0] == blank -%}
{%- assign my_checkbox0 = false -%}
{%- else -%}
{%- assign my_checkbox0 = true -%}
{%- endif -%}
        {% if block_type[forloop.index0] == 'tab' %}
          {% assign buttonContentID = block_button_text[forloop.index0] | replace: ' ', '-' | downcase %}
        {% endif %}
        {% if block_type[forloop.index0] == '@app' %}
          {% assign buttonContentID = block_type[forloop.index0] | replace: '@', '' | downcase %}
        {% endif %}
        <div
          id="{{ buttonContentID }}-content"
          class="setting-tab-content {{ buttonContentID }}-content{% if forloop.first %} tab-active{% endif %}"
        >
          {% if my_checkbox0 == true %}
            <!-- <div class="js-related-products-slider"> -->
            {% render 'recent-products' %}
            <!-- </div> -->
          {% elsif my_checkbox1 == true %}
            <!-- <div class="js-related-products-slider"> -->
            {% render 'frequently-bought-together' %}
            <!-- </div> -->
          {% elsif my_checkbox2 == true %}
            {% render 'recommended-products' %}
          {% elsif my_checkbox3 == true %}
            {% render 'wear-it-with', buttonId: buttonContentID %}
          {% endif %}
          {{ block_liquid_content[forloop.index0] }}
          {% if block_type[forloop.index0] == '@app' %}
            {% render block %}
            <p style="font-size: 15px;color: #777;font-style: italic;letter-spacing: 1px;font-family: Playfair Display,serif;">Share a photo of your MiaDonna style by tagging your photos with #MyMiaDonna</p>
          {% endif %}
        </div>
      {% endfor %}
    </setting-tabs>
  </div>
</section>




<script data-theme-editor-load-script src="{{ 'z__jsRecommendedProducts.js' | asset_url }}"></script>


</section>