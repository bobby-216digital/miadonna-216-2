{% comment %}
ATB-SCHEMA{
  "name": "Product related",
  "class": "recommended-products-section jsRecommendedProducts",
  "id": "recently-and-instagram-products",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
