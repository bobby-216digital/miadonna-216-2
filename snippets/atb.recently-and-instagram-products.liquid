    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "half",
          "label": "Half"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 40,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 40,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_left",
      "label": "Left spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_right",
      "label": "Right spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "tab",
          "label": "tab"
        },
        {
          "value": "@app",
          "label": "@app"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "block_button_text",
      "label": "Button Text",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:tab"
    },
    {
      "type": "checkbox",
      "id": "block_recent_products",
      "label": "Recent products",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:tab"
    },
    {
      "type": "checkbox",
      "id": "block_frequently_bought_together",
      "label": "Frequently bought together",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:tab"
    },
    {
      "type": "checkbox",
      "id": "block_you_may_also_like",
      "label": "You may also like",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:tab"
    },
    {
      "type": "checkbox",
      "id": "block_complementary-products",
      "label": "Complementary products",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:tab"
    },
    {
      "type": "liquid",
      "id": "block_liquid_content",
      "label": "Liquid code",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:tab"
    }
  ],
  "warnings": [
    "repeating checkbox fields may not be properly handled"
  ]
