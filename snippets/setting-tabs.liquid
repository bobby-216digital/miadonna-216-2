{%
  render 'setting-tabs-js',
  product:product,
  attributes_customizable:attributes_customizable,
  attributes_center_stone_count:attributes_center_stone_count,
  isRTS: isRTS,
  attributes_basic_builder: attributes_basic_builder,
  allow_image_convention: allow_image_convention,
  cache_buster: now | date: '%s'
%}
{%- unless is_ring_engraving_content -%}
  <style>
    #ring_engraving_section{display:none;}
  </style>
{%- endunless -%}
<script>
 
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.dtl-swatches').forEach(function (wrapper) {
      const select = wrapper.nextElementSibling;
      if (!select) return;

      const selectedValue = select.value;

      const activeSwatch = wrapper.querySelector('.swatches-tab[data-value="' + selectedValue + '"]');

      if (activeSwatch) {
        wrapper.querySelectorAll('.swatches-tab').forEach((btn) => {
          btn.classList.remove('active');
          btn.setAttribute('aria-checked', 'false');
          btn.setAttribute('tabindex', '-1');
        });

        activeSwatch.classList.add('active');
        activeSwatch.setAttribute('aria-checked', 'true');
        activeSwatch.setAttribute('tabindex', '0');
      }
    });
  });

  document.addEventListener('click', function (e) {
    const swatch = e.target.closest('.swatches-tab');
    if (!swatch) return;

    const wrapper = swatch.closest('.dtl-swatches');
    const select = wrapper.nextElementSibling;
    const value = swatch.dataset.value;

    select.value = value;
    select.dispatchEvent(new Event('change', { bubbles: true }));

    wrapper.querySelectorAll('.swatches-tab').forEach((btn) => {
      btn.classList.remove('active');
      btn.setAttribute('aria-checked', 'false');
      btn.setAttribute('tabindex', '-1');
    });

    swatch.classList.add('active');
    swatch.setAttribute('aria-checked', 'true');
    swatch.setAttribute('tabindex', '0');
  });
</script>
