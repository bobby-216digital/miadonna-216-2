{% comment %}
ATB-SCHEMA{
  "name": "Our Pledge - Imagetext",
  "max_blocks": 3,
  "id": "our-pledge_image-with-text",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Image-Text"
    },
    {
      "type": "select",
      "id": "block_image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "repeatable": "Image-Text",
      "info": ""
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "repeatable": "Image-Text",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Title",
      "repeatable": "Image-Text",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "block_description",
      "label": "Description Text",
      "repeatable": "Image-Text",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image_position' -%}
{%- assign block_image_position = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_description' -%}
{%- assign block_description = val -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
<style>
  #shopify-section-{{ section_id }} .shaded {
    background: rgba(0,0,0,.04);
  }
  #shopify-section-{{ section_id }} .offset-group>*+* {
    margin-top: 26px;
    font-family: Playfair Display,serif;
  }
  #shopify-section-{{ section_id }} ._body {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section_id }} .content-cell {
    padding: 50px 26px;
  }
  #shopify-section-{{ section_id }} .text-style-subtitle {
    color: #000;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} p:not(.text-style-title):not(h1):not(.text-style-title-2):not(h2) {
    font-size: 15px;
  }
  @media only screen and (min-width: 750px){
    #shopify-section-{{ section_id }} .content-cell {
      padding: 50px;
    }
  }
  @media only screen and (min-width: 1024px){
    #shopify-section-{{ section_id }} .content-cell {
      padding: 100px 50px;
    }
    #shopify-section-{{ section_id }} .text-style-subtitle {
      font-size: 18px;
    }
  }
  @media only screen and (max-width: 749px){
    #shopify-section-{{ section_id }} ._image {
      order: 0 !important;
    }
  }
</style>

<section class="body-cell section is-standard">
  <div class="media-grid-layout -square cell-style-A shaded">
    {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      <section class="container has-no-side-gutter shaded">
        <figure
          class="_image formatted-image one-half small-down--one-whole column"
          {% if block_image_position[forloop.index0] == 'right' %}
            style="order: 2"
          {% endif %}
        >
          {% if my_image0 != blank %}
            {%
              render 'image-element',
              image: my_image0,
              alt: my_image0.alt,
              stretch_width: true,
              additional_classes: 'media-grid__image',
              focal_point: my_image0.presentation.focal_point,
            %}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </figure>
        <section class="_body one-half small-down--one-whole column text-center">
          <div class="_content content-cell offset-group">
            <h2 class="text-style-subtitle black-text">{{ block_title[forloop.index0] }}</h2>
            <p>{{ block_description[forloop.index0] | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
          </div>
        </section>
      </section>
    {% endfor %}
  </div>
</section>



<style>
</style>

<script type="application/javascript">
</script>
</section>