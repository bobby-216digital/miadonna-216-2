<section id="shopify-section-{{section_id}}" class="shopify-section image-with-text image-with-text-2">
{% comment %}
  ** Image with text **
{% endcomment %}

{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}</noscript>
<style>
  .cta-table table td,.cta-table table th {
    padding: 2em;
    text-align: center;
}

.cta-table {
    font-family: Montserrat,sans-serif;
    font-weight: 500;
    overflow-x: auto;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
}

.cta-table table th {
    background: #e2e2e2;
    color: #000;
    text-transform: uppercase;
    border: 1px solid #fff;
}

.cta-table table tr:nth-child(2n) td {
    background: #f4f4f4;
    border: 1px solid #fff;
}

.cta-table table tr:nth-child(odd) td {
    background: #f9f9f9;
    border: 1px solid #fff;
}
  </style>
{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section_id }} .plyr__video-embed{
    width: 100%;
    /* height: 100%; */
  }
  @media screen and (min-width: 1300px){
    #shopify-section-{{ section_id }} .image-with-text__heading{
      margin-bottom: 3rem;
    }
  }
  @media screen and (max-width: 768px){
    #shopify-section-{{ section_id }} {
    padding-top: 30px;
    padding-bottom: 30px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="container"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% if block_type[forloop.index0] == 'text' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block_text[forloop.index0] -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block_background[forloop.index0] | color_extract: 'alpha' -%}
          {%- assign text_alpha = block_text_color[forloop.index0] | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block_text_color[forloop.index0] }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block_text_color[forloop.index0] }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ blocks[forloop.index0] }} {
                background-color: {%- if background_alpha != 0 -%}{{ block_background[forloop.index0] }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: blocks[forloop.index0]
            %}
          {% endstyle %}

          <div
            class="
              one-half
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex
              is-flex-wrap
              is-justify-{{ block_alignment[forloop.index0] }}
              is-align-{{ block_vertical_position[forloop.index0] }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
          >
      
            <div class="image-with-text__wrapper">
           
                <h3 class="image-with-text__heading text-align-{{ block_alignment[forloop.index0] }} is-{{ block_heading_size[forloop.index0] }}"  style="font-size: 28px;font-weight: 600;line-height: 1.2 !important;    margin-bottom: 0;">
                
                  {{ block_title2[forloop.index0] }}
                </h1>
           

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block_alignment[forloop.index0] }} content">
                  {{ text }}
                </div>
              {% endif %}

              {% if block_button_label[forloop.index0] != blank %}
                <div class="buttons is-{{ block_alignment[forloop.index0] }}">
                  {% render 'button',
                    label: block_button_label[forloop.index0],
                    href: block_link[forloop.index0],
                    style: block_button_style[forloop.index0],
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block_type[forloop.index0] == 'table' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = block_image[forloop.index0] -%}
          {%- assign iframe_video = block_iframe_video[forloop.index0] -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              one-half
              medium-down--one-whole
              column
              is-align-center
              {% if iframe_video %}column-has-video{% endif %}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
            style="position: relative;"
          >
         <div class="cta-table">
          <table>
            <tbody>
              <tr>
                <th>{{ block_heading1[forloop.index0] }}</th>
                <th>{{ block_heading2[forloop.index0] }}</th>
                <th>{{ block_heading3[forloop.index0] }}</th>
                <th>{{ block_heading4[forloop.index0] }}</th>
              </tr>
              <tr>
                <td>{{ block_r1v1[forloop.index0] }}</td>
                <td>{{ block_r1v2[forloop.index0] }}</td>
                <td>{{ block_r1v3[forloop.index0] }}</td>
                <td>{{ block_r1v4[forloop.index0] }}</td>
              </tr>
              <tr>
              <td>{{ block_r2v1[forloop.index0] }}</td>
                <td>{{ block_r2v2[forloop.index0] }}</td>
                <td>{{ block_r2v3[forloop.index0] }}</td>
                <td>{{ block_r2v4[forloop.index0] }}</td>
              </tr>
              <tr>
                <td>{{ block_r3v1[forloop.index0] }}</td>
                <td>{{ block_r3v2[forloop.index0] }}</td>
                <td>{{ block_r3v3[forloop.index0] }}</td>
                <td>{{ block_r3v4[forloop.index0] }}</td>
              </tr>
              <tr>
                <td>{{ block_r4v1[forloop.index0] }}</td>
                <td>{{ block_r4v2[forloop.index0] }}</td>
                <td>{{ block_r4v3[forloop.index0] }}</td>
                <td>{{ block_r4v4[forloop.index0] }}</td>
              </tr>
            </tbody>
          </table>
        </div>
              {% if block_image_text[forloop.index0] != blank %}
              <p><strong>Ring Shown:</strong> {{ block_image_text[forloop.index0] }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>
