<section id="shopify-section-{{section_id}}" class="shopify-section featured-product-section jsProduct">
{% comment %}
** Featured product **
{% endcomment %}

{%- assign featured_product = atb_featured_product -%}
{%- assign product = all_products[featured_product] -%}

{%- assign product_tags = product.tags | join: ' ' -%}
{%- assign collection_handles = product.collections | map: 'handle' -%}

{% liquid
  assign selected_variant = product.selected_variant

  if product.variants.size == 1 or settings.select_first_available_variant
    assign selected_variant = product.selected_or_first_available_variant
  endif
%}

{% if product.empty? %}
  {%- assign section_onboarding = true -%}
{% else %}
  {%- assign section_onboarding = false -%}
{% endif %}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- endif %}
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
  <section class="section
                {{ atb_css_class }}
                is-width-{{ atb_width }}
                "
          {% if atb_animation != "none" %}
            data-scroll-class="{{ atb_animation }}"
          {% endif %}>
    <div class="product-{{ product.id }}">
      {%
        render 'product',
        product: product,
        sold_out_options: settings.sold_out_options,
        selected_variant: selected_variant,
        width: width,
        css_class: css_class,
        display_thumbnails: atb_display_thumbnails,
        enable_product_lightbox: atb_enable_product_lightbox,
        enable_shopify_product_badges: atb_enable_shopify_product_badges,
        enable_thumbnail_slider: atb_enable_thumbnail_slider,
        enable_zoom: atb_enable_zoom,
        gallery_arrows: atb_gallery_arrows,
        product_height: atb_product_height,
        product_images_position: atb_product_images_position,
        set_product_height: atb_set_product_height,
        slideshow_transition: atb_slideshow_transition,
        stickers_enabled: settings.stickers_enabled,
        tag_style: settings.tag_style,
        thumbnail_position: atb_thumbnail_position,
        video_looping: atb_video_looping,
        section_onboarding: section_onboarding
      %}
    </div>
  </section>

{% comment %} Shopify-XR {% endcomment %}
{% if product.media %}
<script>
  window.ShopifyXR=window.ShopifyXR||function(){(ShopifyXR.q=ShopifyXR.q||[]).push(arguments)}
    {% assign models = product.media | where: 'media_type', 'model' | json %}
    ShopifyXR('addModels', {{ models }});
</script>
{% endif %}

{%- for block0 in blocks -%}
{%- if block_show_tags[forloop.index0] == blank -%}
{%- assign my_checkbox4 = false -%}
{%- else -%}
{%- assign my_checkbox4 = true -%}
{%- endif -%}
{%- if block_show_types[forloop.index0] == blank -%}
{%- assign my_checkbox3 = false -%}
{%- else -%}
{%- assign my_checkbox3 = true -%}
{%- endif -%}
{%- if block_show_collections[forloop.index0] == blank -%}
{%- assign my_checkbox2 = false -%}
{%- else -%}
{%- assign my_checkbox2 = true -%}
{%- endif -%}
{%- if block_show_payment_button[forloop.index0] == blank -%}
{%- assign my_checkbox1 = false -%}
{%- else -%}
{%- assign my_checkbox1 = true -%}
{%- endif -%}
{%- if block_display_savings[forloop.index0] == blank -%}
{%- assign my_checkbox0 = false -%}
{%- else -%}
{%- assign my_checkbox0 = true -%}
{%- endif -%}
  {%- if block_type[forloop.index0] == 'price' -%}
    {%- assign display_savings = my_checkbox0 | json -%}
  {%- endif -%}
{%- endfor -%}

{% comment %} JavaScript {% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data
>
  {
    "display_savings": {{ display_savings }},
    "gallery_arrows": {{ atb_gallery_arrows | json }},
    "thumbnail_arrows": {{ atb_gallery_arrows | json }},
    "enable_zoom": {{ atb_enable_zoom | json }},
    "enable_product_lightbox": {{ atb_enable_product_lightbox | json }},
    "enable_thumbnail_slider": {{ atb_enable_thumbnail_slider | json }},
    "slideshow_speed": {{ atb_slideshow_speed | json }},
    "slideshow_transition": {{ atb_slideshow_transition | json }},
    "thumbnails_enabled": {{ atb_display_thumbnails | json }},
    "thumbnail_position": {{ atb_thumbnail_position | json }},
    "product_media_amount": {{ product.media.size }},
    "template": "featured-product-section"
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsProduct.js' | asset_url }}"></script>


</section>