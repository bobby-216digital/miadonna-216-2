<style>
  .recently-viewed-heading.show-heading {
    display: block !important;
  }
  /* @media screen and (max-width: 798px) {
    .products-slider.mobile-products-slider:after {
      content: "flickity";
      display: none; /* hide :after */
    }
  } */
</style>

<ul
  class="recently-viewed-grid product-content-wrapper has-no-side-gutter products-slider"
  data-products-per-slide="8"
  data-products-limit="8"
  data-products-available="8"
>
  <!-- Recently viewed products will appear here -->
</ul>

<script>
  document.addEventListener("DOMContentLoaded", function (event) {
    const productData = JSON.parse(localStorage.getItem("recentlyViewedProduct") || sessionStorage.getItem("recentlyViewedProduct"));
    const heading = document.querySelector(".recently-viewed-heading");
    if (productData && productData.length > 1) {
      heading.style.display = "block !important";
      heading.classList.add('show-heading');
    } else {
      $('#recently-viewed').closest('.recommended-products-section').addClass('recently-view-has-no-data');
    }
    if (productData.length > 3 && productData.length < 8) {
      document.querySelector(".recently-viewed-grid").classList.add('no-slider');
    }
    if (productData.length > 7) {
      document.querySelector(".recently-viewed-grid").setAttribute("data-products-limit", productData.length);
      document.querySelector(".recently-viewed-grid").setAttribute("data-products-available", productData.length);
    }
  });
  
  function setRecentlyViewedProducts() {
    const productData = {
      productTitle: "{{ product.title | remove: '"' }}",
      productImg: "{{ settings.speedsize_url_pfx_https -}}{{ product.featured_media | image_url: width: 450 }}",
      productPrice: "{{ product.price_max | money_with_currency }}",
      productUrl: "{{ product.url }}",
      productImageAltText: "{{ product.featured_media.alt | escape }}"
    };

    const currProductPageTitle = productData.productTitle;
    const localData = localStorage.getItem("recentlyViewedProduct");
    let productArray = [];
    const numberOfProducts = 20;

    if (localData === null) {
      productArray.push(productData);
      localStorage.setItem("recentlyViewedProduct", JSON.stringify(productArray));
      // localStorage.setItem("recentlyViewedProductBlog", JSON.stringify(productArray));
    } else {
      productArray = JSON.parse(localData);

      const sameProduct = productArray.some(item => item.productTitle === currProductPageTitle);

      if (!sameProduct) {
        if (productArray.length >= numberOfProducts) {
          productArray.shift();
        }
        productArray.push(productData);
        localStorage.setItem("recentlyViewedProduct", JSON.stringify(productArray));
        // localStorage.setItem("recentlyViewedProductBlog", JSON.stringify(productArray));
      }
    }
  }

