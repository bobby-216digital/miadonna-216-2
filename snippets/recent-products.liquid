  setRecentlyViewedProducts();

  function getRecentlyViewedProducts() {
    const productArray = JSON.parse(localStorage.getItem("recentlyViewedProduct"));
    const recentlyViewedHtml = [];
    const currProductPageTitle = "{{ product.title | remove: '"' }}";

    productArray.forEach((item, index) => {
      if (item.t !== currProductPageTitle) {
        if (index > 6) {
          var desktopCount = 'is-hidden';
        } else {
          var desktopCount = '';
        }
        if (index > 2) {
          var tabletCount = 'is-tablet-hidden';
        } else {
          var tabletCount = '';
        }
        recentlyViewedHtml.unshift(`
        <li class="product-item one-seventh column medium-down--one-third ${tabletCount} ${desktopCount}"> 
          <a href="${item.productUrl}">
            <img class="recently-viewed-img" src="${item.productImg}" loading="lazy" alt="${item.productImageAltText}"/>
          </a>
          <h3><a class="recently-viewed-a" href="${item.productUrl}">${item.productTitle}</a></h3>
          <p>${item.productPrice}</p>
        </li>
        `);
      }
    });

    const newProductData = `${recentlyViewedHtml.join("")}`;
    const fullContent = document.querySelector(".recently-viewed-grid");
    fullContent.innerHTML = newProductData;
  }

