<div class="filter__sidebar-container is-hidden-desktop-only vdb-lb-main-advance-filter-mobile" style="top: 48px;">
  <div class="filter__sidebar-content">
    <header>
      <h6>Filter</h6>
      {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-advanced-filter-mobile-view-close' %}
    </header>
    <section>
      <ul class="filter__list">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'Shape' %}
              {% comment %}filter__list-open{% endcomment %}
              <li class="filter__list-item filter__list-shapes">
                <div class="filter__list-label">
                  <div class="filter__list-title">
                    <h6>Shape</h6>
                    <div class="filter-info">
                      <div class="tooltip mobile-tooltip" data-mb-tooltip="shape">
                        <img
                          src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
                          width="18px"
                          height="18px"
                        class="icon-info" alt="">
                        <span class="tooltiptext">
                          <p class="tooltip-title">
                            Shape {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-close-tooltip' %}
                          </p>
                          {% if block.settings.description_textarea_shape != blank %}
                            <p class="tooltip-content">{{ block.settings.description_textarea_shape | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
                          {% endif %}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="filter__list-icon" data-li="shapes">
                    <i class="icon-solid-caret"></i>
                  </div>
                </div>
                <div class="filter__list-content">
                  <div class="options swiper vdb-hb-slider-shape">
                    <div class="swiper-wrapper">
                    {% assign shapeString = '' %}
                      {% for i in (1..14) %}
                        {% assign shape_label_id = 'main_title_shape_' | append: i %}
                        {% assign shape_display_id = 'main_title_shape_checkbox_' | append: i %}
                      {% if block.settings[shape_label_id] != blank and block.settings[shape_display_id] == true %}
                        {% assign shapeString = shapeString | append: ',' | append: i %}
                      {% endif %}
                    {% endfor %}

                    {% assign shapeArray = shapeString | remove_first: ',' | split: ',' %}
                          {% assign shapeIndex = 0 %}
                          {% assign shapeParams = '' %}
                          {% if hybridPageQueryArray != blank %}
                            {% for param in hybridPageQueryArray %}
                              {%- if param contains "shape" -%}
                                {% assign shapeKey = param | split: '=' | first | strip %}
                                {% if shapeKey != "supported_shapes" %}
                                  {% assign shapeParams = param | split: '=' | last | strip %}
                                  {% assign shapeParams = shapeParams | replace: "Cut", "" | strip %}
                                {% endif %}
                              {%- endif -%}
                            {% endfor %}
                          {% else %}
                      {% assign shapeIndex = shapeArray | first %}
                          {% endif %}

                    {% assign defaultShapeIndex = shapeArray | first %}
                    {% for i in shapeArray %}
                      {% assign shape_label_id = 'main_title_shape_' | append: i %}
                      {% assign shape_display_id = 'main_title_shape_checkbox_' | append: i %}
                      {% assign shape_icon_id = 'main_title_shape_icon_' | append: i %}
                      {% if block.settings[shape_label_id] != blank and block.settings[shape_display_id] == true %}
                        {% comment %}
                        {% assign shape_default_icon_file = 'icon-shape-' | append: block.settings[shape_label_id] | handle | append: '-cut'  | downcase  %}
                        {% assign shape_default_icon_file_string = shape_default_icon_file_string | append: "" %}
                        {% endcomment %}
                        {% assign shape_handle = block.settings[shape_label_id] | handle | downcase %}
                        {% assign class_name_shape = 'vdb-list-item-shape-style-' | append: shape_handle %}
                        
                          {% if shapeParams == block.settings[shape_label_id] %} {% assign shapeIndex = i %} {% endif %}
                        {% unless i != defaultShapeIndex %} {% assign defaultShape = block.settings[shape_label_id] %}{% endunless %}
                          <div class="option swiper-slide {{ class_name_shape }} {% unless i != shapeIndex %}active-state{% endunless %}">
                            <button
                              class="vdb-list-item-a-shape-style"
                              data-module="{{ class_name_shape }}"
                            data-shape-value="{{ block.settings[shape_label_id] }}">
                              {% if block.settings[shape_icon_id] != blank %}
                                {{ block.settings[shape_icon_id] | image_url: width: 300 | image_tag | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                              {% else %}
                                {% if shape_handle == 'round' %}
                                  {% render 'icon-shape-round-cut' %}
                                {% elsif shape_handle == 'princess' %}
                                  {% render 'icon-shape-princess-cut' %}
                                {% elsif shape_handle == 'cushion' %}
                                  {% render 'icon-shape-cushion-cut' %}
                                {% elsif shape_handle == 'oval' %}
                                  {% render 'icon-shape-oval-cut' %}
                                {% elsif shape_handle == 'emerald' %}
                                  {% render 'icon-shape-emerald-cut' %}
                                {% elsif shape_handle == 'asscher' %}
                                  {% render 'icon-shape-asscher-cut' %}
                                {% elsif shape_handle == 'radiant' %}
                                  {% render 'icon-shape-radiant-cut' %}
                                {% elsif shape_handle == 'pear' %}
                                  {% render 'icon-shape-pear-cut' %}
                                {% elsif shape_handle == 'heart' %}
                                  {% render 'icon-shape-heart-cut' %}
                                {% elsif shape_handle == 'marquise' %}
                                  {% render 'icon-shape-marquise-cut' %}
                                {% elsif shape_handle == 'oval-rose' %}
                                  {% render 'icon-shape-oval-rose-cut' %}
                                {% elsif shape_handle == 'trillion' or shape_handle == 'trilliant' %}
                                {% render 'icon-shape-trillion-cut' %}
                                {% elsif shape_handle == 'half-moon' %}
                                  {% render 'icon-shape-half-moon-cut' %}
                                {% elsif shape_handle == 'baguette' %}
                                  {% render 'icon-shape-baguette-cut' %}
                                {% elsif shape_handle == 'rose-brilliant' %}
                                  {% render 'icon-shape-rose-brilliant-cut' %}
                                {% elsif shape_handle == 'rose' %}
                                  {% render 'icon-shape-rose-cut' %}
                                {% endif %}
                              {% endif %}
                              <div>{{ block.settings[shape_label_id] }}</div>
                            </button>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                    {% comment %}
                      <div class="swiper-button-next"></div>
                      <div class="swiper-button-prev"></div>
                    {% endcomment %}
                  <div class="swiper-scrollbar swiper-scrollbar-shape"></div>
                  </div>
                </div>
              </li>
            {% when 'Color' %}
              <li class="filter__list-item filter__list-color">
                <div class="filter__list-label">
                  <div class="filter__list-title">
                    <h6>Color</h6>
                    <div class="filter-info">
                      <div class="tooltip mobile-tooltip" data-mb-tooltip="color">
                        <img
                          src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
                          width="18px"
                          height="18px"
                        class="icon-info" alt="">
                        <span class="tooltiptext">
                          <p class="tooltip-title">
                            Color {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-close-tooltip' %}
                          </p>
                          {% if block.settings.description_textarea_color != blank %}
                            <p class="tooltip-content">{{ block.settings.description_textarea_color | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
                          {% endif %}
                          <div class="color-desc">
                            <div class="color--item color--item-colorless">
                              {% render 'icon-shape-round-cut' %}
                              <div class="btn-text">
                                <p>D E F</p>
                                <p>Colorless</p>
                              </div>
                            </div>
                            <div class="color--item color--item-near-colorless">
                              {% render 'icon-shape-round-cut' %}
                              <div class="btn-text">
                                <p>G H I</p>
                                <p>Near Colorless</p>
                              </div>
                            </div>
                            <div class="color--item color--item-slight-color">
                              {% render 'icon-shape-round-cut' %}
                              <div class="btn-text">
                                <p>J K L</p>
                                <p>Slight Color</p>
                              </div>
                            </div>
                          </div>
                          <p class="tooltip-content">
                            Diamonds are valued for their lack of color, so the price increases the closer it gets to
                            colorless.
                          </p>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="filter__list-icon" data-li="color">
                    <i class="icon-solid-caret"></i>
                  </div>
                </div>
                <div class="filter__list-content">
                  <div class="options">
                    {% for i in (1..3) %}
                      {% assign color_label_id = 'main_title_color_' | append: i %}
                      {% assign color_value_id = 'main_value_color_' | append: i %}
                      {% assign color_display_id = 'main_title_color_checkbox_' | append: i %}
                      {% if block.settings[color_label_id] != blank and block.settings[color_display_id] == true %}
                        {% assign color_handle = block.settings[color_label_id] | handle | downcase %}
                        {% assign class_name_color = 'vdb-list-item-color-style-' | append: color_handle %}
                        <div class="option {{ class_name_color }} {% unless i != 1 %}active-state{% endunless %}">
                          {% unless i != 1 %}
                            {% assign defaultColor = block.settings[color_value_id] %}
                          {% endunless %}

                          <button
                            class="vdb-list-item-a-color-style"
                            data-module="{{ class_name_color }}"
                          data-color-values="{{ block.settings[color_value_id] }}">
                            <div>{{ block.settings[color_value_id] | replace: ',', ' ' }}</div>
                            <div>{{ block.settings[color_label_id] }}</div>
                          </button>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </li>
            {% when 'Carat' %}
              {% assign caratMinParams = '1' %}
              {% assign caratMaxParams = '' %}
              {% assign ringHandle = 'No' %}
              {% if hybridPageQueryArray != blank %}
                {% for param in hybridPageQueryArray %}
                  {%- if param contains "ring-handle" -%}
                    {% assign ringHandle = 'Yes' %}
                  {%- endif -%}
                {% endfor %}

                {% for param in hybridPageQueryArray %}
                  {%- if param contains "min_carat" -%}
                    {% assign caratMinParams = param | split: '=' | last | strip | to_i %}
                  {% comment %} {% else %}
                    {%- assign caratMinParams = block.settings.main_title_carat_min -%} {% endcomment %}
                  {%- endif -%}
                {% endfor %}

                {% for param in hybridPageQueryArray %}
                  {%- if param contains "max_carat" -%}
                    {% assign caratMaxParams = param | split: '=' | last | strip | to_i %}
                  {% comment %} {% else %}
                    {%- assign caratMaxParams = block.settings.main_title_carat_max -%} {% endcomment %}
                  {%- endif -%}
                {% endfor %}
              {% else %}
                {% comment %} {%- assign caratMinParams = block.settings.main_title_carat_min -%} {% endcomment %}
                {% comment %} {%- assign caratMaxParams = block.settings.main_title_carat_max -%} {% endcomment %}
              {% endif %}
              {%- assign defaultCaratMin = caratMinParams -%}
              {%- assign defaultCaratMax = caratMaxParams -%}
              
              {% if carat_metafields != blank %}
                {% assign caratMetafields = carat_metafields |  split: '-' %}
                {% assign minCaratValue = caratMetafields | first %}
                {% assign maxCaratValue = caratMetafields | last %}
              {% else %}
                {% assign minCaratValue = block.settings.main_title_carat_min %}
                {% assign maxCaratValue = block.settings.main_title_carat_max %}
              {% endif %}
              {%- assign defaultCaratMin = minCaratValue -%}
              {%- assign defaultCaratMax = maxCaratValue -%}

              {% if ringHandle == 'Yes' %}
                {% assign minCaratValue = caratMinParams %}
                {% assign caratMinParams = '1' %}
                {% assign maxCaratValue = caratMaxParams %}
              {% endif %}
              {% if caratMaxParams == blank %}{% assign caratMaxParams = maxCaratValue %}{% endif %}

              <li class="filter__list-item filter__list-carat">
                <div class="filter__list-label">
                  <div class="filter__list-title">
                    <h6>Carat</h6>
                    <div class="filter-info">
                      <div class="tooltip mobile-tooltip" data-mb-tooltip="carat">
                        <img
                          src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
                          width="18px"
                          height="18px"
                        class="icon-info" alt="">
                        <span class="tooltiptext">
                          <p class="tooltip-title">
                            Carat Size {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-close-tooltip' %}
                          </p>
                          {% if block.settings.description_textarea_carat != blank %}
                            <p class="tooltip-content">{{ block.settings.description_textarea_carat | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
                          {% endif %}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="filter__list-icon" data-li="carat">
                    <i class="icon-solid-caret"></i>
                  </div>
                </div>
                <div class="filter__list-content">
                  <div class="range-slider range-target">
                    <div class="range-base">
                      <tc-range-slider
                        id="slider_carat_mia_mobile"
                        min="{{ minCaratValue }}"
                        max="{{ maxCaratValue }}"
                        value1="{{ caratMinParams }}"
                        value2="{{ caratMaxParams }}"
                        aria-label1="Minimum carat weight"
                        aria-label2="Maximum carat weight"
                        step="0.01"
                        moving-tooltip="true"
                        moving-tooltip-distance-to-pointer="-30"
                        moving-tooltip-bg="transparent"
                        moving-tooltip-text-color="#3c3737"
                        moving-tooltip-width="70"
                        moving-tooltip-height="20"
                        mousewheel-disabled="true"
                        pointer-bg="#fca999"
                        pointer-bg-hover="#fca999"
                        pointer-bg-focus="#fca999"
                        pointer-border="1px solid #fca999"
                        pointer-border-hover="1px solid #fca999"
                        pointer-border-focus="1px solid #fca999"
                        slider-bg="#ebebeb"
                        slider-bg-fill="#fca999"
                        moving-tooltip-units=" CT"
                        slider-width="400px"
                        slider-height="5px"
                        generate-labels="false"
                      css-links="{{ 'tc-range-box-shadow.css' | asset_url }};" />
                    </div>
                  </div>
                </div>
              </li>
            {% when 'Price' %}
              {% assign priceMinParams = '' %}
              {% assign priceMaxParams = '' %}
              {% if hybridPageQueryArray != blank %}
                {% for param in hybridPageQueryArray %}
                  {%- if param contains "min_price" -%}
                    {% assign priceMinParams = param | split: '=' | last | strip | to_i %}
                  {% comment %} {% else %}
                    {%- assign priceMinParams = block.settings.main_title_price_min -%} {% endcomment %}
                  {%- endif -%}
                {% endfor %}

                {% for param in hybridPageQueryArray %}
                  {%- if param contains "max_price" -%}
                    {% assign priceMaxParams = param | split: '=' | last | strip | to_i %}
                  {% comment %} {% else %}
                    {%- assign priceMaxParams = block.settings.main_title_price_max -%} {% endcomment %}
                  {%- endif -%}
                {% endfor %}
              {% else %}
                {% comment %} {%- assign priceMinParams = block.settings.main_title_price_min -%}
                {%- assign priceMaxParams = block.settings.main_title_price_max -%} {% endcomment %}
              {% endif %}
              {%- assign defaultPriceMin = priceMinParams -%}
              {%- assign defaultPriceMax = priceMaxParams -%}

              {% if price_metafields != blank %}
                {% assign priceMetafields = price_metafields |  split: '-' %}
                {% assign minPriceValue = priceMetafields | first %}
                {% assign maxPriceValue = priceMetafields | last %}
              {% else %}
                {% assign minPriceValue = block.settings.main_title_carat_min %}
                {% assign maxPriceValue = block.settings.main_title_carat_max %}
              {% endif %}
              
              {%- assign defaultPriceMin = minPriceValue -%}
              {%- assign defaultPriceMax = maxPriceValue -%}
              {% if priceMinParams == blank %}{% assign priceMinParams = minPriceValue %}{% endif %}
              {% if priceMaxParams == blank %}{% assign priceMaxParams = maxPriceValue %}{% endif %}
              <li class="filter__list-item filter__list-price">
                <div class="filter__list-label">
                  <div class="filter__list-title">
                    <h6>Price</h6>
                    <div class="filter-info">
                      <div class="tooltip mobile-tooltip" data-mb-tooltip="price">
                        <img
                          src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
                          width="18px"
                          height="18px"
                        class="icon-info" alt="">
                        <span class="tooltiptext">
                          <p class="tooltip-title">
                            Price {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-close-tooltip' %}
                          </p>
                          {% if block.settings.description_textarea_price != blank %}
                            <p class="tooltip-content">{{ block.settings.description_textarea_price | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
                          {% endif %}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="filter__list-icon" data-li="price">
                    <i class="icon-solid-caret"></i>
                  </div>
                </div>
                <div class="filter__list-content">
                  <div class="range-slider range-target">
                    <div class="range-base">
                      <tc-range-slider
                        id="slider_price_mia_mobile"
                        min="{{ minPriceValue }}"
                        max="{{ maxPriceValue }}"
                        value1="{{ priceMinParams }}"
                        value2="{{ priceMaxParams }}"
                        aria-label1="Minimum price"
                        aria-label2="Maximum price"
                        step="1"
                        moving-tooltip="true"
                        moving-tooltip-distance-to-pointer="-30"
                        moving-tooltip-bg="transparent"
                        moving-tooltip-text-color="#3c3737"
                        moving-tooltip-width="70"
                        moving-tooltip-height="20"
                        mousewheel-disabled="true"
                        pointer-bg="#fca999"
                        pointer-bg-hover="#fca999"
                        pointer-bg-focus="#fca999"
                        pointer-border="1px solid #fca999"
                        pointer-border-hover="1px solid #fca999"
                        pointer-border-focus="1px solid #fca999"
                        slider-bg="#ebebeb"
                        slider-bg-fill="#fca999"
                        moving-tooltip-units="$"
                        moving-tooltip-units-type="prefix"
                        slider-width="400px"
                        slider-height="5px"
                        generate-labels="false"
                      css-links="{{ 'tc-range-box-shadow.css' | asset_url }};" />
                    </div>
                  </div>
                </div>
              </li>
            {% when 'Clarity' %}
              <li class="filter__list-item filter__list-clarity">
                <div class="filter__list-label">
                  <div class="filter__list-title">
                    <h6>Clarity</h6>
                    <div class="filter-info">
                      <div class="tooltip mobile-tooltip" data-mb-tooltip="clarity">
                        <img
                          src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
                          width="18px"
                          height="18px"
                        class="icon-info" alt="">
                        <span class="tooltiptext">
                          <p class="tooltip-title">
                            Clarity {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-close-tooltip' %}
                          </p>
                          {% if block.settings.description_textarea_clarity != blank %}
                            <p class="tooltip-content">{{ block.settings.description_textarea_clarity | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
                          {% endif %}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="filter__list-icon" data-li="clarity">
                    <i class="icon-solid-caret"></i>
                  </div>
                </div>
                <div class="filter__list-content">
                  <div class="range-slider range-target">
                    <div class="range-base">
                      {% assign clarity_values = '' %}
                      {% for i in (1..9) %}
                        {% assign clarity_label_id = 'main_title_clarity_' | append: i %}
                        {% assign clarity_display_id = 'main_title_clarity_checkbox_' | append: i %}
                        {% if block.settings[clarity_label_id] != blank
                          and block.settings[clarity_display_id] == true
                        %}
                          {% assign clarity_values = clarity_values
                            | append: block.settings[clarity_label_id]
                         | append: ',' %}
                        {% endif %}
                      {% endfor %}
                      {% assign clarity_value_array = clarity_values | replace_last: ',', '' | split: ',' %}
                      <tc-range-slider
                        id="slider_clarity_mia_mobile"
                        min="{{ clarity_value_array | first }}"
                        max="{{ clarity_value_array | last }}"
                        value1="{{ clarity_value_array | first }}"
                        value2="{{ clarity_value_array | last }}"
                        aria-label1="Minimum clarity"
                        aria-label2="Maximum clarity"
                        data="{{ clarity_values | replace_last: ', ', '' }}"
                        marks="true"
                        marks-count="{{ clarity_value_array | size }}"
                        marks-values-count="{{ clarity_value_array | size }}"
                        mousewheel-disabled="true"
                        pointer-bg="#fca999"
                        pointer-bg-hover="#fca999"
                        pointer-bg-focus="#fca999"
                        pointer-border="1px solid #fca999"
                        pointer-border-hover="1px solid #fca999"
                        pointer-border-focus="1px solid #fca999"
                        slider-bg="#ebebeb"
                        slider-bg-fill="#fca999"
                        slider-width="400px"
                        slider-height="5px"
                        generate-labels="false"
                      css-links="{{ 'tc-range-box-shadow.css' | asset_url }};" />
                    </div>
                  </div>
                </div>
              </li>
            {% when 'Cut' %}
              <li class="filter__list-item filter__list-cut">
                <div class="filter__list-label">
                  <div class="filter__list-title">
                    <h6>Cut</h6>
                    <div class="filter-info">
                      <div class="tooltip mobile-tooltip" data-mb-tooltip="cut">
                        <img
                          src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
                          width="18px"
                          height="18px"
                        class="icon-info" alt="">
                        <span class="tooltiptext">
                          <p class="tooltip-title">
                            Cut {% render 'icon', name: 'x', icon_class: 'icon-close vdb-lb-close-tooltip' %}
                          </p>
                          {% if block.settings.description_textarea_cut != blank %}
