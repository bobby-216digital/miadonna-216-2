                              {% endif %}
                              <div>{{ block.settings[fancy_label_id] }}</div>
                            </button>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                    {% comment %}
                      <div class="swiper-button-next"></div>
                      <div class="swiper-button-prev"></div>
