                        {% assign color_value_id = 'main_value_fancy_' | append: i %}
                        {% assign fancy_display_id = 'main_title_fancy_checkbox_' | append: i %}
                        {% assign fancy_icon_id = 'main_title_fancy_icon_' | append: i %}

