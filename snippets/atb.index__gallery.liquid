{% comment %}
ATB-SCHEMA{
  "name": "Gallery",
  "class": "gallery jsGallery",
  "max_blocks": 20,
  "id": "index__gallery",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "select",
      "id": "atb_gallery_type",
      "label": "Gallery style",
      "default": "classic",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "horizontal-masonry",
          "label": "Horizontal masonry"
        },
        {
          "value": "masonry",
          "label": "Vertical masonry"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_crop_images",
      "label": "Crop images",
      "default": false,
      "info": "Applies to classic only."
    },
    {
      "type": "range",
      "id": "atb_images_per_row",
      "label": "Images per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Applies to vertical masonry and classic only."
    },
    {
      "type": "checkbox",
      "id": "atb_enable_lightbox",
      "label": "Enable lightbox",
      "default": true,
      "info": ""
    },
    {
      "type": "header",
      "content": "Colors",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_overlay_color",
      "label": "Overlay",
      "default": "#000000",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_link_color",
      "label": "Icons",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 20,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 20,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": ""
    },
    {
      "type": "paragraph",
      "content": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Image"
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "info": "800 x 800px recommended",
      "repeatable": "Image"
    },
    {
      "type": "text",
      "id": "block_link",
      "label": "Link",
      "repeatable": "Image",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_gallery_type' -%}
{%- assign atb_gallery_type = val -%}
{%- include 'atb-render' field:'atb_crop_images' -%}
{%- assign atb_crop_images = val -%}
{%- include 'atb-render' field:'atb_images_per_row' -%}
{%- assign atb_images_per_row = val -%}
{%- include 'atb-render' field:'atb_enable_lightbox' -%}
{%- assign atb_enable_lightbox = val -%}
{%- include 'atb-render' field:'atb_overlay_color' -%}
{%- assign atb_overlay_color = val -%}
{%- include 'atb-render' field:'atb_link_color' -%}
{%- assign atb_link_color = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'undefined' -%}
{%- assign undefined = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_link' -%}
{%- assign block_link = val -%}
{%- if atb_crop_images == blank -%}
{%- assign atb_crop_images = false -%}
{%- else -%}
{%- assign atb_crop_images = true -%}
{%- endif -%}
{%- if atb_enable_lightbox == blank -%}
{%- assign atb_enable_lightbox = false -%}
{%- else -%}
{%- assign atb_enable_lightbox = true -%}
{%- endif -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- assign atb_images_per_row = atb_images_per_row | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section gallery jsGallery">
{% comment %}
  ** Gallery **
{% endcomment %}

{%- assign blocks = section.blocks -%}

{% if type == 'block' %}
  {%- assign loop = '1,2,3,4,5' | split: ',' -%}
{% else %}
  {%- assign loop = blocks -%}
{% endif %}

{% comment %} Section specific CSS {% endcomment %}
{%- capture section_css -%}
  .gallery-item__overlay {
    background-color: {{ atb_overlay_color | color_modify: 'alpha', 0 }};
  }

  .gallery-item__overlay .icon {
    fill: {{ atb_link_color }};
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}

    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if loop.size > atb_images_per_row %}
      has-multirow-blocks
    {% endif %}
    {% if atb_width == 'wide' and atb_show_gutter == false %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="
      is-justify-center
      gallery__wrapper
      gallery-type--{{ atb_gallery_type }}
      {% if atb_gallery_type != 'masonry' %}
      container
      {% endif %}
    "
  >
    {% if blocks.size > 0 or loop.size > 0 %}
      {% for item in loop %}
        {% if type == 'block' %}
          {% capture index %}{{ forloop.index }}{% endcapture %}
        {% else %}
          {%- assign block = item -%}
        {% endif %}

        {% comment %} Add number to id for each loop {% endcomment %}
        {% capture image_index %}image{{ index }}{% endcapture %}
        {% capture link %}link{{ index }}{% endcapture %}
        {% capture hide %}hide{{ index}}{% endcapture %}

        {% comment %} Content settings {% endcomment %}
        {%- assign image = block_image_index[forloop.index0]] -%}
        {% comment %} End content settings {% endcomment %}

        {% if block_hide[forloop.index0]] == false or type != 'block' %}
          <div
            class="
              gallery__item
              {% if atb_show_gutter %}
                has-gutter
              {% endif %}
              {% if atb_gallery_type != 'horizontal-masonry' %}
                {% render 'column-width', value: atb_images_per_row %}
                medium-down--one-half
                small-down--one-whole
              {% endif %}
              column
              {% if atb_gallery_type == 'classic' and atb_crop_images == true %}
                has-image-crop image-crop--center
              {% endif %}
            "
            {% if type != 'block' %}
              {{- block.shopify_attributes -}}
            {% endif %}
          >
            {% if image != blank %}
              <div class="gallery__item-wrap is-relative">
                {% if atb_gallery_type == 'horizontal-masonry' %}
                  {%
                    render 'image-element',
                    image: image,
                    alt: image.alt,
                    back_to_basics: true,
                    focal_point: image.presentation.focal_point,
                  %}
                {% elsif atb_gallery_type == 'masonry' %}
                  {%
                    render 'image-element',
                    image: image,
                    alt: image.alt,
                    focal_point: image.presentation.focal_point,
                  %}
                {% else %}
                  {%
                    render 'image-element',
                    image: image,
                    alt: image.alt,
                    stretch_width: atb_crop_images,
                    focal_point: image.presentation.focal_point,
                  %}
                {% endif %}

                {% if atb_enable_lightbox or block_link[forloop.index0]] != blank %}
                  <div class="gallery-item__overlay is-flex is-align-center is-justify-center">
                    {% if atb_enable_lightbox %}
                      <a href="{{ image |  img_url: '2000x' }}" data-fancybox="{{ section_id }}" class="gallery__link">
                        {% render 'icon', name: 'zoom' %}
                      </a>
                    {% endif %}
                    {% if block_link[forloop.index0]] != blank %}
                      <a href="{{ block_link[forloop.index0]] }}" class="gallery__link">
                        {% render 'icon', name: 'link' %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

            {% else %}
              <div class="gallery__item-wrap is-relative">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}

                {% if atb_enable_lightbox or block_link[forloop.index0]] != blank %}
                  <div class="gallery-item__overlay is-flex is-align-center is-justify-center">
                    {% if atb_enable_lightbox %}
                      <a href="{{ image |  img_url: '2000x' }}" data-fancybox="{{ section_id }}" class="gallery__link">
                        {% render 'icon', name: 'zoom' %}
                      </a>
                    {% endif %}
                    {% if block_link[forloop.index0]] != blank %}
                      <a href="{{ block_link[forloop.index0]] }}" class="gallery__link">
                        {% render 'icon', name: 'link' %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% comment %} JavaScript {% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data
>
  {
    "gallery_type": {{ atb_gallery_type | json }},
    "show_gutter": {{ atb_show_gutter }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsGallery.js' | asset_url }}"></script>


</section>