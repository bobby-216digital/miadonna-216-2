{% comment %}
  Product snippet

  @param product
  @param selected_variant
  @param width
  @param css_class
  @param display_social_buttons
  @param display_thumbnails
  @param enable_product_lightbox
  @param enable_thumbnail_slider
  @param enable_zoom
  @param gallery_arrows
  @param product_description_position
  @param product_height
  @param set_product_height
  @param slideshow_transition
  @param stickers_enabled
  @param tag_style
  @param thumbnail_position
  @param video_looping
  @param section_onboarding
{% endcomment %}

{% comment %} HTML markup {% endcomment %}

<div
  class="
    product_section
    js-product_section
    container
    is-justify-space-between
    has-padding-bottom
    has-no-side-gutter
    {% if product_images_position == 'right' %}
      is-flex-row-reverse
    {% endif %}
  "
>
  {% comment %}
    <div class="mobile-only-section">
      <div
        class="
          product__information
          has-product-sticker
          two-fifths
          column
          large-down--one-whole
        "
      >
        {%- for block in section.blocks -%}
          {% unless block.type == 'media-buttons' or block.type == 'tgd' or block.type == 'additional-product-tabs' %}
            <div
              class="
                product-block
                product-block--{{ block.type | downcase | replace: '_', '-' | replace: '@', '-' }}
                {% if forloop.first == true %}
                  product-block--first
                {% endif %}
              "
              {{ block.shopify_attributes }}
            >
          {% endunless %}

          {%- if block.type == 'title' -%}
            <h1 class="product_name title">
              {% if is_product_modal %}
                <a href="{{ product.url  }}">{{ product.title }}</a>
              {% elsif section_onboarding %}
                {{ 'homepage.onboarding.product_title' | t }}
              {% else %}
                {{ product.title }}
              {% endif %}
            </h1>
            {% render 'okendo-custom-star-rating', product: product %}
          {%- elsif block.type == 'description' -%}
            {% if block.settings.custom_description != blank %}
              <div class="description content has-padding-top">
                {{ block.settings.custom_description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
              </div>
            {% elsif section_onboarding %}
              <div class="description content has-padding-top">
                <p>
                  {{ 'homepage.onboarding.product_description' | t }}
                </p>
              </div>
            {% else %}
              {% if product.description != blank %}
                <div
                  class="
                    description
                    description-content
                    content
                    has-padding-bottom
                  "
                >
                  {% if is_product_modal %}
                    {% if block.settings.truncate_words %}
                      {{
                        product.description
                        | strip_html
                        | truncatewords: block.settings.truncate_words_limit
                        | replace: 'Description', ''
                        | replace: 'Dimensions', ''
                        | replace: 'Details', ''
                        | replace: 'Specs', ''
                        | replace: 'Shipping', ''
                        | replace: 'Size', ''
                        | escape
                        | split: '<!-- split -->'
                        | first | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx
                      }}
                    {% else %}
                      {{
                        product.description
                        | strip_html
                        | replace: 'Description', ''
                        | replace: 'Dimensions', ''
                        | replace: 'Details', ''
                        | replace: 'Specs', ''
                        | replace: 'Shipping', ''
                        | replace: 'Size', ''
                        | escape
                        | split: '<!-- split -->'
                        | first | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx
                      }}
                    {% endif %}
                  {% else %}
                    {%- assign product_description = product.description -%}
                    {%- assign paragraphs = product_description | split: '</p>' -%}
                    {%- assign description_size = paragraphs.size -%}
                    {%- assign first_paragraph = '' -%}

                    {%- for paragraph in paragraphs -%}
                      {%- if paragraph contains '<p>' -%}
                        {%- assign p_start = paragraph | split: '<p>' | last -%}
                        {%- assign p_content = p_start | split: '|' | first -%}
                        {%- assign first_paragraph = p_content | strip -%}
                        {% break %}
                      {%- endif -%}
                    {%- endfor -%}
                    <div class="metal-properties">
                      {{
                        first_paragraph
                        | truncatewords: 10
                        | replace: '<br>', ''
                        | append: '<a href="#product-tgd-wrapper-mobile" style="font-weight:600;text-decoration:underline;margin-left:.5rem;">More Details</a>'
                      }}
                    </div>
                  {% endif %}
                  <!-- <a href="" style="font-weight:600;text-decoration:underline;">More Details</a> -->
                </div>
              {% endif %}
            {% endif %}

            {% if is_product_modal %}
              <a
                class="product__view-details"
                href="{{ product.url | within: collection  }}"
                title="{{ product.title | escape }}"
              >
                {{- 'collections.general.view_product_details' | t -}}
              </a>
            {% endif %}
          {% elsif block.type == '@app' %}
            <div class="product-app cell-style-blacktext">
              {% render block %}
            </div>
          {% endif %}
          {% unless block.type == 'media-buttons' or block.type == 'tgd' or block.type == 'additional-product-tabs' %}
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% endcomment %}

  {% assign allow_image_convention = product.metafields.attributes.allow_image_convention | plus: 0 %}
  {% assign allow_video_convention = product.metafields.attributes.allow_video_convention | plus: 0 %}
  <!-- speedsizeIgnore -->
  <div
    class="
      product__images
      three-fifths
      column
      large-down--one-whole
    "
  >
    {% assign display_count = 0 %}
    <div class="pg-container new-loose-diamond">
      {% for media in product.media limit: 6 %}
        {% comment %}
          {% assign display_count = display_count | plus: 1 %}

          {% assign pos = display_count | minus: 1 | modulo: 3 %}
        {% endcomment %}
        {% assign mod = forloop.index | minus: 2 | modulo: 3 %}

        {% if mod == 0 %}
          {% assign media_class = 'pg-row-two pg-row-single' %}
        {% else %}
          {% assign media_class = 'pg-row-two' %}
        {% endif %}
        {% if media.src contains 'webwhite'
          or media.src contains 'WebWhite'
          or media.src contains 'white'
          or media.src contains 'White'
          or media.src contains 'home_try-on'
          or media.src contains 'hero'
          or media.src contains 'Hero'
        %}
          {% comment %} Check alt text for video iframe {% endcomment %}

          <div class="image__container {{ media_class }}">
            <a
              href="{{ media | img_url: '2048x' }}"
              class="product-gallery__link"
              data-fancybox="{{ product.id }}"
              title="{{ image_alt | split: '|' | first | escape }}"
            >
              <div class="pg-cell">
                {%- if template_name == 'loose-lab' -%}
                  {{ media | image_url: width: 1200 | image_tag: alt: media.alt, preload: true, fetchpriority: 'high' }}
                {%- else -%}
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag: alt: media.alt, preload: true, fetchpriority: 'high'
                    | replace: 'https:https:', 'https:'
                    | replace: 'https:https:', 'https:'
                  }}
                {%- endif -%}
              </div>
            </a>
          </div>

        {% else %}
          <div class="image__container {{ media_class }}">
            <a
              href="{{ media | img_url: '2048x' }}"
              class="product-gallery__link"
              data-fancybox="product-gallery"
              title="{{ image_alt | split: '|' | first | escape }}"
            >
              <div class="pg-cell">
                {%- if template_name == 'loose-lab' -%}
                  {{ media | image_url: width: 1200 | image_tag: alt: media.alt, preload: true, fetchpriority: 'high' }}

                {%- else -%}
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag: alt: media.alt, preload: true, fetchpriority: 'high'
                    | replace: 'https:https:', 'https:'
                    | replace: 'https:https:', 'https:'
                  }}
                {%- endif -%}
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}

      {%- if product.metafields.vdb_product.vdb_video_url
        and product.metafields.vdb_product.vdb_video_url != '-'
        and product.metafields.vdb_product.vdb_video_url != '_'
        and product.metafields.vdb_product.vdb_video_url != blank
      -%}
        {%- assign d360 = product.metafields.vdb_product.vdb_video_url -%}
      {%- endif -%}
      {% if d360 %}
        {% comment %}
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "VideoObject",
              "name": "{{ product.title }}",
              "description": "{{ product.description  | strip_html }}",
              "thumbnailUrl": [
                "{{ product.featured_image.src | img_url: '1x1' }}"
              ],
              "uploadDate": "{{ product.created_at | iso8601 }}",
              "duration": "PT1M54S",  "embedUrl": "{{ d360  }}"  }
          </script>
        {% endcomment %}

        <a
          data-fancybox="product-gallery"
          data-type="iframe"
          href="{{ d360  }}"
          class="video-popup-trigger"
          aria-label="360 degree product view"
        >
          <div id="product-video--section" class="pg-row-two">
            <div
              id="product-vimeo_video"
              class="pg-cell is-video"
            >
              <div class="lazyframe canvas-video pg-cell" data-ratio="9:16" style="pointer-events:none;">
                <iframe
                  frameborder="0"
                  title="360 degree product view"
                  loading="lazy"
                  scrolling="no"
                  data-src="{{ d360  }}"
                  tabindex="-1"
                  aria-hidden="true"
                ></iframe>
              </div>
            </div>
          </div>
        </a>
      {% endif %}
    </div>
    {% comment %}
      {% if section_onboarding %}
        <div class="featured-product__images">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--product' }}
        </div>
      {% else %}
        {% render 'loose-product__images',
          product: product,
          template_name: 'loose-lab',
          display_thumbnails: display_thumbnails,
          thumbnail_position: thumbnail_position,
          enable_thumbnail_slider: enable_thumbnail_slider,
          product_height: product_height,
          set_product_height: set_product_height,
          video_looping: video_looping,
          gallery_arrows: gallery_arrows,
          slideshow_transition: slideshow_transition,
          enable_product_lightbox: enable_product_lightbox,
          enable_zoom: enable_zoom
        %}
      {% endif %}
    {% endcomment %}
    {% comment %}
      {%- for block in section.blocks -%}
        {%- if block.type == 'media-buttons' -%}
          <ul class="buttons-wrapper" id="media-buttons">
            {% if block.settings.button_1 != blank %}
              <li class="button-item">
                <button class="media-button">{{ block.settings.button_1 }}</button>
              </li>
            {% endif %}
            {% if block.settings.button_2 != blank %}
              <li class="button-item">
                <button onClick="productImages('images')" class="product-image--button media-button block-button-active">
                  {{ block.settings.button_2 }}
                </button>
              </li>
            {% endif %}
            {% if block.settings.button_3 != blank %}
              {%- if product.metafields.attributes.vimeo_id
                and product.metafields.attributes.vimeo_id != '-'
                and product.metafields.attributes.vimeo_id != '_'
              -%}
                {%- assign vimeo_video = product.metafields.attributes.vimeo_id -%}
              {%- endif -%}
              {% if vimeo_video %}
                <li class="button-item">
                  <button onClick="productImages('video')" class="product-video--button media-button">
                    {{ block.settings.button_3 }}
                  </button>
                </li>
              {% endif %}
              {%- if product.metafields.vdb_product.vdb_video_url
                and product.metafields.vdb_product.vdb_video_url != '-'
                and product.metafields.vdb_product.vdb_video_url != '_'
                and product.metafields.vdb_product.vdb_video_url != blank
              -%}
                {%- assign d360 = product.metafields.vdb_product.vdb_video_url -%}
              {%- endif -%}
              {% if d360 %}
                <li class="button-item">
                  <button onClick="productImages('video')" class="product-video--button media-button">
                    {{ block.settings.button_3 }}
                  </button>
                </li>
              {% endif %}
            {% endif %}
            {% if block.settings.button_4 != blank %}
              <li class="button-item">
                <button onClick="productImagesPopup('all')" class="media-button">{{ block.settings.button_4 }}</button>
              </li>
            {% endif %}
          </ul>
        {%- elsif block.type == 'tgd' -%}
          <div id="product-tgd-wrapper-desktop" class="product-tgd-wrapper product-tgd-wrapper-desktop">
            <div class="product-tgd">
              <div class="one-third column medium-down--one-whole">
                <img
                  src="{{ block.settings.image1 | img_url: 'master' }}"
                  width="100%"
                  height="100%"
                  loading="eager"
                >
                <div class="content">
                  <h6>{{ block.settings.title1 }}</h6>
                  {{ block.settings.content1 }}
                </div>
              </div>
              <div class="one-third column medium-down--one-whole">
                <img
                  src="{{ block.settings.image2 | img_url: 'master' }}"
                  width="100%"
                  height="100%"
                  loading="eager"
                >
                <div class="content">
                  <h6>{{ block.settings.title2 }}</h6>
                  {{ block.settings.content2 }}
                </div>
              </div>
              <div class="one-third column medium-down--one-whole">
                <img
                  src="{{ block.settings.image3 | img_url: 'master' }}"
                  width="100%"
                  height="100%"
                  loading="eager"
                >
                <div class="content">
                  <h6>{{ block.settings.title3 }}</h6>
                  {{ block.settings.content3 }}
                </div>
              </div>
            </div>
          </div>
        {%- elsif block.type == 'additional-product-tabs' -%}
          <div class="product-additional-information">
            <setting-tabs class="setting-tabs-wrapper">
              <div class="setting-tabs-buttons">
                {% if product.tags != blank %}
                  <button id="product-details" class="setting-tab-button product-details button-active">
                    Product Details
                  </button>
                {% endif %}
                {% comment %} {% if product.description == blank %}button-active{% endif %} {% endcomment %}
                <button
                  id="product-shipping"
                  class="setting-tab-button product-shipping {% if product.tags == blank %}button-active{% endif %}"
                >
                  Shipping And Returns
                </button>
                <button id="product-included" class="setting-tab-button product-included">Material & Quality</button>
              </div>
              {% if product.tags != blank %}
                <div id="product-details-content" class="setting-tab-content product-details-content tab-active">
                  <div class="products__specs-wrapper">
                    <div class="products__specs">
                      {%- assign caratTags = product.tags | where: 'carat_' | last -%}
                      {%- assign shapeTags = product.tags | where: 'shape_' | last -%}
                      {%- assign cutTags = product.tags | where: 'cut_' | last -%}
                      {%- assign colorTags = product.tags | where: 'color_' | last -%}
                      {%- assign clarityTags = product.tags | where: 'clarity_' | last -%}
                      {%- assign sustainabilityTags = product.tags | where: 'sustainability_' | last -%}
                      {%- assign labTags = product.tags | where: 'lab_' | last -%}
                      {%- assign originTags = product.tags | where: 'origin_' | last -%}
                      {%- assign measurementsTags = product.tags | where: 'measurements_' | last -%}
                      {%- assign depthTags = product.tags | where: 'depth_' | last -%}
                      {%- assign tableTags = product.tags | where: 'table_' | last -%}
                      {%- assign polishTags = product.tags | where: 'polish_' | last -%}
                      {%- assign symmetryTags = product.tags | where: 'symmetry_' | last -%}
                      {%- assign fluorTags = product.tags | where: 'fluor_' | last -%}
                      {%- assign lWRatioTags = product.tags | where: 'l_w_ratio_' | last -%}
                      {%- assign certNumTags = product.tags | where: 'cert_num_' | last -%}
                      {%- assign certURLTags = product.tags | where: 'cert_url_' | last -%}
                      {%- assign culetSizeTags = product.tags | where: 'culet_size_' | last -%}

                      <ul class="products__specs-list">
                        {%- if caratTags.size > 0 %}
                          <li>
                            <span>Carat:</span>
                            <span>{{- caratTags | remove: 'carat_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if shapeTags.size > 0 %}
                          <li>
                            <span>Shape:</span>
                            <span>{{- shapeTags | remove: 'shape_' | remove: '_cut' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if cutTags.size > 0 %}
                          <li>
                            <span>Cut:</span>
                            <span>{{- cutTags | remove: 'cut_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if colorTags.size > 0 %}
                          <li>
                            <span>Color:</span>
                            <span>{{- colorTags | remove: 'color_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if clarityTags.size > 0 %}
                          <li>
                            <span>Clarity:</span>
                            <span>{{- clarityTags | remove: 'clarity_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if sustainabilityTags.size > 0 %}
                          <li>
                            <span>Sustainability:</span>
                            <span>{{- sustainabilityTags | remove: 'sustainability_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if certNumTags.size > 0 %}
                          <li>
                            <span>Certificate:</span>
                            <span
                              class="cert-popup-pdp open-cert-popup-pdp"
                              data-cert-url="{%- if product.metafields.vdb_product.vdb_cert_url.size > 0 %}{{- product.metafields.vdb_product.vdb_cert_url -}}{% endif -%}"
                            >
                              {%- if certNumTags.size > 0 %}
                                #
                                {{- certNumTags | remove: 'cert_num_' -}}
                              {% endif -%}
                            </span>
                          </li>
                        {% endif -%}
                        {% comment %}
                          {%- if originTags.size > 0 %}
                            <li>
                              <span>Origin:</span>
                              <span>{{- originTags | remove: 'origin_' | replace: "_", " " -}}</span>
                            </li>
                          {% endif -%}
                        {% endcomment %}
                        {%- if selected_variant.sku.size > 0 %}
                          <li>
                            <span>SKU:</span>
                            <span>{{- selected_variant.sku -}}</span>
                          </li>
                        {% endif -%}
                        {%- if measurementsTags.size > 0 %}
                          <li>
                            {% comment %} <span>Measurements (MM):</span> {% endcomment %}
                            <span>Measurement:</span>
                            <span>{{- measurementsTags | remove: 'measurements_' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if depthTags.size > 0 %}
                          <li>
                            <span>Depth:</span>
                            <span>{{- depthTags | remove: 'depth_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if tableTags.size > 0 %}
                          <li>
                            <span>Table %:</span>
                            <span>{{- tableTags | remove: 'table_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if polishTags.size > 0 %}
                          <li>
                            <span>Polish:</span>
                            <span>{{- polishTags | remove: 'polish_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if symmetryTags.size > 0 %}
                          <li>
                            <span>Symmetry:</span>
                            <span>{{- symmetryTags | remove: 'symmetry_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if culetSizeTags.size > 0 %}
                          <li>
                            <span>Culet:</span>
                            <span>{{- culetSizeTags | remove: 'culet_size_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if fluorTags.size > 0 %}
                          <li>
                            <span>Fluorescence:</span>
                            <span>{{- fluorTags | remove: 'fluor_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                        {%- if lWRatioTags.size > 0 %}
                          <li>
                            <span>Length/Width Ratio:</span>
                            <span>{{- lWRatioTags | remove: 'l_w_ratio_' | replace: '_', ' ' -}}</span>
                          </li>
                        {% endif -%}
                      </ul>
                    </div>
                  </div>
                </div>
              {% endif %}
              {% comment %} {% if product.description == blank %}tab-active{% endif %} {% endcomment %}
              <div
                id="product-shipping-content"
                class="setting-tab-content product-shipping-content {% if product.tags == blank %}button-active{% endif %}"
              >
                {%- assign shippingReturnsText = '' -%}
                {%- for productCollection in product.collections -%}
                  {%- if productCollection.metafields.product.shipping_text -%}
                    {%- assign shippingReturnsText = productCollection.metafields.product.shipping_text -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if shippingReturnsText != '' -%}
                  <div class="dynamic-shipping-content">
                    {{ shippingReturnsText }}
                  </div>
                {%- else -%}
                  <div class="static-shipping-content">
                    {{ settings.product_shipping_content | replace: '<p></p>', '<br>' }}
                  </div>
                {%- endif -%}
              </div>
              <div id="product-included-content" class="setting-tab-content product-included-content">
                <div class="static-material-content">
                  {{ settings.material_quality_content | replace: '<p></p>', '<br>' }}
                </div>
              </div>
            </setting-tabs>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {% endcomment %}
  </div>
  <!--endSpeedsizeIgnore-->

  <div
    class="
      product__information
      has-product-sticker
      two-fifths
      column
      large-down--one-whole
    "
  >
    <div class="sku-review">
      <div class="block--sku">
        <div class="order-ship-date">
          <p class="order-ship-text">SKU:</p>
          <p class="order-ship-date order-ship-sku">
            {{ product.selected_or_first_available_variant.sku }}
          </p>
        </div>
      </div>
      <div class="star-wish">
        {% comment %} {% render 'okendo-custom-star-rating', product: product %} {% endcomment %}
        <div class="header__icon" data-icon="heart">
          {% comment %} <span>|</span>  {% endcomment %}
          <mage-wishlist-heart product-id="{{ product.id }}"></mage-wishlist-heart>
          {%- comment -%}
            <svg width="15" height="13" viewBox="0 0 13 11" xmlns="http://www.w3.org/2000/svg">
