    __domReady__(function() {
      KlaviyoSubscribe.attachToForms("#email_signup", {
        success: function(form) {
          var successMessageHeight = form.find('.email-alert.email-alert-success').outerHeight();
          $('.footer__store-info').css('bottom', successMessageHeight);
          form.find('.email-alert.email-alert-success').finish().show().delay(4000).fadeOut("fast", function() {
            $('.footer__store-info').css('bottom', '0');
          });
          $('.email-input').val('').blur();
          $('.sign-up').blur();
          ga('send', 'event', 'Funnel Tracking', 'Click', 'Email Sign-up');
