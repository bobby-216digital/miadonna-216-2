{% comment %}
ATB-SCHEMA{
  "name": "Sustainable Practice",
  "id": "how-we-give_sustainable",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_count",
      "label": "Count",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_left_heading",
      "label": "Left Heading",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_left_text",
      "label": "Left Text",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_right_heading",
      "label": "Right Heading",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_right_text",
      "label": "Right Text",
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_count' -%}
{%- assign atb_count = val -%}
{%- include 'atb-render' field:'atb_left_heading' -%}
{%- assign atb_left_heading = val -%}
{%- include 'atb-render' field:'atb_left_text' -%}
{%- assign atb_left_text = val -%}
{%- include 'atb-render' field:'atb_right_heading' -%}
{%- assign atb_right_heading = val -%}
{%- include 'atb-render' field:'atb_right_text' -%}
{%- assign atb_right_text = val -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
<section class="_body content-cell offset-group body-cell typeset-cell">
	<div class="pure-g">
		<div class="cell-style-E pure-u-1 pure-u-md-1-2 sustainable-practices _left">
			<h1 class="count">{{ atb_count }}</h1>
			<h2>{{ atb_left_heading }}</h2>
			<p>{{ atb_left_text }}</p>
		</div>
		<div class="pure-u-1 pure-u-md-1-2 left-align sustainable-practices _right">
			<i class="ornamental-break ornamental-break-green ornamental-break-left"></i>
			<h2 class="black-text text-style-title content-subtitle">{{ atb_right_heading }}</h2>
			<p>{{ atb_right_text }}</p>
		</div>
	</div>
</section>



