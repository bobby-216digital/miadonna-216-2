<section id="shopify-section-{{section_id}}" class="shopify-section newsletter">
{% comment %}
** Newsletter **
{% endcomment %}

{% comment %} Assign object as block or section {% endcomment %}
{% if type == 'block' %}
  {%- assign object = block -%}
{% else %}
  {%- assign object = section -%}
{% endif %}

{% comment %} Content Settings {% endcomment %}
{%- assign heading = atb_newsletter_title -%}
{%- assign subheading = atb_newsletter_richtext -%}
{%- assign background_image = atb_background_image -%}
{%- assign image_darken = atb_image_darken -%}
{%- assign image = atb_image -%}
{%- assign image_position = atb_image_position -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign text_alpha = atb_text_color | color_extract: 'alpha' -%}

{%- capture section_css -%}

  {% if background_image != blank %}
    .has-background .newsletter__wrapper {
      background-image: url({{ settings.speedsize_url_pfx_https -}}{{ background_image | img_url: '2000x' }});
      background-position: {{ background_image.presentation.focal_point }};
    }
  {% endif %}

  .section {
    background-color: {{ atb_background_color }};
  }

  .newsletter-container {
    {% if atb_width == 'wide' %}
    width: 100%;
    {% endif %}
  }

  .newsletter__text {
    color: {% if text_alpha != 0 %}{{ atb_text_color }}{% else %}{{ settings.regular_color }}{% endif %}
  }

{%- endcapture -%}

{% style %}
  #shopify-section-{{ object.id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% elsif atb_width == 'half' %}
      width: 50%;
    {% endif %}
  }

  #shopify-section-{{ object.id }} .newsletter__wrapper {
    {% if atb_width == 'half' %}
      max-width: 100%;
    {% endif %}
  }

  {% render 'css-loop',
          css: section_css,
          id: object.id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: object.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
{% if image != blank %}
  <div class="newsletter__image--mobile-wrapper has-image-crop">
    {%
      render 'image-element',
      image: image,
      alt: image.alt,
      stretch_width: true,
      focal_point: image.presentation.focal_point,
    %}
  </div>
{% endif %}
<section class="section newsletter-section newsletter-section--is-width-{{ atb_width }}
                {{ atb_css_class }}
                {{ newsletter_class }}
                is-width-{{ atb_width }}
                {% if image != blank %}
                  has-full-width-crop
                {% endif %}
                {% if background_alpha != 0 or gradient_alpha != 0 or background_image != blank %}
                  has-background
                {% endif %}
                {% if background_image != blank %}
                  dark-overlay-{{ image_darken  }}
                {% endif %}"
                {% if atb_animation != "none" %}
                  data-scroll-class="{{ atb_animation }}"
                {% endif %} >
  <div class="newsletter-container is-flex
              {% if image_position == 'right' %}is-flex-row-reverse{% endif %}">
    {% if image != blank %}
      <div class="newsletter__image one-half column has-image-crop">
        {%
          render 'image-element',
          image: image,
          alt: image.alt,
          stretch_width: true,
          calculate_wrap: true,
          focal_point: image.presentation.focal_point,
        %}
      </div>
    {% endif %}

    <div class="newsletter__wrapper column {% if image != blank %} is-active-image one-half medium-down--one-whole{% else %} one-whole {% endif %}">
      <div class="newsletter__text-wrapper text-align-{{ atb_newsletter_section_text_align }}">
        <h2 class="newsletter__heading newsletter__text title">{{ heading }}</h2>
        <div class="newsletter__subheading newsletter__text">{{ subheading }}</div>
      </div>

      {% render 'newsletter-form',
              type: 'section',
              display_first_name: atb_display_first_name,
              display_last_name: atb_display_last_name
      %}
    </div>
  </div>
</section>


</section>