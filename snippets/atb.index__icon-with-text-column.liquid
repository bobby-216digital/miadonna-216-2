{% comment %}
ATB-SCHEMA{
  "name": "Text columns with icons",
  "class": "icon-with-text-column",
  "max_blocks": 20,
  "id": "index__icon-with-text-column",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_preheading",
      "label": "Pre-Heading",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_heading",
      "label": "Heading",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_icons_per_row",
      "label": "Items per row",
      "min": 1,
      "max": 8,
      "default": 4,
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_icon_size",
      "label": "Icon size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_align_text",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_button_style",
      "label": "Button style",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--primary",
      "info": ""
    },
    {
      "type": "header",
      "content": "Colors",
      "info": ""
    },
    {
      "type": "color",
