<section id="shopify-section-{{section_id}}" class="shopify-section icon-with-text-column">
{% comment %}
** Icon with text column **
{% endcomment %}

{% comment %} Content setttings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign text_alpha = atb_text_color | color_extract: 'alpha' -%}
{%- assign icon_alpha = atb_icon_color | color_extract: 'alpha' -%}
{%- assign background_alpha = atb_background | color_extract: 'alpha' -%}
{%- assign gradient_alpha = atb_gradient | color_extract: 'alpha' -%}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}

  .icon-with-text-column__column {
    background-image: linear-gradient({{ atb_gradient_rotation }}deg, rgba(255,255,255,0), {{ atb_gradient }});
    background-color: {%- if background_alpha != 0 -%}{{ atb_background }}{%- endif -%};

  }

  .icon-column__title {
    color: {%- if text_alpha != 0 -%}{{ atb_text_color }}{%- endif -%};
  }

  .icon {
    fill: {%- if icon_alpha != 0 -%}{{ atb_icon_color }}{%- endif -%};
  }

  .icon-column__text {
    color: {%- if text_alpha != 0 -%}{{ atb_text_color }}{%- endif -%};
  }

{%- endcapture -%}

{% style %}
    .icon-with-text-column {
    z-index: 9;
}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% elsif atb_width == 'half' %}
      width: 50%;
    {% endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
   #shopify-section-{{ section_id }} .icon-column__title {
    font-size: 18px;
    margin-top: 20px;
    margin-bottom: 30px;
    font-weight: 500;
     font-family: Montserrat,sans-serif !important;
}
 #shopify-section-{{ section_id }}  section.section {
    /* margin-top: -75px; */
    background: #fff;
    padding: 40px 0;

    width: 100%;
   /* box-shadow:50px 50px 79px #00000012; */
   border-radius:2px;
}
  #shopify-section-{{ section_id }}  .icon-with-text-column__column {
    padding: 0 65px;
    padding-bottom: 30px;
}
    #shopify-section-{{ section_id }}  p {
    font-size: 15px;
    color: #212121 !important;
          font-family: Montserrat,sans-serif !important;
    line-height: 1.3;
}
  .container.is-justify-center.diamond-landing-template-content header {
    width: 100%;
    margin: 0 auto;
    text-align: CENTER;
}
  @media screen and (max-width:768px){
 #shopify-section-{{ section_id }}   {
    margin: 0 20px;
    width: auto;
}

#shopify-section-{{ section_id }}  .section {
    margin-top: -30px !important;
}
  }
{% endstyle %}

<section class="section
                {{ atb_css_class }}
                is-width-{{ atb_width }}
                {% if atb_show_gutter == false %}
                  has-no-side-gutter
                  has-background
                {% else %}
                  has-gutter-enabled
                {% endif %}
                {% if blocks.size > atb_icons_per_row %}
                  has-multirow-blocks
                {% endif %}
                {% if atb_width == 'wide' %}
                  equal-columns--outside-trim
                {% endif %}"
                {% if atb_animation != "none" %}
                  data-scroll-class="{{ atb_animation }}"
                {% endif %}>
  <div class="container is-justify-center diamond-landing-template-content">
    {% if atb_heading != blank %}
    <header>
        <div class="_inner">
          <h2>
            <span class="block-pre-header">{{ atb_preheading }}</span>
            <span class="block-header">{{ atb_heading }}</span>
          </h2>
          <i class="ornamental-break -dark"></i>
        </div>
      </header>
      {% endif %}
    {% for block in blocks %}

      {% comment %} Content settings {% endcomment %}
      {%- assign text = block_text[forloop.index0] -%}
      {% comment %} End content settings {% endcomment %}

      <div class="icon-with-text-column__column
                  {% if atb_show_gutter %}
                    has-gutter
                  {% endif %}
                  column
                  has-padding
                  {% render 'column-width', value: atb_icons_per_row %}
                  text-align-{{ atb_align_text }}
                  medium-down--one-whole">

        {%- capture icon_size -%}
          is-{{ atb_icon_size }}
        {%- endcapture -%}

      {% if my_image0 != blank %}
        {%- assign icon = my_image0 | img_url -%}

        <div class="icon_img"><img src="{{ icon | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}" width="51" height="" alt="{{ block_title[forloop.index0] }}" loading="lazy"></div>
      {% endif %}
        {% if block_title[forloop.index0] != blank or text != blank %}
          <div class="icon-column__text ">
            <h3 class="icon-column__title title">{{ block_title[forloop.index0] }}</h3>
            {{ text }}
          </div>
        {% endif %}

        {% if block_button_label[forloop.index0] != blank %}
          <div class="icon-column__action has-padding-top">
            {% render 'button',
                    label: block_button_label[forloop.index0],
                    href: block_link[forloop.index0],
                    style: atb_button_style,
                    type: "link"
            %}
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>
</section>


</section>