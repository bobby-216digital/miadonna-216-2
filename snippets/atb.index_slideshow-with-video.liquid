<section id="shopify-section-{{section_id}}" class="shopify-section jsSlideshowClassic overlaid-header-option slideshow-section video-slideshow-section under-menu">
{% comment %}
  ** Slideshow classic **
{% endcomment %}

{% comment %} Content settings {% endcomment %}

{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
    #shopify-section-{{ section_id }} {
      padding-top: {{ atb_padding_top }}px;
      padding-bottom: {{ atb_padding_bottom }}px;
      {% if atb_width == 'wide' %}
        width: 100%;
      {% endif %}
    }

    #shopify-section-{{ section_id }} .slideshow-classic {
      height: 588px;
    }
    #shopify-section-{{ section_id }} .slideshow-classic .gallery-cell,
    #shopify-section-{{ section_id }} .video-element {
      height: 100%;
    }
    #shopify-section-{{ section_id }} .video-element video {
      height: 100%;
      display: block;
      object-fit: cover;
      aspect-ratio: 16/9;
    }
    #shopify-section-{{ section_id }} .slideshow-classic__subheading {
      font-size: 14px;
      line-height: 20px;
      text-transform: inherit;
    }
    #shopify-section-{{ section_id }} .slideshow-classic__buttons {
      align-items: flex-start;
      flex-direction: column;
    }
    #shopify-section-{{ section_id }} .slideshow-classic__buttons a.button--primary {
      width: 100%;
    }
    #shopify-section-{{ section_id }} .slideshow-classic .flickity-page-dots {
      max-width: 1440px;
      width: 100%;
      left: 30px;
      right: 0;
      margin: auto;
      text-align: left;
      padding: 0 40px;
      bottom: 40px !important;
    }
    #shopify-section-{{ section_id }} .slideshow-classic .flickity-page-dots .dot {
      border-radius: 0;
    }
    @media screen and (min-width: 768px) {
      .video-slideshow-section .play-button{
        padding:15px 16px;
      }
      .video-slideshow-section .play-button img {
        top: 0;
        left: 2px;
        margin: 0 auto;
        position: relative;
        height: 20px;
        vertical-align: middle;
      }
      #shopify-section-{{ section_id }} .slideshow-classic {
        height: 780px;
      }
      #shopify-section-{{ section_id }} .slideshow-classic__subheading {
        font-size: 15px;
      }
      #shopify-section-{{ section_id }} .slideshow-classic__buttons a.button--primary {
        width: 35%;
      }
    }
    @media screen and (min-width: 1500px) {
      #shopify-section-{{ blocks[forloop.index0] }} .caption-content {
        padding: 0;
      }
      #shopify-section-{{ section_id }} .slideshow-classic .flickity-page-dots {
        left: 0;
      }
    }
    @media screen and (max-width: 1500px) {
      #shopify-section-{{ section_id }} .slideshow-classic .flickity-page-dots {
        left: 0;
        padding: 0 30px;
      }
    }
    @media screen and (max-width: 767px) {
      .video-slideshow-section .title span {
        font-size: 22px;
      }
      .slideshow-classic .mobile-text--over-media .caption {
        /* top: 25%;
        transform: translateY(-50%); */
        top: 0;
        transform: none;
      }
      #shopify-section-{{ section_id }} .slideshow-classic__buttons a.button--primary {
        width: auto;
        min-width: 156px;
      }
    }

    #shopify-section-{{ section_id }} .desktop-image,
    #shopify-section-{{ section_id }} .mobile-image {
      width: 100%;
    }
    #shopify-section-{{ section_id }} .image-slideshow__slide .video-element:after {
      width: 100%;
      position: absolute;
      content: "";
      top: 0;
      right: 0;
      left: 0;
      background: rgba(0,0,0,0.2);
      bottom: 0;
      /* z-index: -1; */
    }
    .video-slideshow-section .video-element video{
      width:100%;
    }
    .video-slideshow-section .slideshow-classic__heading{
      text-transform:uppercase;
    }
    .video-slideshow-section .title span{
      text-transform:capitalize;
    }
    .video-slideshow-section .slideshow-classic__subheading {
      text-transform:uppercase;
    }
    .video-slideshow-section .slideshow-classic__subheading span {
      display: block;
    }
    .video-slideshow-section .flickity-page-dots .dot{
        width:30px;
    }
    #shopify-section-{{ section_id }} .slideshow-classic .mobile-text--over-media .caption {
      max-width: 1440px;
      left: 0;
      right: 0;
      margin: auto;
    }
    @media (max-width: 767px) {
      .video-slideshow-section .video-element video,.video-slideshow-section .plyr__video-embed iframe{
        height:750px;
        object-fit:cover;
      }

      .video-slideshow-section span.close-btn {
      /* color: #fff; */
      font-size: 20px;
      top: 5%;
      right: 2%;

  }
      .video-slideshow-section .plyr__video-embed, .video-slideshow-section .plyr__video-wrapper--fixed-ratio {
        z-index: -1;
        position: relative;
    }
      .video-slideshow-section .slideshow-classic .flickity-page-dots{
        /* bottom: 15% !important; */
        bottom: 5% !important;
      }
      .video-slideshow-section .slideshow-classic__banner h2.title {
        font-size: 32px;
        font-weight: 600;
        line-height: 40px;
      }
      .video-slideshow-section .slideshow-classic__buttons a.button--primary,.video-slideshow-section .watch-btn p{
        font-size: 13px !important;
      }
      .video-slideshow-section .play-button{
        padding:10px 12px;
      }
      .video-slideshow-section .play-button img {
          top: 0px;
          left: 2px;
          height: 15px;
      }
      .video-slideshow-section .watch-btn {
          position: absolute;
          bottom: 8%;
          right: auto;
          /* top: 38px; */
          left: 10%;
      }
      .slideshow-classic .mobile-text--over-media .caption {
        /* top: 25%;
        transform: translateY(-50%); */
        top: 0;
        transform: none;
      }
      .video-slideshow-section .plyr__video-embed,
      .video-slideshow-section .lazyframe,
      .video-slideshow-section .lazyframe iframe {
        height: 100%;
        padding-bottom: 0;
      }
    }
    {%
      render 'css-loop',
      css: section_css,
      id: section_id
    %}

    {%
      render 'css-loop',
      css: atb_custom_css,
      id: section_id
    %}
{% endstyle %}

