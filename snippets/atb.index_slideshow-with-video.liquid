    is-width-{{ atb_width }}
    under-overlay-menu
    {% if atb_mobile_text_below_image == true %}
      mobile-text--below-media
      {% else %}
      mobile-text--over-media
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="
      slideshow-classic
      image-slideshow
      image-slideshow--{{ atb_image_transition  }}
      page-dots--{{ atb_show_nav_buttons }}
    "
    data-slideshow-classic
  >
    {% for block in blocks %}
      {% comment %} Content settings {% endcomment %}
      {%- assign image = my_image0 -%}
      {%- assign link = block_link[forloop.index0] -%}
      {%- assign mobile_image = my_image1 -%}
      {%- assign pretext = block_pretext[forloop.index0] -%}
      {%- assign title = block_title[forloop.index0] -%}
      {%- assign subtitle = block_subtitle[forloop.index0] -%}
      {%- assign text_horizontal_position = block_text_horizontal_position[forloop.index0] -%}
      {%- assign button_1 = block_button_1[forloop.index0] -%}
      {%- assign button_1_link = block_button_1_link[forloop.index0] -%}
      {%- assign button_2 = block_button_2[forloop.index0] -%}
      {%- assign button_2_link = block_button_2_link[forloop.index0] -%}
      {%- assign video-url = block_video-url[forloop.index0] -%}
      {%- assign iframe_video = block_iframe_video_id[forloop.index0] -%}
      {% comment %} Ends content settings {% endcomment %}

      {% comment %} NE compatibility {% endcomment %}
      {% comment %} In the new editor, these will reference the section settings instead of the blocks{% endcomment %}
      {% comment %} In the new editor, aside from the block settings listed above, all other block setting references should be changed to section settings including classes {% endcomment %}
      {%- assign background_color_alpha = my_range0 | divided_by: 100.00 -%}
      {%- assign heading_alpha = block_heading_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign preheading_alpha = block_pretext_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign subheading_alpha = block_subheading_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign caption_border_alpha = block_border_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign mobile_headline_alpha = block_heading_color_mobile[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign mobile_preheading_alpha = block_pretext_color_mobile[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign mobile_subtitle_alpha = block_subheading_color_mobile[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign caption_background_alpha = block_background_color[forloop.index0] | color_extract: 'alpha' -%}
      {% comment %} Ends NE compatibility {% endcomment %}

      <div
        class="
          gallery-cell
          image-slideshow__slide
          slideshow-classic__banner
          {% if atb_mobile_text_below_image == true %}
            mobile-text--below-media
          {% else %}
            mobile-text--over-media
          {% endif %}
        "
        id="shopify-section-{{ blocks[forloop.index0] }}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% if button_1 != blank and button_2 != blank %}
          {%- assign buttons = true -%}
        {% else %}
          {%- assign buttons = false -%}
        {% endif %}

        {% style -%}
          #shopify-section-{{ blocks[forloop.index0] }} .caption-content {
            width: 100%;
            background-color: {% if caption_background_alpha != 0 %}{% if background_color_alpha != 100  %}{{ block_background_color[forloop.index0] | color_modify: 'alpha', background_color_alpha }}{% else %}{{ block_background_color[forloop.index0] }}{% endif %}{% else %}rgba(0,0,0,0){% endif %};
            {% comment %} NE compatibility {% endcomment %}
            {% comment %} This will change to a default 2px border if the border color has been set {% endcomment %}
            {% comment %}{% if atb_border_color != 0 %}border: 2px solid {{ atb_border_color }}{% endif %};{% endcomment %}
            border: {{ my_range1 }}px solid {{ block_border_color[forloop.index0] }};
            {% comment %} Ends NE compatibility {% endcomment %}
          }

          #shopify-section-{{ blocks[forloop.index0] }} .slideshow-classic__heading {
            word-break: break-word;
            color: {% if heading_alpha != 0 %}{{ block_heading_color[forloop.index0] }}{% else %}{{ settings.heading_color }}{% endif %};
          }

          #shopify-section-{{ blocks[forloop.index0] }} .slideshow-classic__preheading {
            color: {% if preheading_alpha != 0 %}{{ block_pretext_color[forloop.index0] }}{% else %}{{ settings.heading_color }}{% endif %};
          }

          #shopify-section-{{ blocks[forloop.index0] }} .slideshow-classic__subheading {
            color: {% if subheading_alpha != 0 %}{{ block_subheading_color[forloop.index0] }}{% else %}{{ settings.heading_color }}{% endif %};
          }

          @media only screen and (min-width: 768px) {
            #shopify-section-{{ blocks[forloop.index0] }} .caption-content {
              width: 95%;
            }
          }

          @media only screen and (min-width: 991px) {
            #shopify-section-{{ blocks[forloop.index0] }} .caption-content {
              width: {{ my_range2 }}%;
            }
          }

          @media only screen and (max-width: 480px) {
            #shopify-section-{{ blocks[forloop.index0] }}  .slideshow-classic__heading {
              color: {% if mobile_headline_alpha != 0 %}{{ block_heading_color_mobile[forloop.index0]}}{% endif %};
            }
            #shopify-section-{{ blocks[forloop.index0] }}  .slideshow-classic__preheading {
              color: {% if mobile_preheading_alpha != 0 %}{{ block_pretext_color_mobile[forloop.index0]}}{% endif %};
            }
            #shopify-section-{{ blocks[forloop.index0] }}  .slideshow-classic__subheading {
              color: {% if mobile_subtitle_alpha != 0 %}{{ block_subheading_color_mobile[forloop.index0]}}{% endif %};
            }
          }
        {% endstyle -%}

        {% if mobile_image != blank %}
          {%- assign hide_mobile = 'is-hidden-mobile-only' -%}
        {% endif %}

        {% if image != blank %}
          {%
            render 'image-element',
            image: image,
            alt: image.alt,
            stretch_width: true,
            section: 'slideshow',
            additional_classes: hide_mobile,
            focal_point: image.presentation.focal_point,
          %}
        {% endif %}

        {% if video-url != blank %}
          <div class="video-element" data-video-element tabindex="-1">
            <video
              preload="none"
              class="slider-bg-video video-{{ blocks[forloop.index0] }}"
              data-video-element
              loop
              muted
              autoplay
              playsinline
              defer
            >
              <source src="{{ video-url | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}">
            </video>
          </div>
        {% endif %}

        {% if mobile_image != blank %}
          <div class="is-hidden-desktop-only" tabindex="-1">
            {%
              render 'image-element',
              image: mobile_image,
              alt: mobile_image.alt,
              stretch_width: true,
              section: 'slideshow',
              focal_point: mobile_image.presentation.focal_point,
            %}
          </div>
        {% endif %}

        {% if link != blank %}
          <a class="banner--full-link" href="{{ link }}" tabindex="-1"></a>
        {% endif %}

        {% if pretext != blank or title != blank or subtitle != blank or button_1 != blank or button_2 != blank %}
          <div class="caption text-align-{{ text_horizontal_position }}" tabindex="-1">
            <div class="caption-content text-align-{{ block_text_alignment[forloop.index0] }}">
              {% if pretext != blank %}
                <div class="slideshow-classic__preheading pretext">
                  {{ pretext }}
                </div>
              {% endif %}
              {% if title != blank %}
                <h2
                  class="
                    slideshow-classic__heading
                    title
                    {% if settings.banner_heading_size > 35 %}
                      mobile-shrink-text
                    {% endif %}
                  "
                >
                  {{ title }}
                </h2>
              {% endif %}
              {% if subtitle != blank %}
                <h3 class="slideshow-classic__subheading subtitle">
                  {{ subtitle | replace: 'p>', 'span>' }}
                </h3>
              {% endif %}
              {% if button_1 != blank or button_2 != blank %}
                <div
                  class="
                    slideshow-classic__buttons
                    buttons
                    {% unless buttons == true %}
                      is-justify-{{ block_text_alignment[forloop.index0] }}
                    {% endunless %}
                  "
                >
                  {% if button_1 != blank %}
                    {% render 'button',
                      label: button_1,
                      href: button_1_link,
                      type: 'link',
                      style: block_button_1_style[forloop.index0]
                    %}
                  {% endif %}

                  {% if button_2 != blank %}
                    {% render 'button',
                      label: button_2,
                      href: button_2_link,
                      type: 'link',
                      style: block_button_2_style[forloop.index0]
                    %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
          {% if iframe_video != blank %}
            <div class="video-section" tabindex="-1">
              <div class="watch-btn">
                <p>
                  Watch how it works
                  <span class="play-button" data-src="{{ video-url | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}"
                    ><img
                      src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/rectangle_808.png?v=1695041847"
                      alt="Watch Video"
                  ></span>
                </p>
              </div>
              {% comment %}
                <div class="video-element video-element-popup">
                  {% if iframe_video != blank %}
                    <div class="plyr__video-embed video-{{ id }}" data-video-element>
                      {% if iframe_video.type == 'youtube' %}
                        <iframe
                          src="https://www.youtube.com/embed/{{ iframe_video.id  }}?autoplay=false&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                          allowfullscreen
                          allowtransparency
                          allow="autoplay"
                        ></iframe>
                      {% elsif iframe_video.type == 'vimeo' %}
                        <iframe
                          src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;autoplay=1&amp;byline=false&amp;portrait=false&amp;title=false&amp;speed=true&amp;transparent=0&amp;gesture=media"
                          allowfullscreen
                          allowtransparency
                          allow="autoplay"
                        ></iframe>
                      {% endif %}
                    </div>
                  {% endif %}

                  <span class="close-btn">x</span>
                </div>
              {% endcomment %}
            </div>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% for block0 in blocks %}
{%- assign my_range2 = block_text_width[forloop.index0] | plus: 0 -%}
{%- assign my_range1 = block_border_width[forloop.index0] | plus: 0 -%}
{%- assign my_range0 = block_background_opacity[forloop.index0] | plus: 0 -%}
{%- assign my_image_key1 = block_mobile_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
  {%- assign iframe_video = block_iframe_video_id[forloop.index0] -%}
  {% if iframe_video != blank %}
    <div class="video-section">
      <div class="video-element video-element-popup">
        {% if iframe_video != blank %}
          <div class="plyr__video-embed video-{{ id }}" data-video-element>
            {% if iframe_video.type == 'youtube' %}
              <iframe
                src="https://www.youtube.com/embed/{{ iframe_video.id  }}?iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                allowfullscreen
                allowtransparency
                allow="autoplay"
              ></iframe>
            {% elsif iframe_video.type == 'vimeo' %}
              <iframe
                src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;byline=false&amp;portrait=false&amp;title=false&amp;speed=true&amp;transparent=0&amp;gesture=media"
                allowfullscreen
                allowtransparency
                allow="autoplay"
              ></iframe>
            {% endif %}
          </div>
        {% endif %}

        <span class="close-btn">x</span>
      </div>
    </div>
  {% endif %}
{% endfor %}

{% comment %}JavaScript{% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data
>
  {
    "image_transition": {{ atb_image_transition | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "image_slideshow_speed": {{ atb_image_slideshow_speed | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "show_arrows": {{ atb_show_arrows | json }},
    "show_nav_buttons": {{ atb_show_nav_buttons | json }},
    "number_of_slides": {{ blocks.size | json }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsSlideshowClassic.js' | asset_url }}"></script>
<script
  type="application/json"
  data-section-id="{{ id }}"
  data-section-data
>
  {
    "autoplay": {{ autoplay | json }},
    "autoloop": {{ atb_autoloop | json }},
    "video_id": {{ iframe_video.id | json }},
    "video_type": {{ iframe_video.type | json }},
    "iframe_video": {{ iframe_video | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "html5_video": {{ html5_video | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "aspect_ratio": {{ atb_aspect_ratio | json }},
    "poster": {{ image | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "button": {{ button_label | json }},
    "id": {{ id | json }},
    "mute": {{ mute | json }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsVideo.js' | asset_url }}" async></script>
<script src="https://player.vimeo.com/api/player.js" defer></script>


</section>