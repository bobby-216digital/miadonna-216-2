{% comment %}
ATB-SCHEMA{
  "name": "Slideshow with Video",
  "class": "jsSlideshowClassic overlaid-header-option slideshow-section video-slideshow-section under-menu",
  "id": "index_slideshow-with-video",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
