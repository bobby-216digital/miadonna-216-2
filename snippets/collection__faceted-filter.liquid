                    <div class="faceted-filter-group-display__header" style="display: none;">
                      {%- if filter.active_values.size > 0 -%}
                        <a href="{{ filter.url_to_remove }}" class="faceted-filter-group-display__header-clear">
                          {%- render 'icon', name: 'x', icon_class: 'clear-filter' -%}
                          <span>{{ 'collections.sidebar.clear' | t }}</span></a
                        >
                      {%- endif -%}
                    </div>

                    {%- case filter.type -%}
                      {%- when 'list' -%}
                        {% if filter.label == 'Shape' %}
                          {%- assign desired_order = 'round,oval,emerald,princess,asscher,cushion,radiant,pear,heart,rose-brilliant,rose,oval-rose,baguette,marquise'
                            | split: ','
                          -%}
                          {%- assign sorted_values = '' -%}

                          {%- for order_value in desired_order -%}
                            {%- for filter_value in filter.values -%}
                              {%- assign shape_value = filter_value.label
                                | downcase
                                | replace: ' ', '-'
                                | remove: '-cut'
                              -%}
                              {%- if shape_value == order_value -%}
                                {%- assign sorted_values = sorted_values | append: filter_value.label | append: ',' -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endfor -%}

                          {%- assign sorted_values = sorted_values | slice: 0, sorted_values.size | rstrip: ',' -%}
                          {%- assign sorted_values_array = sorted_values | split: ',' -%}

                          <ul class="faceted-filter-group-display__list" style="margin: 1rem auto 0;overflow:auto;">
                            {%- for sorted_value in sorted_values_array -%}
                              {%- assign filter_value = filter.values | where: 'label', sorted_value | first -%}
                              {%- assign shape_value = filter_value.label
                                | downcase
                                | replace: ' ', '-'
                                | remove: '-cut'
                              -%}
                              <li class="faceted-filter-group-display__list-item" style="margin: 0;">
                                {% capture input_id %}Filter-{{ filter.label | escape }}-{{ forloop.index }}{% endcapture %}
                                <label
                                  class="faceted-filter-group-display__list-item-label"
                                  for="{{ input_id }}"
                                  style="padding: 0;"
                                >
                                  <input
                                    class="faceted-filter-group-display__list-item-input"
                                    type="checkbox"
                                    name="{{ filter_value.param_name | escape }}"
                                    value="{{ filter_value.value | escape }}"
                                    id="{{ input_id }}"
                                    {% if filter_value.active -%}
                                      checked
                                    {%- endif %}
                                    {% if filter_value.count == 0 and filter_value.active == false -%}
                                      disabled
                                    {%- endif %}
                                  >
                                  {% if shape_value == 'round' %}
                                    {% render 'icon-shape-round-cut' %}
                                  {% elsif shape_value == 'princess' %}
                                    {% render 'icon-shape-princess-cut' %}
                                  {% elsif shape_value == 'cushion' %}
                                    {% render 'icon-shape-cushion-cut' %}
                                  {% elsif shape_value == 'oval' %}
                                    {% render 'icon-shape-oval-cut' %}
                                  {% elsif shape_value == 'emerald' %}
                                    {% render 'icon-shape-emerald-cut' %}
                                  {% elsif shape_value == 'asscher' %}
                                    {% render 'icon-shape-asscher-cut' %}
                                  {% elsif shape_value == 'radiant' %}
                                    {% render 'icon-shape-radiant-cut' %}
                                  {% elsif shape_value == 'pear' %}
                                    {% render 'icon-shape-pear-cut' %}
                                  {% elsif shape_value == 'heart' %}
                                    {% render 'icon-shape-heart-cut' %}
                                  {% elsif shape_value == 'marquise' %}
                                    {% render 'icon-shape-marquise-cut' %}
                                  {% elsif shape_value == 'oval-rose' %}
                                    {% render 'icon-shape-oval-rose-cut' %}
                                  {% elsif shape_value == 'trillion' %}
                                    {% render 'icon-shape-round-cut' %}
                                  {% elsif shape_value == 'half-moon' %}
                                    {% render 'icon-shape-half-moon-cut' %}
                                  {% elsif shape_value == 'baguette' %}
                                    {% render 'icon-shape-baguette-cut' %}
                                  {% elsif shape_value == 'rose-brilliant' %}
                                    {% render 'icon-shape-rose-brilliant-cut' %}
                                  {% elsif shape_value == 'rose' %}
                                    {% render 'icon-shape-rose-cut' %}
                                  {% endif %}
                                  <span class="faceted-filter-group-display__list-item-label-text">
                                    {{- filter_value.label | remove: ' Cut' -}}
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {% elsif filter.label == 'Style' %}
                          <ul class="faceted-filter-group-display__list" style="margin: 1rem auto 0;">
                            {%- for filter_value in filter.values -%}
                              {% assign shape_value = filter_value.label | downcase %}
                              {% assign shape_value = shape_value | replace: ' ', '-' %}
                              <li class="faceted-filter-group-display__list-item" style="margin: 0;">
                                {% capture input_id %}Filter-{{ filter.label | escape }}-{{ forloop.index }}{% endcapture %}
                                <label
                                  class="faceted-filter-group-display__list-item-label"
                                  for="{{ input_id }}"
                                  style="padding: 0;"
                                >
                                  <input
                                    class="faceted-filter-group-display__list-item-input"
                                    type="checkbox"
                                    name="{{ filter_value.param_name | escape }}"
                                    value="{{ filter_value.value | escape }}"
                                    id="{{ input_id }}"
                                    {% if filter_value.active -%}
                                      checked
                                    {%- endif %}
                                    {% if filter_value.count == 0 and filter_value.active == false -%}
                                      disabled
                                    {%- endif %}
                                  >
                                  {% if shape_value == 'bands' %}
                                    {% render 'icons-bands' %}
                                  {% elsif shape_value == 'bracelets' %}
                                    {% render 'icons-bracelets' %}
                                  {% elsif shape_value == 'earrings' %}
                                    {% render 'icons-earrings' %}
                                  {% elsif shape_value == 'engagement-rings' %}
                                    {% render 'icons-engagement-rings' %}
                                  {% elsif shape_value == 'necklace' %}
                                    {% render 'icons-necklaces' %}
                                  {% endif %}
                                  <span class="faceted-filter-group-display__list-item-label-text">
                                    {{- filter_value.label | remove: ' Cut' -}}
                                  </span>
                                </label>
                              </li>
                            {% endfor %}
                          </ul>
                        {% else %}
                          <ul
                            class="faceted-filter-group-display__list {% if filter.label == 'Features' %}filter-value-buttons {% if filter.values.size > 8 %}filter-value-buttons-scroller{% endif %}{% endif %}"
                            style="margin: 1rem auto 0;"
                          >
                            {%- for filter_value in filter.values -%}
                              <li class="faceted-filter-group-display__list-item {% if filter.label == 'Metal' %}setting-accordion-content{% endif %}">
                                {% capture input_id %}Filter-{{ filter.label | escape }}-{{ forloop.index }}{% endcapture %}
                                {% if filter.label == 'Metal' %}
                                  {% assign firstLabelValue = filter_value.label | split: ' ' %}
                                  {% assign firstLabelValue = firstLabelValue | first %}
                                  {% assign labelValue = filter_value.label | remove: firstLabelValue | uniq %}
                                  <div class="setting-value">
                                    <div class="setting-value-inputs">
                                      <input
                                        class="input_value visually-hidden solid_metal_{{ filter_value.label | replace: ' ', '_' | downcase }}"
                                        type="radio"
                                        name="{{ filter_value.param_name | escape }}"
                                        value="{{ filter_value.value | escape }}"
                                        id="{{ input_id }}"
                                        {% if filter_value.active -%}
                                          checked
                                        {%- endif %}
                                        {% if filter_value.count == 0 and filter_value.active == false -%}
                                          disabled
                                        {%- endif %}
                                      >
                                      <label class="input_label" for="{{ input_id }}">
                                        {%- if firstLabelValue contains 'K' %}
                                          {{- firstLabelValue -}}
                                        {%- endif -%}
                                      </label>
                                    </div>
                                    <p>
                                      {%- if firstLabelValue contains 'K' %}
                                        {{- labelValue -}}
                                      {% else -%}
                                        {{- filter_value.label -}}
                                      {%- endif -%}
                                    </p>
                                  </div>
                                {% elsif filter.label == 'Features' %}
                                  <label
                                    class="faceted-filter-group-display__list-item-label"
                                    for="{{ input_id }}"
                                  >
                                    <input
                                      class="faceted-filter-group-display__list-item-input visually-hidden"
                                      type="checkbox"
                                      name="{{ filter_value.param_name | escape }}"
                                      value="{{ filter_value.value | escape }}"
                                      id="{{ input_id }}"
                                      {% if filter_value.active -%}
                                        checked
                                      {%- endif %}
                                      {% if filter_value.count == 0 and filter_value.active == false -%}
                                        disabled
                                      {%- endif %}
                                    >
                                    <span class="button faceted-filter-group-display__list-item-label-text">
                                      {{- filter_value.label -}}
                                    </span>
                                  </label>
                                {% else %}
                                  <label
                                    class="faceted-filter-group-display__list-item-label"
                                    for="{{ input_id }}"
                                  >
                                    <input
                                      class="faceted-filter-group-display__list-item-input"
                                      type="checkbox"
                                      name="{{ filter_value.param_name | escape }}"
                                      value="{{ filter_value.value | escape }}"
                                      id="{{ input_id }}"
                                      {% if filter_value.active -%}
                                        checked
                                      {%- endif %}
                                      {% if filter_value.count == 0 and filter_value.active == false -%}
                                        disabled
                                      {%- endif %}
                                    >
                                    <svg
                                      class="faceted-filter-group-display__checkmark"
                                      aria-hidden="true"
                                      focusable="false"
                                      role="presentation"
                                      width="14"
                                      height="14"
                                      xmlns="http://www.w3.org/2000/svg"
                                      viewBox="0 0 14 14"
                                    >
                                      <path class="faceted-filter-group-display__checkmark-check" fill="none" d="M2.5 7L5.5 10L11.5 4"></path>
                                    </svg>
                                    <span class="faceted-filter-group-display__list-item-label-text">
                                      {{- filter_value.label -}}
                                    </span>
                                  </label>
                                {% endif %}
                              </li>
                            {%- endfor -%}
                          </ul>
                        {% endif %}

                        <div class="faceted-filter-group-display__submit faceted-filter-group-display__list-submit">
                          {%- assign label = 'collections.sidebar.apply_filter' | t | escape -%}
                          {% render 'button', label: label, type: 'submit', style: 'button--primary' %}
                        </div>
                      {%- when 'price_range' -%}
                        <div
                          class="faceted-filter-group-display__price-range"
                          style="max-width: 50%;margin: 1.5rem auto 0rem;grid-template-columns: repeat(1,1fr);"
                        >
                          <tc-range-slider
                            id="faceted_price_slider"
                            aria-label1="Minimum price"
                            aria-label2="Maximum price"
                            min="{{ lowestProductValue | replace: ',', '' }}"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            {% if filter.min_value.value -%}
                              value1="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                            {% else %}
                              value1="{{ lowestProductValue | replace: ',', '' }}"
                            {%- endif %}
                            {% if filter.max_value.value -%}
                              value2="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                            {% else %}
                              value2="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            {%- endif %}
                            moving-tooltip="true"
                            moving-tooltip-distance-to-pointer="-20"
                            moving-tooltip-bg="transparent"
                            moving-tooltip-text-color="#3c3737"
                            moving-tooltip-width="70"
                            moving-tooltip-height="20"
                            mousewheel-disabled="true"
                            pointer-bg="#fca999"
                            pointer-bg-hover="#fca999"
                            pointer-bg-focus="#fca999"
                            pointer-border="1px solid #fca999"
                            pointer-border-hover="1px solid #fca999"
                            pointer-border-focus="1px solid #fca999"
                            slider-bg="#ebebeb"
                            slider-bg-fill="#fca999"
                            moving-tooltip-units="$"
                            moving-tooltip-units-type="prefix"
                            slider-width="100%"
                            slider-height="5px"
                            generate-labels="false"
                            step="1"
                            css-links="{{ 'tc-range-box-shadow.css' | asset_url }};"
                          >
                          </tc-range-slider>
                          <div class="faceted-filter-group-display__price-range-from" style="display: none;">
                            <label
                              class="faceted-filter-group-display__price-range-label"
                              for="Filter-{{ filter.label }}-{{ forloop.index }}"
                            >
                              {{ 'collections.sidebar.from' | t | escape }}
                            </label>
                            <span>{{ cart.currency.symbol }}</span>
                            <input
                              class="faceted-filter-group-display__price-range-input"
                              name="{{ filter.min_value.param_name }}"
                              id="Filter-{{ filter.label }}-{{ forloop.index }}"
                              {% if filter.min_value.value -%}
                                value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              {%- endif %}
                              type="number"
                              placeholder="{{ lowestProductValue | replace: ',', '' }}"
                              min="{{ lowestProductValue | replace: ',', '' }}"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            >
                          </div>
                          <div class="faceted-filter-group-display__price-range-to" style="display: none;">
                            <label
                              class="faceted-filter-group-display__price-range-label"
                              for="Filter-{{ filter.label }}-{{ forloop.index }}"
                            >
                              {{ 'collections.sidebar.to' | t | escape }}
                            </label>
                            <span>{{ cart.currency.symbol }}</span>
                            <input
                              class="faceted-filter-group-display__price-range-input"
                              name="{{ filter.max_value.param_name }}"
                              id="Filter-{{ filter.label }}-{{ forloop.index }}"
                              {% if filter.max_value.value -%}
                                value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              {%- endif %}
                              type="number"
                              placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              min="{{ lowestProductValue | replace: ',', '' }}"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            >
                          </div>
                        </div>

                        <div class="faceted-filter-group-display__submit" style="margin-top: 2rem;">
                          {%- assign label = 'collections.sidebar.apply_filter' | t | escape -%}
                          {% render 'button', label: label, type: 'submit', style: 'button--primary' %}
                        </div>
                    {%- endcase -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </collection-setting-tabs>

        {% if has_active_filters %}
          <div>
            <div class="faceted-active-filters">
              {%- assign label = 'collections.sidebar.clear_all' | t | append: ' filters' -%}
              {% render 'button',
                label: label,
                type: 'link',
                class: 'faceted-active-filters__clear',
                href: collection.url
              %}
            </div>
          </div>
        {% endif %}
      </form>
    </div>
    {% endcomment %}
  </div>
</div>
{% endif %}  