{% comment %}
ATB-SCHEMA{
  "name": "Home Ring Slider ",
  "class": "jsRingSlider",
  "id": "home-ring-slider",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_sec_background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "collection_block",
          "label": "collection_block"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "image_picker",
      "label": "Image",
      "id": "block_image",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "text",
      "label": "Image Alt Text",
      "id": "block_image_alt",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "text",
      "label": "Title",
      "id": "block_title",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "wysiwyg",
      "label": "Content",
      "id": "block_content",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "text",
      "label": "Button Text",
      "id": "block_button_text",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "text",
      "label": "Button Link",
      "id": "block_url",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "text",
      "label": "Button Text 2",
      "id": "block_button_text_2",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "text",
      "label": "Button Link 2",
      "id": "block_url_2",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "color",
      "id": "block_background_color",
      "label": "Button Background color",
      "default": "rgba(119,119,119,1)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    },
    {
      "type": "color",
      "id": "block_text_color",
      "label": "Button Text color",
      "default": "rgba(255,255,255,1)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:collection_block"
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_sec_background_color' -%}
{%- assign atb_sec_background_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'block_type' -%}
{%- assign block_type = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_image_alt' -%}
{%- assign block_image_alt = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_content' -%}
{%- assign block_content = val -%}
{%- include 'atb-render' field:'block_button_text' -%}
{%- assign block_button_text = val -%}
{%- include 'atb-render' field:'block_url' -%}
{%- assign block_url = val -%}
{%- include 'atb-render' field:'block_button_text_2' -%}
{%- assign block_button_text_2 = val -%}
{%- include 'atb-render' field:'block_url_2' -%}
