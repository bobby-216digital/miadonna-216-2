  {% else %}
    "image": {{ product_image | img_url: '1024x1024' | prepend: 'https:' | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped
    }},
  {% endif %}

  {% if product.description != blank %}
    "description": {{ product.description | strip_html | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped
    }},
  {% endif %}

  {% if selected_variant.option1 != blank %}
    "material": {{ selected_variant.option1 | json }},
  {% endif %}

    "brand": {
      "@type": "Brand",
      "name": "MiaDonna"
    },

  {% if selected_variant.sku != blank %}
    "sku": {{ selected_variant.sku | json }},
  {% endif %}

  {% if selected_variant.barcode != blank %}
    "mpn": {{ selected_variant.barcode | json }},
  {% endif %}

  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ selected_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if selected_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    "url": {{ canonical_url | json }},

    "shippingDetails": {
      "@type": "OfferShippingDetails",
