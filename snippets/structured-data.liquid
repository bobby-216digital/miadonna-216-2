        try {

          const json = JSON.parse(script.textContent);

          if (
            json &&
            json['@type'] === 'Product'
          ) {
            productSchemaScript = script;
            productSchema = json;
          }

        } catch (error) {
          // Ignore other JSON-LD blocks
        }

      });

      /*
       * Existing Product schema not found.
       */
      if (!productSchemaScript || !productSchema) {
        console.log('Product schema not found.');
        return;
      }

      /*
       * Sort reviews by latest date
       * and take only the latest 5 reviews.
       */
      const latestFiveReviews = reviews
        .slice()
        .sort(function (a, b) {

          const dateA =
            a.dateCreated ||
            a.createdAt ||
            a.datePublished ||
            '';

          const dateB =
            b.dateCreated ||
            b.createdAt ||
            b.datePublished ||
            '';

          return new Date(dateB) - new Date(dateA);

        })
        .slice(0, 5);

      /*
       * Convert latest 5 Okendo reviews
       * to Schema.org Review.
       */
      const schemaReviews = latestFiveReviews
        .map(function (review) {

          const reviewBody =
            review.body ||
            review.reviewBody ||
            review.content ||
            review.comment ||
            '';

          const rating =
            review.rating ||
            review.reviewRating?.ratingValue;

          const authorName =
            review.reviewer?.displayName ||
            review.reviewer?.name ||
            review.reviewerDisplayName ||
            review.author?.name ||
            review.author ||
            '';

          const reviewTitle =
            review.title ||
            review.reviewTitle ||
            review.name ||
            '';

          const datePublished =
            review.dateCreated ||
            review.createdAt ||
            review.datePublished ||
            '';

          /*
           * Do not add incomplete reviews.
           */
          if (
            !reviewBody ||
            !rating ||
            !authorName
          ) {
            return null;
          }

          const schemaReview = {
            '@type': 'Review',

            'reviewBody': String(reviewBody)
              .replace(/<[^>]*>/g, '')
              .replace(/\s+/g, ' ')
              .trim(),

            'reviewRating': {
              '@type': 'Rating',
              'ratingValue': String(rating),
              'bestRating': '5',
              'worstRating': '1'
            },

            'author': {
              '@type': 'Person',
              'name': String(authorName)
                .replace(/<[^>]*>/g, '')
                .trim()
            }
          };

          if (reviewTitle) {
            schemaReview.name = String(reviewTitle)
              .replace(/<[^>]*>/g, '')
              .trim();
          }

          if (datePublished) {
            schemaReview.datePublished = datePublished;
          }

          return schemaReview;

        })
        .filter(Boolean);

      /*
       * If no valid reviews exist,
       * don't modify Product schema.
       */
      if (!schemaReviews.length) {
        console.log('No valid Okendo reviews for schema.');
        return;
      }

      /*
       * Keep existing aggregateRating.
       * Only add latest 5 reviews.
       */
      productSchema.review = schemaReviews;

      /*
       * Update existing JSON-LD.
       */
      productSchemaScript.textContent =
        JSON.stringify(productSchema);

      console.log(
        'Updated Product Schema with latest 5 reviews:',
        productSchema
      );

    })
    .catch(function (error) {

      console.error(
        'Okendo review schema error:',
        error
      );

    });

});
</script> {% endcomment %}
{% endif %}

