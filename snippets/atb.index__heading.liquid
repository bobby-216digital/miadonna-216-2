{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_padding_left = atb_padding_left | plus: 0 -%}
{%- assign atb_padding_right = atb_padding_right | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section heading-section">
{% comment %}
** Heading **
{% endcomment %}

{%- assign preheading = atb_preheading -%}
{%- assign title = atb_title -%}
{%- assign subheading = atb_subheading -%}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign heading_alpha = atb_heading_color | color_extract: 'alpha' -%}
{%- assign preheading_alpha = atb_preheading_color | color_extract: 'alpha' -%}
{%- assign subheading_alpha = atb_subheading_color | color_extract: 'alpha' -%}
{%- assign background_alpha = atb_background | color_extract: 'alpha' -%}
{%- assign gradient_alpha = atb_gradient | color_extract: 'alpha' -%}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}

  .section {
    background-image: linear-gradient({{ atb_gradient_rotation }}deg, rgba(255,255,255,0), {{ atb_gradient }});
    background-color: {%- if background_alpha != 0 -%}{{ atb_background }}{%- endif -%};
  }

  .heading-section__heading {
    color: {%- if heading_alpha != 0 -%}{{ atb_heading_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
  }

  .heading-section__preheading {
    color: {%- if preheading_alpha != 0 -%}{{ atb_preheading_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
  }

  .heading-section__subheading {
    color: {%- if subheading_alpha != 0 -%}{{ atb_subheading_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
  }

{%- endcapture -%}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- elsif atb_width == 'half' -%}
      width: 50%;
    {%- endif %}
  }

  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
{% if title != blank or subheading != blank or preheading != blank %}
  <section class="section
                  {{ atb_css_class }}
                  is-width-{{ atb_width }}
                  {% if background_alpha != 0 or gradient_alpha != 0  %}
                    has-background
                  {% endif %}
                  "
            data-section-id="{{ section_id }}"
            {% if atb_animation != "none" %}
              data-scroll-class="{{ atb_animation }}"
            {% endif %}>
    <div class="container
                ">
      <div class="one-whole column">
        <div class="heading-section__content
                    is-flex
                    is-flex-column
                    is-align-{{ atb_heading_alignment }}
                    text-align-{{ atb_heading_alignment }}
                    vertical-spacing-{{ atb_vertical_spacing }}">
          {% if preheading != blank %}
            <div class="heading-section__preheading subtitle">
              {{ preheading }}
            </div>
          {% endif %}

          {% if title != blank %}
            <h2 class="heading-section__heading title">{{ title }}</h2>
          {% endif %}

          {% if subheading != blank %}
            <div class="heading-section__subheading subtitle">
              {{ subheading }}
            </div>
          {% endif %}

          {% if settings.display_heading_divider == true %}
            <div class="heading-divider
                      heading-divider--{{ settings.heading_divider_style }}"
                  {% if settings.heading_divider_animation != "none" %}
                    data-scroll-class="{{ settings.heading_divider_animation }}"
                  {% endif %}>
            </div>
          {% endif %}
      </div>
    </div>
  </section>
{% endif %}



</section>