{% comment %}
Required values
menu_link: linklist
______________
Optional values
linklist_class: <string>
link_setting: <string>
{% endcomment %}

<div class="footer__menu is-justify-space-between {{ linklist_class }}">
{% if menu_link != blank %}
  {% assign menu = linklists[menu_link] %}
  <div class="footerlink__heading" tabindex="0">
    {% if link_setting != blank %}<a href="{{ link_setting }}">{% endif %}
      {{ menu.title }}
    {% if link_setting != blank %}</a>{% endif %}
  </div>
  <ul>
    {% for link in menu.links %}
      <li class="footer__menu-link">
        <a {% if link.url contains '#live-chat' %}href="javascript:void(0);" onclick="Chatra('openChat',true)"{% else %}href="{{ link.url }}"{% endif %} class="{% if link.active %}is-active{% endif %}" {% if link.url contains 'accessibility' %} data-acsb-custom-trigger="true" {% endif %}>
          {{ link.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <div class="footerlink__heading">{{ 'homepage.onboarding.menu_title' | t }}</div>
  <p>{{ 'homepage.onboarding.no_content' | t }}</p>
{% endif %}
</div>
