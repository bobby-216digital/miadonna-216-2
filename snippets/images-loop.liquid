{% case media.media_type %}
  {% when 'image' %}
    <div
      class="product-gallery__image{% if i > 1 %} is-hidden{% endif %}"
      data-product-id="{{ product.id }}"
      data-title="{% if image_alt contains 'youtube' or image_alt contains 'vimeo' %}{{ product.title }}{% else %}{{ image_alt | escape  }}{% endif %}"
      data-media-type="{% if media.alt contains 'youtube' or media.alt contains 'vimeo' %}external_video{% else %}{{ media.media_type }}{% endif %}"
    >
      {% capture image_id %}{{ media.id }}{% endcapture %}
      {% capture image_alt %}{{ media.alt | escape }}{% endcapture %}

      {% capture image_100x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '100x' }}{% endcapture %}
      {% capture image_200x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '200x' }}{% endcapture %}
      {% capture image_400x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '400x' }}{% endcapture %}
      {% capture image_600x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '600x' }}{% endcapture %}
      {% capture image_800x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '800x' }}{% endcapture %}
      {% capture image_1200x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '1200x' }}{% endcapture %}
      {% capture image_2000x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '2000x' }}{% endcapture %}
      {% capture image_5000x %}{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '5000x' }}{% endcapture %}

      {% if image_alt contains 'youtube' or image_alt contains 'vimeo' %}
        {% assign alt_text = image_alt | split: ' ' %}
        {% for property in alt_text %}
          {% if property contains 'src' %}
            {% assign cleanURL = property | remove: 'src=' | remove: '&quot;' | remove: '"' %}
            <div class="product-gallery__video" data-youtube-video>
              <iframe
                src="{{ cleanURL  }}"
                frameborder="0"
              ></iframe>
            </div>
          {% endif %}
        {% endfor %}

      {% else %}
        <h6 class="product-alt text-center">{{ image_alt | split: '|' | first | escape | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</h6>
        {% if enable_product_lightbox and product.media.size > 0 %}
          <a
            href="{{ media | img_url: '2048x' }}"
            class="product-gallery__link"
            data-fancybox="product-gallery"
            title="{{ image_alt | split: '|' | first | escape }}"
          >
        {% endif %}

        <div class="image__container" style="max-width: {{ media.width }}px">
          {{
            media
            | image_url: width: 1200
            | image_tag: alt: media.alt | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
          }}
        </div>

        {% if enable_product_lightbox and product.media.size > 0 %}
          </a>
        {% endif %}
      {% endif %}
    </div>
{% endcase %}
