.pure-table {
    border-collapse: collapse;
    border-spacing: 0;
    empty-cells: show;
    border: 1px solid #cbcbcb
}

.pure-table caption {
    color: #000;
    font: italic 85%/1 arial,sans-serif;
    padding: 1em 0;
    text-align: center
}

.pure-table td,.pure-table th {
    border-left: 1px solid #cbcbcb;
    border-width: 0 0 0 1px;
    font-size: inherit;
    margin: 0;
    overflow: visible;
    padding: .5em 1em
}

.pure-table td:first-child,.pure-table th:first-child {
    border-left-width: 0
}

.pure-table thead {
    background-color: #e0e0e0;
    color: #000;
    text-align: left;
    vertical-align: bottom
}

.pure-table td {
    background-color: transparent
}

.pure-table-odd td {
    background-color: #f2f2f2
}

.pure-table-striped tr:nth-child(2n-1) td {
    background-color: #f2f2f2
}

.pure-table-bordered td {
    border-bottom: 1px solid #cbcbcb
}

.pure-table-bordered tbody>tr:last-child>td {
    border-bottom-width: 0
}

.pure-table-horizontal td,.pure-table-horizontal th {
    border-width: 0 0 1px;
    border-bottom: 1px solid #cbcbcb
}

.pure-table-horizontal tbody>tr:last-child>td {
    border-bottom-width: 0
}
/* How We Give */
.custom-green-heading {
  margin-bottom: 0px !important;
  line-height: 1.2;
}

.green-btn {
  cursor: pointer;
}

.how-we-give-container > section {
  margin: 7rem 0 !important;
}
.the-result {
  background-color: #C2EDD5; }

.result-block {
  padding: 1em; }
  .result-block h2 {
    margin: 1rem 0; height:166px;overflow:hidden}
@media screen and (max-width:768px){
  .result-block h2 { height:auto;}
}

  #shopify-section-{{ section_id }} {
      {%- if atb_background -%}
          background-color: {{atb_background}};
      {%- endif -%}
       color:{{ atb_text_color | default: '#000' }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  .result-block h2{
    font-family: Playfair Display,serif;
    position: relative;
  }
  
  .result-block p{
    font-family: Playfair Display,serif;
    margin-top: 30px;
  }
  .result-block h2:after{
    position: absolute;
    content: '';
    bottom: 0;
    left: 0;
    height: 3px;
    width: 80px;
    background-color: #fff;
  }
  @media screen and (max-width: 767px){
     #shopify-section-{{ section_id }} {
      padding-top: 30px;
      padding-bottom: 30px;
    }
  }
{% endstyle %}
<section id="{{ atb_id_sec }}"
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
