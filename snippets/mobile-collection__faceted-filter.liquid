                                                    {{
                                                      metaobject.image
                                                      | image_url: width: 100
                                                      | image_tag: class: 'facets__image', alt: filter_value.label 
                                                    }}
                                                    {% break %}
                                                  {%- endif -%}
                                                {%- endif -%}
                                              {% endfor %}
                                            {% endpaginate %}
                                            {%- endcomment -%}
                                          </span> 
                                        {% elsif filter.label == 'Features' %}
                                          {% if collection.handle contains 'necklaces' %}
                                            {%- render 'features-filter-images', filter_colection: 'Necklace', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'lab-grown-diamond-tennis-bracelets' and filter_value.label == 'Statement' %}
                                            {%- render 'features-filter-images', filter_colection: 'Tennis Bracelets', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'tennis' %}
                                            {%- render 'features-filter-images', filter_colection: 'Tennis Jewelry', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'earrings' %}
                                            {%- render 'features-filter-images', filter_colection: 'Earrings', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'bracelet' %}
                                            {%- render 'features-filter-images', filter_colection: 'Bracelet', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'fashion-rings' %}
                                            {%- render 'features-filter-images', filter_colection: 'All Fashion Rings', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'eternity' %}
                                            {%- render 'features-filter-images', filter_colection: 'Eternity', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'shop-all-wedding' %}
                                            {%- render 'features-filter-images', filter_colection: 'All Bands', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'wedding-bands' %}
                                            {%- render 'features-filter-images', filter_colection: 'Band', filter_value: filter_value -%}
                                          {% elsif collection.handle contains 'lab-grown-diamond-rings' %}
                                            {%- render 'features-filter-images', filter_colection: 'All Fashion Rings', filter_value: filter_value -%}
                                          {%- else -%}
                                            {% paginate shop.metaobjects.collection_features_filter.values by 1000 %}
                                              {% for metaobject in shop.metaobjects.collection_features_filter.values %}
                                                {%- if metaobject.display_name == filter_value.label -%}
                                                  {%- if metaobject.image -%}
                                                    {{
                                                      metaobject.image
                                                      | image_url: width: 300
                                                      | image_tag: class: 'facets__image', alt: filter_value.label 
                                                    }}
                                                    {% break %}
                                                  {%- endif -%}
                                                {%- endif -%}
                                              {% endfor %}
                                            {% endpaginate %}
                                          {%- endif -%}
                                          {% comment %}
                                            {% assign downcase_value = filter_value.value | replace: ' ', '-' | downcase %}
                                            <img src="https://sfycdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/{{ downcase_value }}.jpg?v=1731672446&width=200" width="167.69px" height="167.69px" />
                                          {% endcomment %}
                                        {% endif %}
                                      </label>
                                      <span class="faceted-filter-group-display__list-item-label-text">
                                        {{- filter_value.label | remove: ' Cut' -}}
                                      </span>
                                      {% comment %}
