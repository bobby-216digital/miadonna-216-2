                                    {{ 'collections.sidebar.from' | t | escape }}
                                  </label>
                                  <span>{{ cart.currency.symbol }}</span>
                                  <input
                                    class="faceted-filter-group-display__price-range-input"
                                    name="{{ filter.min_value.param_name }}"
                                    id="Filter-{{ filter.label }}-{{ forloop.index }}"
                                    {% if filter.min_value.value -%}
                                      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                    {%- endif %}
                                    type="number"
                                    placeholder="{{ lowestProductValue | replace: ',', '' }}"
                                    min="{{ lowestProductValue | replace: ',', '' }}"
                                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                  >
                                </div>
                                <div class="faceted-filter-group-display__price-range-to" style="display: none;">
