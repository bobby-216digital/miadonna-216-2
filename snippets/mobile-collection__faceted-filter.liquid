                                  <input
                                    class="faceted-filter-group-display__price-range-input"
                                    name="{{ filter.max_value.param_name }}"
                                    id="Filter-{{ filter.label }}-{{ forloop.index }}"
                                    {% if filter.max_value.value -%}
                                      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                    {%- endif %}
                                    type="number"
                                    placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                    min="{{ lowestProductValue | replace: ',', '' }}"
                                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                  >
                                </div>
                              </div>
      
                              <div class="faceted-filter-group-display__submit" style="margin: 20px auto 0;width:60%;">
                                {%- assign label = 'collections.sidebar.apply_filter' | t | escape -%}
