
{%- capture productHandleContentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
{%- assign productHandlePageUrl = productHandleContentForQuerystring
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{%- assign productHandlePageQueryStringReplace = productHandlePageUrl
  | replace: request.path, ''
  | replace: request.host, ''
-%} 
    {% comment %} {%- capture productHandleContentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}

{%- assign productHandlePageUrl = productHandleContentForQuerystring
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{%- assign productHandlePageQueryStringReplace = productHandlePageUrl
  | split: request.path
  | last
-%} {% endcomment %}
{%- assign productHandlePageQueryString = productHandlePageQueryStringReplace | split: '?' | last -%}
{%- assign productHandlePageQueryArray = productHandlePageQueryString | split: '&' -%}

{% assign has_active_filters = false %}
{% assign has_valid_handle_stone = false %}
{% assign has_valid_handle = false %}
{% assign handlename = '' %}
{% assign handleKey = '' %}

{% assign ringhandleKey = '' %}
{% assign ringhandlename = '' %}


{% assign progresssetupKey = '' %}
{% assign progresssetupname = '' %}


{% assign dyoKey = '' %}
{% assign dyoName = '' %}

{% assign shapeKey = '' %}
{% assign shapeName = '' %}

{% assign viewdiamondKey = '' %}
{% assign viewdiamondName = '' %}
{% for param in productHandlePageQueryArray %}
  {% assign parts = param | split: '=' %}
  {% assign key = parts[0] %}
  {% assign value = parts[1] %}
  {% if key == 'stone-handle' %}
    {% assign handleKey = 'stone-handle' %}
        {% assign has_valid_handle = true %}
                {% assign has_valid_handle_stone = true %}

        {% assign handlename = value %}
 {% endif %}
{% if key == 'handle' %}
        {% assign has_valid_handle = true %}
        {% assign handleKey = 'handle' %}
                {% assign has_valid_handle_stone = true %}

        {% assign handlename = value %}

{% endif %}
{% if key == 'viewdiamond' %}
        {% assign has_valid_handle = true %}
        {% assign viewdiamondKey = 'viewdiamond' %}
        {% assign viewdiamondName = value %}

{% endif %}
{% if key == 'ring-handle' %}
        {% assign has_valid_handle = true %}
        {% assign ringhandleKey = 'ring-handle' %}
         {% assign has_valid_handle_stone = true %}
        {% assign ringhandlename = value %}

{% endif %}
{% if key == 'dyo' %}
        {% assign has_valid_handle = true %}
        {% assign dyoKey = 'dyo' %}
        {% assign dyoName = value %}

{% endif %}
{% if key == 'shape' %}
        {% assign has_valid_handle = true %}
        {% assign shapeKey = 'shape' %}
        {% assign shapeName = value %}

{% endif %}
{% if key == 'progresssetup' %}
        {% assign has_valid_handle = true %}
        {% assign progresssetupKey = 'progresssetup' %}
                {% assign has_valid_handle_stone = true %}
        {% assign progresssetupname = value %}

{% endif %}
{% endfor %}
{% assign urlParam = '' %}
{% if has_valid_handle  %}
  {% assign urlParam = '?'|append: productHandlePageQueryString %}
 {% endif %} 



{%- comment -%}Shows "Clear all" and Active filters that have been selected. Do not collapse this element - should always be visible{%- endcomment -%}

{%- for filter in collection.filters -%}
  {% if filter.type == 'price_range' %}
    {%- if filter.min_value.value != null or filter.max_value.value != null -%}
      {% assign has_active_filters = true %}
    {%- endif -%}
  {%- else -%}
    {%- for filter_value in filter.active_values -%}
      {% assign has_active_filters = true %}
    {%- endfor -%}
  {% endif %}
{%- endfor -%}

{% assign lowestProductValue = 0 %}
{% assign products_by_price = collection.products | sort: 'price' %}
{% for product in products_by_price %}
  {% if forloop.first %}
    {% assign lowestProductValue = product.price | money_without_currency %}
  {% endif %}
{% endfor %}

