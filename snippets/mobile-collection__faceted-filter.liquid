                                  name="{{ handleKey}}"
                                  id="Filter-handle-0"
                                    value="{{ handlename}}"
                                
                                  type="hidden"
                                >
                              {% if ringhandlename != blank %}
                              <input class="faceted-filter-group-display__ring-handle"
                                  name="{{ ringhandleKey}}"
                                  id="Filter-handle-0"
                                    value="{{ ringhandlename}}"
                                
                                  type="hidden"
                                >
                        {% endif %} 
                        {% if dyoName != blank %}
                              <input class="faceted-filter-group-display__dyo"
                                  name="{{ dyoKey}}"
                                  id="Filter-handle-0"
                                    value="{{ dyoName}}"
                                
                                  type="hidden"
                                >
                        {% endif %} 

                        {% if viewdiamondName != blank %}
                              <input class="faceted-filter-group-display__dyo"
                                  name="{{ viewdiamondKey}}"
                                  id="Filter-handle-0"
                                    value="{{ viewdiamondName}}"
                                
                                  type="hidden"
                                >
                        {% endif %} 
                        
                        {% endif %} 

                          {% if viewdiamondName != blank %}
                              <input class="faceted-filter-group-display__dyo"
                                  name="{{ shapeKey}}"
                                  id="Filter-handle-0"
                                    value="{{ shapeName}}"
                                
                                  type="hidden"
                                >
                        {% endif %} 
                        </div>
                      </div>
                    </div>
                  </li>

      
        
                {% endunless %}
              {% endif %}
          {% endfor %}
        </ul>
        <div class="filters-toggle-container">
           {% unless has_valid_handle %} 
          <div class="filter-buttons">
            {% if has_active_filters %}
              <div class="faceted-active-filters">
                {%- assign label = 'collections.sidebar.clear_all' | t -%}
                {% render 'button',
                  label: label,
                  type: 'link',
                  style: 'button--secondary',
                  class: 'faceted-active-filters__clear',
                  href: collection.url
                %}
              </div>
            {% endif %}
            {% assign applies_filters = 0 %}
            {% for filter in collection.filters %}
              {% assign applies_filters = applies_filters | plus: filter.active_values.size %}
            {% endfor %}
            <button form="form-{{ section.id }}" type="submit" class="button button--primary results-button">
              {{ 'collections.sidebar.apply_filter' | t -}}
              {%- if applies_filters > 0 %} ({{ applies_filters }}){% endif %}
            </button>
          </div>
           {% endunless %} 
        </div>
      </form>
      {%- if collection.tags contains 'Ready To Ship' -%}
        <ul class="filter__list">
          <li id="ready-to-ship-content" class="filter__list-item-rts filter__list-ready-to-ship">
            <div class="filter__list-label-rts">
              <div class="filter__list-title">
                <h3>Ready-To-Ship</h3>
              </div>
              <div class="filter__list-icon">
                <input type="checkbox" class="visually-hidden" id="ready-to-shop"{% if current_tags contains 'Ready To Ship' %} checked{% endif %}>
                <label class="switch" for="ready-to-shop"><span class="visually-hidden">Ready-To-Ship</span></label>
              </div>
            </div>
          </li>
        </ul>
        <script>
          document.getElementById('ready-to-shop').onclick = function() {
            if (this.checked == true) {
              window.location.href = '{{ collection.url }}/Ready-to-ship';
            } else {
              window.location.href = '{{ collection.url }}';
            }
          }
        </script>
      {%- endif -%}
    </section>
  </div>
</div>
<div class="filter__sidebar-overlay" style="top: 0px;"></div>
