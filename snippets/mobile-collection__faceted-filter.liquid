                                          {% assign firstLabelValue = filter_value.label | split: ' ' %}
                                          {% assign firstLabelValue = firstLabelValue | first %}
                                          {% assign labelValue = filter_value.label | remove: firstLabelValue | uniq %}
                                          <div class="setting-value">
                                            <div class="setting-value-inputs">
                                              <input
                                                class="input_value visually-hidden solid_metal_{{ filter_value.label | replace: ' ', '_' | downcase }}"
                                                type="radio"
                                                name="{{ filter_value.param_name | escape }}"
                                                value="{{ filter_value.value | escape }}"
                                                id="{{ input_id }}"
                                                {% if filter_value.active -%}
                                                  checked
                                                {%- endif %}
                                                {% if filter_value.count == 0 and filter_value.active == false -%}
                                                  disabled
                                                {%- endif %}
                                              >
                                              <label class="input_label" for="{{ input_id }}">
                                                {%- if firstLabelValue contains 'K' %}
                                                  {{- firstLabelValue -}}
                                                {%- endif -%}
                                              </label>
                                            </div>
                                            <p>
                                              {%- if firstLabelValue contains 'K' %}
                                                {{- labelValue -}}
                                              {% else -%}
                                                {{- filter_value.label -}}
                                              {%- endif -%}
                                            </p>
                                          </div>
                                        {% elsif filter.label == 'Features' %}
                                          <label
                                            class="faceted-filter-group-display__list-item-label"
                                            for="{{ input_id }}"
                                          >
                                            <input
                                              class="faceted-filter-group-display__list-item-input visually-hidden"
                                              type="checkbox"
                                              name="{{ filter_value.param_name | escape }}"
                                              value="{{ filter_value.value | escape }}"
                                              id="{{ input_id }}"
                                              {% if filter_value.active -%}
                                                checked
                                              {%- endif %}
                                              {% if filter_value.count == 0 and filter_value.active == false -%}
                                                disabled
                                              {%- endif %}
                                            >
                                            <span class="button faceted-filter-group-display__list-item-label-text">
                                              {{- filter_value.label -}}
                                            </span>
                                          </label>
                                        {% else %}
