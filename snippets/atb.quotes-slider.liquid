{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_hide_mobile' -%}
{%- assign atb_hide_mobile = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_text_color' -%}
{%- assign atb_text_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_image_alt' -%}
{%- assign block_image_alt = val -%}
{%- include 'atb-render' field:'block_image_alignment' -%}
{%- assign block_image_alignment = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_subtitle' -%}
{%- assign block_subtitle = val -%}
{%- include 'atb-render' field:'block_text_alignment' -%}
{%- assign block_text_alignment = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- if atb_hide_mobile == blank -%}
{%- assign atb_hide_mobile = false -%}
{%- else -%}
{%- assign atb_hide_mobile = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section quotes-slider jsQuotesSlider">
{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    margin-bottom:40px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .slide-text{
    padding: 40px;
  }
 #shopify-section-{{ section_id }} p{
    
    font-family: 'Playfair Display';
    font-style: italic;
  }
  #shopify-section-{{ section_id }} .slide-text h3 {
    font-size: 17px;
    margin-bottom: 25px;
    padding-top: 50px;
    position: relative;
    font-weight: 600;
    line-height: 1.333;
    quotes: "\201c" "\201d" "\201c" "\201d";
  }
  #shopify-section-{{ section_id }} .slide-text h3:before {
    content: open-quote;
    display: block;
    font-size: 70px;
    font-style: italic;
    left: -6px;
    line-height: 1;
    position: absolute;
    top: 0;
  }
  #shopify-section-{{ section_id }} .slide-text span {
    color: #e6c799 !important;
    font-family: Montserrat,sans-serif;
    font-size: 12px;
    font-weight: 500;
  }
  #shopify-section-{{ section_id }} .slide-image {
    position: relative;
  }
  #shopify-section-{{ section_id }} .image-element__wrap img {
    height: auto;
    margin: 30px auto;
    max-width: 100px;
  }
  #shopify-section-{{ section_id }} .flickity-page-dots {
    bottom: -20px;
  }
  #shopify-section-{{ section_id }} .quotes-slider .dot{
    background:#7777;
    height: 4px;
    width: 60px;
    border-radius: 0;
  }
  #shopify-section-{{ section_id }} .dot.is-selected {
    
    background: #fff;
  }
  .quotes-slider .column {
    display: flex;
    flex-wrap: wrap;
  }
  @media only screen and (min-width: 750px){
    #shopify-section-{{ section_id }} .slide-text h3 {
      padding-top: 45px;
    }
    #shopify-section-{{ section_id }} .slide-text span {
      font-size: 19px;
    }
  }
  @media only screen and (min-width: 1024px){
    #shopify-section-{{ section_id }} .slide-text h3 {
      font-size: 30px;
      padding-top: 70px;
    }
    #shopify-section-{{ section_id }} .slide-text h3:before {
      font-size: 108px;
      left: 0;
    }
    #shopify-section-{{ section_id }} .image-element__wrap img {
      left: 50%;
      margin: 0 auto;
      max-width: 55%;
      position: absolute;
      top: 50%;
      transform: translate3d(-50%,-50%,0);
    }
    #shopify-section-{{ section_id }} .flickity-page-dots {
      bottom: -35px;
    }
  }
  @media only screen and (min-width: 1400px){
    #shopify-section-{{ section_id }} .slide-text{
      padding: 40px 40px 40px 0;
    }
  }
  @media only screen and (max-width: 1024px){
    #shopify-section-{{ section_id }} {
      padding: 0 0 40px;
    }
  }

  {% render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}
  
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-collection-blocks
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="quotes-slide-wrapper">
    {% if atb_main_title != blank %}
      <h3 style="color: {{ atb_text_color }};">{{ atb_main_title }}</h3>
    {% endif %}
    <div
      class="container quotes-slider {% if blocks.size <= 1 %}no-slider{% endif %}"
      style="flex-wrap: nowrap;"
      data-products-per-slide="1"
      data-products-limit="{% if blocks.size > 1 %}15{% else %}1{% endif %}"
      data-products-available="{% if blocks.size > 1 %}15{% else %}1{% endif %}"
    >
      {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        <div class="container quotes-slide one-whole column">
          <div class="four-sixths column medium-down--one-whole slide-text text-align-{{ block_text_alignment[forloop.index0] }}">
            {% if block_title[forloop.index0] != blank %}
              <h3 style="color: {{ atb_text_color }};">{{ block_title[forloop.index0] }}</h3>
            {% endif %}
            {% if block_subtitle[forloop.index0] != blank %}
              <span style="color: {{ atb_text_color }};">{{ block_subtitle[forloop.index0] }}</span>
            {% endif %}
          </div>
          <div
            class="two-sixths column medium-down--one-whole slide-image"
            {% if block_image_alignment[forloop.index0] == 'left' %}
              style="order: -1;"
            {% endif %}
          >
            {% if my_image0 != blank %}
              <div class="image-element__wrap" style="height: auto;">
                <img
                  src="{{ settings.speedsize_url_pfx_https -}}{{ my_image0 | img_url: 'master' }}"
                  alt="{{ block_image_alt[forloop.index0] }}"
                  width="100%"
                  height="100%"
                  loading="eager"
                >
              </div>
              {%
                render 'image-element',
                image: my_image0,
                alt: block_image_alt[forloop.index0],
              %}
            {% else %}
              <div class="image-element__wrap" style="height: auto;">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsQuotesSlider.js' | asset_url }}"></script>


</section>