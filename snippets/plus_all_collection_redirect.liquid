{% if enable and collection.handle == 'all' and settings.plus_all_redirect_url != blank %}
  <script>
    window.location.href = {{ settings.plus_all_redirect_url | json }};
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url={{ settings.plus_all_redirect_url }}">
  </noscript>
{% endif %}
{% if template == 'list-collections' %}
  <script>
    window.location.href = {{ shop.url | json }};
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url={{ shop.url }}">
  </noscript>
{% endif %}