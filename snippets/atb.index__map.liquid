{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_map_address' -%}
{%- assign atb_map_address = val -%}
{%- include 'atb-render' field:'atb_map_height' -%}
{%- assign atb_map_height = val -%}
{%- include 'atb-render' field:'atb_zoom_level' -%}
{%- assign atb_zoom_level = val -%}
{%- include 'atb-render' field:'atb_map_image' -%}
{%- assign atb_map_image = val -%}
{%- include 'atb-render' field:'atb_api_key' -%}
{%- assign atb_api_key = val -%}
{%- include 'atb-render' field:'atb_show_pin' -%}
{%- assign atb_show_pin = val -%}
{%- include 'atb-render' field:'atb_map_style' -%}
{%- assign atb_map_style = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_padding_left' -%}
{%- assign atb_padding_left = val -%}
{%- include 'atb-render' field:'atb_padding_right' -%}
{%- assign atb_padding_right = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- if atb_show_pin == blank -%}
{%- assign atb_show_pin = false -%}
{%- else -%}
{%- assign atb_show_pin = true -%}
{%- endif -%}
{%- assign atb_map_height = atb_map_height | plus: 0 -%}
{%- assign atb_zoom_level = atb_zoom_level | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_padding_left = atb_padding_left | plus: 0 -%}
{%- assign atb_padding_right = atb_padding_right | plus: 0 -%}
{%- assign atb_map_image_key = atb_map_image| split: '/files/' | last -%}{%- assign atb_map_image = images[atb_map_image_key] -%}{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section map-section jsMap">
{% comment %}
** Map **
{% endcomment %}

{%- capture map_style_json -%}
  {% render 'map-styles', name: atb_map_style %}
{%- endcapture -%}

{% comment %} Content settings {% endcomment %}
{%- assign map_address = atb_map_address -%}
{%- assign map_height = atb_map_height -%}
{%- assign zoom_level = atb_zoom_level -%}
{%- assign map_image = atb_map_image -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{%- capture section_css -%}
  #map--{{ section_id }} {
    height: {{ map_height }}px;
    width: 100%;
    overflow: hidden;
  }

  .map {
    width: 100%;
    height: 100%;
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% elsif atb_width == 'half' %}
      width: 50%;
    {% endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section class="section
                {{ atb_css_class }}
                is-width-{{ atb_width }}"
          {% if atb_animation != "none" %}
            data-scroll-class="{{ atb_animation }}"
          {% endif %} >

{% if map_address != blank and atb_api_key != blank %}

  {% comment %} API Map {% endcomment %}
  <div id="map--{{ section_id }}" class="embed-container maps">
      {% if atb_api_key != blank %}
        <div class="map-section__container map" id="map-{{ section_id }}"
        data-address="{{ map_address | strip_html }}"
        data-zoom="{{ zoom_level }}"
        data-pin="{{ atb_show_pin }}"
        data-id="map-{{ section_id }}"
        data-style="{{ atb_map_style }}"
        data-api-key="{{ atb_api_key }}"
        data-directions-address="{{ map_address | strip_html | handleize | replace: '_', '+' | replace: ' ', '+'}}">
        </div>
      {% endif %}
  </div>

{% elsif map_address != blank and atb_api_key == blank %}

  {% comment %} Iframe Map {% endcomment %}
  <div id="map--{{ section_id }}" class="embed-container maps">
    <iframe width="100%"  height="{{ map_height }}" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="https://maps.google.com/maps?f=q&amp;source=embed&amp;hl=en&amp;geocode=&amp;q={% if map_address != blank %}{{ map_address | strip_html | replace: ' ', '+'  }}{% else %}{{ shop.address.street  }}{% endif %}&amp;z={{ zoom_level  }}&amp;output=embed"></iframe>
  </div>

{% else %}

  {% comment %} Image Map {% endcomment %}
  <div id="map--{{ section_id }}" class="map__placeholder maps">
    {% if map_image == blank %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--map' }}
    {% else %}
      {%
        render 'image-element',
        image: map_image,
        alt: map_image.alt,
        stretch_width: true,
        focal_point: map_image.presentation.focal_point,
      %}
    {% endif %}
  </div>

{% endif %}
</section>

{% if atb_api_key %}
{% comment %} JavaScript {% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data >
  {
    "api_key": {{ atb_api_key | json }},
    "directions_address": {{ map_address | strip_html | handleize | replace: '_', '+' | replace: ' ', '+' | json }},
    "id": {{ section_id | prepend: 'map-' | json }},
    "map_address": {{ map_address | json }},
    "map_height": {{ map_height | json }},
    "map_style": {{ map_style_json | strip | json }},
    "show_pin": {{ atb_show_pin | json }},
    "zoom_level": {{ zoom_level | json }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsMap.js' | asset_url }}"></script>
{% endif %}



</section>