<section id="shopify-section-{{section_id}}" class="shopify-section collection-tabs home-collection-tabs jsCollectionTabs">
{% comment %} Section specific CSS {% endcomment %}

{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}</noscript>

<style>
  #shopify-section-{{ section_id }} .section-heading{
    margin-bottom: 30px;
  }
  #shopify-section-{{ section_id }} .product-item h4 span{
    display:block;
  }
  #shopify-section-{{ section_id }} .section-heading h3{
    margin-top: 0;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    
  }
  #shopify-section-{{ section_id }} .section-heading .main-subheading{
    font-size: 22px;
    font-style: italic;
    line-height: 28.71px;
    letter-spacing: 0.35px;
    font-family: 'Playfair Display';
  }

    .home-collection-tabs .product-item .hover-image{
    display:none;
  }
  .home-collection-tabs .product-item:hover .before-image{
    display:none;
  }
  .home-collection-tabs .product-item:hover .hover-image{
    display:block;
  }
   .home-collection-tabs .product-item h4{
     position:relative;
     padding-bottom:10px;
     padding-left:0;
     font-family: Montserrat,sans-serif;
     font-style: normal;
   }
  .home-collection-tabs .product-item h4:after{
    background-color: #dea595;
    bottom: 0px;
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    transition: width .8s;
    width: 80px;
    z-index: 0;
  }
  .home-collection-tabs .product-item:hover h4::after{
    width:0;
  }
  #shopify-section-{{ section_id }} .product-item h4{
    font-size:16px ;
    margin-top:10px;
    font-weight:500;
    font-family: Montserrat,sans-serif;
    font-style: normal;
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section_id }} .section-heading h3,#shopify-section-{{ section_id }} .product-item h4{
      font-size: 14px;
    }
    #shopify-section-{{ section_id }} .section-heading .main-subheading{
      font-size: 16px;
    }
  }
</style>

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- elsif atb_width == 'half' -%}
      width: 50%;
    {%- endif %}
  }
  #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons{
    gap: 0;
    margin-bottom: 1rem;
    justify-content: center;
  }
  #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button{
    border: 3px solid #f5f5f5;
    font-size: 16px;
    padding: 0.5rem 2rem;
    outline: none;
    box-shadodow: none;
    letter-spacing: 0;
    background: transparent;
    text-align:center;
    margin-right:5px;
    line-height: normal;
  }
  
  
  #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button.button-active {
    background:#f5f5f5 !important;
  }
  #shopify-section-{{ section_id }} .product-content-wrapper{
    justify-content: flex-start;
  }
  #shopify-section-{{ section_id }} .product-content-wrapper .product-item{
    margin-right: 5px !important;
  }
  #shopify-section-{{ section_id }} .product-content-wrapper .image-element__wrap{
    max-width: 100% !important;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button{
    background-color: transparent;
  }
  @media screen and (max-width: 1300px){
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons{
      flex-wrap: nowrap;
      overflow: auto;
      padding: 0 1rem 1rem;
      justify-content: flex-start;
    }
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button{
      white-space: nowrap;
    }
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-1,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-2,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-3{
      justify-content: center;
    }
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-1,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-2,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-3{
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button{
      font-size: 14px;
    }
    .home-collection-tabs .has-no-side-gutter .medium-down--one-half {
        width: 60% !important;
      }
    
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-setting-tabs
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    has-no-side-gutter
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="section-heading text-center">
    <h3>{{ atb_main_heading }}</h3>
    <div class="main-subheading">
      {{ atb_main_subheading }}
    </div>
  </div>
  <div class="container">
    {% assign buttonTextEmpty = false %}
    {% assign buttonCount = 0 %}
    {%- for block0 in blocks -%}
{%- assign my_image_key1 = block_image-2[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      {% if block_button_text[forloop.index0] == blank %}
        {% assign buttonTextEmpty = true %}
      {% endif %}
      {% if block_button_text[forloop.index0] != blank %}
        {% assign buttonCount = buttonCount | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% assign btn_handles = "Fashion Rings,Engagement Rings,Earrings,Necklaces" | split: "," %}
    <setting-tabs class="setting-tabs-wrapper one-whole">
      
        <div class="setting-tabs-buttons tab-buttons-{{ buttonCount }}">
          {%- for btn in btn_handles -%}
            {% assign buttonID = btn | replace: ' ', '-' | downcase %}
            <h3
              id="{{ buttonID }}"
              class="setting-tab-button {{ buttonID }}{% if forloop.first %} button-active{% endif %}"
            >
              {{ btn }}
            </h3>
          {% endfor %}
        </div>
      

      {%- for btn in btn_handles -%}
        {% assign buttonID = btn | replace: ' ', '-' | downcase %}
        <div
          id="{{ buttonID }}-content"
          class="setting-tab-content {{ buttonID }}-content js-related-products-slider{% if forloop.first %} tab-active{% endif %}"
        >
          <div
            class="product-content-wrapper products-slider"
            data-products-per-slide="5"
            data-products-limit="20"
            data-products-available="20"
          >
        {% for block0 in blocks %}
{%- assign my_image_key1 = block_image-2[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
          {% if buttonID == block_button[forloop.index0] %}
        <div class="product-item one-fifth column medium-down--one-half">
          {% if block_url[forloop.index0] != blank %}
            <a
              href="{{ block_url[forloop.index0] }}"
              class="collection-link"
              style="color: {{ atb_text_color }};"
            >
          {% endif %}
          {% if my_image0 != blank %}
            {%
              render 'image-element',
              image: my_image0,
              alt: block_image_alt[forloop.index0],
               additional_classes:'before-image',
            %}
          {% else %}
            <div class="image-element__wrap" style="height: auto;">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% if my_image1 != blank %}
            {%
              render 'image-element',
              image: my_image1,
              alt: block_image_alt[forloop.index0],
              additional_classes:'hover-image',
            %}
        {% endif %}
          {% if block_title[forloop.index0] != blank %}
            <h4 style="color: {{ atb_text_color }};">{{ block_title[forloop.index0] }}</h4>
          {% endif %}
          {% if block_url[forloop.index0] != blank %}
            </a>
          {% endif %}
        </div>
          {% endif %}
      {% endfor %}
      
          </div>
        </div>
      {% endfor %}
    </setting-tabs>
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsCollectionTabs.js' | asset_url }}"></script>


</section>