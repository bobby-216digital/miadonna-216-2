<script defer>
  dataLayer.push({ ecommerce: null });  
  dataLayer.push({
    event: "pr_view_item_list",
    ecommerce: {
      item_list_id: {{ collection.id | json }},
      item_list_name: {{ collection.title | json }},
      items: [{%- for product in collection.products -%}
        {% assign product_image = selected_variant.featured_image | default: product.featured_image %}
        {
          item_name: {{ product.title | json }},
          item_id: {{ product.id | json }},
          price: {{ product.selected_or_first_available_variant.price | divided_by: 100 | json }},
          item_brand: {{ product.vendor | json }},
          item_variant: {{ product.selected_or_first_available_variant.title | json }},
          item_category: {{ product.type | json }},
          retailPrice: {{ product.selected_or_first_available_variant.compare_at_price | divided_by: 100 | json }},
          categoryId: {{ collection.id | json }},
          image: {{ product_image | image_url: width: 1024 | prepend: 'https:' | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
          index: {{ forloop.index | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}]
    }
  });
</script>
