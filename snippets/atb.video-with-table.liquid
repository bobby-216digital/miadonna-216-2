<section id="shopify-section-{{section_id}}" class="shopify-section image-with-text image-with-text-1">
{% comment %}
  ** Image with text **
{% endcomment %}
<style>
    .cta-table table td,.cta-table table th {
      padding: 2em;
      text-align: center;
  }

  .cta-table {
      font-family: Montserrat,sans-serif;
      font-weight: 500;
      overflow-x: auto;
      text-align: center;
      text-transform: uppercase;
      width: 100%;
  }

  .cta-table table th {
      background: #e2e2e2;
      color: #000;
      text-transform: uppercase;
      border: 1px solid #fff;
  }

  .cta-table table tr:nth-child(2n) td {
      background: #f4f4f4;
      border: 1px solid #fff;
  }

  .cta-table table tr:nth-child(odd) td {
      background: #f9f9f9;
      border: 1px solid #fff;
  }
</style>
{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section_id }} .plyr__video-embed {
    width: 100%;
  }
  #shopify-section-{{ section_id }} .image-with-text__heading {
    font-weight: 500;
    line-height: 40px;
    letter-spacing: 1.4px;
  }
  #shopify-section-{{ section_id }} .image-with-text__text > p {
    line-height: 24px;
    letter-spacing: 0.35px;
  }
  #shopify-section-{{ section_id }} .image-with-text__text > p a {
    font-weight: 600;
    text-decoration: underline;
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% for block0 in blocks %}
{%- if block_controls[forloop.index0] == blank -%}
{%- assign my_checkbox3 = false -%}
{%- else -%}
{%- assign my_checkbox3 = true -%}
{%- endif -%}
{%- if block_mute_video[forloop.index0] == blank -%}
{%- assign my_checkbox2 = false -%}
{%- else -%}
{%- assign my_checkbox2 = true -%}
{%- endif -%}
{%- if block_autoloop[forloop.index0] == blank -%}
{%- assign my_checkbox1 = false -%}
{%- else -%}
{%- assign my_checkbox1 = true -%}
{%- endif -%}
{%- if block_autoplay[forloop.index0] == blank -%}
{%- assign my_checkbox0 = false -%}
{%- else -%}
{%- assign my_checkbox0 = true -%}
{%- endif -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
  {% if block_type[forloop.index0] == 'video' %}
    {% assign hasVideoBlock = 'has-video-block' %}
  {% endif %}
{% endfor %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
    {{ hasVideoBlock  }}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="container is-align-center"
    style="background: #f5f5f5;"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% if block_type[forloop.index0] == 'text' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block_text[forloop.index0] -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block_background[forloop.index0] | color_extract: 'alpha' -%}
          {%- assign text_alpha = block_text_color[forloop.index0] | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block_text_color[forloop.index0] }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block_text_color[forloop.index0] }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ blocks[forloop.index0] }} {
                background-color: {%- if background_alpha != 0 -%}{{ block_background[forloop.index0] }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: blocks[forloop.index0]
            %}
          {% endstyle %}

          <div
            class="
              image-with-text__text-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                two-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex
              is-flex-wrap
              is-justify-{{ block_alignment[forloop.index0] }}
              is-align-{{ block_vertical_position[forloop.index0] }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
          >
            <div class="image-with-text__wrapper">
              {% if block_title[forloop.index0] != blank %}
                <h3 class="image-with-text__heading text-align-{{ block_alignment[forloop.index0] }} is-{{ block_heading_size[forloop.index0] }}">
                  {{ block_title[forloop.index0] }}
                </h3>
              {% endif %}

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block_alignment[forloop.index0] }} content">
                  {{ text }}
                </div>
              {% endif %}

              {% if block_button_label[forloop.index0] != blank %}
                <div class="buttons is-{{ block_alignment[forloop.index0] }}">
                  {% render 'button',
                    label: block_button_label[forloop.index0],
                    href: block_link[forloop.index0],
                    style: block_button_style[forloop.index0],
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block_type[forloop.index0] == 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = my_image0 -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              image-with-text__image-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                three-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              is-flex
              is-align-center
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
          >
            {% if block_image_link[forloop.index0] %}
              <a class="image-with-text__link" href="{{ block_image_link[forloop.index0] }}">
            {% endif %}
            {% if image != blank %}
              {%
                render 'image-element',
                image: image,
                alt: image.alt,
                stretch_width: true,
                additional_classes: 'image-with-text__image',
                focal_point: image.presentation.focal_point,
              %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block_image_link[forloop.index0] %}
              </a>
            {% endif %}
          </div>
        {% elsif block_type[forloop.index0] == 'table' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = my_image0 -%}
          {%- assign iframe_video = block_iframe_video_id[forloop.index0] -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              one-half
              medium-down--one-whole
              column
              is-align-center
              {% if iframe_video %}column-has-video{% endif %}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
            style="position: relative;"
          >
            <div class="cta-table">
              <style>
                .cta-table table td {
                  width: 50%;
                  padding: 1em;
                }
                .cta-table table tr:nth-child(odd) td {
                  border: 1px solid #212121;
                }
                .cta-table table tr:nth-child(2n) td {
                  border: 1px solid #212121;
                }
                .cta-table table tr td {
                  background: transparent !important;
                }
                .cta-table table tr td:last-child {
                  background: #ffffff !important;
                }
              </style>
              <table style="width: 100%;">
                <tbody>
                  <tr>
                    <td>{{ block_r1v1[forloop.index0] }}</td>
                    <td>{{ block_r1v2[forloop.index0] }}</td>
                  </tr>
                  <tr>
                    <td>{{ block_r2v1[forloop.index0] }}</td>
                    <td><s>{{ block_r2v2[forloop.index0] }}</s>&nbsp;{{ block_r2v3[forloop.index0] }}</td>
                  </tr>
                  <tr>
                    <td>{{ block_r3v1[forloop.index0] }}</td>
                    <td>{{ block_r3v2[forloop.index0] }}</td>
                  </tr>
                  <tr>
                    <td>{{ block_r4v1[forloop.index0] }}</td>
                    <td>{{ block_r4v2[forloop.index0] }}</td>
                  </tr>
                  <tr>
                    <td>{{ block_r5v1[forloop.index0] }}</td>
                    <td>{{ block_r5v2[forloop.index0] }}</td>
                  </tr>
                  <tr>
                    <td>{{ block_r6v1[forloop.index0] }}</td>
                    <td>{{ block_r6v2[forloop.index0] }}</td>
                  </tr>
                  <tr>
                    <td>{{ block_r7v1[forloop.index0] }}</td>
                    <td>{{ block_r7v2[forloop.index0] }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        {% elsif block_type[forloop.index0] == 'video' %}
          <div
            class="
              image-with-text__video-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                one-half
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              is-flex
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
          >
            {%- assign iframe_video = block_iframe_video_id[forloop.index0] -%}
            {% if iframe_video != blank %}
              <div
                class="plyr__video-embed video-{{ blocks[forloop.index0] }}"
                style="{% if block_aspect_ratio[forloop.index0] == '1:1' %}padding-bottom: 100%;{% elsif block_aspect_ratio[forloop.index0] == '4:3' %}padding-bottom: 76.8%;{% else %}padding-bottom: 63.5%;{% endif %}"
              >
                <div class="lazyframe" data-ratio="{{ block_aspect_ratio[forloop.index0] }}">
                  {% if block_aspect_ratio[forloop.index0] == '16:9' %}
                    <style>
                      .lazyframe[data-ratio="16:9"]:before {
                        padding-top: 63.5%;
                      }
                    </style>
                  {% elsif block_aspect_ratio[forloop.index0] == '4:3' %}
                    <style>
                      .lazyframe[data-ratio="4:3"]:before {
                        padding-top: 0;
                        padding-bottom: 76.8%;
                      }
                    </style>
                  {% endif %}
                  {% if iframe_video.type == 'youtube' %}
                    <iframe
                      src="https://www.youtube.com/embed/{{ iframe_video.id  }}?origin=https://plyr.io&amp;autoplay=true&amp;mute=true&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                      allowfullscreen
                      allowtransparency
                      allow="autoplay"
                    ></iframe>
                  {% elsif iframe_video.type == 'vimeo' %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;pip=0&amp;controls=0&amp;autoplay=1&amp;muted=1&amp;byline=false&amp;portrait=false&amp;title=false&amp;speed=true&amp;transparent=0&amp;gesture=media"
                      allowfullscreen
                      allowtransparency
                      allow="autoplay"
                      width="100%"
                      height="100%"
                    ></iframe>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>


</section>