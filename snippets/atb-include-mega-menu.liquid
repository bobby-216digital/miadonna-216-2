                  render 'image-element',
                  image: block_image[forloop.index0],
                  alt: block_image[forloop.index0].alt,
                  additional_classes: 'mega-menu__image',
                  focal_point: block_image[forloop.index0].presentation.focal_point,
                %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              <div class="image-element__content content">
                <div class="mega-menu__callout__text">
                  {% if block_image_title[forloop.index0] or block_image_caption[forloop.index0] %}
                    <p class="banner-title"><strong>{{ block_image_title[forloop.index0] }}</strong></p>
                    <p>{{ block_image_caption[forloop.index0] }}</p>
                  {% endif %}
                </div>
                <div class="mega-menu__callout__btn-text">
                  {% if block_btn_text[forloop.index0] %}
                    <p class="mega-menu__callout__btn">{{ block_btn_text[forloop.index0] }}</p>
                  {% endif %}
                </div>
              </div>

              {% if block_image_link[forloop.index0] != blank %}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
