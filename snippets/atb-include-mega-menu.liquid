                            src="{{ settings.speedsize_url_pfx_https -}}{{ block_collection_image_1[forloop.index0] | img_url: '100' }}"
                            alt="{{ block_collection_image_1[forloop.index0].alt }}"
                            srcset="{{ settings.speedsize_url_pfx_https -}}{{ block_collection_image_1[forloop.index0] | img_url: '100' }} 100w"
                            width="100"
                            height="120"
                            loading="lazy"
                          >
                        {% else %}
                          {{ 'image' | placeholder_svg_tag }}
                        {% endif %}
                      </div>
                      <div class="mega-menu__callouts__item-text">
                        {% if block_collection_title_1[forloop.index0] != blank %}
                          <p>{{ block_collection_title_1[forloop.index0] }}</p>
                        {% endif %}
                      </div>
                      {% if block_collection_link_1[forloop.index0] != blank %}
                        </a>
                      {% else %}
                        </div>
                      {% endif %}
                    </li>
                  {% endif %}
