{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign mobile_menu_background_color = settings.mobile_menu_background_color | color_extract: 'alpha' -%}
{%- assign mobile_menu_link_color = settings.mobile_menu_link_color | color_extract: 'alpha' -%}
{%- assign mobile_menu_link_hover_color = settings.mobile_menu_link_hover_color | color_extract: 'alpha' -%}

{% comment %} Opacity level {% endcomment %}
{%- assign mobile_menu_opacity = settings.mobile_menu_opacity | divided_by: 100.00 -%}

{% comment %} Mobile specific CSS {% endcomment %}
{%- style -%}
  .mobile-menu {
    visibility: hidden;
    transition: transform 0.5s ease, visibility 0s linear 0.5s;
  }

  .mobile-menu__toggle-icon.is-active + .mobile-menu {
    visibility: visible;
    transition: transform 0.5s ease, visibility 0s linear 0s;
  }

  .mobile-menu__submenu.has-mega-menu {
    visibility: hidden;
    transition: transform 0.5s ease, visibility 0s linear 0.5s;
  }

  .mobile-menu__toggle-icon.is-active + .mobile-menu .submenu__input:checked ~ .mobile-menu__submenu.has-mega-menu {
    visibility: visible;
    transition: transform 0.5s ease, visibility 0s linear 0s;
  }

  .mobile-menu .submenu__input:focus-visible + .submenu__label {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .mobile-menu {
    background-color: {% if mobile_menu_background_color != 0.0 %}{{ settings.mobile_menu_background_color | color_modify: 'alpha', mobile_menu_opacity }}{% else %}{{ settings.header_background | color_modify: 'alpha', mobile_menu_opacity }}{% endif %};
  }

  {%- if mobile_menu_link_color != 0.0 -%}
    .mobile-menu-link,
    .mobile-menu__item,
    .mobile-menu a {
      color: {{ settings.mobile_menu_link_color }};
    }
  {%- endif -%}

  {%- if mobile_menu_link_hover_color != 0.0 -%}
    .mobile-menu-link:hover,
    .mobile-menu__item:hover,
    .mobile-menu a:hover {
      color: {{ settings.mobile_menu_link_hover_color }};
    }
  {%- endif -%}
{%- endstyle -%}

{% comment %} HTML markup {% endcomment %}
<div id="mobile-header" class="mobile-header">
  <div
    data-show-mobile-menu="false"
    class="mobile-menu__toggle-button mobile-toggle__position--{{ settings.logo_menu_position }}"
    role="button"
    tabindex="0"
    aria-label="{{ 'layout.general.menu' | t | escape }}"
    aria-controls="mobile-menu"
    aria-expanded="false"
  ></div>
  <div
    class="
      mobile-header__content
      mobile-layout--{{ settings.logo_menu_position }}
      mobile-logo__position--{{ settings.logo_mobile_position }}
      header__icon-style-{{ settings.mobile_icon_style | replace: '_', '-' }}
    "
  >
    <div class="mobile-dropdown mobile-dropdown__position--{{ settings.logo_menu_position }}">
      <div class="mobile-menu__toggle-icon">
        <div class="mobile-header__open-menu">
          {% render 'icon', name: 'menu' %}
        </div>
        <div class="mobile-header__close-menu">
          {% render 'icon', name: 'x' %}
        </div>
      </div>
      {% render 'mobile-menu', nav_blocks: nav_blocks %}
      {% if settings.show_search_icon_mobile %}
        {% comment %} Search icon {% endcomment %}
        <a href="#search" class="header__link action-area__link mobile_search snize-custom-widget-opener copied" aria-label="Search" data-show-search-trigger>
          {% render 'icon', name: 'search', icon_class: 'header__icon' %}
          <span class="icon-caption">{{ 'general.search.title' | t | escape }}</span>
        </a>
      {% endif %}
    </div>
    <div class="mobile-logo">
      {% if settings.logo_mobile != blank %}
        <a class="mobile-header__logo header__link primary-logo" href="{{ routes.root_url }}" title="{{ shop.name }}">
          {% render 'image-element',
            image: settings.logo_mobile,
            alt: settings.logo_mobile.alt,
            additional_classes: 'primary-logo',
            focal_point: settings.logo_mobile.presentation.focal_point
          %}
        </a>
      {% elsif section.settings.logo != blank %}
        <a class="mobile-header__logo header__link primary-logo" href="{{ routes.root_url }}" title="{{ shop.name }}">
          {% render 'image-element',
            image: section.settings.logo,
            alt: section.settings.logo.alt,
            image_section: 'header',
            additional_classes: 'primary-logo',
            focal_point: section.settings.logo.presentation.focal_point
          %}
          {% if section.settings.enable_sticky and section.settings.sticky_logo != blank %}
            {% render 'image-element',
              image: section.settings.sticky_logo,
              alt: section.settings.sticky_logo.alt,
              image_section: 'header',
              additional_classes: 'sticky-logo',
              focal_point: section.settings.sticky_logo.presentation.focal_point
            %}
          {% endif %}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="header__link header__logo-text primary-brand">
          <span>{{ shop.name }}</span>
        </a>
      {% endif %}
    </div>
    <div class="mobile-icons {% if settings.show_search_icon_mobile == false %}has-one-icon{% endif %}">
      {% if settings.show_search_icon_mobile %}
        {% comment %} Search icon {% endcomment %}
      {% endif %}

      {% comment %} <a href="#help" class="header__link action-area__link" aria-label="Help" data-swym-loaded="true">
        <span class="icon header__icon" data-icon="phone">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
            <title>Phone</title>
            <g id="phone"><path d="M95,76.76A11.6,11.6,0,0,1,91.59,85l-3.87,3.87A20.79,20.79,0,0,1,73.13,95a19.81,19.81,0,0,1-2.87-.22,73.37,73.37,0,0,1-26.14-9.52A83,83,0,0,1,27.59,72.4,83.11,83.11,0,0,1,14.72,55.87a73.35,73.35,0,0,1-9.5-26.13,20.54,20.54,0,0,1,5.92-17.48L15,8.39a11.65,11.65,0,0,1,16.43,0l8.48,8.49a11.61,11.61,0,0,1,0,16.44l-3.76,3.76a5.72,5.72,0,0,0-.58,7.33,82.45,82.45,0,0,0,9.13,10.86,81.3,81.3,0,0,0,10.88,9.14,5.7,5.7,0,0,0,7.32-.6l3.76-3.76a11.66,11.66,0,0,1,16.44,0l8.48,8.5A11.57,11.57,0,0,1,95,76.76Z"/></g>
          </svg>
        </span>
      </a> {% endcomment %}

        {% if shop.customer_accounts_enabled %}
          {% comment %} Account icon {% endcomment %}
          {% if customer %}
            {% comment %} Logout {% endcomment %}
            <a href="#mage" class="header__link action-area__link" aria-label="Account">
            {%- comment -%}<a href="{{ routes.account_url }}" class="header__link action-area__link" aria-label="Account">{%- endcomment -%}
              {% render 'icon', name: 'avatar-2', icon_class: 'header__icon' %}
              {%- comment -%}<span class="icon-caption">{{ 'layout.customer.my_account' | t | escape }}</span>
              <span class="tooltip-text">{{ 'layout.customer.my_account' | t | escape }}</span>{%- endcomment -%}
            </a>
          {% else %}
            {% comment %} Login {% endcomment %}
            <a href="#mage" class="header__link action-area__link"  aria-label="Login">
            {%- comment -%}<a href="{{ routes.account_login_url }}" class="header__link action-area__link"  aria-label="Login">{%- endcomment -%}
              {% render 'icon', name: 'avatar-2', icon_class: 'header__icon' %}
              <span class="icon-caption">{{ 'layout.customer.log_in' | t | escape }}</span>
            </a>
          {% endif %}
        {% endif %}


      {% comment %} Cart icon {% endcomment %}
      <div
        class="header-cart action-area__link {% if cart.item_count != 0 %}has-cart-count{% endif %}"
        data-ajax-cart-trigger
      >
        <a
          class="header__link"
          {% if settings.cart_action != 'mini_cart' or settings.cart_action != 'drawer' %}
            href="{{ routes.cart_url }}"
          {% endif %}
           aria-label="View your shopping bag"
        >
          <span class="header-cart__icon">
            {% render 'icon', name: settings.cart_icon, icon_class: 'header__icon' %}
            {% comment %}
              <span class="header-cart__count header-cart__count--badge badge" data-bind="itemCount">
                {{ cart.item_count }}
              </span>
            {% endcomment %}
          </span>
          <span class="header-cart__caption icon-caption">
            {{ 'layout.general.cart' | t | escape }}
            {%- if object.settings.icon_style == 'text' -%}
              <span class="header-cart__count cart__count--text" data-bind="itemCount">{{ cart.item_count }}</span>
            {%- endif -%}
          </span>
        </a>
        {% if settings.cart_action == 'mini_cart' or settings.cart_action == 'drawer' %}
          {% render 'ajax-cart', context: 'mobile-header' %}
        {% endif %}
      </div>
    </div>
  </div>

  {% if settings.logo_mobile_position == 'below' %}
    <div class="mobile-logo__outer">
      {% if settings.logo_mobile != blank %}
        <a class="mobile-header__logo header__link primary-logo" href="{{ routes.root_url }}" title="{{ shop.name }}">
          {% render 'image-element',
            image: settings.logo_mobile,
            alt: settings.logo_mobile.alt,
            additional_classes: 'primary-logo',
            focal_point: settings.logo_mobile.presentation.focal_point
          %}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="header__link header__logo-text primary-brand">
          {{ shop.name }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% unless template.name == 'index'
  or template.name == 'product'
  or template.name == 'article'
  or template.name == 'blog'
%}
  <style>
    #mobile-header {
      border: 0;
    }
    .collection-mobile-breadcrumb{
      display: none;
    }
    .collection-mobile-breadcrumb .breadcrumb__container {
      overflow: hidden;
    }
    .collection-mobile-breadcrumb .breadcrumb__container .breadcrumb {
      font-size: 10px !important;
    }
    .collection-mobile-breadcrumb .breadcrumb__container ul {
      flex-wrap: nowrap;
      justify-content: flex-start;
    }
    .collection-mobile-breadcrumb .breadcrumb__container ul li {
      white-space: nowrap;
    }
    {% comment %} @media screen and (max-width: 767px){
      .collection-mobile-breadcrumb{
        display: flex;
        padding: 1rem 0;
      }
      .collection__breadcrumb{
        display: none;
      }
    } {% endcomment %}
  </style>
  <div class="container collection-mobile-breadcrumb">
    <div class="breadcrumb__container one-whole column">
      {% render 'breadcrumb' %}
    </div>
  </div>
{% endunless %}
<script>
    document.addEventListener('Searchanise.Loaded', function() {
    (function($) {
        if (window.innerWidth <= 1024) {
            setTimeout(function() {
                $('.mobile-dropdown [data-show-search-trigger]')[2].remove();

                if (!$('.mobile-dropdown [data-show-search-trigger]').hasClass('snize-custom-widget-opener copied')){
                $('.mobile-dropdown [data-show-search-trigger]').after($('.mobile-dropdown [data-show-search-trigger]').clone().addClass('snize-custom-widget-opener copied'));
                $('.mobile-dropdown [data-show-search-trigger]')[0].remove();
                
                $('[data-show-search-trigger]').unbind('touchstart');
                }

                console.log('testystsdfsdf');
                console.log($('.mobile-dropdown [data-show-search-trigger]'));
                Searchanise.Start();
                $(document).on('Searchanise.AutocompleteUpdated', function(event, input, container) {
                    $('.snize-close-button').click(() => Searchanise.AutocompleteCloseAll())
                     document.addEventListener('click', function (e) {
                          const el = e.target.closest('.snize-custom-widget-opener');
                          if (el) {
                              document.getElementById('header-search-input').value = '';
                          
                          document.getElementById('header-search-input').click();
                            document.querySelectorAll('.snize-ac-results-list-last-js').forEach(element => {
                                  element.classList.remove('hidden');
                              });
                              document.querySelectorAll("#snize-ac-items-container-4").forEach(element => {
                                  element.classList.add('hidden');
                              });
                          }
                      }, true);
                })
            }, 550)
        }
    })(window.Searchanise.$)
}); 

function initSearchanise() {

    if (window.innerWidth <= 1024) {

        setTimeout(function () {

            Searchanise.Start();

            $(document)
                .off('Searchanise.AutocompleteUpdated.mobile')
                .on('Searchanise.AutocompleteUpdated.mobile', function () {

                    $('.snize-close-button')
                        .off('click.mobile')
                        .on('click.mobile', function () {
                            Searchanise.AutocompleteCloseAll();
                        });

                });

        }, 1000);
    }
}

// Searchanise loaded
{% comment %} document.addEventListener('Searchanise.Loaded', function () {
    initSearchanise();
}); {% endcomment %}

// Window resize
window.addEventListener('resize', function () {
    initSearchanise();
});


  </script>