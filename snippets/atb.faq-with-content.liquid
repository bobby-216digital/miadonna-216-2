{% comment %}
ATB-SCHEMA{
  "name": "FAQ with Content",
  "class": "image-with-text faq-with-text image-with-text-1",
  "max_blocks": 3,
  "id": "faq-with-content",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_id_sec",
      "label": "Section Id",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "image",
          "label": "image"
        },
        {
          "value": "text",
          "label": "text"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "wysiwyg",
      "id": "block_image_content",
      "label": "Image content",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image"
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "info": "1024 x 1024px recommended",
      "repeatable": "block",
      "conditional": "block_type:image"
    },
    {
      "type": "text",
      "id": "block_image_text_1",
      "label": "Image Label 1",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image"
    },
    {
      "type": "image_picker",
      "id": "block_image_2",
      "label": "Image",
      "info": "1024 x 1024px recommended",
      "repeatable": "block",
      "conditional": "block_type:image"
    },
    {
      "type": "text",
      "id": "block_image_text_2",
      "label": "Image Label 2",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image"
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Heading",
      "default": "Heading text here",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "text",
      "id": "block_pre-title",
      "label": "Pre Heading",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "select",
      "id": "block_heading_size",
      "label": "Base size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "wysiwyg",
      "id": "block_text",
      "label": "Text",
      "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "link_list",
      "id": "block_faqs_menu",
      "label": "FAQs menu",
      "info": "Select faqs navigation.",
      "repeatable": "block",
      "conditional": "block_type:text"
    },
    {
      "type": "wysiwyg",
      "id": "block_text-2",
      "label": "Text 2",
      "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "link_list",
      "id": "block_faqs_menu_2",
      "label": "FAQs menu 2",
      "info": "Select faqs navigation.",
      "repeatable": "block",
      "conditional": "block_type:text"
    },
    {
      "type": "text",
      "id": "block_button_label",
      "label": "Button label",
      "default": "View all",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "text",
      "id": "block_link",
      "label": "Button link",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "select",
      "id": "block_button_style",
      "label": "Button style",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--primary",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "color",
      "id": "block_background",
      "label": "Background",
      "default": "rgba(0,0,0,0)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "color",
      "id": "block_text_color",
      "label": "Text",
      "default": "rgba(0,0,0,0)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "select",
      "id": "block_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "select",
      "id": "block_vertical_position",
      "label": "Vertical position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


