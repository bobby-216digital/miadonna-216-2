                {% endif %}
              {% endfor %}
            </p>
          </div>
          {% if forloop.index == blockSizeLast %}
            <div
              class="sub_footer-faq-item one-whole"
            >
              <button class="sub_footer-accordion-title">
                <span>{{- link.title | escape -}}</span>
                {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
              </button>
              <p class="sub_footer-accordion-content">
                {% for childLink in link.links %}
                  {% if childLink.links == blank %}
                    {% if childLink.url != routes.root_url %}
                      <a href="{{ childLink.url }}" style="text-decoration:underline;">
                    {% endif %}
                    {{ childLink.title | remove: '<br>' | escape -}}
