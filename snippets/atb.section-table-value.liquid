{% comment %}
ATB-SCHEMA{
  "name": "Table Data",
  "id": "section-table-value",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_header1",
      "label": "Heading 1",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_header2",
      "label": "Heading 2",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "table_text"
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Title",
      "repeatable": "table_text",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_value1",
      "label": "Value 1",
      "repeatable": "table_text",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_value2",
      "label": "Value 2",
      "repeatable": "table_text",
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_header1' -%}
{%- assign atb_header1 = val -%}
{%- include 'atb-render' field:'atb_header2' -%}
{%- assign atb_header2 = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_value1' -%}
{%- assign block_value1 = val -%}
{%- include 'atb-render' field:'block_value2' -%}
{%- assign block_value2 = val -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
<section class="section lgd-block lgd-real">
  <div class="container">
    <div class="pure-g body-cell cta-row"><div class="pure-u-1 pure-u-lg-24-24 cta-col">
        <div class="cta-table">
          <table>
            <tbody>
              <tr>
                <th></th>
                <th>{{ atb_header1 }}</th>
                <th>{{ atb_header2 }}</th>
              </tr>
              {% for block0 in blocks %}
              <tr>
                <td>{{ block_title[forloop.index0] }}</td>
                <td>{{ block_value1[forloop.index0] }}</td>
                <td>{{ block_value2[forloop.index0] }}</td>
              </tr>
              {% endfor %}
             
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  </section>
  <style>
    .cta-row .cta-col .cta-table table tr:nth-child(2n) td {
    background-color: #f4f4f4;
}
    .cta-row .cta-col .cta-table table tr:nth-child(odd) td {
    background-color: #f9f9f9;
}
    .cta-row .cta-col .cta-table table th, .cta-row .cta-col .cta-table table td {
    text-align: center;
}
   .cta-row .cta-col .cta-table table th {
    background: #e2e2e2;
    color: #000;
    text-transform: uppercase;
}
    .cta-row .cta-col .cta-table table th, .cta-row .cta-col .cta-table table td {
    font-size: 15px;
    padding: 2em;
}
    .cta-row .cta-col .cta-table table th,.cta-row .cta-col .cta-table table td {
    border: 1px solid #ffffff;
    }
    .cta-row .cta-col .cta-table table {
    font-family: Montserrat,sans-serif;
    font-weight: 500;
    overflow-x: auto;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
}
    @media screen and (max-width:768px){
      .cta-row .cta-col .cta-table table th, .cta-row .cta-col .cta-table table td {
    font-size: 9px;
    padding: 1.5em;
    line-height: 16px;
}
    }
  </style>


<style>
</style>

<script type="application/javascript">
</script></section>