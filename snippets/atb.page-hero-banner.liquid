{% comment %}
ATB-SCHEMA{
  "name": "Hero Banner",
  "id": "page-hero-banner",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "General Banner Settings",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_banner_activate",
      "label": "Activate Banner",
      "default": false,
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_slider_style",
      "label": "Slider Style",
      "info": "Note: Selecting 'video' will disable all text within slides",
      "options": [
        {
          "value": "slideshow",
          "label": "Slideshow"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "select",
      "id": "atb_cta_color",
      "label": "General CTA Background Color",
      "info": "This controls styles for both video and slideshow banners",
      "options": [
        {
          "value": "rgba(0,0,0,0)",
          "label": "Transparent"
        },
        {
          "value": "rgba(0,0,0,1)",
          "label": "Black"
        }
      ],
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Slideshow Settings",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_slider_home_auto",
      "label": "Auto-rotate slides",
      "default": false,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_slider_home_show_dots",
      "label": "Show dot indicators",
      "default": false,
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_slider_home_rate",
      "label": "Rotation interval",
      "options": [
        {
          "value": "1000",
          "label": "1 second"
        },
        {
          "value": "2000",
          "label": "2 seconds"
        },
        {
          "value": "3000",
          "label": "3 seconds"
        },
        {
          "value": "4000",
          "label": "4 seconds"
        },
        {
          "value": "5000",
          "label": "5 seconds"
        },
        {
          "value": "7000",
          "label": "7 seconds"
        },
        {
          "value": "10000",
          "label": "10 seconds"
        },
        {
          "value": "15000",
          "label": "15 seconds"
        }
      ],
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_slider_home_transition",
      "label": "Transition effect",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_slider_text_position",
      "label": "Banner Text Position",
      "options": [
        {
          "value": "within",
          "label": "Within Slides"
        },
        {
          "value": "above",
          "label": "Above Slideshow"
        }
      ],
      "default": "within",
      "info": ""
    },
    {
      "type": "header",
      "content": "Video Banner Settings",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Video Text Title",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_hero_body",
      "label": "Video Text Body",
      "info": ""
    },
    {
      "type": "image_picker",
      "id": "atb_hero_image",
      "label": "Hero Image, Poster and Backup",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_cta_url",
      "label": "CTA Link (leave blank if none)",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_cta_label",
      "label": "CTA Label",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_video_link",
      "label": "Video Asset Link",
      "info": "Link to the shopify (or any other) CDN resource."
    },
    {
      "type": "text",
      "id": "atb_mobile_video_link",
      "label": "Mobile Video Asset Link",
      "info": "Link to the shopify (or any other) CDN resource."
    },
    {
      "type": "range",
      "id": "atb_video_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "label": "Video Background Opacity",
      "default": 0,
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Hero-Slide"
    },
    {
      "type": "image_picker",
      "id": "block_slide_image",
      "label": "Desktop Image",
      "info": "minimum 2400x1400",
      "repeatable": "Hero-Slide"
    },
    {
      "type": "image_picker",
      "id": "block_slide_image_mobile",
      "label": "Mobile Image",
      "info": "minimum 1500x1200",
      "repeatable": "Hero-Slide"
    },
    {
      "type": "select",
      "id": "block_slide_text_align",
      "label": "Slide Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left Aligned"
        },
        {
          "value": "center",
          "label": "Center Aligned"
        },
        {
          "value": "right",
          "label": "Right Aligned"
        }
      ],
      "default": "left",
      "repeatable": "Hero-Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Hero Title",
      "repeatable": "Hero-Slide",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "block_hero_body",
      "label": "Hero Text Body",
      "repeatable": "Hero-Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_cta_url",
      "label": "CTA Link (leave blank if none)",
      "repeatable": "Hero-Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_cta_label",
      "label": "CTA Label",
      "repeatable": "Hero-Slide",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


