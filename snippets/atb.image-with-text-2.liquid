{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_hide_mobile' -%}
{%- assign atb_hide_mobile = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'block_type' -%}
{%- assign block_type = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image_position' -%}
{%- assign block_image_position = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_image_link' -%}
{%- assign block_image_link = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_content' -%}
{%- assign block_content = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- if atb_hide_mobile == blank -%}
{%- assign atb_hide_mobile = false -%}
{%- else -%}
{%- assign atb_hide_mobile = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section image-with-text image-with-text-1">
{% comment %}
  ** Image with text 2 **
{% endcomment %}

{{ 'image-with-text-2.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'image-with-text-2.css' | asset_url | stylesheet_tag }}</noscript>

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="container">
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% if block_type[forloop.index0] == 'image-with-text' %}
          <div
            class="image-with-text-wrapper"
          >
            <div
              class="image-with-text__image-column one-third column medium-down--one-whole"
              {% if block_image_position[forloop.index0] == 'right' %}
                style="order: 2;"
              {% endif %}
            >
              {% if my_image0 != blank %}
                <img src="{{ settings.speedsize_url_pfx_https -}}{{ my_image0 | img_url: 'master' }}" width="100%" height="100%" loading="eager">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="image-with-text__text-column two-thirds column medium-down--one-whole text-{{ block_image_position[forloop.index0] }}">
              <h2>{{ block_title[forloop.index0] }}</h2>
              <p>{{ block_content[forloop.index0] | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>


</section>