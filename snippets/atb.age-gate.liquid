{% comment %}
ATB-SCHEMA{
  "name": "t:sections.age_gate.name",
  "class": "shopify-section__age-gate",
  "id": "age-gate",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "number",
      "id": "atb_min_age",
      "label": "t:sections.age_gate.minimum_age.label",
      "default": 18,
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_min_age' -%}
{%- assign atb_min_age = val -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section shopify-section__age-gate">
{% liquid 
  capture _
    echo settings.show_age_gate_logo
  endcapture
%}

<script
  type="application/json"
  data-section-type="age-gate"
  data-section-id="{{ section_id }}"
  data-section-data
  data-required-age="||{{ atb_min_age }}||"
>
  {% assign age_gate_id = template.directory | append: template.name | append: template.suffix %}
  {
    "id": {{ age_gate_id | json }},
    "required_age": {{ atb_min_age | json }}
  }
</script>

</section>