{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'undefined' -%}
{%- assign undefined = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'block_type' -%}
{%- assign block_type = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_answer' -%}
{%- assign block_answer = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section FAQ jsFAQ">
{% comment %}
  ** FAQ **
{% endcomment %}

{% assign id = section_id %}
{% assign title = atb_title %}
{% assign img_border_radius = atb_border_radius %}
{% comment %} Layout {% endcomment %}
{% assign width = atb_width %}
{% assign animation = atb_animation | default: 'none' %}
{% assign padding_top = atb_padding_top %}
{% assign padding_bottom = atb_padding_bottom %}
{% comment %} Advanced {% endcomment %}
{% assign css_class = atb_css_class %}
{% assign custom_css = atb_custom_css %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        {% unless block_type[forloop.index0] == 'heading' %}
          {
            "@type": "Question",
            "name": "{{ block_title[forloop.index0] | escape }}",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "{{ block_answer[forloop.index0] | strip_html }}"
            }
          }{% unless forloop.last %},{% endunless %}
        {% endunless %}
      {% endfor %}
    ]
  }
</script>

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

{% capture icon_set %}
{% if settings.toggle_icon_style == 'carets' %}
  {% render 'icon',
          name: 'down-caret',
          icon_class: 'icon--rotate'
  %}
{% else %}
  {% render 'icon',
          name: 'plus',
          icon_class: 'icon--active'
  %}
  {% render 'icon', name: 'minus' %}
{% endif %}
{% endcapture %}

<section
  class="
    section
    {{ css_class }}
    is-width-{{ width }}
    has-gutter-enabled
    {% if width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if animation != 'none' %}
    data-scroll-class="{{ animation }}"
  {% endif %}
>
  <div class="container">
    {%- if title != blank -%}
      {% render 'heading', title: title, heading_tag: 'h2', context: 'faq', text_alignment: 'left' %}
    {%- endif -%}

    {% if blocks.size > 0 %}
      {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        {% if block_type[forloop.index0] == 'image' %}
          {% assign image = true %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="page-faq__column-wrap container column-wrapper">
      <div class="{% if image == true %}one-half{% else %}one-whole{% endif %} medium-down--one-whole column faq faq__column-1">
        {% if blocks.size > 0 %}
          <dl
            class="
              {{ atb_css_class }}
              faq-accordion
              accordion-icon--{{ settings.toggle_icon_style }}
            "
          >
            {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
              {% if block_type[forloop.index0] == 'content' %}
                <div class="faq-accordion-item">
                  {% if block_title[forloop.index0] != blank %}
                    <dt>
                      <button
                        class="accordion-style--{{ settings.toggle_icon_style }} accordion__button"
                        type="button"
                        aria-controls="panel-{{ blocks[forloop.index0] }}"
                        aria-expanded="true"
                      >
                        {{ icon_set }}
                        {{ block_title[forloop.index0] }}
                      </button>
                    </dt>
                    <dd id="panel-{{ blocks[forloop.index0] }}" aria-hidden="false">
                      <div class="content">
                        {{ block_answer[forloop.index0] }}
                      </div>
                    </dd>
                  {% endif %}
                </div>

              {% elsif block_type[forloop.index0] == 'heading' %}
                {% if block_title[forloop.index0] != blank %}
                  <h2 class="title faq-title">{{ block_title[forloop.index0] }}</h2>
                {% endif %}
              {% endif %}
            {% endfor %}
          </dl>
        {% endif %}
      </div>

      {% if blocks.size > 0 %}
        {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
          {% if block_type[forloop.index0] == 'image' %}
            <div class="one-half medium-down--one-whole column faq faq--image faq__column-2">
              {% if my_image0 != blank %}
                {%
                  render 'image-element',
                  image: my_image0,
                  alt: my_image0.alt,
                  stretch_width: true,
                  focal_point: my_image0.presentation.focal_point,
                %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<script data-theme-editor-load-script src="{{ 'z__jsFAQ.js' | asset_url }}"></script>


</section>