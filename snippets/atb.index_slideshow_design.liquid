{% comment %}
ATB-SCHEMA{
  "name": "Slideshow - Design",
  "class": "jsSlideshowDesign overlaid-header-option slideshow-section under-menu",
  "id": "index_slideshow_design",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "select",
      "id": "atb_image_transition",
      "label": "Image transition",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "default": "slide",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_image_slideshow_speed",
      "label": "Change image every",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 8,
      "unit": "sec",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_arrows",
      "label": "Show arrows",
      "default": true,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_nav_buttons",
      "label": "Show navigation dots",
      "default": true,
      "info": ""
    },
    {
      "type": "header",
      "content": "Mobile",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_mobile_text_below_image",
      "label": "Show text below image",
      "default": true,
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "wide",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Slide"
    },
    {
      "type": "text",
      "id": "block_link",
      "label": "Link",
      "info": "Links entire image",
      "repeatable": "Slide"
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "info": "1800 x 900px recommended",
      "repeatable": "Slide"
    },
    {
      "type": "image_picker",
      "id": "block_mobile_image",
      "label": "Mobile Image",
      "info": "900 x 1800px recommended",
      "repeatable": "Slide"
    },
    {
      "type": "wysiwyg",
      "id": "block_pretext",
      "label": "Preheading",
      "default": "<p>Preheading</p>",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Heading",
      "default": "Classic slideshow",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "block_subtitle",
      "label": "Subheading",
      "default": "<p>Additional info in the subheading</p>",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_pretext_color",
      "label": "Preheading",
      "default": "#000000",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_heading_color",
      "label": "Heading",
      "default": "#000000",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_subheading_color",
      "label": "Subheading",
      "default": "#000000",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_text_horizontal_position",
      "label": "Horizontal position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "range",
      "id": "block_background_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "default": 77,
      "unit": "%",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_border_color",
      "label": "Border",
      "default": "#FFFFFF",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "range",
      "id": "block_border_width",
      "label": "Border width",
      "min": 0,
      "max": 20,
      "default": 0,
      "unit": "px",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "range",
      "id": "block_text_width",
      "label": "Text width",
      "min": 40,
      "max": 100,
      "default": 40,
      "unit": "%",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_button_1",
      "label": "First button label",
      "default": "Button 1",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_button_1_link",
      "label": "First slide link",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_button_1_style",
      "label": "First button style",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--secondary",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_button_2",
      "label": "Second button label",
      "default": "Button 2",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_button_2_link",
      "label": "Second slide link",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_button_2_style",
      "label": "Second button style",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--secondary",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_pretext_color_mobile",
      "label": "Preheading",
      "default": "rgba(0,0,0,0)",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_heading_color_mobile",
      "label": "Heading",
      "default": "rgba(0,0,0,0)",
      "repeatable": "Slide",
      "info": ""
    },
    {
      "type": "color",
      "id": "block_subheading_color_mobile",
      "label": "Subheading",
      "default": "rgba(0,0,0,0)",
      "repeatable": "Slide",
      "info": ""
    }
  ],
  "warnings": [
    "repeating range fields may not be properly handled",
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


