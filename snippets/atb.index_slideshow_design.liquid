<section id="shopify-section-{{section_id}}" class="shopify-section jsSlideshowDesign overlaid-header-option slideshow-section under-menu">
{% comment %}
** Slideshow classic **
{% endcomment %}

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  #shopify-section-{{ section_id }} .desktop-image,
  #shopify-section-{{ section_id }} .mobile-image {
    width: 100%;
  }

  {%
    render 'css-loop',
    css: section_css,
    id: section_id
  %}

  {%
    render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}

{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    under-overlay-menu
    {% if atb_mobile_text_below_image == true %}
      mobile-text--below-media
      {% else %}
      mobile-text--over-media
    {% endif %}
  "
  {% if atb_animation != "none" %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="
      slideshow-classic
      image-slideshow
      image-slideshow--{{ atb_image_transition  }}
      page-dots--{{ atb_show_nav_buttons }}
    "
    data-slideshow-classic
  >
    {% for block in blocks %}

      {% comment %} Content settings {% endcomment %}
      {%- assign image = my_image0 -%}
      {%- assign link = block_link[forloop.index0] -%}
      {%- assign mobile_image = my_image1 -%}
      {%- assign pretext = block_pretext[forloop.index0] -%}
      {%- assign title = block_title[forloop.index0] -%}
      {%- assign subtitle = block_subtitle[forloop.index0] -%}
      {%- assign text_horizontal_position = block_text_horizontal_position[forloop.index0] -%}
      {%- assign button_1 = block_button_1[forloop.index0] -%}
      {%- assign button_1_link = block_button_1_link[forloop.index0] -%}
      {%- assign button_2 = block_button_2[forloop.index0] -%}
      {%- assign button_2_link = block_button_2_link[forloop.index0] -%}
      {% comment %} Ends content settings {% endcomment %}

      {% comment %} NE compatibility {% endcomment %}
      {% comment %} In the new editor, these will reference the section settings instead of the blocks{% endcomment %}
      {% comment %} In the new editor, aside from the block settings listed above, all other block setting references should be changed to section settings including classes {% endcomment %}
      {%- assign background_color_alpha = my_range0 | divided_by: 100.00 -%}
      {%- assign heading_alpha = block_heading_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign preheading_alpha = block_pretext_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign subheading_alpha = block_subheading_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign caption_border_alpha = block_border_color[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign mobile_headline_alpha = block_heading_color_mobile[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign mobile_preheading_alpha = block_pretext_color_mobile[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign mobile_subtitle_alpha = block_subheading_color_mobile[forloop.index0] | color_extract: 'alpha' -%}
      {%- assign caption_background_alpha = block_background_color[forloop.index0] | color_extract: 'alpha' -%}
      {% comment %} Ends NE compatibility {% endcomment %}

      <div
        class="
          gallery-cell
          image-slideshow__slide
          slideshow-classic__banner
          {% if atb_mobile_text_below_image == true %}
            mobile-text--below-media
          {% else %}
            mobile-text--over-media
          {% endif %}
        "
        id="shopify-section-{{ blocks[forloop.index0] }}"
        data-slide-index={{ forloop.index0 }}
        {{ block.shopify_attributes }}
      >

        {% if button_1 != blank and button_2 != blank %}
          {%- assign buttons = true -%}
        {% else %}
          {%- assign buttons = false -%}
        {% endif %}

        {% style -%}
          #shopify-section-{{ blocks[forloop.index0] }} .caption-content {
            background-color: {% if caption_background_alpha != 0 %}{% if background_color_alpha != 100  %}{{ block_background_color[forloop.index0] | color_modify: 'alpha', background_color_alpha }}{% else %}{{ block_background_color[forloop.index0] }}{% endif %}{% else %}rgba(0,0,0,0){% endif %};
            {% comment %} NE compatibility {% endcomment %}
            {% comment %} This will change to a default 2px border if the border color has been set {% endcomment %}
            {% comment %}{% if atb_border_color != 0 %}border: 2px solid {{ atb_border_color }}{% endif %};{% endcomment %}
            border: {{ my_range1 }}px solid {{ block_border_color[forloop.index0] }};
            {% comment %} Ends NE compatibility {% endcomment %}
          }

          #shopify-section-{{ blocks[forloop.index0] }} .slideshow-classic__heading {
            color: {% if heading_alpha != 0 %}{{ block_heading_color[forloop.index0] }}{% else %}{{ settings.heading_color }}{% endif %};
          }

          #shopify-section-{{ blocks[forloop.index0] }} .slideshow-classic__preheading {
            color: {% if preheading_alpha != 0 %}{{ block_pretext_color[forloop.index0] }}{% else %}{{ settings.heading_color }}{% endif %};
          }

          #shopify-section-{{ blocks[forloop.index0] }} .slideshow-classic__subheading {
            color: {% if subheading_alpha != 0 %}{{ block_subheading_color[forloop.index0] }}{% else %}{{ settings.heading_color }}{% endif %};
          }

          @media only screen and (min-width: 480px) {
            #shopify-section-{{ blocks[forloop.index0] }} .caption-content {
              width: {{ my_range2 }}%;
            }
          }

          @media only screen and (max-width: 480px) {
            #shopify-section-{{ blocks[forloop.index0] }}  .slideshow-classic__heading {
              color: {% if mobile_headline_alpha != 0 %}{{ block_heading_color_mobile[forloop.index0]}}{% endif %};
            }
            #shopify-section-{{ blocks[forloop.index0] }}  .slideshow-classic__preheading {
              color: {% if mobile_preheading_alpha != 0 %}{{ block_pretext_color_mobile[forloop.index0]}}{% endif %};
            }
            #shopify-section-{{ blocks[forloop.index0] }}  .slideshow-classic__subheading {
              color: {% if mobile_subtitle_alpha != 0 %}{{ block_subheading_color_mobile[forloop.index0]}}{% endif %};
            }
          }
        {%- endstyle -%}

        {% if mobile_image != blank %}
          {%- assign hide_mobile = 'is-hidden-mobile-only' -%}
        {% endif %}

        {% if image != blank %}
          {%
            render 'image-element',
            image: image,
            alt: image.alt,
            stretch_width: true,
            additional_classes: hide_mobile,
            focal_point: image.presentation.focal_point,
          %}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        {% if mobile_image != blank %}
          <div class="is-hidden-desktop-only">
            {%
              render 'image-element',
              image: mobile_image,
              alt: mobile_image.alt,
              stretch_width: true,
              focal_point: mobile_image.presentation.focal_point,
            %}
          </div>
        {% endif %}

        {% if link != blank %}
          <a class="banner--full-link" href="{{ link }}"></a>
        {% endif %}

        {% if pretext != blank or title != blank or subtitle != blank or button_1 != blank or button_2 != blank %}
          <div class="caption text-align-{{ text_horizontal_position }}">
            <div class="caption-content text-align-{{ block_text_alignment[forloop.index0] }}">
              {% if pretext != blank %}
                <div class="slideshow-classic__preheading pretext">
                  {{ pretext }}
                </div>
              {% endif %}
              {% if title != blank %}
                <h2
                  class="
                    slideshow-classic__heading
                    title
                    {% if settings.banner_heading_size > 35 %}
                      mobile-shrink-text
                    {% endif %}
                  "
                >
                  <span>{{ title }}</span>
                </h2>
              {% endif %}
              {% if subtitle != blank %}
                <div class="slideshow-classic__subheading subtitle">
                  {{ subtitle }}
                </div>
              {% endif %}
              {% if button_1 != blank or button_2 != blank %}
                <div
                  class="
                    slideshow-classic__buttons
                    buttons
                    {% unless buttons == true %}
                      is-justify-{{ block_text_alignment[forloop.index0] }}
                    {% endunless %}
                  "
                >
                  {% if button_1 != blank %}
                    {%
                      render 'button',
                      label: button_1,
                      href: button_1_link,
                      type: "link",
                      style: block_button_1_style[forloop.index0]
                    %}
                  {% endif %}

                  {% if button_2 != blank %}
                    {%
                      render 'button',
                      label: button_2,
                      href: button_2_link,
                      type: "link",
                      style: block_button_2_style[forloop.index0]
                    %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% comment %}JavaScript{% endcomment %}
<script
    type="application/json"
    data-section-id="{{ section_id }}"
    data-section-data
  >
  {
    "image_transition": {{ atb_image_transition | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "image_slideshow_speed": {{ atb_image_slideshow_speed | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }},
    "show_arrows": {{ atb_show_arrows | json }},
    "show_nav_buttons": {{ atb_show_nav_buttons | json }},
    "number_of_slides": {{ blocks.size | json }}
  }
</script>
<script data-theme-editor-load-script src="{{ 'z__jsSlideshowDesign.js' | asset_url }}"></script>


</section>