                            src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.collection_image_1 | img_url: '100' }}"
                            alt="{{ block.settings.collection_image_1.alt }}"
                            srcset="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.collection_image_1 | img_url: '100' }} 100w"
                            width="100"
                            height="120"
                            loading="lazy"
                          >
                          {% endcomment %}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag }}
                        {% endif %}
                      </div>
                      <div class="mega-menu__callouts__item-text">
                        {% if block.settings.collection_title_1 != blank %}
                          <p>{{ block.settings.collection_title_1 }}</p>
                        {% endif %}
                      </div>
                      {% if block.settings.collection_link_1 != blank %}
                        </a>
                      {% else %}
                        </div>
                      {% endif %}
                    </li>
                  {% endif %}
                  {% if block.settings.collection_image_2 != blank or block.settings.collection_title_2 != blank %}
                    <li class="mega-menu__callouts__item">
                      {% if block.settings.collection_link_2 != blank %}
