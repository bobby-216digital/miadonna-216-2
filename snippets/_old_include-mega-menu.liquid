    </div>
    <div class="img-right one-fifth">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div
            class="
              column
              mega-menu__block
              block__{{ block.id }}
              block__{{ block.type | replace: '_', '-' }}
              one-Whole
              medium-down--one-half
            "
            {{ block.shopify_attributes }}
          >
            {% comment %} Image and menu {% endcomment %}
            <div class="mega-menu__content">
              {% if block.settings.image_link != blank %}
                <a href="{{ block.settings.image_link }}">
              {% endif %}

              {% if block.settings.image != null %}
                {%
                  render 'image-element',
                  image: block.settings.image,
                  alt: block.settings.image.alt,
                  additional_classes: 'mega-menu__image',
                  focal_point: block.settings.image.presentation.focal_point,
                %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              <div class="image-element__content content">
                <div class="mega-menu__callout__text">
                  {% if block.settings.image_title or block.settings.image_caption %}
                    <p class="banner-title"><strong>{{ block.settings.image_title | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</strong></p>
                    <p>{{ block.settings.image_caption | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
                  {% endif %}
                </div>
                {% unless block.settings.btn_text == blank %}
                  <div class="mega-menu__callout__btn-text">
                    <p class="mega-menu__callout__btn">{{ block.settings.btn_text }}</p>
                </div>
              {% endunless %}
              </div>

              {% if block.settings.image_link != blank %}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.show_mega_bottom_bar %}
    <div class="mega-menu__banner {% if section.settings.mega_bottom_bar_link != blank %}has-link{% endif %} is-{{ section.settings.size }}">
      {% if section.settings.mega_bottom_bar_link != blank %}
        <a class="mega-menu__banner-link" href="{{ section.settings.mega_bottom_bar_link }}">
      {% endif %}
      <div class="container">
        <div class="one-whole column is-flex is-justify-center is-align-center">
          {% if section.settings.mega_bottom_bar_icon != blank %}
            {% render 'icon', name: section.settings.mega_bottom_bar_icon %}
          {% endif %}
          <p class="mega-menu__sticker-text">
            {{ section.settings.mega_bottom_bar_text }}
          </p>
        </div>
      </div>
      {% if section.settings.mega_bottom_bar_link != blank %}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>
