                    <li class="mega-menu__callouts__item">
                      {% if block.settings.collection_link_3 != blank %}
                        <a class="mega-menu__callouts__item-link" href="{{ block.settings.collection_link_3 }}">
                      {% else %}
                        <div class="mega-menu__callouts__item-link">
                      {% endif %}
                      <div class="mega-menu__callouts__item-img">
                        {% if block.settings.collection_image_3 != blank %}
                          {%
