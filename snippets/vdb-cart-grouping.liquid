<script>
  $(document).on("click", ".ajax-cart__line-item-main_title", function () {
      
      var $el =  $(this);

if ($el.length) {
    var $nextDiv = $el.parent().next('div');

    if ($nextDiv.length) {
       $nextDiv.toggleClass("hidden");
    }
}
$(this).toggleClass("active");
      $(this).next(".ajax-cart__line-items").stop(true, true).slideToggle(300);
  });
  (function ($) {
  // Flag to prevent recursive fetch calls when MageSDK fetches /cart.js internally
  let isUpdatingMagePoints = false;

  // Function to update ALL instances on the page
  function updateMageCartPoints() {
    if (isUpdatingMagePoints) return;

    const fetchPoints = function () {
      if (window.MageSDK && typeof window.MageSDK.getCartEarningValue === 'function') {
        isUpdatingMagePoints = true;

        window.MageSDK.getCartEarningValue()
          .then(function (resp) {
            if (resp && resp.success) {
              const isCredit = resp.data.loyaltyMode === 'store_credit';
              const formattedPoints = isCredit
                ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(Number(resp.data.points))
                : resp.data.formatted; // e.g. "150"
              const label = isCredit
                ? `Earn <strong>${formattedPoints}</strong>&nbsp;Store Credit With This Purchase`
                : `Earn <strong>${formattedPoints} Points</strong>&nbsp;With This Purchase`;
              
              // Target ALL instances by class name
              const $pills = $('.mage-cart-rewards-pill');
              
              if ($pills.length) {
                // Update text inside every instance
                $pills.find('.mage-rewards-text').html(label);
                // Show all pill instances
                $pills.show(); 
              }
            }
          })
          .catch(function (err) {
            console.error('Error fetching Mage SDK points:', err);
          })
          .finally(function () {
            isUpdatingMagePoints = false; // Unlock interceptor flag
          });
      }
    };

    if (window.MageSDK) {
      fetchPoints();
    } else {
      document.addEventListener('mage-sdk-loaded', fetchPoints, { once: true });
    }
  }


  // 1. Run on DOM Ready
  $(document).ready(function () {
    updateMageCartPoints();
  });

  // 2. Intercept Native fetch() requests (Dawn theme, modern AJAX drawers)
  const originalFetch = window.fetch;
  window.fetch = async function () {
    const response = await originalFetch.apply(this, arguments);
    const url = typeof arguments[0] === 'string' ? arguments[0] : arguments[0]?.url || '';

    if (
      !isUpdatingMagePoints && 
      (url.includes('/cart/add') || url.includes('/cart/change') || url.includes('/cart/update') || url.includes('/cart.js'))
    ) {
      updateMageCartPoints();
    }

    return response;
  };

  // 3. Intercept jQuery AJAX requests (Legacy AJAX drawers)
  $(document).ajaxComplete(function (event, xhr, settings) {
    if (
      !isUpdatingMagePoints && 
      settings.url && 
      (settings.url.includes('/cart/add') || settings.url.includes('/cart/change') || settings.url.includes('/cart/update') || settings.url.includes('/cart.js'))
    ) {
      updateMageCartPoints();
    }
  });

})(jQuery);
</script>