          await fetch('/cart/update.js', { method: 'POST', body: formDataFreeGift });
          await open_group_cart_drawer();
        }
      }
    {% endif %}
  }
  async function tpc_cart_item_remove(source,keys){
    let keys_arr = keys.split(',');
    if(keys_arr.length > 0){
      var formData = new FormData();
      for(let k=0; k<keys_arr.length; k++){
        if(keys_arr[k]!=""){
          formData.append('updates['+keys_arr[k]+']', 0);
          var deleteVariantIdArr = keys_arr[k].split(':');console.log('keys_arr[k]', keys_arr[k], deleteVariantIdArr);
          if(deleteVariantIdArr[0] != ''){
            let storedProps = JSON.parse(localStorage.getItem('itemProperties')) || {};console.log('storedProps', storedProps);
            delete storedProps[deleteVariantIdArr[0]];

            localStorage.setItem('itemProperties', JSON.stringify(storedProps));console.log('storedProps222', storedProps);
          }
        }
      }

      //remove current product or group-products
      await fetch('/cart/update.js', { method: 'POST', body: formData });

      //now check that have we ONLY free product, existed in cart then remove it
      let freeProductIdVariantId='', freeProductIdVariantId_2='';
      if (document.getElementById('free-product-id')) {
        freeProductIdVariantId = document.getElementById('free-product-id').dataset.variantId;  
      }
      if (document.getElementById('free-product-id-two')) {
        freeProductIdVariantId_2 = document.getElementById('free-product-id-two').dataset.variantId;  
      }
      if(freeProductIdVariantId!='' || freeProductIdVariantId_2!=""){
        let rawResponseFree = await fetch('/cart.json');
        let cartObjFree = await rawResponseFree.json();
        if(cartObjFree.total_price == 0){
          var formDataFree = new FormData();
          if(freeProductIdVariantId!=""){
            formDataFree.append('updates['+freeProductIdVariantId+']', 0);  
          }
          if(freeProductIdVariantId_2!=""){
            formDataFree.append('updates['+freeProductIdVariantId_2+']', 0);  
          }
          
          await fetch('/cart/update.js', { method: 'POST', body: formDataFree });
        } 
      }
      
      if(source=='cart_drawer'){
        open_group_cart_drawer();
      }else{
        location.reload(); 
      }
    }
  }
  
  (function(){
    setTimeout(function(){
      //this functions load on page load. So we render html, but do not open cart drawer.
      open_group_cart_drawer(false);
    },3000);
  })();
</script>

