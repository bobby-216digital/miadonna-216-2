{% assign vdbMoneyFormat = '${{amount}}' %}
{%- assign money_format = '${{no_decial}}' -%}
<script>
    const vdbMoneyFormat = "{{ vdbMoneyFormat }}";
    const money_format = "{{money_format}}";
    function vdbCartFormatMoney(cents, format) {
        if (typeof cents == 'string') {
            cents = cents.replace('.', '');
        }
        var value = '';
        var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        var formatString = (format || vdbMoneyFormat);

        function defaultOption(opt, def) {
            return (typeof opt == 'undefined' ? def : opt);
        }

        function formatWithDelimiters(number, precision, thousands, decimal) {
            precision = defaultOption(precision, 2);
            thousands = defaultOption(thousands, ',');
            decimal = defaultOption(decimal, '.');
            if (isNaN(number) || number == null) {
                return 0;
            }
            number = (number / 100.0).toFixed(precision);
            var parts = number.split('.'),
                dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
                cents = parts[1] ? (decimal + parts[1]) : '';
            return dollars + cents;
        }
        switch (formatString.match(placeholderRegex)[1]) {
            case 'amount':
                value = formatWithDelimiters(cents, 2);
                break;
            case 'amount_no_decimals':
                value = formatWithDelimiters(cents, 0);
                break;
            case 'amount_with_comma_separator':
                value = formatWithDelimiters(cents, 2, '.', ',');
                break;
            case 'amount_no_decimals_with_comma_separator':
                value = formatWithDelimiters(cents, 0, '.', ',');
                break;
            case 'no_decial':
                value = Math.floor(cents/100).toLocaleString("en-US");
                break;
        }
        return formatString.replace(placeholderRegex, value);
    }

  const noImageURL = '{{ settings.speedsize_url_pfx_https -}}{{ image | img_url: 'master' }}';

  async function freeProductAddToCart() {
    if (document.getElementById('free-product-id') || document.getElementById('free-product-id-two')) {
      let freeProductIdVariantId =  document.getElementById('free-product-id') ? document.getElementById('free-product-id').dataset.variantId : "";
      let freeProductIdVariantIdTwo = document.getElementById('free-product-id-two') ? document.getElementById('free-product-id-two').dataset.variantId : "";
      if(freeProductIdVariantId?.length > 0 || freeProductIdVariantIdTwo?.length > 0 ){
        let freeCartRawResponse = await fetch('/cart.js', { });
        let free_cart_json = await freeCartRawResponse.text();
        let free_cart_arr = JSON.parse(free_cart_json);
        let freeCartGroupedItems = groupingCartItems(free_cart_arr);
        let isFreeProductExists = 'Yes', isFreeProductOneExists = freeProductIdVariantId?.length > 0 ? 'Yes' : 'No', isFreeProductTwoExists = freeProductIdVariantIdTwo?.length > 0 ? 'Yes' : 'No';

        for (let i = 0; i < freeCartGroupedItems.length; i++) {
          if(freeCartGroupedItems[i].variant_id == freeProductIdVariantId){
            isFreeProductExists = 'No';
            isFreeProductOneExists = 'No';
          } else if(freeCartGroupedItems[i].variant_id == freeProductIdVariantIdTwo){
            isFreeProductExists = 'No';
            isFreeProductTwoExists = 'No';
          }
        }
  
        if (isFreeProductExists == "Yes") {
          let formItems = [];
          isFreeProductOneExists == 'Yes' && (formItems.push({'id': freeProductIdVariantId, 'quantity': 1 }));
          isFreeProductTwoExists == 'Yes' && (formItems.push({'id': freeProductIdVariantIdTwo, 'quantity': 1 }));
          if (formItems?.length > 0) {
            let formData = {'items':formItems};
            let rawResponse = await fetch("/cart/add.js", {
              method: "POST",
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(formData),
            });
            await rawResponse.json();
            // window.PXUTheme.jsAjaxCart.updateView();
          }
        }
      }
    }
  }
  function groupingCartItems(cart_arr){
    let final_item_group = [];
    if(cart_arr.items && cart_arr.items.length>0){
      let tmp_group = {};
      for(let i=0; i<cart_arr.items.length; i++){
        let item = cart_arr.items[i];
        let group_name;
        /*if(item.properties != null && Object.keys(item.properties).length > 0 && item.properties['_groupId'] != undefined && item.properties['_groupId'] != ""){
          group_name = item.properties['_groupId'];
        }else */
        if(item.handle == "one-tree-planted" || item.handle == "copy-of-one-tree-planted"){
          group_name = 'free-product';
        } else {
          group_name = 'no-group';
        }
        if(tmp_group[group_name] == undefined){
          tmp_group[group_name] = [];
        }
        tmp_group[group_name].push(item);
      }

      Object.keys(tmp_group).forEach((grp_key) => {
        if(grp_key=="no-group"){
          tmp_group[grp_key].forEach((item) => {
			let tmp_item = item;
			if(typeof tmp_item.properties['_main_product'] != "undefined" && tmp_item.properties['_main_product'] != ""){
				tmp_item.image = tmp_item.properties['_main_product'];
			}else{
				tmp_item.image = tmp_item.image; 
			}
            final_item_group.push(tmp_item);
          });
        }
        else if(grp_key!="free-product"){
          let combined_item = {
            "handle": "",
            "image": "",
            "price": 0,
            "title": "",
            "properties": {},
            "quantity": "",
            "url": "",
            "key": "",
          };
          tmp_group[grp_key].forEach((item) => {
            if(item.properties['_isMain'] != undefined && item.properties['_isMain'] == "true"){
              combined_item.handle = item.handle;
              combined_item.title = item.title;
              combined_item.quantity = item.quantity;
              if(item.properties['_product_url'] != undefined && item.properties['_product_url'] != ""){
                combined_item.url = item.properties['_product_url']+"&variant="+item.variant_id;
              }else{
                combined_item.url = item.url; 
              }
              if(item.properties['_main_product'] != undefined && item.properties['_main_product'] != ""){
                combined_item.image = item.properties['_main_product'];
              }else{
                combined_item.image = item.image; 
              }
            }
            combined_item.price = parseInt(combined_item.price) + parseInt(item.line_price);
            combined_item.key = combined_item.key + "," + item.key;

            if(item.properties['Metal'] != undefined && item.properties['Metal'] != ""){
              combined_item.properties['01_VDB_Metal'] = item.properties['Metal'];
            }
            if(item.properties['Size'] != undefined && item.properties['Size'] != ""){
              combined_item.properties['02_VDB_Size'] = item.properties['Size'];
            }
            if(item.properties['Material'] != undefined && item.properties['Material'] != ""){
              combined_item.properties['03_VDB_Material'] = item.properties['Material'];
            }
            if(item.properties['shape'] != undefined && item.properties['shape'] != ""){
              combined_item.properties['04_VDB_Stone Shape'] = item.properties['shape'];
            }
            if(item.properties['stone'] != undefined && item.properties['stone'] != ""){
              combined_item.properties['04_VDB_Stone'] = item.properties['stone'];
            }
            if(item.properties['side_stone'] != undefined && item.properties['side_stone'] != ""){
              combined_item.properties['05_VDB_Side Stone'] = item.properties['side_stone'];
            }
            if(item.properties['engravingFont'] != undefined && item.properties['engravingFont'] != ""){
              combined_item.properties['07_VDB_Engraving Font'] = item.properties['engravingFont'];
            }
            if(item.properties['engravingText'] != undefined && item.properties['engravingText'] != ""){
              combined_item.properties['08_VDB_Engraving Text'] = item.properties['engravingText'];
            }
            if(item.properties['Names'] != undefined && item.properties['Names'] != ""){
              combined_item.properties['09_VDB_Names'] = item.properties['Names'];
            }
            if(item.properties['Chain_Length'] != undefined && item.properties['Chain_Length'] != ""){
              combined_item.properties['10_VDB_Chain Length'] = item.properties['Chain_Length'];
            }
            if(item.sku != undefined && item.sku?.length > 0 && item.properties['_isMain'] != undefined && item.properties['_isMain'] == "true"){
              combined_item.properties['11_VDB_Setting SKU'] = `<a class="cart-item-custom" href="${combined_item.url}" target="_blank">${item.sku}</a>`;
            }
            if(item.sku != undefined && item.sku?.length > 0 && item.properties['isStone'] != undefined && item.properties['isStone'] == "true"){
                if (item.properties['gem_type'] != undefined && item.properties['gem_type'] != "") {
                    combined_item.properties['12_VDB_Gemstone SKU'] = `<a class="cart-item-custom" href="${item.url}" target="_blank">${item.sku}</a>`;
                } else {
                    combined_item.properties['12_VDB_Diamond SKU'] = `<a class="cart-item-custom" href="${item.url}" target="_blank">${item.sku}</a>`;
                }
            }
            if(item.properties['Setting SKU'] != undefined && item.properties['Setting SKU'] != ""){
                combined_item.properties['13_VDB_Setting SKU'] = `<a class="cart-item-custom" href="${combined_item.url}" target="_blank">${item.properties['Setting SKU']}</a>`;
            }
            if(item.properties['Gemstone SKU'] != undefined && item.properties['Gemstone SKU'] != ""){
                combined_item.properties['14_VDB_Gemstone SKU'] = `<a class="cart-item-custom" href="${item.url}" target="_blank">${item.properties['Gemstone SKU']}</a>`;
            }
            if(item.properties['Diamond SKU'] != undefined && item.properties['Diamond SKU'] != ""){
                combined_item.properties['14_VDB_Diamond SKU'] = `<a class="cart-item-custom" href="${item.url}" target="_blank">${item.properties['Diamond SKU']}</a>`;
            }
            if(item.properties['Size2'] != undefined && item.properties['Size2'] != ""){
                combined_item.properties['15_VDB_Size'] = item.properties['Size2'];
            }
        });

          final_item_group.push(combined_item);
        }
      });
      Object.keys(tmp_group).forEach((grp_key) => {
        if(grp_key=="free-product"){
          tmp_group[grp_key].forEach((item) => {
            final_item_group.push(item);
          });
        }
      });
    }
    return final_item_group;
  }

