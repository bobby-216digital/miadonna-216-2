{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_hide_mobile' -%}
{%- assign atb_hide_mobile = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_text_position' -%}
{%- assign block_text_position = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_image_link' -%}
{%- assign block_image_link = val -%}
{%- include 'atb-render' field:'block_text_alignment' -%}
{%- assign block_text_alignment = val -%}
{%- include 'atb-render' field:'block_title_1' -%}
{%- assign block_title_1 = val -%}
{%- include 'atb-render' field:'block_title_2' -%}
{%- assign block_title_2 = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- if atb_hide_mobile == blank -%}
{%- assign atb_hide_mobile = false -%}
{%- else -%}
{%- assign atb_hide_mobile = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section category-crousel jsCategoryCarousel">
{% comment %}
  ** Category carousel **
{% endcomment %}

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .category-carousel-wrapper .category-carousel-column {
    position: relative;
  }
  #shopify-section-{{ section_id }} .category-carousel-wrapper .category-carousel__column {
    position: absolute;
    left: 0;
    bottom: 20px;
    width: 350px;
    font-size: 24px;
    font-weight: 600;
    line-height: 26px;
    padding: 0 20px;
    letter-spacing: 1.4px;
  }
  #shopify-section-{{ section_id }} .category-carousel-wrapper .image-text em {
    font-weight: 400;
    font-family: "Playfair Display";
  }
  #shopify-section-{{ section_id }} .category-carousel-wrapper .flickity-button{
    background: transparent;
  }
  #shopify-section-{{ section_id }} .category--carousel.no-slider:after {
    content: "flickity";
    display: none; /* hide :after */
  }
  @media screen and (min-width: 1025px) {
    /* disable Flickity for large devices */
    #shopify-section-{{ section_id }} .category--carousel.no-slider:after {
      content: "";
    }
  }
  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section_id }} .category-carousel-wrapper .image-text {
      width: 250px;
      font-size: 20px;
      line-height: 26px;
      padding: 5px 20px;
    }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="container category-carousel-wrapper category--carousel has-no-side-gutter {% if blocks.size < 5 %}no-slider{% endif %}"
    data-products-per-slide="4"
    data-products-limit="{% if blocks.size > 4 %}20{% else %}4{% endif %}"
    data-products-available="{% if blocks.size > 4 %}20{% else %}4{% endif %}"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        <div
          class="category-carousel-column one-fourth medium-down--one-third small-down--one-whole column"
        >
          {% if my_image0 != blank %}
            {%
              render 'image-element',
              image: my_image0,
              alt: my_image0.alt,
              focal_point: my_image0.presentation.focal_point,
            %}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          {% if block_title_1[forloop.index0] != blank or block_title_2[forloop.index0] != blank %}
            <div class="category-carousel__column" style="{{ block_text_position[forloop.index0] }}: 0;">
              <div class="image-text text-{{ block_text_position[forloop.index0] }}">
                <p>
                  <em>{{ block_title_1[forloop.index0] }}</em>
                </p>
                <p>{{ block_title_2[forloop.index0] }}</p>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsCategoryCarousel.js' | asset_url }}"></script>


</section>