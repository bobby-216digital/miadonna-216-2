{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_description' -%}
{%- assign atb_description = val -%}
{%- include 'atb-render' field:'atb_image' -%}
{%- assign atb_image = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_hide_mobile' -%}
{%- assign atb_hide_mobile = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_text_color' -%}
{%- assign atb_text_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- if atb_hide_mobile == blank -%}
{%- assign atb_hide_mobile = false -%}
{%- else -%}
{%- assign atb_hide_mobile = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_image_key = atb_image| split: '/files/' | last -%}{%- assign atb_image = images[atb_image_key] -%}{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section content-with-image">
{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .content-wrapper{
    padding: 0 30px;
  }
  #shopify-section-{{ section_id }} .content-title {
    margin: 0 auto 20px;
    max-width: 70rem;
    font-size: 40px;
    line-height: 30.46px;
    font-family: 'Playfair Display';
  }
  #shopify-section-{{ section_id }} .content-description {
    margin-top: 20px;
    font-size: 14px;
    max-width: 46rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 24px;
    letter-spacing: 0.35px;
  }
  #shopify-section-{{ section_id }} .ring-size-image {
    margin-top: 20px;
    margin-left: auto;
    margin-right: auto;
    max-width: 653px;
  }
  {% render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-collection-blocks
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="content-wrapper text-center">
    {% if atb_title != blank %}
      <h3 class="content-title" style="color: {{ atb_text_color }};">{{ atb_title }}</h3>
    {% endif %}
    {% if atb_description != blank %}
      <div class="content-description" style="color: {{ atb_text_color }};">
        {{ atb_description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
      </div>
    {% endif %}
    {% if atb_image != blank %}
      {% render 'image-element',
        image: atb_image,
        alt: atb_image.alt,
        additional_classes: 'ring-size-image'
      %}
    {% endif %}
  </div>
</section>


</section>