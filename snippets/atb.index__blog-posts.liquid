{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section blog-posts blog-posts--1">
{% comment %}
** Blog posts **
{% endcomment %}

{%- assign title = atb_title -%}
{%- assign blog = blogs[atb_blog_widget_select] -%}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- endif %}
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section class="section
                {{ atb_css_class }}
                is-width-{{ atb_width }}"
                {% if atb_animation != "none" %}
                  data-scroll-class="{{ atb_animation }}"
                {% endif %}>

  {% if title != blank %}
    <div class="container">
      {% render 'heading',
              title: title,
              heading_tag: 'h2',
              context: 'featured-blog',
              text_alignment: 'center',
              url: blog.url
      %}
    </div>
  {% endif %}

  <div class="container">
    {% if blog != blank %}
      {% for article in blog.articles limit: atb_home_page_articles %}
          <div class="featured-article blog-card {% render 'column-width', value: atb_home_page_articles %} columns article card show-border-{{ atb_show-border }} medium-down--one-whole has-margin-bottom ">

            {% if article.image != blank %}
              <div class="card-image blog-card__image">
                <figure class="image">
                  <a class="blog-card__link" href="{{ article.url }}" title="{{ article.title | escape }}">
                    {%
                      render 'image-element',
                      image: article.image,
                      alt: article.image.alt,
                      additional_classes: 'blog-card__image',
                    %}
                  </a>
                </figure>
              </div>
            {% endif %}

            <div class="card-content blog-card__content">
              <div class="media">
                <div class="media-content">
                  <h3 class="title">
                    <a class="featured-article--link" href="{{ article.url }}" title="{{ article.title | escape }}">{{ article.title }}</a>
                  </h3>
                </div>
              </div>

              {% if article.excerpt != blank and atb_blog_show_excerpt%}
                {%- assign postexcerpt = article.excerpt | size -%}
                {% if postexcerpt > 150 %}
                  {%- assign excerptlength = 'lg' -%}
                {% elsif postexcerpt <= 150 %}
                  {%- assign excerptlength = 'sm' -%}
                {% endif %}
                <div class="excerpt excerpt-length-{{ excerptlength }} has-margin-bottom">
                  {{ article.excerpt | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                  <span class="truncation-fade"></span>
                </div>
              {% endif %}

              <div class="meta-info is-small">
                {% if atb_blog_show_tags %}
                  {% if article.tags.size > 0 %}
                    <ul class="meta-tag-list tags">
                    {% for tag in article.tags %}
                      <li class="tag tag--{{ settings.tag_style}}">
                        <a href="{{ shop.url}}/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" title="{{ blog.title | escape }} {{ 'blogs.general.tagged' | t }} {{ tag | escape }}">{{ tag }}
                        </a>
                      </li>
                    {% endfor %}
                    </ul>
                  {% endif %}
                {% endif %}

                {% render 'meta-info-list',
                        article: article,
                        blog_author: atb_blog_author,
                        blog_date: atb_blog_date,
                        blog_read_time: atb_read_time,
                        blog_comment_count: atb_blog_comment_count
                %}
              </div>
            </div>
          {% if atb_button_type != 'none' %}
            <div class="blog-card__read-more">
              {% render 'button',
                      label: atb_button_label,
                      href: article.url,
                      type: "link",
                      style: atb_button_type
              %}
            </div>
          {% endif %}
          </div>
      {% endfor %}
    {% else %}
      {% for i in (1..atb_home_page_articles) %}
        <div class="featured-article blog-card {% render 'column-width', value: atb_home_page_articles %} columns article card show-border-{{ atb_show-border }} medium-down--one-half small-down--one-whole has-margin-bottom">
          <div class="card-image blog-card__image">
            <figure class="image">
              <a href="{{ article.url }}">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </a>
            </figure>
          </div>

          <div class="card-content blog-card__content">
            <div class="media">
              <div class="media-content">
                <h4 class="title">
                  <a class="featured-article--link" href="#">{{ 'homepage.onboarding.blogpost_title' | t }}</a>
                </h4>
              </div>
            </div>

            {% if atb_blog_show_excerpt%}
              <div class="excerpt has-margin-bottom">
                {{ 'homepage.onboarding.blog_excerpt' | t }}
                <span class="truncation-fade"></span>
              </div>
            {% endif %}

            <div class="meta-info is-small">
                {% if atb_blog_show_tags %}
                <ul class="meta-tag-list tags ">
                  {% for i in (1..3) %}
                    <li class="tag tag--{{ settings.tag_style}}">
                      <a href="#">
                        tag{{i}}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
                {% endif %}

                {% render 'meta-info-list',
                        article: article,
                        blog_author: atb_blog_author,
                        blog_date: atb_blog_date,
                        blog_read_time: atb_read_time,
                        blog_comment_count: atb_blog_comment_count
                %}
              </div>
            </div>

          {% if atb_button_type != 'none' %}
            <div class="blog-card__read-more">
              {% render 'button',
                      label: atb_button_label,
                      href: a.url,
                      type: "link",
                      style: atb_button_type
              %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>



</section>