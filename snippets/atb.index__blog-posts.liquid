{%- assign atb_blog_show_tags = true -%}
{%- endif -%}
{%- if atb_blog_author == blank -%}
{%- assign atb_blog_author = false -%}
{%- else -%}
{%- assign atb_blog_author = true -%}
{%- endif -%}
{%- if atb_read_time == blank -%}
{%- assign atb_read_time = false -%}
{%- else -%}
{%- assign atb_read_time = true -%}
{%- endif -%}
