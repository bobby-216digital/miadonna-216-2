                <label for="light">Light</label>
              </div>
            </fieldset>
          </div>
        </div>
      </div>
      <div class="single-column">
        <div class="setting-accordion-item setting-accordion-ring-size">
          <div class="setting-accordion-button accordion-active">
            <span class="caret-wrapper">
              <i class="icon-solid-caret"></i>
            </span>
            <span class="button_text">Ring size:</span>
            <span id="variant_value" class="selected_value">6.25</span>
            <span class="selected_value size-guide">Ring Size Guide</span>
          </div>
          <div class="setting-accordion-content">
            <div class="select-wrapper">
              <select class="sustainability-select">
                <option selected>U.S. Ring Size: 6.25</option>
                <option>U.S. Ring Size: 7.25</option>
                <option>U.S. Ring Size: 8.25</option>
                <option>U.S. Ring Size: 9.25</option>
