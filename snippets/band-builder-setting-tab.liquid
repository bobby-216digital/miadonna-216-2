            </span>
            <span class="button_text">Engraving:</span>
            <span id="variant_value" class="selected_value">Yes</span>
          </div>
          <div class="setting-accordion-content">
            <fieldset class="radio-wrapper" style="border: none; margin: 0; padding: 0;">
              <legend class="visually-hidden">Engraving</legend>
              <div class="label-wrapper">
                <input type="radio" name="engraving" id="no" value="No" checked>
                <label for="no">No</label>
              </div>
              <div class="label-wrapper">
                <input type="radio" name="engraving" id="yes" value="Yes">
                <label for="yes">Yes ($50.00 USD)</label>
              </div>
            </fieldset>
            <div class="select-wrapper">
              <label for="font-style" class="visually-hidden">Engraving font</label>
