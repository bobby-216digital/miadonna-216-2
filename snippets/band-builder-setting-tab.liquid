            <fieldset class="radio-wrapper" style="border: none; margin: 0; padding: 0;">
              <legend class="visually-hidden">Weight</legend>
              <div class="label-wrapper">
                <input type="radio" name="weight" id="premium" value="Premium" checked>
                <label for="premium">Premium</label>
              </div>
              <div class="label-wrapper">
