                    <p class="tooltip-title">Shape {% render 'icon', name: 'x', icon_class: 'icon-close' %}</p>
                  {% endcomment %}
                  <p class="tooltip-content">100% Recycled Solid Metal</p>
                </span>
              </div>
            </span>
