          <div class="setting-accordion-button accordion-active">
            <span class="caret-wrapper">
              <i class="icon-solid-caret"></i>
            </span>
            <span class="button_text">Weight:</span>
            <span id="variant_value" class="selected_value">Premium</span>
            <span>
              <div class="tooltip">
                <img
                  src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/info.png?v=1685953801"
