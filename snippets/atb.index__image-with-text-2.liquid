        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--primary",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "color",
      "id": "block_background",
      "label": "Background",
      "default": "rgba(0,0,0,0)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "color",
      "id": "block_text_color",
      "label": "Text",
      "default": "rgba(0,0,0,0)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "select",
      "id": "block_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "select",
      "id": "block_vertical_position",
      "label": "Vertical position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    }
