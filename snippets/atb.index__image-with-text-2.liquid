{% comment %}
ATB-SCHEMA{
  "name": "Index image with text 2",
  "class": "image-with-text image-with-text-2",
  "max_blocks": 3,
  "id": "index__image-with-text-2",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
