<section id="shopify-section-{{section_id}}" class="shopify-section image-with-text image-with-text-2">
{% comment %}
  ** Image with text **
{% endcomment %}

{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}</noscript>

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section_id }} .plyr__video-embed{
    width: 100%;
    /* height: 100%; */
  }
  #shopify-section-{{ section_id }} .image-with-text__heading{
    margin-bottom: 1.5rem;
  }
  @media screen and (min-width: 1400px){
    #shopify-section-{{ section_id }} .image-with-text__heading{
      margin-bottom: 3rem;
    }
  }
  @media screen and (max-width: 1400px){
    #shopify-section-{{ section_id }} .image-with-text__text-column .breadcrumb.is-regular{
      top: 5px;
    }
  }
  {% render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  id="{{ atb_id_sec }}"
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="container"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% if block_type[forloop.index0] != 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block_text[forloop.index0] -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block_background[forloop.index0] | color_extract: 'alpha' -%}
          {%- assign text_alpha = block_text_color[forloop.index0] | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block_text_color[forloop.index0] }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block_text_color[forloop.index0] }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ blocks[forloop.index0] }} {
                background-color: {%- if background_alpha != 0 -%}{{ block_background[forloop.index0] }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: blocks[forloop.index0]
            %}
          {% endstyle %}

          <div
            class="
              image-with-text__text-column
              image-with-text__column
              one-third
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex

              is-justify-{{ block_alignment[forloop.index0] }}
              is-align-{{ block_vertical_position[forloop.index0] }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
          >
            {% unless template == 'index' %}
              <div class="is-hidden-mobile-only">
                {% render 'breadcrumb' %}
              </div>
            {% endunless %}
            <div class="image-with-text__wrapper">
              <h1 class="image-with-text__heading text-align-{{ block_alignment[forloop.index0] }}">
                {{- block_title[forloop.index0] -}}
                {{ block_title2[forloop.index0] }}
              </h1>

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block_alignment[forloop.index0] }} content">
                  {{ text }}
                </div>
              {% endif %}

              {% if block_button_label[forloop.index0] != blank %}
                <div class="buttons is-{{ block_alignment[forloop.index0] }}">
                  {% render 'button',
                    label: block_button_label[forloop.index0],
                    href: block_link[forloop.index0],
                    style: block_button_style[forloop.index0],
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block_type[forloop.index0] == 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = my_image0 -%}
          {%- assign mobileImage = my_image1 -%}
          {%- assign iframe_video = block_iframe_video_id[forloop.index0] -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              image-with-text__image-column
              image-with-text__column
              two-thirds
              medium-down--one-whole
              column
              is-flex
              is-align-center
              {% if iframe_video %}column-has-video{% endif %}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ blocks[forloop.index0] }}"
            {% endif %}
            style="position: relative;"
          >
            {% if block_image_link[forloop.index0] %}
              <a class="image-with-text__link" href="{{ block_image_link[forloop.index0] }}">
            {% endif %}

            {% if iframe_video != blank %}
              <div class="plyr__video-embed video-{{ blocks[forloop.index0] }}" data-video-element>
                {% if iframe_video.type == 'youtube' %}
                  <iframe
                    src="https://www.youtube.com/embed/{{ iframe_video.id  }}?origin=https://plyr.io&amp;autoplay=true&amp;mute=true&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                    allowfullscreen
                    allowtransparency
                    allow="autoplay"
                  ></iframe>
                {% elsif iframe_video.type == 'vimeo' %}
                  <iframe
                    src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;autoplay=1&amp;muted=1&amp;controls=1&amp;portrait=false&amp;transparent=1"
                    allowfullscreen
                    allowtransparency
                    allow="autoplay"
                  ></iframe>
                {% endif %}
              </div>
            {% else %}
              {% if image != blank %}
                {% if mobileImage != blank %}
                  <div class="is-hidden-mobile-only" style="width: 100%;">
                {% endif %}
                {%
                  render 'image-element',
                  image: image,
                  alt: image.alt,
                  stretch_width: true,
                  additional_classes: 'image-with-text__image',
                  focal_point: image.presentation.focal_point,
                %}
                {% if mobileImage != blank %}
                  </div>
                {% endif %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              {% if mobileImage != blank %}
                <div class="is-hidden-desktop-only">
                  {%
                    render 'image-element',
                    image: mobileImage,
                    alt: mobileImage.alt,
                    stretch_width: true,
                    additional_classes: 'image-with-text__image',
                    focal_point: image.presentation.focal_point,
                  %}
                </div>
              {% endif %}
            {% endif %}
            {% if block_image_link[forloop.index0] %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>


</section>