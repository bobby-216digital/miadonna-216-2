          "label": "Vimeo"
        }
      ],
      "repeatable": "block",
      "conditional": "block_type:image"
    },
    {
      "type": "text",
      "id": "block_iframe_video_id",
      "label": "YouTube or Vimeo ID",
      "default": "_9VUPq3SxOc",
      "repeatable": "block",
      "conditional": "block_type:image"
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Heading",
      "default": "Heading text here",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "text",
      "id": "block_title2",
      "label": "Heading",
      "default": "Heading text here",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:text"
    },
    {
      "type": "wysiwyg",
      "id": "block_text",
      "label": "Text",
