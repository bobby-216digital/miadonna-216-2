{% comment %}
ATB-SCHEMA{
  "name": "Icon Cards",
  "id": "icon-card",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Label",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_card_per_row",
      "label": "Card Per Row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "card",
          "label": "card"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Title",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:card"
    },
    {
      "type": "text",
      "id": "block_sub_title",
      "label": "Sub Title",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:card"
    },
    {
      "type": "image_picker",
      "id": "block_icon",
      "label": "Icon",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:card"
    },
    {
      "type": "wysiwyg",
      "id": "block_card_info",
      "label": "Card Info",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:card"
    },
    {
      "type": "text",
      "id": "block_link_title",
      "label": "Link Title",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:card"
    },
    {
      "type": "text",
      "id": "block_learn_more_link",
      "label": "Learn More Link",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:card"
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_card_per_row' -%}
{%- assign atb_card_per_row = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'block_type' -%}
{%- assign block_type = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_sub_title' -%}
{%- assign block_sub_title = val -%}
{%- include 'atb-render' field:'block_icon' -%}
{%- assign block_icon = val -%}
{%- include 'atb-render' field:'block_card_info' -%}
{%- assign block_card_info = val -%}
{%- include 'atb-render' field:'block_link_title' -%}
{%- assign block_link_title = val -%}
{%- include 'atb-render' field:'block_learn_more_link' -%}
{%- assign block_learn_more_link = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- assign atb_card_per_row = atb_card_per_row | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
{% style %} 

  #shopify-section-{{ section_id }} .rich-text__text h3 {
    font-family: "Playfair Display", serif;
    display: inline-block;
    background-color: #fff;
    padding: 0 20px;
  }
  #shopify-section-{{ section_id }}{
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    z-index: 9;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px) {
        display: none;
      }
    {% endif %}
  }
  {%- if atb_title != '' -%}
  #shopify-section-{{ section_id }} .section-icon-with-text {
    position: relative;
    padding-bottom: 50px;
  }
    {% endif %} 
  #shopify-section-{{ section_id }} .column{
    text-align: center;
    padding: 10px 0;
  }
  #shopify-section-{{ section_id }} .image-element__wrap img{
    width: 130px;
    object-fit: none;
  }
  {%- if atb_title != '' -%}
 #shopify-section-{{ section_id }} .section-icon-with-text::before {
    position: absolute;
    height: calc(100% - 50px);
    width: 100%;
    border: 3px solid #f5f5f5;
    top: 50px;
    content: '';
  }
  {% endif %}
 
  #shopify-section-{{ section_id }} .description > * {
    color: #3c3737;
    font-size: 52.58px;
    font-weight: 400;
    line-height: 48.75px;
    margin-top: 0;
    font-style: italic;
    letter-spacing: 0.35px;
    font-family: 'Playfair Display';
  }
  @media screen and (min-width: 798px) {
    #shopify-section-{{ section_id }} .container {
      align-items: center;
    }
     #shopify-section-{{ section_id }} .column{
      padding: 20px;
    }
    #shopify-section-{{ section_id }} .image-element__wrap {
      height: auto;
    }
    #shopify-section-{{ section_id }} .rich-text__text h3 {
      font-size: 40px;
    }
  }
  @media screen and (max-width: 798px) {
    #shopify-section-{{ section_id }} .image-element__wrap img{
      max-width: 80px;
    }
    #shopify-section-{{ section_id }}.container {
      gap: 2rem;
    }
    #shopify-section-{{ section_id }}.image-element__wrap {
      max-width: 60% !important;
    }
    #shopify-section-{{ section_id }} h3 {
      font-size: 20px;
      line-height: 1;
      max-width: 180px;
      padding: 0 10px;
    }
  }
.card-title {
    font-weight: 800;
    letter-spacing: 1px;
}

.card-subTitle {
    font-weight: 600;
    letter-spacing: 1px;
    font-size: 16px;
    max-width: 140px;
    margin: 0 auto 15px;
}
.card-info {
    max-width: 300px;
    font-size: 12px;
    margin: auto;
}
  .card-learn-more-btn{
    font-weight: 600;
      text-decoration: underline;
  }
  {% render 'css-loop',
      css: atb_custom_css,
      id: section_id %}
  {% endstyle %}

<section id="shopify-section-{{ section_id }}" class="section section-icon-with-text {{ atb_css_class }} is-width-{{ atb_width }}{% if atb_show_gutter == false %} has-no-side-gutter{% else %} has-gutter-enabled {% endif %}{% if atb_width == 'wide' %}equal-columns--outside-trim{% endif %}">{% assign value = atb_card_per_row %}

  <div class="container">
    {%- if atb_title != '' -%}
      <div class="columns one-whole">
        <div class="rich-text__content card-content">
          <div class="rich-text__text has-columns--1 text-align-center content">
            <h3 class="">{{ atb_title }}</h3>
          </div>
        </div>
      </div>
    {%- endif -%}
    {%- for block0 in blocks -%}
{%- assign my_image_key0 = block_icon[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      {%- if block_type[forloop.index0] == 'card' -%}
        <div class="column
          {% liquid if value == '2' or value == 2 
            echo 'one-half'
            elsif value == '3' or value == 3
            echo 'one-third'
            elsif value == '4' or value == 4
            echo 'one-fourth'
            elsif value == '5' or value == 5
            echo 'one-fifth'
            elsif value == '6' or value == 6 
            echo 'one-sixth' 
            endif %} medium-down--one-half small-down--one-whole">
          {%- if my_image0 != '' -%}
            <div class="card-icon">
              {%- render 'image-element',
                image: my_image0,
                alt: block_title[forloop.index0],
                stretch_width: true, -%}
            </div>
          {%- endif -%}
          {%- if block_title[forloop.index0] -%}
            <div class="card-title">
              {{ block_title[forloop.index0] }}
            </div>
          {%- endif -%}
          {%- if block_sub_title[forloop.index0] -%}
            <div class="card-subTitle">
              {{ block_sub_title[forloop.index0] }}
            </div>
          {%- endif -%}
          {%- if block_card_info[forloop.index0] -%}
            <div class="card-info">
              {{ block_card_info[forloop.index0] }}
            </div>
          {%- endif -%}
          {% if block_learn_more_link[forloop.index0] != blank %}
            <div class="card-learn-more-btn">
              <a href="{{block_learn_more_link[forloop.index0]}}">{{ block.settinghs.link_title | default: 'Learn more' }}</a>
            </div>
          {% endif %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

</section>