{%- assign atb_content_image_key = atb_content_image| split: '/files/' | last -%}{%- assign atb_content_image = images[atb_content_image_key] -%}{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section contact-section jsCustomContactForm">
{% comment %}
** Contact form **
{% endcomment %}

{% assign id = section_id %}

{% assign title = atb_title %}
{% assign content_text = atb_content_text %}
{% assign social_enable = atb_social_enable %}
{% assign content_image = atb_content_image %}
{% assign form_position = atb_form_position %}
{% assign text_alignment = atb_text_alignment %}

{% if title != blank or content_text != blank or content_image != nil or social_enable %}
  {% assign contact_content = true %}
{% else %}
  {% assign contact_content = false %}
{% endif %}
{% comment %}Text{% endcomment %}
{% assign text_color = atb_text_color %}
{% comment %}Background{% endcomment %}
{% assign background = atb_background %}
{% comment %}Layout{% endcomment %}
{% assign width = atb_width %}
{% assign padding_top = atb_padding_top %}
{% assign padding_bottom = atb_padding_bottom %}
{% assign padding_left = atb_padding_left %}
{% assign padding_right = atb_padding_right %}
{% assign animation = atb_animation | default: 'none' %}
{% comment %} Advanced {% endcomment %}
{% assign css_class = atb_css_class %}
{% assign custom_css = atb_custom_css %}

{% comment %} Is the color set to transparent? {% endcomment %}
{% assign background_alpha = background | color_extract: 'alpha' %}
{% assign text_alpha = text_color | color_extract: 'alpha' %}

{% if settings.form_button_style contains 'primary' %}
  {% assign field_input_size = settings.button_primary_padding %}
  {% assign field_input_style = 'primary-btn-style' %}
{% elsif settings.form_button_style contains 'secondary' %}
  {% assign field_input_size = settings.button_secondary_padding %}
  {% assign field_input_style = 'secondary-btn-style' %}
{% else %}
  {% assign field_input_size = settings.button_link_padding %}
{% endif %}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}

  .contact-form__form {
    color: {% if text_alpha != 0 %}{{ text_color }}{% else %}{{ settings.regular_color }}{% endif %};
  }

  .contact-form__form {
    background-color: {% if background_alpha != 0 %}{{ background }}{% endif %};
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    padding-left: {{ padding_left }}px;
    padding-right: {{ padding_right }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  {%
    render 'css-loop',
    css: section_css,
    id: id
  %}

  {%
    render 'css-loop',
    css: custom_css,
    id: id
  %}
{% endstyle %}

<section class="section
        {{ css_class }}
        is-width-{{ width }}"
        {% if animation != "none" %}
          data-scroll-class="{{ animation }}"
        {% endif %}>

  <div class="container
              content
              contact-form
              {% if contact_content == true %}
              contact-form--{{ form_position }}
              {% else %}
              contact-form--center
              {% endif %}
              ">

    {% if contact_content == true %}
      <div class="{% if blocks.size > 0 %}one-half{% else %}two-thirds offset-by-three{% endif %} medium-down--one-whole column">
        {% if content_image != nil %}
          <div class="contact-form__image">
            {%
              render 'image-element',
              image: content_image,
              alt: content_image.alt,
              focal_point: content_image.presentation.focal_point,
            %}
          </div>
        {% endif %}

        <div class="text-align-{{ text_alignment }}">
          {% if title != blank %}
            <h2 class="contact-form__heading title"><span>{{ title }}</span></h2>
          {% endif %}

          {% if content_text != blank %}
            <div class="contact-form__text">
              {{ content_text | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
            </div>
          {% endif %}

          {% if social_enable %}
            <div class="contact-form__social">
              {% render 'social-icons' %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if blocks.size > 0 and type != "block" %}
      <div class="one-half medium-down--one-whole column">
        <div class="contact-form__form">
          <div class="form__success-message"></div>
          <div class="one-whole column contact-form__form-errors">
            <p class="form__error"></p>
          </div>

          {% form 'contact', class: 'custom-contact-form' %}
            {% if form.posted_successfully? %}
              <div class="custom-contact-form__success">
                <p>{{ 'contact.form.post_success' | t }}</p>
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="custom-contact-form__errors">
                <p>{{ 'general.forms.post_error' | t }}</p>

                {%- assign message = 'contact.form.message' | t -%}

                {% for field in form.errors %}
                  {% if field == 'form' %}
                    <p>{{ form.errors.messages[field] }}</p>
                  {% else %}
                    {%- assign field_name = field | replace: 'body', message -%}
                    <p>{{ 'general.forms.post_field_error_html' | t: field: field_name, error: form.errors.messages[field] }}</p>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <div class="custom-contact-form__blocks">
              {%- assign used_labels = '' -%}

              {% for block0 in blocks %}
{%- if block_required[forloop.index0] == blank -%}
{%- assign my_checkbox0 = false -%}
{%- else -%}
{%- assign my_checkbox0 = true -%}
{%- endif -%}
                {%- assign suffix = '' -%}
                {% if used_labels contains block_label[forloop.index0] %}
                  {% assign suffix = '-' | append: forloop.index %}
                {% endif %}
                {%- assign used_labels = used_labels | join: '|' | append: '|' | append: block_label[forloop.index0] | split: '|' -%}

                {%- assign required_highlight = '' -%}
                {% if my_checkbox0 %}
                  {% capture required_highlight %}
                    <span class="required">*</span>
                  {% endcapture %}
                {% endif %}

                <div class="custom-contact-form__block custom-contact-form__block--{{ block_type[forloop.index0] }}" {{ block.shopify_attributes }}>
                  {% if block_type[forloop.index0] == 'textfield' %}
                    <label
                      class="label{% if settings.use_placeholders %} is-sr-only{% endif %}"
                      for="textfield{{ suffix }}"
                    >
                      {{ block_label[forloop.index0] | escape }} {{ required_highlight }}
                    </label>
                    <input
                      id="textfield{{ suffix }}"
                      class="input is-{{ field_input_style }} is-{{ field_input_size }}"
                      type="text"
                      {% if settings.use_placeholders %}
                        placeholder="{{ block_label[forloop.index0] | escape }}{% if my_checkbox0 %}*{% endif %}"
                      {% endif %}
                      name="contact[{{ block_label[forloop.index0] | escape }}{{ suffix }}]"
                      {% if my_checkbox0 %}
                        required="required"
                      {% endif %}
                    >

                  {% elsif block_type[forloop.index0] == 'email' %}
                    <label
                      class="label{% if settings.use_placeholders %} is-sr-only{% endif %}"
                      for="email"
                    >
                      {{ block_label[forloop.index0] | escape }} <span class="required">*</span>
                    </label>
                    <input
                      id="email"
                      class="input is-{{ field_input_style }} is-{{ field_input_size }}"
                      type="email"
                      {% if settings.use_placeholders %}
                        placeholder="{{ block_label[forloop.index0] | escape }}*"
                      {% endif %}
                      name="contact[email]"
                      autocorrect="off"
                      autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      required="required"
                    >

                  {% elsif block_type[forloop.index0] == 'textarea' %}
                    <label
                      class="label{% if settings.use_placeholders %} is-sr-only{% endif %}"
                      for="textarea{{ suffix }}"
                    >
                      {{ block_label[forloop.index0] | escape }} {{ required_highlight }}
                    </label>
                    <textarea
                      id="textarea{{ suffix }}"
                      class="textarea is-{{ field_input_style }} is-{{ field_input_size }}"
                      {% if settings.use_placeholders %}
                        placeholder="{{ block_label[forloop.index0] | escape }}{% if my_checkbox0 %}*{% endif %}"
                      {% endif %}
                      name="contact[{{ block_label[forloop.index0] | escape }}{{ suffix }}]"
                      {% if my_checkbox0 %}
                        required="required"
                      {% endif %}>
                    </textarea>

                  {% elsif block_type[forloop.index0] == 'checkbox' %}
                    <label class="label">{{ block_label[forloop.index0] | escape }} {{ required_highlight }}</label>
                    <ul {% if my_checkbox0 %}data-is-required{% endif %}>
                      {% for index in (1..10) %}
                        {% capture option %}options_{{index}}{% endcapture %}
                        {% if block_option[forloop.index0]] != blank %}
                          <li>
                            <input
                              id="checkbox[option{{ index }}]-{{ suffix }}"
                              class="checkbox"
                              type="checkbox"
                              name="contact[{{ block_label[forloop.index0] | escape }} {{ index }} {{ suffix }}]"
                              value="{{ block_option[forloop.index0]] }}"
                            >
                            <label for="checkbox[option{{ index }}]-{{ suffix }}">{{ block_option[forloop.index0]] }}</label>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>

                  {% elsif block_type[forloop.index0] == 'radio' %}
                    <label class="label">{{ block_label[forloop.index0] | escape }} {{ required_highlight }}</label>
                    <ul>
                      {% for index in (1..10) %}
                        {% capture option %}options_{{index}}{% endcapture %}
                        {% if block_option[forloop.index0]] != blank %}
                          <li>
                            <input
                              id="radio[option{{ index }}]-{{ suffix }}"
                              class="radio"
                              type="radio"
                              name="contact[{{ block_label[forloop.index0] | escape }}{{ suffix }}]"
                              value="{{ block_option[forloop.index0]] }}"
                              {% if forloop.first %}
                                checked
                              {% endif %}
                            >
                            <label for="radio[option{{ index }}]-{{ suffix }}">{{ block_option[forloop.index0]] }}</label>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>

                  {% elsif block_type[forloop.index0] == 'dropdown' %}
                    <label
                      class="label{% if settings.use_placeholders %} is-sr-only{% endif %}"
                      for="select{{ suffix }}"
                    >
                      {{ block_label[forloop.index0] | escape }} {{ required_highlight }}
                    </label>
                    <span class="select is-wide is-{{ field_input_style }} is-{{ field_input_size }}">
                      <select
                        id="select{{ suffix }}"
                        name="contact[{{ block_label[forloop.index0] | escape }}{{ suffix }}]"
                        {% if my_checkbox0 %}
                          required="required"
                        {% endif %}
                      >
                        {% if settings.use_placeholders %}
                          <option value="" selected disabled>{{ block_label[forloop.index0] | escape }} {{ required_highlight }}</option>
                        {% endif %}
                        {% for index in (0..10) %}
                          {% capture option %}options_{{index}}{% endcapture %}
                          {% if forloop.index0 == 0 %}
                            {% if block_placeholder[forloop.index0] != blank %}
                              <option value="">{{ block_placeholder[forloop.index0] }}</option>
                            {% endif %}
                          {% else %}
                            {% if block_option[forloop.index0]] != blank %}
                              <option value="{{ block_option[forloop.index0]]}}">{{ block_option[forloop.index0]] }}</option>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </select>
                    </span>

                  {% elsif block_type[forloop.index0] == 'paragraph' %}
                    {{ block_text[forloop.index0] }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>

            <input type="hidden" name="challenge" value="false" />

            {%- assign submit_label = 'contact.form.send' | t -%}
            {%
              render 'button',
              label: submit_label,
              style: settings.form_button_style,
              class: 'is-within-form'
            %}
          {% endform %}
        </div>
      </div>

      {% elsif type == "block" %}
        <div class="one-half medium-down--one-whole column">
          <div class="contact-form__form">
            <div class="form__success-message"></div>
            <div class="one-whole column contact-form__form-errors">
              <p class="form__error"></p>
            </div>

            {% form 'contact', class: 'contact-form contact-form--contact-section' %}
              {% if form.posted_successfully? %}
                <div class="one-whole column">
                  <p class="quote has-margin-bottom">{{ 'contact.form.post_success' | t }}</p>
                </div>
              {% endif %}

              {% if form.errors %}
                <div class="one-whole column contact-form__form-errors">

                  <p class="quote">{{ 'general.forms.post_error' | t }}</p>

                    {% assign message = 'contact.form.message' | t %}
                    {% for field in form.errors %}
                      {% if field == 'form' %}
                        <p class="form__error">
                          {{ form.errors.messages[field] }}
                        </p>
                      {% else %}
                        <p class="form__error">
                          {% assign field_name = field | replace: 'body', message %}
                          {{ 'general.forms.post_field_error_html' | t: field: field_name, error: form.errors.messages[field] }}
                        </p>
                      {% endif %}
                    {% endfor %}
                </div>
              {% endif %}

              <div class="contact-form__blocks">
                <div class="container">

                  <!-- name field-->
                  <div class="one-whole column">
                    <div class="contact-form__block contact-form__block--{{ block_type[forloop.index0] }}" {{ block.shopify_attributes }}>
                      {% assign name_attr = 'contact.form.name' | handle %}
                      <label for="contactFormName" class="label {% if settings.use_placeholders %}is-sr-only{% endif %}">
                        {{ 'contact.form.name' | t }} <span class="required">*</span>
                      </label>
                      <input type="text" placeholder="{% if settings.use_placeholders %}{{ 'contact.form.name' | t }}*{% endif %}" name="contact[name_attr]" id="contactFormName" class="input is-{{ field_input_style }} is-{{ field_input_size }}" required="required" />
                    </div>
                  </div>

                  <!-- email field-->
                  <div class="one-whole column">
                    <div class="contact-form__block contact-form__block--{{ block_type[forloop.index0] }}" {{ block.shopify_attributes }}>
                      <label for="contactFormEmail" class="label {% if settings.use_placeholders %}is-sr-only{% endif %}">
                        {{ 'contact.form.email' | t }} <span class="required">*</span>
                      </label>
                      <input type="email" placeholder="{% if settings.use_placeholders %}{{ 'contact.form.email' | t }}*{% endif %}" id="contactFormEmail" class="input is-{{ field_input_style }} is-{{ field_input_size }}" name="contact[email]" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required="required">
                    </div>
                  </div>

                  <!-- textarea field -->
                  <div class="one-whole column">
                    <div class="contact-form__block contact-form__block--{{ block_type[forloop.index0] }}" {{ block.shopify_attributes }}>
                      <label for="contactFormMessage" class="label {% if settings.use_placeholders %}is-sr-only{% endif %}">
                        {{ 'contact.form.message' | t }} <span class="required">*</span>
                      </label>
                      <textarea placeholder="{% if settings.use_placeholders %}{{ 'contact.form.message' | t }}*{% endif %}" id="contactFormMessage" class="textarea is-{{ field_input_style }} is-{{ field_input_size }}" name="contact[body]" required="required"></textarea>
                    </div>
                  </div>

                </div>
              </div>
              <input type="hidden" name="challenge" value="false" />
              <div class="container">
                <div class="one-whole column">
                  {% assign submit_label = 'contact.form.send' | t %}
                  {%
                    render 'button',
                    label: submit_label,
                    style: settings.form_button_style,
                    class: 'is-within-form'
                  %}
                </div>
              </div>
            {% endform %}
          </div>
        </div>
    {% endif %}

  </div>
</section>

{% comment %}JavaScript{% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data
>
  {}
</script>
<script src="{{ 'z__jsCustomContactForm.js' | asset_url }}"></script>


</section>