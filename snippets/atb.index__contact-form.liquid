{% comment %}
ATB-SCHEMA{
  "name": "Contact",
  "class": "contact-section jsCustomContactForm",
  "max_blocks": 10,
  "id": "index__contact-form",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Content",
      "info": ""
    },
    {
      "type": "image_picker",
      "id": "atb_content_image",
      "label": "Image",
      "info": "1000 x 1000px recommended"
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Heading",
      "default": "Get in touch today",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_content_text",
      "label": "Text",
      "default": "<p>Customize your contact form to suit your business! Add custom fields like a dropdown menu, checkbox, text fields and more, so that you can gather pertinent info from shoppers right from the get-go, to help answer their inquiries more effectively.</p>",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_social_enable",
      "label": "Display social media icons",
      "default": true,
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": ""
    },
    {
      "type": "header",
      "content": "Contact form",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background",
      "label": "Background",
      "default": "#E5E5E5",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_text_color",
      "label": "Text",
      "default": "#000000",
      "info": "Does not apply to placeholders."
    },
    {
      "type": "select",
      "id": "atb_form_position",
      "label": "Form position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right",
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "default": 40,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 40,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "checkbox",
          "label": "checkbox"
        },
        {
          "value": "email",
          "label": "email"
        },
        {
          "value": "dropdown",
          "label": "dropdown"
        },
        {
          "value": "paragraph",
          "label": "paragraph"
        },
        {
          "value": "radio",
          "label": "radio"
        },
        {
          "value": "textarea",
          "label": "textarea"
        },
        {
          "value": "textfield",
          "label": "textfield"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "block_label",
      "label": "Title",
      "default": "Select all that apply",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,email,dropdown,radio,textarea,textfield"
    },
    {
      "type": "checkbox",
      "id": "block_required",
      "label": "Field is required",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio,textarea,textfield"
    },
    {
      "type": "text",
      "id": "block_options_1",
      "label": "Option 1",
      "default": "Option 1",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_2",
      "label": "Option 2",
      "default": "Option 2",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_3",
      "label": "Option 3",
      "default": "Option 3",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_4",
      "label": "Option 4",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_5",
      "label": "Option 5",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_6",
      "label": "Option 6",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_7",
      "label": "Option 7",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_8",
      "label": "Option 8",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_9",
      "label": "Option 9",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "text",
      "id": "block_options_10",
      "label": "Option 10",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:checkbox,dropdown,radio"
    },
    {
      "type": "wysiwyg",
      "id": "block_text",
      "label": "Text",
      "default": "<p>Use this field to display&nbsp;text of any kind, such as&nbsp;standard reply times for inquiries.</p>",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:paragraph"
    }
  ],
  "warnings": [
    "repeating checkbox fields may not be properly handled",
    "some fields may be named the same"
  ]
}ATB-SCHEMA
{% endcomment %}


