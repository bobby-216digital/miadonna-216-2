{%- style -%}
    .product-details-loader {
        position: absolute;
        width: 100%;
        height: auto;
        top: 50%;
        right: 0;
        opacity: 0.5;
        display: flex;
        z-index: 100;
        background: #fff;
        justify-content: center;
        transform: translateY(-50%);
        transform: none;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }
    .product-details-loader div {
        box-sizing: border-box;
        display: block;
        position: fixed;
        width: 44px;
        height: 44px;
        margin: 4px;
        border: 4px solid #7c7979;
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        animation: product-settings-loader 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
        border-color: #7c7979 transparent transparent transparent;
    }
    @media screen and (max-width: 575px) {
        .product-details-loader {
        padding-top: 0rem;
        }
    }
    .product-details-loader div:nth-child(1) {
        animation-delay: -0.45s;
    }
    .product-details-loader div:nth-child(2) {
        animation-delay: -0.3s;
    }
    .product-details-loader div:nth-child(3) {
        animation-delay: -0.15s;
    }
    @keyframes product-details-loader {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
    .product-details-loader#product-details-loader-el {
        align-items: center;
        background: #f8f8f894;
        left: 0%;
        opacity:1;
    }

    /* Price Skeleton - Start || 01-04-2026 & SHOP-2887 */
    .price-ui.show_setting_only {
        position: relative;
        display: inline-block;
        transition: opacity 0.2s ease;
    }

    /* Lock width to prevent layout shift */
    .price-ui.show_setting_only.is-loading {
        color: transparent;
    }

    /* Skeleton layer */
    .price-ui.show_setting_only.is-loading::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 4px;
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 37%, #f0f0f0 63%);
        background-size: 400% 100%;
        animation: shimmer 1.2s infinite;
    }

    /* Smooth fade-in */
    .price-ui.show_setting_only:not(.is-loading) {
        opacity: 1;
    }

    .price-ui.show_setting_only.is-loading {
        opacity: 0.7;
    }

    @keyframes shimmer {
        100% {
            background-position: -100% 0;
        }
    }
    /* END */
.pg-row-single {
    grid-column: 1 / -1;
    position: relative;
}
{%- endstyle -%}

