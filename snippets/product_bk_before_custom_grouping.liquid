            <div class="additional-accordion pdp-accordion-common{% if current_variant.metafields.custom.additional_stone_color == blank %} hide{% else %}{%- assign is_show_additional_stone = true -%}{%- endif -%}" id="additional_stone_color"><span class="accordion-data-label">Diamond Color Grade:</span><span class="accordion-data-value">{{ current_variant.metafields.custom.additional_stone_color.value }}</span></div>
            <div class="additional-accordion pdp-accordion-common{% if current_variant.metafields.custom.additional_stone_clarity == blank %} hide{% else %}{%- assign is_show_additional_stone = true -%}{%- endif %}" id="additional_stone_clarity"><span class="accordion-data-label">Diamond Clarity Grade:</span><span class="accordion-data-value">{{ current_variant.metafields.custom.additional_stone_clarity.value }}</span></div>
            {%- comment -%}<div class="additional-accordion pdp-accordion-common{% if current_variant.metafields.specs.additional_stone_avg_wt == blank %} hide{% else %}{%- assign is_show_additional_stone = true -%}{%- endif %}" id="additional_stone_avg_wt"><span class="accordion-data-label">Avg. Carat Weight:</span><span class="accordion-data-value">{{ current_variant.metafields.specs.additional_stone_avg_wt }}</span></div>{%- endcomment -%}
            <div class="additional-accordion pdp-accordion-common{% if current_variant.metafields.specs.additional_stone_count == blank %} hide{% else %}{%- assign is_show_additional_stone = true -%}{%- endif %}" id="additional_stone_count"><span class="accordion-data-label">Count:</span><span class="accordion-data-value">{{ current_variant.metafields.specs.additional_stone_count.value }}</span></div>
            {%- comment -%}<div class="primary-accordion pdp-accordion-common{% if current_variant.metafields.specs.additional_stone_count == blank or current_variant.metafields.specs.additional_stone_avg_wt == blank %} hide{% else %}{%- assign additional_total_carat_wt = true -%}{% endif %}" id="additional_stone_total_ctw"><span class="accordion-data-label">Total Carat Weight:</span><span class="accordion-data-value">{% if additional_total_carat_wt %}{{ current_variant.metafields.specs.additional_stone_count.value | times:current_variant.metafields.specs.additional_stone_avg_wt }}{% endif %}</span></div>{%- endcomment -%}
            <div class="primary-accordion pdp-accordion-common{% if additional_total_carat_wt == '' or additional_total_carat_wt == 0 %} hide{% else %}{%- assign display_additional_total_carat_wt = true -%}{% endif %}" id="additional_stone_total_ctw"><span class="accordion-data-label">Total Carat Weight:</span><span class="accordion-data-value">{% if display_additional_total_carat_wt %}{{ additional_total_carat_wt }}{% endif %}</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
     {%- if is_show_primary_stone -%}
      document.getElementById('primary_stone_table_accordion').classList.remove('hide');
    {%- endif -%}
    {%- if is_show_additional_stone -%}
      document.getElementById('additional_stone_table_accordion').classList.remove('hide');
    {%- endif -%}
    const links = document.querySelectorAll('.product-link');

    links.forEach(link => {
      link.addEventListener('click', function(event) {
        event.preventDefault();
        const targetId = this.getAttribute('href');

        if (targetId.includes('#')) {
          const targetElement = document.querySelector(targetId);
          if (targetElement) {
            const headerHeight = 80; // Adjust this to your fixed header's height
            const offset = targetElement.offsetTop - headerHeight;
            window.scrollTo({ top: offset, behavior: 'smooth' });
          }
        } else {
          window.location.href = targetId;
        }
      });
    });
  });


document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.is-video').forEach(function(videoWrapper) {
        const video = videoWrapper.querySelector('.video');
        const pauseBtn = videoWrapper.querySelector('.icon.icon-pause');
        const playBtn = videoWrapper.querySelector('.icon.icon-play');

        

        pauseBtn.addEventListener('click', function(e) {
            e.stopPropagation();

            video.pause();

            pauseBtn.style.display = 'none';
            playBtn.style.display = 'block';
        });

        playBtn.addEventListener('click', function(e) {
          
            e.stopPropagation();

            video.play();

            playBtn.style.display = 'none';
            pauseBtn.style.display = 'block';
        });

    });

});


  document.querySelectorAll('.popup-icon').forEach(function(icon) {
  icon.addEventListener('click', function() {
    Fancybox.show(
      [{
        src: this.dataset.popup,
        type: "inline"
      }],
      {
        dragToClose: false,
        Carousel: {
          friction: 0,
          Panzoom: {
            touch: false
          }
        }
      }
    );
  });
});
function fancyboxPopup(id, value=''){
   Fancybox.show(
  [{
    src: id,
    type: "inline"
  }],
  {
    dragToClose: false,

    Carousel: {
      friction: 0,
      Panzoom: {
        touch: false
      }
    }
  }
);
}
function fancyboxPopupClose(id){
 var ids =  document.querySelector(id);
      Fancybox.close(ids);

}
document.querySelectorAll('.quality--heading button').forEach(function(button) {

    button.addEventListener('click', function() {

        let data_id = this.getAttribute('data-id');

        // Hide all popups
        document.querySelectorAll('.quality--popup').forEach(function(popup) {
            popup.style.display = 'none';
        });

        // Remove active class from all buttons
        document.querySelectorAll('.quality--heading button').forEach(function(btn) {
            btn.classList.remove('active');
        });

        // Show selected popup
        let activePopup = document.querySelector('.qpop--' + data_id);

        if (activePopup) {
            activePopup.style.display = 'block';
        }

        // Add active class to clicked button
        this.classList.add('active');

    });

});
$(function () {

    window.mobileSlider = function(slideIndex='') {

        if (window.matchMedia("(max-width: 767px)").matches) {

            if (!$('.my-slider').hasClass('slick-initialized')) {

                $('.my-slider').slick({
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    dots: false,
                    arrows: true,
                    infinite: false,

                    prevArrow: `
                        <button class="scroll-arrow scroll-arrow-left" aria-label="Scroll Left">
                            <svg width="24" height="21" viewBox="0 0 24 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1.09149 11.0341L9.85809 19.8008C10.157 20.0996 10.7049 20.0996 11.0038 19.8008C11.3027 19.5019 11.3027 18.954 11.0038 18.6551L3.582 11.2333H22.3606C22.8089 11.2333 23.1576 10.8846 23.1576 10.4363C23.1576 10.0379 22.8089 9.63936 22.3606 9.63936H3.582L11.0038 2.26738C11.3027 1.96851 11.3027 1.42059 11.0038 1.12173C10.7049 0.822867 10.157 0.822867 9.85809 1.12173L1.09149 9.88842C0.792594 10.1873 0.792594 10.7352 1.09149 11.0341Z"></path>
                            </svg>
                        </button>`,

                    nextArrow: `
                        <button class="scroll-arrow scroll-arrow-right" aria-label="Scroll Right">
                            <svg width="24" height="21" viewBox="0 0 24 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.9085 11.0341L14.1419 19.8008C13.843 20.0996 13.2951 20.0996 12.9962 19.8008C12.6973 19.5019 12.6973 18.954 12.9962 18.6551L20.418 11.2333H1.63937C1.19108 11.2333 0.842401 10.8846 0.842401 10.4363C0.842401 10.0379 1.19108 9.63937 1.63937 9.63937H20.418L12.9962 2.26739C12.6973 1.96852 12.6973 1.4206 12.9962 1.12174C13.2951 0.822876 13.843 0.822876 14.1419 1.12174L22.9085 9.88843C23.2074 10.1873 23.2074 10.7352 22.9085 11.0341Z"></path>
                            </svg>
                        </button>`
                });

            }
            else if(slideIndex != ''){
              $('.my-slider').slick('slickRemove', slideIndex);
            }

        } else {

            if ($('.my-slider').hasClass('slick-initialized')) {
                $('.my-slider').slick('unslick');
            }

        }
    }

    mobileSlider();

    $(window).on('resize', function () {
        mobileSlider();
    });

});

window.updateMetafields = function(styleData, primaryStoneData, additionalStoneData, productMetaObj = {}) {
  const styleDetailEl = document.getElementById('style_details_table_accordion');
  const primaryStoneEl = document.getElementById('primary_stone_table_accordion');
  const additionalStoneEl = document.getElementById('additional_stone_table_accordion');

  if(productMetaObj['style_meta']){
    var isHideStyleAccordion = true;
    const style_meta = productMetaObj['style_meta'];
    Object.keys(style_meta).forEach(function(style) {
      const styleMetaValue = style_meta[style];
      const styleMetaElement = document.querySelector('#' + style);

      if (!styleMetaElement) return;

      const styleMetaSpan = styleMetaElement.querySelector('span.accordion-data-value');

      if (styleMetaValue && styleMetaValue.toString().trim() !== '') {
        styleMetaElement.classList.remove('hide');
        if (styleMetaSpan) {
          isHideStyleAccordion = false;
          styleMetaSpan.textContent = styleMetaValue;
        }
      } else {
        styleMetaElement.classList.add('hide');
        if (styleMetaSpan) {
          styleMetaSpan.textContent = '';
        }
      }
    });
    if(isHideStyleAccordion){
      styleDetailEl.classList.add('hide');
    }
    else{
      styleDetailEl.classList.remove('hide');
    }
  }

  if(productMetaObj['primary_meta']){
    var isHidePrimaryStoneAccordion = true;
    const primary_meta = productMetaObj['primary_meta'];
    Object.keys(primary_meta).forEach(function(primary) {
      const primaryMetaValue = primary_meta[primary];
      const primaryMetaElement = document.querySelector('#' + primary);

      if (!primaryMetaElement) return;

      const primaryMetaSpan = primaryMetaElement.querySelector('span.accordion-data-value');

      if (primaryMetaValue && primaryMetaValue.toString().trim() !== '') {
        primaryMetaElement.classList.remove('hide');
        if (primaryMetaSpan) {
          isHidePrimaryStoneAccordion = false;
          primaryMetaSpan.textContent = primaryMetaValue;
        }
      } else {
        primaryMetaElement.classList.add('hide');
        if (primaryMetaSpan) {
          primaryMetaSpan.textContent = '';
        }
      }
    });
    if(isHidePrimaryStoneAccordion){
      {%- comment %}{%- assign is_check_hide_primary_stone = true -%}{%- endcomment %}
      primaryStoneEl.classList.add('hide');
    }
    else{
      {%- comment %}{%- assign is_check_hide_primary_stone = false -%}{%- endcomment %}
      primaryStoneEl.classList.remove('hide');
    }
  }

  if(productMetaObj['additional_meta']){
    var isHideAdditionalStoneAccordion = true;
    const additional_meta = productMetaObj['additional_meta'];
    Object.keys(additional_meta).forEach(function(additional) {
      const additionalMetaValue = additional_meta[additional];
      const additionalMetaElement = document.querySelector('#' + additional);

      if (!additionalMetaElement) return;

      const additionalMetaSpan = additionalMetaElement.querySelector('span.accordion-data-value');

      if (additionalMetaValue && additionalMetaValue.toString().trim() !== '') {
        additionalMetaElement.classList.remove('hide');
        if (additionalMetaSpan) {
          isHideAdditionalStoneAccordion = false;
          additionalMetaSpan.textContent = additionalMetaValue;
        }
      } else {
        additionalMetaElement.classList.add('hide');
        if (additionalMetaSpan) {
          additionalMetaSpan.textContent = '';
        }
      }
    });
    if(isHideAdditionalStoneAccordion){
      {%- comment %}{%- assign is_check_hide_additional_stone = true -%}{%- endcomment %}
      additionalStoneEl.classList.add('hide');
    }
    else{
      {%- comment %}{%- assign is_check_hide_additional_stone = false -%}{%- endcomment %}
      additionalStoneEl.classList.remove('hide');
    }
  }

  if(productMetaObj['style_meta']){
    const style_meta = productMetaObj['style_meta'];
    Object.keys(style_meta).forEach(function(style) {
      const styleMetaValue = style_meta[style];
      const styleMetaElement = document.querySelector('#' + style);

      if (!styleMetaElement) return;

      const styleMetaSpan = styleMetaElement.querySelector('span.accordion-data-value');

      if (styleMetaValue && styleMetaValue.toString().trim() !== '') {
        styleMetaElement.classList.remove('hide');
        if (styleMetaSpan) {
          styleMetaSpan.textContent = styleMetaValue;
        }
      } else {
        styleMetaElement.classList.add('hide');
        if (styleMetaSpan) {
          styleMetaSpan.textContent = '';
        }
      }
    });
  }

  

  let isHidePrimaryAccordion = true,
      isHideAdditionalAccordion = true;

  Object.keys(styleData).forEach(function(style) {
    const value = styleData[style];
    const element = document.querySelector('#' + style);

    if (!element) return;

    const span = element.querySelector('span.accordion-data-value');

    if (value && value.toString().trim() !== '') {
      element.classList.remove('hide');
      if (span) {
        span.textContent = value;
      }
    } else {
      element.classList.add('hide');
      if (span) {
        span.textContent = '';
      }
    }
  });

  Object.keys(primaryStoneData).forEach(function(primary) {
    const primaryValue = primaryStoneData[primary];
    const primaryElement = document.querySelector('#' + primary);

    if (!primaryElement) return;

    const primarySpan = primaryElement.querySelector('span.accordion-data-value');

    if (primaryValue && primaryValue.toString().trim() !== '') {
      primaryElement.classList.remove('hide');
      if (primarySpan) {
        isHidePrimaryAccordion = false;
        primarySpan.textContent = primaryValue;
      }
    } else {
      primaryElement.classList.add('hide');
      if (primarySpan) {
        primarySpan.textContent = '';
      }
    }
  });

  {%- if is_check_hide_primary_stone -%}
    if(isHidePrimaryAccordion){
      primaryStoneEl.classList.add('hide');
    }
    else{
      primaryStoneEl.classList.remove('hide');
    }
  {%- endif -%}

  Object.keys(additionalStoneData).forEach(function(additional) {
    const additionalValue = additionalStoneData[additional];
    const additionalElement = document.querySelector('#' + additional);

    if (!additionalElement) return;

    const additionalSpan = additionalElement.querySelector('span.accordion-data-value');

    if (additionalValue && additionalValue.toString().trim() !== '') {
      additionalElement.classList.remove('hide');
      if (additionalSpan) {
        isHideAdditionalAccordion = false;
        additionalSpan.textContent = additionalValue;
      }
    } else {
      additionalElement.classList.add('hide');
      if (additionalSpan) {
        additionalSpan.textContent = '';
      }
    }
  });

  {%- if is_check_hide_additional_stone -%}
    if(isHideAdditionalAccordion){
      additionalStoneEl.classList.add('hide');
    }
    else{
      additionalStoneEl.classList.remove('hide');
    }
  {%- endif -%}
};

</script>
