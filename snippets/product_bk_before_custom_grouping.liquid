    {%- endif -%}
    {%- if tagDn contains 'clarity_' -%}
      {%- assign clarityVal = ' ' | append: tag | remove:'clarity_' | remove:'Clarity_' | replace:'_', ' ' -%}
    {%- endif -%}
  {%- endfor -%}
{% endif %}
