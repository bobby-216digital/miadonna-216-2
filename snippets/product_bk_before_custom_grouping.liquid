                online or with a MiaDonna jewelry specialist and our master jewelers will create it for you in 10 to 15
                business days. Our jewelry is created in recycled 14k, 18k and Platinum solid precious metals and we use a
                higher gram weight of metal. Most other jewelry companies prestock their jewelry, limited sizes and lower
                gram weights.
              {% endcomment %}
            </div>
          </setting-tabs>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div
    class="
      product__information
      has-product-sticker
      two-fifths
      column
      large-down--one-whole
    "
  >
    <div class="info-panel">
      <div class="sku-review">
        <div class="block--sku">
            <div class="order-ship-date">
                <p class="order-ship-text">SKU:</p>
                <p class="order-ship-date order-ship-sku">
                    {{ product.selected_or_first_available_variant.sku }}
                </p>
            </div>          
        </div>
        <div class="star-wish">
          {% render 'okendo-custom-star-rating', product: product %}
          <div class="header__icon" data-icon="heart"> 
            <span>|</span> 
            <mage-wishlist-heart product-id="{{ product.id }}"></mage-wishlist-heart>
          </div>
        </div>
      </div>
      {% comment %} Sale sticker {% endcomment %}
      {% if stickers_enabled %}
        {% assign collection_handles = product.collections | map: 'handle' %}
        {% render 'product-thumbnail__sticker',
          product: product,
          context: 'product',
          collection_handles: collection_handles
        %}
      {% endif %}

      {%- for block in section.blocks -%}
        {% unless block.type == 'media-buttons' or block.type == 'tgd' or block.type == 'additional-product-tabs' %}
          <div
            class="
              product-block product-block--{{ block.type | downcase | replace: '_', '-' | replace: '@', '-' }}
              {% if forloop.first == true %}
                product-block--first
              {% endif %}
            "
            {{ block.shopify_attributes }}
          >
        {% endunless %}
        {%- if block.type == 'vendor' -%}
          {% comment %} Vendor {% endcomment %}
          <p class="vendor">
            <span class="vendor">
              {% if section_onboarding %}
                Vendor name
              {% else %}
                {{ product.vendor | link_to_vendor }}
              {% endif %}
            </span>
          </p>

        {%- elsif block.type == 'sku' -%}
          {% comment %} Sku {% endcomment %}
          <p class="sku">
            {% if section_onboarding %}
              1234567890
            {% else %}
              {{ selected_variant.sku }}
            {% endif %}
          </p>

        {%- elsif block.type == 'title' -%}
          {% comment %} Name {% endcomment %}
          <h1 class="product_name title">
            {% if is_product_modal %}
              <a href="{{ product.url  }}">{{ product.title }}</a>
            {% elsif section_onboarding %}
              {{ 'homepage.onboarding.product_title' | t }}
            {% else %}
              {{ product.title }}
            {% endif %}
          </h1>
          {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
          {%- assign pageUrl = contentForQuerystring
              | split: '"pageurl":"'
              | last
              | split: '"'
              | first
              | split: '.myshopify.com'
              | last
              | replace: '\/', '/'
              | replace: '%20', ' '
              | replace: '\u0026', '&'
          -%}
          {%- assign pageUrlArr = pageUrl | split:'?' | last | split:'&' -%}
          {% assign stone_specs_detail = '' %}
          {% for variant in product.variants -%}
            {%- assign variant_value1 = variant.options | first | downcase -%}
            {%- assign variant_value2 = variant.options | last | downcase -%}
            {%- for parameter in pageUrlArr -%}
              {% assign parameter_dn = parameter | downcase %}
              {%- if parameter_dn contains variant_value1 -%}
                {% assign option1_match = parameter | split:'=' | last %}
              {% endif %}
              {%- if parameter_dn contains variant_value2 -%}
                {% assign option2_match = parameter | split:'=' | last %}
              {% endif %}
            {% endfor %}
            {% if option1_match and option2_match %}
              {%- capture stone_specs_detail -%}
                {%- if variant.metafields.specs.primary_stone_color != blank -%}
                  {{ variant.metafields.specs.primary_stone_color }} &#8226;&nbsp;
                {%- endif -%}
                {%- if variant.metafields.specs.primary_stone_clarity != blank -%}
                  {{ variant.metafields.specs.primary_stone_clarity }} &#8226;&nbsp;
                {%- endif -%}
                {%- if variant.metafields.specs.primary_stone_certification != blank -%}
                  {{ variant.metafields.specs.primary_stone_certification }} &#8226;&nbsp;
                {%- endif -%}
              {%- endcapture -%}
              {%- assign stone_specs_detail = stone_specs_detail | remove_last:'&#8226;&nbsp;' -%}
              {%- assign stone_specs_detail = stone_specs_detail | strip -%}
            {% break %}
            {% endif %}
          {%- endfor %}
          <span id="stone-specs-detail" class="stone-specs-detail{% if stone_specs_detail == '' %} hide{% endif %}">{{ stone_specs_detail }}</span>
          {% assign is_show_setting_only = 'yes' %}
          {%- for tag in product.tags -%}
            {% if tag == 'Is Not Setting Only' %}
              {% assign is_show_setting_only = 'no' %}
            {% endif %}
          {% endfor %}
          <div class="product_form price-affirm">
            <div class="modal_price subtitle" data-display-savings="true">
              <div class="price-ui{% if is_show_setting_only == 'yes' and product.metafields.attributes.customizable == "1" %} show_setting_only{% endif %}" id="price-ui-section">
                {% assign is_compare_at_price_and_sale = 'none' %}
                {% if product.selected_or_first_available_variant.compare_at_price and product.selected_or_first_available_variant.compare_at_price != product.selected_or_first_available_variant.price %}
                  {% assign is_compare_at_price_and_sale = '' %}
                {% endif %}

                <span class="compare-at-price" data-compare-at-price="" style="display: {{ is_compare_at_price_and_sale }}">
                  {{- cart.currency.symbol }}
                  <span class="money final_compare_at_price" data-final-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}" data-price="">
                    {{ product.selected_or_first_available_variant.compare_at_price | divided_by: 100.0 -}}
                  </span>
                </span>
                <span
                  class="price {% if product.selected_or_first_available_variant.compare_at_price and product.selected_or_first_available_variant.compare_at_price != product.selected_or_first_available_variant.price %}price--sale{% endif %}"
                  data-price=""
                >
                  {{- cart.currency.symbol }}
                  <span
                    class="money final_price"
                    data-final-price="{{ product.selected_or_first_available_variant.price }}"
                  >
                    {{- product.selected_or_first_available_variant.price | divided_by: 100.0 | split:',' | first -}}
                    {{ cart.currency.iso_code }}
                  </span>
                </span>
                {% if is_show_setting_only == 'yes' and product.metafields.attributes.customizable == '1' %}
                  <span class="center_text">(Setting Only)</span>
                {% endif %}
                <span class="sale-badge-wrapper" style="display: {{ is_compare_at_price_and_sale }}">
                  <span class="sale-badge">Sale</span>
                </span>
              </div>
            </div>
            <div class="affirm-rate"><font>|</font> <p class="affirm-as-low-as" data-page-type="product" data-amount="{{product.selected_or_first_available_variant.price}}"></p></div>
          </div>
          {%- comment -%}{% render 'okendo-custom-star-rating', product: product %}{%- endcomment -%}
        {%- elsif block.type == 'size-chart' -%}
          {% comment %} Size chart {% endcomment %}
          {% for tag in product.tags %}
            {% if tag contains 'meta-size-chart-' %}
              {% assign meta_size_chart = true %}
            {% endif %}
          {% endfor %}

          {% if settings.size_chart != blank or block.settings.size_chart != blank or meta_size_chart %}
            <a
              class="product__size-chart"
              href="javascript:;"
              data-fancybox
              data-src="#size-chart{{ product.id  }}"
              data-type="inline"
            >
              {{ block.settings.title | escape }}
            </a>
            {% render 'popup-size-chart', block: block, product_id: product.id %}
          {% endif %}

        {%- elsif block.type == 'price' -%}
          {% comment %} Price {% endcomment %}
          <div class="modal_price subtitle" data-display-savings="{{ block.settings.display_savings }}">
            {% if section_onboarding %}
              <span class="money">$49.00</span>
            {% else %}
              {% comment %}Inject @pixelunion/shopify-price-ui/price-ui begin{% endcomment %}
              <div class="price-ui price-ui--loading" data-price-ui>
                <noscript>
                  <style>
                    .price-ui--loading {
                      display: block !important;
                      opacity: 1 !important;
                    }
                  </style>
                </noscript>
                {% assign compare_at_price = false %}

                {% if product.compare_at_price and product.compare_at_price != product.price %}
                  {% if product.compare_at_price_varies %}
                    {%- capture price_min -%}
                        {%-
                          render 'price-ui-templates',
                          template: 'price-min',
                          value: product.compare_at_price_min,
                        -%}
                      {%- endcapture -%}

                    {%- capture price_max -%}
                        {%-
                          render 'price-ui-templates',
                          template: 'price-max',
                          value: product.compare_at_price_max,
                        -%}
                      {%- endcapture -%}

                    {%- assign compare_at_price = 'product.price.range_html'
                      | t: price_min: price_min, price_max: price_max
                    -%}
                  {% else %}
                    {%- capture compare_at_price -%}
                        {%-
                          render 'price-ui-templates',
                          template: 'price',
                          value: product.compare_at_price,
                        -%}
                      {%- endcapture -%}
                  {% endif %}
                {% endif %}

                {% if product.price_varies %}
                  {%- capture price_min -%}
                      {%-
                        render 'price-ui-templates',
                        template: 'price-min',
                        value: product.price_min,
                      -%}
                    {%- endcapture -%}

                  {%- capture price_max -%}
                      {%-
                        render 'price-ui-templates',
                        template: 'price-max',
                        value: product.price_max,
                      -%}
                    {%- endcapture -%}

                  {%- assign price = 'product.price.range_html' | t: price_min: price_min, price_max: price_max -%}
                {% else %}
                  {%- capture price -%}
                      {%-
                        render 'price-ui-templates',
                        template: 'price',
                        value: product.price,
                      -%}
                    {%- endcapture -%}
                {% endif %}

                {%- render 'price-ui-templates',
                  template: 'price-ui',
                  compare_at_price: compare_at_price,
                  price: price,
                  unit_pricing: false
                -%}
              </div>
              {% comment %}Inject @pixelunion/shopify-price-ui/price-ui end{% endcomment %}
            {% endif %}
          </div>

        {%- elsif block.type == 'complementary_products' -%}
          {% comment %} Complementary products {% endcomment %}
          {% render 'complementary-products', product: product, block: block %}

        {%- elsif block.type == 'description' -%}
          {% comment %} Description {% endcomment %}
          {% if block.settings.custom_description != blank %}
            <div class="description content has-padding-top">
              {{ block.settings.custom_description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
            </div>
          {% elsif section_onboarding %}
            <div class="description content has-padding-top">
              <p>
                {{ 'homepage.onboarding.product_description' | t }}
              </p>
            </div>
          {% else %}
            {% if product.description != blank %}
              <div
                class="
                  description
                  description-content
                  content
                  has-padding-bottom
                "
              >
                {% if is_product_modal %}
                  {% if block.settings.truncate_words %}
                    {{
                      product.description
                      | strip_html
                      | truncatewords: block.settings.truncate_words_limit
                      | replace: 'Description', ''
                      | replace: 'Dimensions', ''
                      | replace: 'Details', ''
                      | replace: 'Specs', ''
                      | replace: 'Shipping', ''
                      | replace: 'Size', ''
                      | escape
                      | split: '<!-- split -->'
                      | first | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
                    }}
                  {% else %}
                    {{
                      product.description
                      | strip_html
                      | replace: 'Description', ''
                      | replace: 'Dimensions', ''
                      | replace: 'Details', ''
                      | replace: 'Specs', ''
                      | replace: 'Shipping', ''
                      | replace: 'Size', ''
                      | escape
                      | split: '<!-- split -->'
                      | first | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
                    }}
                  {% endif %}
                {% else %}
                  {%- assign product_description = product.description -%}
                  {%- assign paragraphs = product_description | split: '</p>' -%}
                  {%- assign description_size = paragraphs.size -%}
                  {%- assign first_paragraph = '' -%}

                  {%- for paragraph in paragraphs -%}
                    {%- if paragraph contains '<p>' -%}
                      {%- assign p_start = paragraph | split: '<p>' | last -%}
                      {%- assign p_content = p_start | split: '|' | first -%}
                      {%- assign first_paragraph = p_content | strip -%}
                      {% break %}
                    {%- endif -%}
                  {%- endfor -%}
                  <div class="metal-properties">
                    {{
                      first_paragraph
                      | replace: '<br>', ''
                      | append: '<a href="#product-tgd-wrapper-desktop" style="font-weight:600;text-decoration:underline;margin-left:.5rem;">More Details</a>'
                    }}
                  </div>
                {% endif %}
                <!-- <a href="" style="font-weight:600;text-decoration:underline;">More Details</a> -->
              </div>
            {% endif %}
          {% endif %}

          {% if is_product_modal %}
            <a
              class="product__view-details"
              href="{{ product.url | within: collection  }}"
              title="{{ product.title | escape }}"
            >
              {{- 'collections.general.view_product_details' | t -}}
            </a>
          {% endif %}

        {%- elsif block.type == 'form' -%}
          {% comment %} Purchase form {% endcomment %}
          {% if section_onboarding %}
            <div class="product-form-container">
              <div class="purchase-details">
                <div class="purchase-details__buttons purchase-details__spb--false">
                  <button
                    name="add"
                    class="action_button button button--add-to-cart add_to_cart"
                    data-label="{{ add_to_cart_label | json }}"
                  >
                    <span class="text">{{ 'products.product.add_to_cart' | t }}</span>
                  </button>
                </div>
              </div>
            </div>
          {% else %}
            <div class="product-form-container">
              {% comment %} Notify form {% endcomment %}
              {% render 'product__notify-me-form', product: product %}

              {% comment %} Product form {% endcomment %}
              {% unless collection_handles contains 'coming-soon' %}
                {% render 'product__form',
                  context: 'product',
                  product: product,
                  sold_out_options: sold_out_options,
                  selected_variant: selected_variant,
                  show_payment_button: block.settings.show_payment_button,
                  collection_handles: collection_handles
                %}
              {% endunless %}
            </div>
          {% endif %}

        {%- elsif block.type == 'product-links' -%}
          {% comment %} Collections, type, tags {% endcomment %}
          {% if block.settings.show_collections or block.settings.show_tags or block.settings.show_type %}
            <div class="product__classification-links has-padding-top">
              {% if block.settings.show_collections %}
                <p class="product__collections-list tags">
                  <span class="product__classification-title">{{ 'products.product.collections' | t }}:</span>
                  {% for col in product.collections %}
                    <span class="tag tag--{{ tag_style }}">
                      <a href="{{ col.url  }}" title="{{ col.title }}">{{ col.title }}</a>
                    </span>
                  {% endfor %}
                </p>
              {% endif %}

              {% if block.settings.show_type %}
                <p class="product__type-list tags">
                  <span class="product__classification-title">{{ 'products.product.product_types' | t }}:</span>
                  <span class="tag tag--{{ tag_style }}">{{ product.type | link_to_type }}</span>
                </p>
              {% endif %}

              {% if block.settings.show_tags and product.tags.size > 0 %}
                <p class="product__tags-list tags">
                  <span class="product__classification-title">{{ 'products.product.tags' | t }}:</span>
                  {% for tag in product.tags %}
                    {% unless tag contains 'meta-' %}
                      <span class="tag tag--{{ tag_style }}">
                        <a
                          href="{{ routes.collections_url  }}/{% if collection %}{{ collection.handle  }}{% else %}all{% endif %}/{{ tag | handle  }}"
                          title="{{ 'products.product.products_tagged' | t: tag: tag }}"
                        >
                          {{- tag -}}
                        </a>
                      </span>
                    {% endunless %}
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          {% endif %}

        {%- elsif block.type == 'rating' -%}
          {% if product.metafields.reviews.rating.value != blank %}
            <div class="product__rating rating">
              {% render 'rating-stars',
                value: product.metafields.reviews.rating.value.rating,
                scale_max: product.metafields.reviews.rating.value.scale_max
              %}

              <p class="rating__text">
                <span aria-hidden="true">
                  {{ product.metafields.reviews.rating.value }} /
                  {{ product.metafields.reviews.rating.value.scale_max }}
                </span>
              </p>

              <p class="rating__count">
                <span aria-hidden="true">
                  {{ product.metafields.reviews.rating_count }}
                  {% if product.metafields.reviews.rating_count > 1 %}
                    {{ 'general.accessibility.star_reviews_text' | t }}
                  {% else %}
                    {{ 'general.accessibility.star_review_text' | t }}
                  {% endif %}
                </span>
              </p>
            </div>
          {% endif %}

        {%- elsif block.type == 'share' -%}
          {% comment %} Social share icons {% endcomment %}
          <div class="product__social-share has-padding-top">
            {% render 'social-share-buttons' %}
          </div>

        {%- elsif block.type == 'text' -%}
          {% comment %} Text {% endcomment %}
          <div class="product-text">
            {{ block.settings.text }}
          </div>
        {%- elsif block.type == 'setting-tabs' -%}
          {% if product.metafields.custom.bundles != blank and product.metafields.custom.bundles.value.count > 0 %}
            {% render 'bundle-setting-tabs', pageUrl:pageUrl, pageUrlArr:pageUrlArr %}
          {% else %}
            {% render 'setting-tabs', pageUrl:pageUrl, pageUrlArr:pageUrlArr %}
          {% endif %}
        {% elsif block.type == 'additional-links' %}
          <div class="product-links-wrapper">
            <ul class="product-links">
              <li class="product-link-item">
                <a class="product-link" href="javascript:void(0);" onClick="shippingPopup()">
                  <div class="icon-wrapper">
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ 'flying-heart.png' | asset_url }}"
                      width="60"
                      height="60"
                      loading="eager"
                      alt="FREE SHIPPING RESIZING*"
                    >
                  </div>
                  FREE SHIPPING & RESIZING*
                </a>
              </li>
              <li class="product-link-item">
                <a class="product-link" href="javascript:void(0);" onclick="productHintPopup()">
                  <div class="icon-wrapper">
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ 'share.png' | asset_url }}"
                      width="60"
                      height="60"
                      loading="eager"
                      alt="Share"
                    >
                  </div>
                  Share
                </a>
              </li>
              <li class="product-link-item">
                <a class="product-link" href="javascript:void(0);" onclick="productReturnPopup()">
                  <div class="icon-wrapper">
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ 'returns.png' | asset_url }}"
                      width="60"
                      height="60"
                      loading="eager"
                      alt="Return"
                    >
                  </div>
                  Easy 60-Day Returns
                </a>
              </li>
              <li class="product-link-item">
                <a class="product-link" href="#faq-section">
                  <div class="icon-wrapper">
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ 'question-mark.png' | asset_url }}"
                      width="60"
                      height="60"
                      loading="eager"
                      alt="Question"
                    >
                  </div>
                  Faq
                </a>
              </li>
              <li class="product-link-item">
                <a class="product-link product-tgd-wrapper" href="javascript:void(0);" onclick="productPaymentPopup()">
                  <div class="icon-wrapper">
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ 'Hand.png' | asset_url }}"
                      width="60"
                      height="60"
                      loading="eager"
                      alt="Hand"
                    >
                  </div>
                  Flexible Payment Options
                </a>
              </li>
              <li class="product-link-item">
                <a class="product-link" href="javascript:void(0);" onclick="productHelpPopup()">
                  <div class="icon-wrapper">
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ 'chat-bubble-icon.png' | asset_url }}"
                      width="60"
                      height="60"
                      loading="eager"
                      alt="Chat"
                    >
                  </div>
                  Need advice?
                </a>
              </li>
            </ul>
          </div>
        {% elsif block.type == 'promotion-banner' %}
          <div class="image--container">
            {% if block.settings.url != blank %}
              <a class="image--link" href="{{ block.settings.url  }}">
            {% else %}
              <div class="image--link">
            {% endif %}
            {% if block.settings.image != blank %}
              <div class="image-wrapper">
                <img
                  src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | img_url: 'master' }}"
                  width="100%"
                  height="100%"
                  loading="eager"
                  alt="{{ block.settings.title }}"
                >
              </div>
            {% endif %}
            <div class="content">
              {% if block.settings.title != blank %}
                <h6>{{ block.settings.title }}</h6>
              {% endif %}
              {% if block.settings.content != blank %}
                {{ block.settings.content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
              {% endif %}
            </div>
            {% if block.settings.url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% elsif block.type == '@app' %}
          <div class="product-app cell-style-blacktext">
            {% render block %}
          </div>
        {%- endif -%}
        {% unless block.type == 'media-buttons' or block.type == 'tgd' or block.type == 'additional-product-tabs' %}
          </div>
        {% endunless %}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tgd' -%}
          <div id="product-tgd-wrapper-mobile" class="product-tgd-wrapper product-tgd-wrapper-mobile">
            <div class="product-tgd mobile-tgd-slider has-no-side-gutter">
              <div class="one-third column medium-down--one-whole">
                <img
                  src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image1 | img_url: 'master' }}"
                  width="100%"
                  height="100%"
                  loading="eager"
                  alt="{{ block.settings.title1 }}"
                >
                <div class="content">
                  <h6>{{ block.settings.title1 }}</h6>
                  {{ block.settings.content1 | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                </div>
              </div>
