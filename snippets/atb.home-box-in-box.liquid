{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image_position' -%}
{%- assign block_image_position = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_image_alt' -%}
{%- assign block_image_alt = val -%}
{%- include 'atb-render' field:'block_background_color' -%}
{%- assign block_background_color = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_content' -%}
{%- assign block_content = val -%}
{%- include 'atb-render' field:'block_button_text' -%}
{%- assign block_button_text = val -%}
{%- include 'atb-render' field:'block_url' -%}
{%- assign block_url = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section jsBoxsSlider">
{% comment %} Section specific CSS {% endcomment %}
{% style %}
    #shopify-section-{{ section_id }} {
      background-color: {{ atb_background_color }};
      padding-top: {{ atb_padding_top }}px;
      padding-bottom: {{ atb_padding_bottom }}px;
      {% if atb_width == 'wide' %}
        width: 100%;
      {% endif %}
      {% if atb_hide_mobile %}
        @media screen and (max-width: 798px){
          display: none;
        }
      {% endif %}
    }
    #shopify-section-{{ section_id }} .container{
      align-items: flex-end;
    }
    #shopify-section-{{ section_id }} .content-wrapper{
      padding: 100px 80px;
      margin-right: -45%;
      z-index: 1;
      position: relative;
      max-width: 662px;
      margin-bottom: 80px;
    }
    #shopify-section-{{ section_id }} .image-element__wrap{
      height: auto;
    }
    #shopify-section-{{ section_id }} .section-title{
      font-weight: 600;
      line-height: 38.4px;
      margin-bottom: 30px;
      letter-spacing: 1.4px;
      font-size:22px;
    }
    #shopify-section-{{ section_id }} .description {
      font-weight: 500;
      line-height: 24px;
      margin-top: 0;
      margin-bottom: 45px;
      letter-spacing: 0.35px;
    }
    #shopify-section-{{ section_id }} .buttons{
      display: block;
    }
    #shopify-section-{{ section_id }} .button{
      width: 300px;
      color: #000;
      margin: auto;
      min-height: 54px;
      font-weight: 600;
      font-size: {{ settings.regular_font_size | append: 'px' }};
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }
    #shopify-section-{{ section_id }} .button.button--primary{
      color: #fff;
      background-color: #3b3737;
    }
    #shopify-section-{{ section_id }} .button.button--primary:hover{
      color: #000;
      border-width: 3px;
      border-color: #3b3737;
      background-color: transparent;
    }
    #shopify-section-{{ section_id }} .button.button--secondary{
      border-width: 3px;
      border-color: #3b3737;
    }
    #shopify-section-{{ section_id }} .button.button--secondary:hover{
      color: #fff;
    }
    #shopify-section-{{ section_id }} .button.button--link-style{
      width: auto;
      border: none;
      position: relative;
      min-height: inherit;
      padding-bottom: 4px;
      display: inline-block;
    }
    #shopify-section-{{ section_id }} .button.button--link-style::before{
      background-color: #d4a696;
      bottom: 0;
      content: '';
      height: 2px;
      left: 50%;
      position: absolute;
      transition: width .8s;
      transform: translateX(-50%);
      width: 80%;
      z-index: 0;
    }
    #shopify-section-{{ section_id }} .button.button--link-style:hover::before {
      width: 0;
    }
    .box-slider .flickity-page-dots .dot {
      display: inline-block;
      width: 60px;
      height: 4px;
      margin: 0px 4px;
      background: #333;
      border-radius: 0;
      cursor: pointer;
    opacity:1;
  }
  .box-slider  li.dot.is-selected {
      background: #fff;
  }
  .box-slider    ol.flickity-page-dots {
      bottom: 10px;
  }
  /* @media screen and (min-width: 991px){
    #shopify-section-{{ section_id }} .content-wrapper{
      margin-left: -45%;
      margin-right: 0;
    }
  } */
  @media screen and (max-width: 1200px){
    #shopify-section-{{ section_id }} .content-wrapper{
      padding: 40px;
    }
  }
  @media screen and (max-width: 1024px){
    #shopify-section-{{ section_id }} .container {
      align-items: center;
    }
    #shopify-section-{{ section_id }} .content-wrapper{
      margin-bottom: 0;
    }
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section_id }} .content-wrapper{
      padding: 20px;
    }
    #shopify-section-{{ section_id }} .section-title {
      line-height: 32px;
      margin-bottom: 15px;
    }
    #shopify-section-{{ section_id }} .description {
      margin-bottom: 18px;
    }
    #shopify-section-{{ section_id }} .button {
      min-height: 50px;
    }
  }
  @media screen and (max-width: 767px){
    #shopify-section-{{ section_id }} .content-wrapper{
      margin: -100px 2rem 0;
      text-align: center !important;
    }
    #shopify-section-{{ section_id }} .button {
      width: 100%;
      font-size: 13px !important;
      font-weight:600;
    }
    #shopify-section-{{ section_id }} .container .two-thirds{
      order: -1;
    }
    #shopify-section-{{ section_id }} .description {
      font-size: {{ settings.regular_font_size | times: 0.9 | floor | append: 'px' }};
    }
     #shopify-section-{{ section_id }} .section-title{
       font-size:18px;
     }
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section_id }} .content-right {
      margin-left: -45%;
      margin-right: 0;
    }
  }

  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text

    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="container box-slider has-no-side-gutter {% if blocks.size <= 1 %}no-slider{% endif %}"
    style="flex-wrap: nowrap;"
    data-products-per-slide="1"
    data-products-limit="{% if blocks.size > 1 %}15{% else %}1{% endif %}"
    data-products-available="{% if blocks.size > 1 %}15{% else %}1{% endif %}"
  >
    {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      <div class="box-cell  layout-table one-whole column ">
        <div class="container has-no-side-gutter">
          <div class="one-third column small-down--one-whole">
            <div
              class="content-wrapper text-left {% if block_image_position[forloop.index0] == 'left' %}content-right{% endif %}"
              style="background-color: {{ block_background_color[forloop.index0] }}"
            >
              <h3 class="h6 section-title ">{{ block_title[forloop.index0] }}</h3>
              <div class="description">
                {{ block_content[forloop.index0] | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
              </div>
              {% if block_button_text[forloop.index0] != blank %}
                <div class="buttons">
                  {% render 'button',
                    label: block_button_text[forloop.index0],
                    href: block_url[forloop.index0],
                    style: block_button_style[forloop.index0],
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

          <div
            class="two-thirds column small-down--one-whole"
            {% if block_image_position[forloop.index0] == 'left' %}
              style="order: -1;"
            {% endif %}
          >
            {% if my_image0 != blank %}
              {% render 'image-element', image: my_image0, alt: block_image_alt[forloop.index0] %}
            {% else %}
              <div class="image-element__wrap">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsBoxSlider.js' | asset_url }}"></script>

</section>