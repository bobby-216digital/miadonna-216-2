<section id="shopify-section-{{section_id}}" class="shopify-section collection-tabs history-tabs jsCollectionTabs">
{% comment %} Section specific CSS {% endcomment %}

{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}</noscript>

<style>
  #shopify-section-{{ section_id }} .section-heading{
    margin-bottom: 30px;
  }
  #shopify-section-{{ section_id }} .section-heading h3{
    margin-top: 0;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} .section-heading .main-subheading{
    font-size: 22px;
    font-style: italic;
    line-height: 28.71px;
    letter-spacing: 0.35px;
    font-family: 'Playfair Display';
  }

  .history-content-wrapper {
    align-items: center;
    gap:20px;
  }
  .history-content-wrapper h6{
    margin: 0 0 20px 6px;
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-style: italic;
  }
  .history-content-wrapper h6 span{
    font-family: Montserrat, sans-serif;
    font-style: normal;
    font-weight: 500;
  }
  .history-tabs-buttons .flickity-prev-next-button{
    top:28px;
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section_id }} .section-heading h3{
      font-size: 18px;
    }
    #shopify-section-{{ section_id }} .section-heading .main-subheading{
      font-size: 16px;
    }
     #shopify-section-{{ section_id }} .image-element__wrap img{
       max-width: 180px;
       margin: auto;
     }
    #shopify-section-{{ section_id }} .year-title{
      font-size: 18px;  
    }
    #shopify-section-{{ section_id }} .year-title, #shopify-section-{{ section_id }} .history-content{
      text-align: center;
    }
  }
</style>

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' -%}
      width: 100%;
    {%- elsif atb_width == 'half' -%}
      width: 50%;
    {%- endif %}
  }
  #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons{
    gap: 0;
    margin-bottom: 1rem;
    justify-content: center;
  }
  #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button{
    border: 3px solid #f5f5f5;
    font-size: 16px;
    padding: 0.5rem 2rem;
    outline: none;
    box-shadodow: none;
    letter-spacing: .1em;
    background: #f5f5f5;
    text-align:center;
    margin-right:5px;
   min-width:max-content;
  }
  
  
  #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button.button-active {
   border-color:#fca999;
  }
  #shopify-section-{{ section_id }} .product-content-wrapper{
    justify-content: flex-start;
  }
  #shopify-section-{{ section_id }} .product-content-wrapper .product-item{
    margin-right: 5px !important;
  }
  #shopify-section-{{ section_id }} .product-content-wrapper .image-element__wrap{
    max-width: 100% !important;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button{
    background-color: transparent;
  }
  @media screen and (max-width: 1300px){
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons{
      flex-wrap: nowrap;
      overflow: auto;
      padding: 0 1rem 1rem;
      justify-content: flex-start;
    }
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button{
      white-space: nowrap;
    }
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-1,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-2,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-3{
      justify-content: center;
    }
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-1,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-2,
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-3{
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section_id }} .setting-tabs-wrapper .setting-tab-button{
      font-size: 14px;
    }
    #shopify-section-{{ section_id }} .flickity-prev-next-button.previous {
      left: -7px;
    }
    #shopify-section-{{ section_id }} .flickity-prev-next-button.next {
      right: -19px;
    }
    #shopify-section-{{ section_id }} .flickity-prev-next-button .flickity-button-icon{
      height: 15px;
      width: 15px;
    }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-setting-tabs
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    has-no-side-gutter
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="section-heading text-center">
    <h3>{{ atb_main_heading }}</h3>
    <div class="main-subheading">
      {{ atb_main_subheading }}
    </div>
  </div>
  <div class="container">
    {% assign buttonTextEmpty = false %}
    {% assign buttonCount = 0 %}
    {%- for block0 in blocks -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      {% if block_button_text[forloop.index0] == blank %}
        {% assign buttonTextEmpty = true %}
      {% endif %}
      {% if block_button_text[forloop.index0] != blank %}
        {% assign buttonCount = buttonCount | plus: 1 %}
      {% endif %}
    {% endfor %}
    
    <setting-tabs class="setting-tabs-wrapper one-whole">
      
        <div class="setting-tabs-buttons history-tabs-buttons tab-buttons-{{ buttonCount }}">
          {%- for block0 in blocks -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
            {% assign buttonID = block_year[forloop.index0] | replace: ' ', '-' | downcase %}
            <button
              id="{{ buttonID }}"
              class="setting-tab-button history-button two column {{ buttonID }}{% if forloop.first %} button-active{% endif %}"
            >
              {{ block_year[forloop.index0] }}
            </button>
          {% endfor %}
        </div>
      

       {%- for block0 in blocks -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        {% assign buttonID = block_year[forloop.index0] | replace: ' ', '-' | downcase %}
        <div
          id="{{ buttonID }}-content"
          class="setting-tab-content {{ buttonID }}-content js-related-products-slider{% if forloop.first %} tab-active{% endif %}"
        >
          <div
            class="section history-content-wrapper container"
          >
       
          
        <div class="one-third column medium-down--one-half small-down--one-whole">
         
          {% if my_image0 != blank %}
            {%
              render 'image-element',
              image: my_image0,
              alt: block_image_alt[forloop.index0]
            %}
          {% else %}
            <div class="image-element__wrap" style="height: auto;">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ten column medium-down--one-half small-down--one-whole">
        
          {% if block_title[forloop.index0] != blank %}
            <h6 style="color: {{ atb_text_color }};" class="year-title"><span>{{ block_year[forloop.index0] }}:</span> {{ block_title[forloop.index0] }}</h6>
          {% endif %}

          <div class="history-content">
            {{ block_content[forloop.index0] | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
          </div>
        </div>

      
          </div>
        </div>
      {% endfor %}
    </setting-tabs>
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsCollectionTabs.js' | asset_url }}"></script>


</section>