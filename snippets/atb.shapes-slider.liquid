<section id="shopify-section-{{section_id}}" class="shopify-section shapes-slider jsShapesSlider">
{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .section-header{
    font-size: 16px;
    line-height: 24px;
    margin-bottom: 3.5rem;
    letter-spacing: 0.35px;
    font-family: {{- atb_description_font.family -}}, {{- atb_description_font.fallback_families -}};
  }
  #shopify-section-{{ section_id }} .heading{
    font-size: 40px;
    font-style: italic;
    line-height: 65.03px;
    letter-spacing: 0.35px;
    margin-bottom: 1.5rem;
    font-family: {{ atb_heading_font.family }}, {{ atb_heading_font.fallback_families }};
  }
  #shopify-section-{{ section_id }} .shapes--slider{
    max-width: 1000px;
    margin: auto;
  }
  #shopify-section-{{ section_id }} .shape{
    text-align: center;
  }
  #shopify-section-{{ section_id }} .shape svg{
    width: 70px;
    height: 70px;
  }
  #shopify-section-{{ section_id }} .shapes--slider .flickity-prev-next-button.previous {
    left: -70px;
  }
  #shopify-section-{{ section_id }} .shapes--slider .flickity-prev-next-button.next {
    right: -60px;
  }
  #shopify-section-{{ section_id }} .shapes--slider .flickity-button {
    box-shadow: none;
    align-items: center;
    justify-content: center;
    background: transparent;
  }
  #shopify-section-{{ section_id }} .section-footer {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section_id }} .section-footer .button.button--secondary {
    width: 300px;
    margin: auto;
    min-height: 54px;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    border-width: 3px;
  }
  #shopify-section-{{ section_id }} .section-footer .button.button--secondary:hover {
    color: {{ atb_button_background }} !important;
    background-color: {{ atb_button_text }} !important;
  }
  #shopify-section-{{ section_id }} .shapes--slider.no-slider:after {
    content: "flickity";
    display: none; /* hide :after */
  }
  @media screen and (min-width: 1025px) {
    /* disable Flickity for large devices */
    #shopify-section-{{ section_id }} .shapes--slider.no-slider:after {
      content: "";
    }
  }
  @media screen and (max-width: 1024px){
    #shopify-section-{{ section_id }} .section-header br{
      display: none;
    }
    #shopify-section-{{ section_id }} .shapes--slider{
      max-width: 650px;
      margin: auto;
    }
    #shopify-section-{{ section_id }} .shapes--slider .flickity-prev-next-button.previous {
      left: -50px;
    }
    #shopify-section-{{ section_id }} .shapes--slider .flickity-prev-next-button.next {
      right: -40px;
    }
  }
  @media screen and (max-width: 575px){
    #shopify-section-{{ section_id }} .heading{
      font-size: 32px;
      line-height: 45px;
    }
    #shopify-section-{{ section_id }} .shapes--slider{
      max-width: 300px;
      margin: auto;
    }
    #shopify-section-{{ section_id }} .shapes--slider .flickity-prev-next-button.previous {
      left: -40px;
    }
    #shopify-section-{{ section_id }} .shapes--slider .flickity-prev-next-button.next {
      right: -30px;
    }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-shapes-slider
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="section-header text-align-center">
    <h2
      class="heading"
    >
      {{ atb_main_title }}
    </h2>
    <div
      class="description"
    >
      {{ atb_description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
    </div>
  </div>
  <div
    class="container shapes--slider {% if blocks.size <= 8 %}no-slider{% endif %}"
    style="flex-wrap: nowrap;"
    data-products-per-slide="8"
    data-products-limit="{% if blocks.size > 8 %}15{% else %}8{% endif %}"
    data-products-available="{% if blocks.size > 8 %}15{% else %}8{% endif %}"
  >
    {% for block0 in blocks %}
      <div class="shape shape-{{ block_type[forloop.index0] }} one-eighth column large-down--one-seventh medium-down--one-seventh small-down--one-third">
        {% case block_type[forloop.index0] %}
          {% when 'round' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-round-cut' %}
            </a>
          {% when 'princess' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-princess-cut' %}
            </a>
          {% when 'cushion' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-cushion-cut' %}
            </a>
          {% when 'oval' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-oval-cut' %}
            </a>
          {% when 'emerald' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-emerald-cut' %}
            </a>
          {% when 'asscher' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-asscher-cut' %}
            </a>
          {% when 'radiant' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-radiant-cut' %}
            </a>
          {% when 'pear' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-pear-cut' %}
            </a>
          {% when 'heart' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-heart-cut' %}
            </a>
          {% when 'marquise' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-marquise-cut' %}
            </a>
          {% when 'oval-rose' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-oval-rose-cut' %}
            </a>
          {% when 'trillion' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-round-cut' %}
            </a>
          {% when 'half-moon' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-half-moon-cut' %}
            </a>
          {% when 'baguette' %}
            <a href="{{ block_link[forloop.index0] }}">
              {% render 'icon-shape-baguette-cut' %}
            </a>
        {% endcase %}
      </div>
    {% endfor %}
  </div>
  <div class="section-footer">
    {% if atb_button_label != blank %}
      <div class="buttons is-{{ atb_button_alignment }}">
        {% render 'button',
          label: atb_button_label,
          href: atb_button_link,
          style: atb_button_style,
          text_color: atb_button_text,
          background_color: atb_button_background,
          type: 'link'
        %}
      </div>
    {% endif %}
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsShapesSlider.js' | asset_url }}"></script>


</section>