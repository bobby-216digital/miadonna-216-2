{% comment %}
ATB-SCHEMA{
  "name": "Partial text overlay",
  "id": "partial-text-overlay",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "image",
          "label": "image"
        },
        {
          "value": "content",
          "label": "content"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "image_picker",
      "label": "Image",
      "id": "block_image",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image"
    },
    {
      "type": "text",
      "label": "Image Alt Text",
      "id": "block_image_alt",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image"
    },
    {
      "type": "select",
      "label": "Image Position",
      "id": "block_image_position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:image"
    },
    {
      "type": "color",
      "id": "block_background_color",
      "label": "Background color",
      "default": "rgba(251,240,232,1)",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "text",
      "label": "Title",
      "id": "block_title",
      "default": "Content Title",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "wysiwyg",
      "label": "Description",
      "id": "block_description",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "text",
      "label": "Button text",
      "id": "block_button_text",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "text",
      "label": "Link",
      "id": "block_button_link",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "text",
      "label": "Button text 2",
      "id": "block_button_text_2",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "text",
      "label": "Link 2",
      "id": "block_button_link_2",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    },
    {
      "type": "select",
      "id": "block_button_style",
      "label": "Style",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--primary",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:content"
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


