<section id="shopify-section-{{section_id}}" class="shopify-section ">
{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .container{
    align-items: flex-end;
  }
  #shopify-section-{{ section_id }} .content-wrapper{
    padding: 100px 80px;
    margin-right: -45%;
    z-index: 1;
    position: relative;
    max-width: 662px;
    margin-bottom: 80px;
  }
  #shopify-section-{{ section_id }} .image-element__wrap{
    height: auto;
  }
  #shopify-section-{{ section_id }} .section-title{
    font-weight: 600;
    /* line-height: 38.4px; */
    margin-bottom: 30px;
    /* letter-spacing: 1.4px; */
  }
  #shopify-section-{{ section_id }} .description{
    margin-bottom: 45px;
  }
  #shopify-section-{{ section_id }} .description > *{
    font-weight: 500;
    line-height: 24px;
    margin-top: 0;
    letter-spacing: 0.35px;
  }
  #shopify-section-{{ section_id }} .buttons{
    display: block;
  }
  #shopify-section-{{ section_id }} .button{
    width: 300px;
    color: #000;
    margin: auto;
    min-height: 54px;
    font-weight: 600;
    font-size: {{ settings.regular_font_size | append: 'px' }};
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} .button.button--primary{
    color: #fff;
    background-color: #3b3737;
  }
  #shopify-section-{{ section_id }} .button.button--primary:hover{
    color: #000;
    border-width: 3px;
    border-color: #3b3737;
    background-color: transparent;
  }
  #shopify-section-{{ section_id }} .button.button--secondary{
    border-width: 3px;
    border-color: #3b3737;
  }
  #shopify-section-{{ section_id }} .button.button--secondary:hover{
    color: #fff;
  }
  #shopify-section-{{ section_id }} .button.button--link-style{
    width: auto;
    border: none;
    position: relative;
    min-height: inherit;
    padding-bottom: 4px;
    display: inline-block;
  }
  #shopify-section-{{ section_id }} .button.button--link-style::before{
    background-color: #d4a696;
    bottom: 0;
    content: '';
    height: 2px;
    left: 50%;
    position: absolute;
    transition: width .8s;
    transform: translateX(-50%);
    width: 80%;
    z-index: 0;
  }
  #shopify-section-{{ section_id }} .button.button--link-style:hover::before {
    width: 0;
  }
  @media screen and (max-width: 1200px){
    #shopify-section-{{ section_id }} .content-wrapper{
      padding: 40px;
    }
  }
  @media screen and (max-width: 1024px){
    #shopify-section-{{ section_id }} .container {
      align-items: center;
    }
    #shopify-section-{{ section_id }} .content-wrapper{
      margin-bottom: 0;
    }
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section_id }} .content-wrapper{
      padding: 20px;
    }
    #shopify-section-{{ section_id }} .section-title {
      line-height: 32px;
      margin-bottom: 15px;
    }
    #shopify-section-{{ section_id }} .description {
      margin-bottom: 18px;
    }
    #shopify-section-{{ section_id }} .button {
      min-height: 50px;
    }
  }
  @media screen and (max-width: 767px){
    #shopify-section-{{ section_id }} .content-wrapper{
      margin: -100px 2rem 0;
      text-align: center !important;
    }
    #shopify-section-{{ section_id }} .button {
      width: 100%;
      font-size: {{ settings.regular_font_size | times: 0.95 | floor | append: 'px' }} !important;
    }
    #shopify-section-{{ section_id }} .container .two-thirds{
      order: -1;
    }
    #shopify-section-{{ section_id }} .description > *{
      font-size: {{ settings.regular_font_size | times: 0.95 | floor | append: 'px' }};
    }
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section_id }} .content-right {
      margin-left: -45%;
      margin-right: 0;
    }
  }

  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  {% assign contentPosition = false %}
  {%- for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
    {% if block_type[forloop.index0] == 'image' -%}
      {%- if block_image_position[forloop.index0] == 'left' -%}
        {% assign contentPosition = true %}
      {% endif %}
    {% endif %}
  {%- endfor -%}
  <div class="container has-no-side-gutter">
    {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
      {% if block_type[forloop.index0] == 'content' %}
        <div class="one-third column small-down--one-whole">
          <div
            class="content-wrapper text-left {% if contentPosition %}content-right{% endif %}"
            style="background-color: {{ block_background_color[forloop.index0] }};"
          >
            <h3 class="section-title">{{ block_title[forloop.index0] }}</h3>
            <div class="description">
              {{ block_description[forloop.index0] | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
            </div>
            {% if block_button_text[forloop.index0] != blank %}
              <div class="buttons">
                {% render 'button',
                  label: block_button_text[forloop.index0],
                  href: block_button_link[forloop.index0],
                  style: block_button_style[forloop.index0],
                  type: 'link'
                %}
              </div>
            {% endif %}
            {% if block_button_text_2[forloop.index0] != blank %}
              <div class="buttons" style="margin-top:10px;">
                {% render 'button',
                  label: block_button_text_2[forloop.index0],
                  href: block_button_link_2[forloop.index0],
                  style: block_button_style[forloop.index0],
                  type: 'link'
                %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
      {% if block_type[forloop.index0] == 'image' %}
        <div
          class="two-thirds column small-down--one-whole"
          {% if block_image_position[forloop.index0] == 'left' %}
            style="order: -1;"
          {% endif %}
        >
          {% if my_image0 != blank %}
            {% render 'image-element', image: my_image0, alt: block_image_alt[forloop.index0] %}
          {% else %}
            <div class="image-element__wrap">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>


</section>