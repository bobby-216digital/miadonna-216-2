{{ 'ring-sizer.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'ring-sizer.css' | asset_url | stylesheet_tag }}</noscript>

<div class="ring-size-form" id="interactive-ring-sizer">
  <h2 class="text-style-chapter-title">International Ring Size Converter</h2>
  <form class="pure-form pure-form-stacked ac-custom ac-checkbox ac-cross">
    <fieldset>
      <legend>Legend</legend>

      <div class="pure-g">
        <div class="pure-u-1 pure-u-lg-1">
          <label class="show-on-select" for="ring_finger_diameter">Ring Finger Diameter (MM)</label>
          <div class="select-wrapper ring-finger-diameter">
            <select id="ring_finger_diameter" class="required pure-input-1-2" required>
              <option selected="selected">Ring Finger Diameter (MM)</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>

        <div class="pure-u-1 pure-u-lg-1-2">
          <label class="show-on-select" for="usa_canada">USA & Canada</label>
          <div class="select-wrapper">
            <select id="usa_canada" class="required pure-input-1-2" required>
              <option selected="selected">USA & Canada</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>

        <div class="pure-u-1 pure-u-lg-1-2">
          <label class="show-on-select" for="australian_british">Australian & British</label>
          <div class="select-wrapper">
            <select id="australian_british" class="required pure-input-1-2" required>
              <option selected="selected">Australian & British</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>

        <div class="pure-u-1 pure-u-lg-1-2">
          <label class="show-on-select" for="french_russian">French & Russian</label>
          <div class="select-wrapper">
            <select id="french_russian" class="required pure-input-1-2" required>
              <option selected="selected">French & Russian</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>

        <div class="pure-u-1 pure-u-lg-1-2">
          <label class="show-on-select" for="german">German</label>
          <div class="select-wrapper">
            <select id="german" class="required pure-input-1-2" required>
              <option selected="selected">German</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>

        <div class="pure-u-1 pure-u-lg-1-2">
          <label class="show-on-select" for="japanese">Japanese</label>
          <div class="select-wrapper">
            <select id="japanese" class="required pure-input-1-2" required>
              <option selected="selected">Japanese</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>

        <div class="pure-u-1 pure-u-lg-1-2">
          <label class="show-on-select" for="swiss">Swiss</label>
          <div class="select-wrapper">
            <select id="swiss" class="required pure-input-1-2" required>
              <option selected="selected">Swiss</option>
            </select>
            <div class="select-button"><div class="arrow"></div></div>
          </div>
        </div>
      </div>
    </fieldset>
  </form>

  <div class="ring-size-instructions">
    <p>Instructions</p>
    <ol>
      <li>Wrap a piece of string or paper around your finger.</li>
      <li>Mark the point where the two ends meet.</li>
      <li>Measure the string or paper against a ruler to get the circumference (in millimeteres) of your finger.</li>
      <li>Divide that number by 3.14 to get the diameter of your finger.</li>
      <li>Use the interactive table above to convert your ring size.</li>
    </ol>
  </div>
</div>

<script src="{{ 'ringSizer-interactive.js' | asset_url  }}" defer="defer"></script>
