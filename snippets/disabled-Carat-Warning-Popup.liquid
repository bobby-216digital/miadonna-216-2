<div
  class="fancybox-container popup-modal certificate-popup product-images-popup disabled-popup fancybox-is-open unavailable-stone"
  role="dialog"
  tabindex="-1"
  id="disabled-popup"
  aria-labelledby="unavailable-stone-title"
  style="transition-duration: 366ms;opacity: 0;visibility: hidden;z-index: -99999999999;"
>
  <div class="fancybox-bg" onClick="disabledClosePopup()"></div>
  <div class="fancybox-inner">
    <div class="fancybox-stage">
      <div class="fancybox-slide fancybox-slide--html fancybox-slide--current fancybox-slide--complete" style="">
        <div
          class="popup__wrapper animated fadeIn has-image image-position-left fancybox-content"
          style="display: inline-block;"
        >
          <button onClick="disabledClosePopup()" class="close popup__close" aria-label="Close popup">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" tabindex="-1"><path d="M20 20L4 4m16 0L4 20"></path></svg>
          </button>
          <div class="popup__inner is-flex has-no-side-gutter">
            <div class="popup__content one-half text-center">
              <h2 id="unavailable-stone-title">Unavailable Stone</h2>
              <p class="subtitle">
                The stone you selected is currently unavailable. Please feel free to choose another one from our wide range of options or you can start freshly with this setting product.
              </p>
             <button class="button button--secondary" id="okButton">GET STARTED</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>