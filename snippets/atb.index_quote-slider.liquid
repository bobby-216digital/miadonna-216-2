{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_show_gutter' -%}
{%- assign atb_show_gutter = val -%}
{%- include 'atb-render' field:'atb_hide_mobile' -%}
{%- assign atb_hide_mobile = val -%}
{%- include 'atb-render' field:'atb_background_color' -%}
{%- assign atb_background_color = val -%}
{%- include 'atb-render' field:'atb_text_color' -%}
{%- assign atb_text_color = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_title' -%}
{%- assign block_title = val -%}
{%- include 'atb-render' field:'block_quote' -%}
{%- assign block_quote = val -%}
{%- include 'atb-render' field:'block_author' -%}
{%- assign block_author = val -%}
{%- if atb_show_gutter == blank -%}
{%- assign atb_show_gutter = false -%}
{%- else -%}
{%- assign atb_show_gutter = true -%}
{%- endif -%}
{%- if atb_hide_mobile == blank -%}
{%- assign atb_hide_mobile = false -%}
{%- else -%}
{%- assign atb_hide_mobile = true -%}
{%- endif -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section quotes-slider jsQuotesSlider">
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    margin-bottom:40px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  p.offset-cell.text-style-title {
    color: #fff;
    font-weight: 500;
    font-size: 32px;
    padding-top: 30px;
    line-height: 40px;
    font-family: 'Playfair Display';
    font-style: italic;
}

.logo-quote img {
    padding: 30px 40px;
    width: 360px;
  
}

.readability-insets span {
    color: #e6c799;
    font-family: Montserrat,sans-serif;
    font-size: 19px;
    font-weight: 500;
}
.quotes-slider .quote-titles {
    padding: 20px 20px 20px 20px;
}


p.offset-cell.text-style-title{

    quotes: "\201c" "\201d" "\201c" "\201d";
}
  p.offset-cell.text-style-title:before {
    font-size: 108px;
    left: 10px;
    font-weight: 600;
    top: 40px;
}
.quotes-slider .flickity-page-dots .dot {
    display: inline-block;
    width: 20px;
    height: 2px;
    margin: 0px 4px;
    background: #777;
    border-radius: 0;
    cursor: pointer;
    opacity:0.3;
}
.quotes-slider  li.dot.is-selected {
    background: #777;
    opacity:1;
}
.quotes-slider    ol.flickity-page-dots {
    bottom: -20px;
}

.container.quotes-slider {
    margin-bottom: 40px;
}
  #shopify-section-{{ section_id }} .logo-quote img {
    margin-top: 30px;
  }
.body-cell{
  display:flex;
  gap:20px;
  align-items: center;
  justify-content: center;
} 
element.style {
    flex-wrap: nowrap;
}
.container.quotes-slider.flickity-enabled.is-draggable.flickity-resize {
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 0px;
}
    @media screen and (max-width:768px){
    .quotes-slider .column {
    width: 100% !important;
    display: block;
    }
    p.offset-cell.text-style-title {
    font-size: 22px;
    line-height:30px;
    text-align: center;
    }
    .quotes-slider .quote-titles {
        padding: 0 20px;
    }
    .logo-quote img {
        padding: 10px;
        width: 180px;
        margin: 0 auto;
        display: block;
    }
  }
  {% endstyle %}
<section   class="
    section
    section-collection-blocks
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
  >
      <div       class="container quotes-slider {% if blocks.size <= 1 %}no-slider{% endif %}"
      style="flex-wrap: nowrap;"
      data-products-per-slide="1"
      data-products-limit="{% if blocks.size > 1 %}15{% else %}5{% endif %}"
      data-products-available="{% if blocks.size > 1 %}15{% else %}5{% endif %}">
  {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}

      <div class="body-cell layout-table one-whole column">
       <div class="logo-quote">
          <img src="{{ settings.speedsize_url_pfx_https -}}{{ my_image0 | img_url:'original' }}" width="100%" height="100%" loading="lazy" alt="slide">
        </div>
        <div class="quote-titles">
        <div class="readability-insets">
          <!--<h2 class="text-style-subtitle">{{ block_title[forloop.index0] }}</h2>-->
          <p class="offset-cell text-style-title">{{ block_quote[forloop.index0] }}</p>
          <span>{{ block_author[forloop.index0] }}</span>
       
      </div>
        </div>
       
    </div>
  {% endfor %}
   </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsQuotesSlider.js' | asset_url }}"></script>



</section>