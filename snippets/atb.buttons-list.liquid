{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_padding_left' -%}
{%- assign atb_padding_left = val -%}
{%- include 'atb-render' field:'atb_padding_right' -%}
{%- assign atb_padding_right = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_button_label' -%}
{%- assign block_button_label = val -%}
{%- include 'atb-render' field:'block_button_link' -%}
{%- assign block_button_link = val -%}
{%- include 'atb-render' field:'block_button_background' -%}
{%- assign block_button_background = val -%}
{%- include 'atb-render' field:'block_button_text' -%}
{%- assign block_button_text = val -%}
{%- include 'atb-render' field:'block_button_style' -%}
{%- assign block_button_style = val -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_padding_left = atb_padding_left | plus: 0 -%}
{%- assign atb_padding_right = atb_padding_right | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section buttons-list">
{% comment %} Section specific CSS {% endcomment %}

{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% elsif atb_width == 'half' %}
      width: 50%;
    {% endif %}
  }
  #shopify-section-{{ section_id }} .section-buttons-list .buttons{
    gap: 17px;
  }
  #shopify-section-{{ section_id }} .section-buttons-list .button{
    min-width: 180px;
    height: 52px;
    outline: none;
    font-weight: 600;
    box-shadow: none;
    line-height: 26.16px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section_id }} .section-buttons-list .buttons{
      overflow: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
    }
  }
  {% render 'css-loop',
      css: section_css,
      id: section_id
  %}
  {% render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-buttons-list
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    has-no-side-gutter
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="container">
    <div class="buttons one-whole column is-center">
      {% for block0 in blocks %}
        {% if block_button_label[forloop.index0] != blank %}
          {% render 'button',
            label: block_button_label[forloop.index0],
            href: block_button_link[forloop.index0],
            style: block_button_style[forloop.index0],
            text_color: block_button_text[forloop.index0],
            background_color: block_button_background[forloop.index0],
            type: 'link'
          %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>


</section>