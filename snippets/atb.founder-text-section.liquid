{% comment %}
ATB-SCHEMA{
  "name": "Founder - Text Section",
  "id": "founder-text-section",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Background color",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background",
      "label": "Background",
      "default": "#ffffff",
      "info": ""
    },
    {
      "type": "header",
      "content": "Content",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_subtitle",
      "label": "SubTitle",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_title",
      "label": "Title",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_text",
      "label": "Text",
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_background' -%}
{%- assign atb_background = val -%}
{%- include 'atb-render' field:'atb_subtitle' -%}
{%- assign atb_subtitle = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_text' -%}
{%- assign atb_text = val -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
<style>
  #shopify-section-{{ section_id }} {
    padding: 50px 26px;
    background-color: {{ atb_background }};
  }
  #shopify-section-{{ section_id }} .readability-insets>* {
    max-width: 76rem;
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section_id }} .offset-group>*+* {
    margin-top: 26px;
    font-family: Playfair Display,serif;
  }
  #shopify-section-{{ section_id }} .content-subtitle{
    color: #777;
    margin-bottom: 26px;
  }
  #shopify-section-{{ section_id }} .text-style-chapter-title {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} .text-style-title {
    color: #000000de;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
  }
  #shopify-section-{{ section_id }} .about-section-content p:not(.text-style-title):not(h1):not(.text-style-title-2):not(h2) {
    font-size: 15px;
  }
  @media only screen and (min-width: 750px){
    #shopify-section-{{ section_id }} {
      padding: 50px;
    }
    #shopify-section-{{ section_id }} .content-subtitle {
      margin-bottom: 35px;
    }
    #shopify-section-{{ section_id }} .text-style-title {
      font-size: 36px;
    }
  }
  @media only screen and (min-width: 1024px){
    #shopify-section-{{ section_id }} {
      padding: 100px 50px;
    }
    #shopify-section-{{ section_id }} .content-subtitle {
      margin-bottom: 50px;
    }
    #shopify-section-{{ section_id }} .text-style-chapter-title {
      font-size: 18px;
    }
    #shopify-section-{{ section_id }} .text-style-title {
      font-size: 40px;
    }
  }
</style>

<section class="about-section-content">
  <div class="content-cell cell-style-A">
    <div class="body-cell offset-group readability-insets text-center">
      {% if atb_subtitle != blank %}
        <h2 class="text-style-chapter-title content-subtitle">{{ atb_subtitle }}</h2>
      {% endif %}
      {% if atb_title != blank %}
        <p class="text-style-title content-subtitle">{{ atb_title }}</p>
      {% endif %}
      {{ atb_text }}
    </div>
  </div>
</section>



<style>
</style>

<script type="application/javascript">
</script>
</section>