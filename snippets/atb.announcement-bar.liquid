<section id="shopify-section-{{section_id}}" class="shopify-section announcement-container jsAnnouncementBar">
{% comment %}
  ** Announcement bar - static **
{% endcomment %}

{% assign id = section_id %}
{% assign icon = atb_icon_label | downcase %}
{% assign size = atb_size %}
{% assign text_color = atb_text_color %}
{% assign show_close_icon = atb_show_close_icon %}

{% comment %} Advanced {% endcomment %}
{% assign width = atb_width %}
{% assign css_class = atb_css_class %}
{% assign custom_css = atb_custom_css %}

{% comment %} Is the color set to transparent? {% endcomment %}
{% assign text_alpha = text_color | color_extract: 'alpha' %}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}
  .announcement-bar {
    background-color: {{ atb_background }};
  }

  .announcement-bar__icon {
    fill: {{ text_color }};
  }

  .announcement-bar__close {
    fill: {{ text_color }};
    background-color: {{ text_color | color_modify: 'alpha', 0.1 }};
  }

  .announcement-bar__close:hover {
    background-color: {{ text_color | color_modify: 'alpha', 0.2 }};
  }

  .message-header {
    color: {% if text_alpha != 0 %}{{ text_color }}{% else %}{{ settings.regular_color }}{% endif %};
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ id }} {
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: id
  %}
  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
{% capture announcement %}
<div class="announcement-bar__container {{ css_class }}">
  <div class="announcement-bar
              is-{{ size }}
              "
        id="announcement-bar">
    <div class="section
                is-width-{{ width }}">
      <div class="message-header">
        <div class="announcement-bar__content is-justify-{{ atb_alignment }} show-close-icon-{{ show_close_icon }}">
          {% if atb_icon_label != blank %}
            <span class="announcement-bar__icon
                        is-{{ size }}
                       ">
              {% render 'icon', name: icon %}
            </span>
          {% endif %}
          <div class="announcement-bar__slider one-half large-down--one-whole">
            {% for block0 in blocks %}
              {% if block_link[forloop.index0] != blank %}
                <a href="{{ block_link[forloop.index0] }}">
              {% endif %}
              <div class="announcement-bar__text text-align-{{ atb_alignment }}">
                {{ block_text[forloop.index0] }}
                <p class="buttons">
                  {% if atb_button_label != blank %}
                    {% render 'button',
                            label: atb_button_label,
                            href: atb_link,
                            type: "link",
                            style: atb_button_style
                    %}
                  {% endif %}
                </p>
              </div>
              {% if block_link[forloop.index0] != blank %}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% if show_close_icon %}
          <button class="close announcement-bar__close js-close-announcement" aria-label="close">
            {% render 'icon', name: 'x' %}
          </button>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="announcement-bar__shadow" id="announcement-bar__shadow" aria-hidden="true"></div>
</div>
{% endcapture %}

{% if atb_homepage_only %}
  {% if template.name == 'index' %}
    {{ announcement }}
  {% endif %}
{% else %}
  {{ announcement }}
{% endif %}

{% comment %}Javascript{% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section_id }}"
  data-section-data
>
  {
    "homepage_only": {{ atb_homepage_only | json }},
    "enable_sticky": {{ atb_enable_sticky | json }},
    "show_close_icon": {{ atb_show_close_icon | json }},
    "alignment": {{ atb_alignment | json }},
    "width": {{ atb_width | json }}
  }
</script>
<script src="{{ 'z__jsAnnouncementBar.js' | asset_url }}"></script>

{% comment %}Schema{% endcomment %}

</section>