{% comment %}
ATB-SCHEMA{
  "name": "Collection list",
  "class": "collection-list",
  "max_blocks": 8,
  "id": "index__collection-list",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "range",
      "id": "atb_collections_per_row",
      "label": "Collections per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_align_height",
      "label": "Align to height",
      "default": false,
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_collection_height",
      "label": "Collection image height",
      "min": 200,
      "max": 400,
      "step": 10,
      "default": 400,
      "unit": "px",
      "info": "Applied when 'Align to height' is also enabled. [Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360024344614)"
    },
    {
      "type": "checkbox",
      "id": "atb_enable_zoom",
      "label": "Magnify image on hover",
      "default": true,
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_button_style",
      "label": "Button style",
      "default": "button--secondary",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Overlay",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_overlay_background",
      "label": "Background",
      "default": "#939393",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_overlay_background_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 70,
      "unit": "%",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_overlay_text",
      "label": "Text",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_collection_title_below_image",
      "label": "Show collection title below image",
      "default": false,
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 20,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 20,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Collection"
    },
    {
      "type": "collection",
      "id": "block_feature_collection",
      "label": "Collection",
      "repeatable": "Collection",
      "info": ""
    },
    {
      "type": "image_picker",
      "id": "block_image",
      "label": "Image",
      "info": "The collection's featured image will be used as a fallback.",
      "repeatable": "Collection"
    },
    {
      "type": "text",
      "id": "block_title",
      "label": "Heading",
      "repeatable": "Collection",
      "info": ""
    },
    {
      "type": "text",
      "id": "block_button_label",
      "label": "Button label",
      "default": "View products",
      "repeatable": "Collection",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


