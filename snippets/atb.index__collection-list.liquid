{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section collection-list">
{% comment %}
** Collection list **
{% endcomment %}

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign overlay_alpha = atb_overlay_background | color_extract: 'alpha' -%}
{%- assign overlay_text_alpha = atb_overlay_text | color_extract: 'alpha' -%}
{% comment %} Opacity level {% endcomment %}
{% if overlay_alpha != 0 %}
  {%- assign overlay_background_alpha = atb_overlay_background_opacity | divided_by: 100.00 -%}
{% endif %}

{% if atb_align_height %}
  {%- assign collection_height = atb_collection_height -%}
{% endif %}

{%- capture section_css -%}
  {% if atb_align_height != blank %}
    .placeholder-svg {
      height: {{ collection_height }}px;
      max-height: {{ collection_height }}px;
    }
  {% endif %}

  .collection-thumbnail-overlay {
    background-color: {%- if overlay_alpha != 0 -%}{{ atb_overlay_background | color_modify: 'alpha', overlay_background_alpha }}{% endif %};
  }

  .collection-info__caption span {
    color: {%- if overlay_text_alpha != 0 -%}{{ atb_overlay_text }}{% endif %}
  }
{%- endcapture -%}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}

 .custom-collection-list .collection-info__caption-wrapper{
    width: 100%;
    opacity: 0;
  }
  /* .custom-collection-list .collection-info__caption-wrapper:before{
    width: 100%;
    height:100%;
    position: absolute;
    content: '';
  } */
  .custom-collection-list .collection-info__caption-wrapper .title{
    font-family: 'Playfair Display';
    text-align: center;
  }
  .custom-collection-list .product-wrap .collection-info__caption-wrapper{
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translate(0%, -50%);
  }
  .custom-collection-list .product-wrap:hover .collection-info__caption-wrapper{
    opacity: 1;
  }
  .custom-collection-list .product-wrap .collection-info__caption:after{
   background: #eae0d4;
    text-align: center;
    left: 0;
    bottom: 0;
    color: #212121;
    display: block;
    font-family: Montserrat,sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0;
    padding: 9px 0;
    position: absolute;
    transition: opacity .35s ease-in-out;
    width: 100%;
    font-size: 13px;
    content: "Shop Collection"!important;
    padding: 13px 40px;
    font-size: 14px;
  }
@media only screen and (max-width: 798px) {
  .custom-collection-list .product-wrap .collection-info__caption:after{
    opacity: 1;
  }
}
  .custom-collection-list .product-wrap:hover .collection-info__caption:after{
    opacity: 1;
  }
  .custom-collection-list .product-wrap:hover .has-image-crop img{
      filter: blur(7px);
  }
{% endstyle %}

<section class="section
                {{ atb_css_class }}
                is-width-{{ atb_width }}
                {% if atb_show_gutter == false %}
                  has-no-side-gutter
                  has-background
                {% else %}
                  has-gutter-enabled
                {% endif %}
                {% if blocks.size > atb_collections_per_row %}
                  has-multirow-blocks
                {% endif %}
                "
                {% if atb_animation != "none" %}
                  data-scroll-class="{{ atb_animation }}"
                {% endif %}>

  <div class="container">
    {% if blocks.size > 0 %}

      {% for block in blocks %}

        {% comment %} Content settings {% endcomment %}
        {%- assign collection = collections[block_feature_collection[forloop.index0]] -%}
        {%- assign image = my_image0 -%}
        {%- assign title = block_title[forloop.index0] -%}
        {%- assign button_label = block_button_label[forloop.index0] -%}
        {% comment %} End content settings {% endcomment %}

        {% if image != blank %}
          {%- assign collection_image = image -%}
          {%- assign collection_image_alt = image.alt | escape -%}
        {% elsif collection.image != blank %}
          {%- assign collection_image = collection.image -%}
          {%- assign collection_image_alt = collection.image.alt | escape -%}
        {% else collection.empty? == false %}
          {%- assign collection_image = collection.products.first.featured_image -%}
          {%- assign collection_image_alt = collection.products.first.featured_image.alt | escape -%}
        {% endif %}

        <div class="column
                    {% render 'column-width', value: atb_collections_per_row %}
                    thumbnail
                    {% if atb_align_height %}
                      list-collection--align-height
                    {% endif %}
                    {% if atb_show_gutter == true %}
                      has-gutter has-gutter--mobile
                    {% endif %}
                    list-collection__thumbnail medium-down--one-half small-down--one-whole">

          <div class="product-wrap enable-zoom-{{ atb_enable_zoom }}">
            <div class="collection-thumbnail-overlay"></div>

            {% if collection_image != blank %}
              <div class="thumbnail image__container has-image-crop">
                {%
                  render 'image-element',
                  image: collection_image.src,
                  alt: collection_image_alt,
                  image_crop: true,
                  max_height: collection_height,
                %}
              </div>
            {% else %}
              {% capture num %}{% cycle "1", "2", "3", "4", "5", "6" %}{% endcapture %}
              {{ 'collection-' | append: num | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            <a class="collection-info__caption" href="{{ collection.url }}">
              {% if atb_collection_title_below_image == blank %}
                <div class="collection-info__caption-wrapper">
                  <span class="title">
                    {% if title != blank %}
                      {{ title }}
                    {% elsif collection != blank %}
                      {{ collection.title }}
                    {% else %}
                      {{ "homepage.onboarding.collection_title" | t }}
                    {% endif %}
                  </span>
                  {% render 'button',
                          label: button_label,
                          href: collection.url,
                          style: atb_button_style
                  %}
                </div>
              {% endif %}
            </a>
          </div>
          {% if atb_collection_title_below_image != blank %}
            <a class="collection-info__caption-wrapper collection-info__caption--below-image" href="{{ collection.url }}">
              <span class="title">
                {% if title != blank %}
                  {{ title }}
                {% elsif collection != blank %}
                  {{ collection.title }}
                {% else %}
                  {{ "homepage.onboarding.collection_title" | t }}
                {% endif %}
              </span>
              {% render 'button',
                      label: button_label,
                      href: collection.url,
                      style: atb_button_style
              %}
            </a>
          {% endif %}
        </div>

      {% endfor %}

    {% endif %}
  </div>
</section>


</section>