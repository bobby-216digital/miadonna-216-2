<section id="shopify-section-{{section_id}}" class="shopify-section rich-text">
{% comment %}
  ** Rich text **
{% endcomment %}

{%- assign title = atb_title -%}
{%- assign heading_font = atb_heading_font -%}
{%- assign heading_color = atb_heading_color -%}
{%- assign heading_alignment = atb_heading_alignment -%}
{%- assign heading_size = atb_heading_size -%}
{%- assign text = atb_text -%}
{%- assign text_font = atb_text_font -%}
{%- assign text_color = atb_text_color -%}
{%- assign text_alignment = atb_text_alignment -%}
{%- assign text_size = atb_text_size -%}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign heading_alpha = heading_color | color_extract: 'alpha' -%}
{%- assign text_alpha = text_color | color_extract: 'alpha' -%}
{%- assign background_alpha = atb_background | color_extract: 'alpha' -%}
{%- assign gradient_alpha = atb_gradient | color_extract: 'alpha' -%}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}
  .section {
    background-image: linear-gradient({{ atb_gradient_rotation }}deg, rgba(255,255,255,0), {{ atb_gradient }});
    background-color: {%- if background_alpha != 0 -%}{{ atb_background }}{%- endif -%};
  }
  .rich-text__heading {
    font-size: {{ heading_size }}px;
    color: {%- if heading_alpha != 0 -%}{{ heading_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: {{ heading_font.weight }};
    font-style: {{ heading_font.style }};
    text-transform: uppercase;
    word-break:break-word;
  }
  .rich-text__text {
    font-size: {{ text_size }}px;
    color: {%- if text_alpha != 0 -%}{{ text_color }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
    font-family: {{ text_font.family }}, {{ text_font.fallback_families }};
    font-weight: {{ text_font.weight }};
    font-style: {{ text_font.style }};
    margin-bottom: 0;
    text-align:center;
  }
  .rich-text__text.content > * {
    font-size: inherit;
    font-family: inherit;
    margin: 0;
  }
  .rich-text__text.content > h1 {
    line-height: 50px;
  }
  .rich-text__content .button {
    width: 500px;
    font-weight: 600;
    min-height: 67px;
    margin-top: 45px;
  }
  .rich-text__content .button:hover {
    border-width: 3px;
    color: {{ atb_button_background }} !important;
    background-color: transparent !important;
    border-color: {{ atb_button_background }} !important;
  }
{%- endcapture -%}

{% style %}
  {{ heading_font | font_face }}
  {{ text_font | font_face }}

  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' %}
      width: 100%;

     {% elsif atb_width == 'one-third' %}
      width: 70%;
    {% elsif atb_width == 'half' %}
      width: 50%;
    {% endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  @media screen and (max-width: 1200px){
    #shopify-section-{{ section_id }} .rich-text__text {
      /* font-size: 28px; */
    }
  }
  @media screen and (max-width: 767px){
     #shopify-section-{{ section_id }} .rich-text__heading {
       font-size: 22px;
     }
    #shopify-section-{{ section_id }} .your-ring .rich-text__heading {
       font-size: 24px;
     }
    #shopify-section-{{ section_id }} .rich-text__text {
      font-size: 14px;
    }
    #shopify-section-{{ section_id }} .rich-text__content .rich-text__text > h1 {
      line-height: 30px;
    }
     #shopify-section-{{ section_id }} {
        padding-top: 30px;
        padding-bottom:30px;
     }
    #shopify-section-{{ section_id }} .rich-text__content {
      padding-top: 0;
    }
    #shopify-section-{{ section_id }} .rich-text__content .button {
      width: 100%;
      min-height: 57px;
      margin-top: 25px;
      font-size: 13px !important;
    }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  id="{{ atb_id_sec }}"
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if background_alpha != 0 or gradient_alpha != 0  %}
      has-background
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div
    class="
      container
      has-limit
    "
  >
    <div class="columns one-whole">
      <div class="rich-text__content card-content">
        {% if title != blank %}
          <h2 class="rich-text__heading title text-align-{{ heading_alignment }} {% if heading_size > 50 %}mobile-shrink-text{% endif %}">
            {{ title }}
          </h2>
        {% endif %}

        {% if text != blank %}
          <div class="rich-text__text has-columns--{{ atb_columns }} text-align-{{ text_alignment }} content {% if text_size > 35 %}mobile-shrink-text{% endif %}">
            {{ text | replace: 'href="#lets-chat"', "href=javascript:void(0); onclick=Chatra('openChat',true)" }}
          </div>
        {% endif %}

        {% if atb_button_label != blank %}
          <div class="buttons is-{{ atb_button_alignment }}">
            {% render 'button',
              label: atb_button_label,
              href: atb_button_link,
              style: atb_button_style,
              text_color: atb_button_text,
              background_color: atb_button_background,
              type: 'link'
            %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>


</section>