{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_divider_style' -%}
{%- assign atb_divider_style = val -%}
{%- include 'atb-render' field:'atb_divider_width' -%}
{%- assign atb_divider_width = val -%}
{%- include 'atb-render' field:'atb_divider_color' -%}
{%- assign atb_divider_color = val -%}
{%- include 'atb-render' field:'atb_alignment' -%}
{%- assign atb_alignment = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'undefined' -%}
{%- assign undefined = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- assign atb_divider_width = atb_divider_width | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section divider-section">
{% comment %}
** Divider **
{% endcomment %}

{%- assign divider_style = atb_divider_style -%}
{%- assign divider_width = atb_divider_width -%}
{%- assign divider_color = atb_divider_color -%}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign divider_alpha = divider_color | color_extract: 'alpha' -%}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}
  .heading-divider:not(.heading-divider--vertical) {
    border-color: {%- if divider_alpha != 0 -%}{{ divider_color }}{%- endif -%};
    border-width: {%- if divider_width == 1 -%}thin{%- else -%}{{ divider_width }}px{%- endif -%};
  }

  .heading-divider--vertical {
    background: {%- if divider_alpha != 0 -%}{{ divider_color }}{%- endif -%};
    width: {{ divider_width }}px;
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  {%
    render 'css-loop',
    css: section_css,
    id: section_id
  %}

  {%
    render 'css-loop',
    css: atb_custom_css,
    id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ atb_css_class }}
    is-width-{{ atb_width }}
  "
  {% if atb_animation != "none" %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="container">
    <div class="one-whole column">
      <div
        class="
          divider-section__content
          is-flex
          is-flex-column
          is-align-{{ atb_alignment }}
        "
      >
        <div class="heading-divider heading-divider--{{ divider_style }}"></div>
      </div>
    </div>
  </div>
</section>



</section>