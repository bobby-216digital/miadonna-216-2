{% comment %}
ATB-SCHEMA{
  "name": "Blog Mobile Menu",
  "id": "blog-mobile-menu",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "class": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "link_list",
      "id": "atb_blog_menu",
      "label": "Select Menu",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_breadcrumb",
      "default": false,
      "label": "Show/Hide breadcrumb",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_blog_title",
      "default": false,
      "label": "Show/Hide Top Blog Title",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block Type",
      "info": "",
      "default": "",
      "options": [
        {
          "value": "search",
          "label": "search"
        }
      ],
      "repeatable": "block"
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "block"
    },
    {
      "type": "select",
      "id": "block_search_results",
      "label": "Search results",
      "options": [
        {
          "value": "article",
          "label": "Blog posts"
        }
      ],
      "default": "article",
      "repeatable": "block",
      "info": "",
      "conditional": "block_type:search"
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_blog_menu' -%}
{%- assign atb_blog_menu = val -%}
{%- include 'atb-render' field:'atb_breadcrumb' -%}
{%- assign atb_breadcrumb = val -%}
{%- include 'atb-render' field:'atb_blog_title' -%}
{%- assign atb_blog_title = val -%}
{%- include 'atb-render' field:'block_type' -%}
{%- assign block_type = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_search_results' -%}
{%- assign block_search_results = val -%}
{%- if atb_breadcrumb == blank -%}
{%- assign atb_breadcrumb = false -%}
{%- else -%}
{%- assign atb_breadcrumb = true -%}
{%- endif -%}
{%- if atb_blog_title == blank -%}
{%- assign atb_blog_title = false -%}
{%- else -%}
{%- assign atb_blog_title = true -%}
{%- endif -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section ">
{% assign id = section_id %}
{% comment %}Layout{% endcomment %}
{% assign width = atb_width %}
{% assign padding_top = atb_padding_top %}
{% assign padding_bottom = atb_padding_bottom %}
{% assign animation = atb_animation | default: 'none' %}
{% comment %} Advanced {% endcomment %}
{% assign css_class = atb_css_class %}
{% assign custom_css = atb_custom_css %}

{% comment %} CSS {% endcomment %}
{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  .sidebar-section {
    {% if atb_sidebar_position == 'right' %}
      order: 1;
    {% endif %}
  }

  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section is-width-wide section-blog-menu blog-mobile-menu
    {{ css_class }}
    is-width-{{ width }}
  "
  {% if animation != 'none' %}
    data-scroll-class="{{ animation }}"
  {% endif %}
>
  {% if atb_breadcrumb %}
    <div class="section">
      <div class=" breadcrumbs">
      {% render 'blog-breadcrumb' %}
      </div>
    </div>
  {% endif %}
   {% if atb_blog_title %}
  <div class="section topic-banner">
    <h2 class="image-with-text-overlay__heading banner__heading title" style="color: #000;text-align:center;">
      <span>THE <span>Blog</span></span>
    </h2>
  </div>
  {% endif %}
  <div class="container top-blog-section">
    <select-menu>
      <div class="sidebar-block__select-wrapper">
        <div id="selectBtn" class="sidebar-block__select">
          <span class="sidebar-block__links">
            {% for link in atb_blog_menu.links %}
              {% if link.active %}
                {% if link.title == 'All' %}
                  Blog Filter
                {% else %}
                  {{ link.title | escape }}
                {% endif %}
              {% endif %}
            {% endfor %}
          </span>
          <span class="icon-caret-wrapper">
            <i class="icon-solid-caret"></i>
          </span>
        </div>
        <div
          class="sidebar-block__contents hide"
        >
          {% if atb_blog_menu %}
            <div class="blog-menu column medium-down--one-whole">
              {% render 'sidebar__menu', menu: atb_blog_menu %}
            </div>
          {% endif %}
          {% for block0 in blocks %}
            <div class="blog-search-bar column one-fifth medium-down--one-whole">
              {% if block_type[forloop.index0] == 'search' %}
                {% render 'sidebar__search', block: block, context: 'sidebar' %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </select-menu>
  </div>
</section>

<script src="{{ 'select-menu.js' | asset_url }}" defer="defer"></script>



<style>
</style>

<script type="application/javascript">
</script>
</section>