<section id="shopify-section-{{section_id}}" class="shopify-section collection-block home-collection-block jsHomeCollectionBlocks">
<style>
  #shopify-section-{{ section_id }} .home-collection-block--slider{
    width: 95%;
    margin-bottom:30px
  }
  {% comment %} #shopify-section-{{ section_id }} .flickity-viewport{
    margin-left: -5px;
  } {% endcomment %}
  #shopify-section-{{ section_id }} .flickity-button{
    top: 45%;
    padding: 0;
    outline: none;
    box-shadow: none;
    background-color: transparent;
  }
  .flickity-prev-next-button .flickity-button-icon{
    margin: 0;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button.previous{
    left: -20px;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button.next{
    right: -30px;
  }
  #shopify-section-{{ section_id }} .column{
    margin-left: 10px;
    margin-right: 10px;
  }
  .collection-block-wrapper h2 {
    font-size: 18px;
    line-height: 24px;
    font-weight: 500;
}
  .home-collection-block .collection-block-wrapper h3 {
    font-size: 16px;
    text-align: left !important;
    font-weight: 300 !important;
    text-transform: initial !important;
    line-height: 26px;
    margin-bottom:10px;
  }
  .home-collection-block .collection-block .hover-image{
    display:none;
  }
  .home-collection-block .collection-block:hover .before-image{
    display:none;
  }
  .home-collection-block .collection-block:hover .hover-image{
    display:block;
  }
   .home-collection-block .collection-link{
     position:relative;
   }
  .home-collection-block .collection-link:after{
    background-color: #dea595;
    bottom: -2px;
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    transition: width .8s;
    width: 80px;
    z-index: 0;
  }
  .home-collection-block .collection-link:hover::after{
    width:0;
  }
  
  #shopify-section-{{ section_id }} .home-collection-block--slider.no-slider .image-element__wrap{
    margin: 0;
  }
   #shopify-section-{{ section_id }} .collection-block .image-element__wrap {
    height: auto;
    /* max-width: 100% !important; */
    border-radius:0;
  }
  .collection-block img {
    max-width: 100%;
    height: auto;
    margin-bottom: 0;
  }
  .collection-block h6{
    text-align: center;
    margin-top: 15px;
    font-style: italic;
    font-family: 'Playfair Display', serif;
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section_id }} .flickity-prev-next-button.previous{
      left: -5px;
    }
    #shopify-section-{{ section_id }} .flickity-prev-next-button.next{
      right: -5px;
    }
  }
  @media screen and (max-width: 767px){
    .home-collection-block .small-down--one-half {
        width: 60% !important;
      }
    .home-collection-block .collection-block-wrapper h2 {
    font-size: 18px;
    }
    .home-collection-block .collection-block-wrapper h3{
      font-size: 14px;
    }
    .collection-block h6{
      font-size: 15px;
    }
    .flickity-prev-next-button .flickity-button-icon {
      width: 20px;
      height: 20px;
    }
     #shopify-section-{{ section_id }} .flickity-prev-next-button.previous{
    left: 0px;
  }
  #shopify-section-{{ section_id }} .flickity-prev-next-button.next{
    right: 0px;
  }
  }
</style>

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section_id }} {
    background-color: {{ atb_background_color }};
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if atb_hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section_id }} .home-collection-block--slider.no-slider:after {
    content: "flickity";
    display: none; /* hide :after */
  }
  @media screen and (min-width: 1025px) {
    /* disable Flickity for large devices */
    #shopify-section-{{ section_id }} .home-collection-block--slider.no-slider:after {
      content: "";
    }
  }
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-collection-blocks
    {{ atb_css_class }}
    is-width-{{ atb_width }}
    {% if atb_show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if atb_width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if atb_animation != 'none' %}
    data-scroll-class="{{ atb_animation }}"
  {% endif %}
>
  <div class="collection-block-wrapper">
    {% if atb_main_title != blank %}
      <div style="color: {{ atb_text_color }};">{{ atb_main_title }}</div>
    {% endif %}
    <div
      class="container home-collection-block--slider {% if blocks.size <= 5 %}no-slider{% endif %}"
      style="flex-wrap: nowrap;"
      data-products-per-slide="5"
      data-products-limit="{% if blocks.size > 5 %}15{% else %}5{% endif %}"
      data-products-available="{% if blocks.size > 5 %}15{% else %}5{% endif %}"
    >
      {% for block0 in blocks %}
{%- assign my_image_key1 = block_image-2[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image1 = images[my_image_key1] -%}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}
        <div class="collection-block one-fifth column large-down--one-fourth medium-down--one-third small-down--one-half">
          {% if block_url[forloop.index0] != blank %}
            <a
              href="{{ block_url[forloop.index0] }}"
              class="collection-link"
              style="color: {{ atb_text_color }};"
            >
          {% endif %}
          {% if my_image0 != blank %}
            {%
              render 'image-element',
              image: my_image0,
              alt: block_image_alt[forloop.index0],
               additional_classes:'before-image',
            %}
          {% else %}
            <div class="image-element__wrap" style="height: auto;">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% if my_image1 != blank %}
            {%
              render 'image-element',
              image: my_image1,
              alt: block_image_alt[forloop.index0],
              additional_classes:'hover-image',
            %}
        {% endif %}
          {% if block_title[forloop.index0] != blank %}
            <h6 style="color: {{ atb_text_color }};">{{ block_title[forloop.index0] }}</h6>
          {% endif %}
          {% if block_url[forloop.index0] != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsHomeCollectionBlock.js' | asset_url }}"></script>


</section>