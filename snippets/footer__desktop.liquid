<div class="footer__desktop large-down--hidden">
  <div class="container contanier-nw has-limit is-justify-space-between footerlr-space">
    {% for block in section.blocks %}
      {% if block.type != 'text' and block.type != 'newsletter' %}
      <div id="shopify-section-{{ block.id }}"
        class="
          footer__block block__{{ block.id }} block__{{ block.type | downcase | replace: '_', '-' }}
          {% render 'column-width', value: section.blocks.size %}
          medium-down--one-whole column
        "
        {{ block.shopify_attributes }}
      >
        {% endif %}
        {% if block.type == 'logo' %}
          {% comment %} Logo and text {% endcomment %}
          <div class="footer-logo">
            <a
              href="{{ routes.root_url }}"
              title="{{ shop.name }}"
              class="footer__logo-wrapper has-padding-bottom is-{{ block.settings.size }}" aria-label="MiaDonna Logo"
            >
              {% if block.settings.logo %}
                {%
                  render 'image-element',
                  image: block.settings.logo,
                  alt: block.settings.logo.alt,
                  additional_classes: 'footer__logo',
                  focal_point: block.settings.logo.presentation.focal_point,
                %}
              {% else %}
                <h2 class="footer__heading">{{ shop.name }}</h2>
              {% endif %}
            </a>
            {% if block.settings.text != blank %}
              {{ block.settings.text }}
            {% endif %}
            {% if block.settings.social_icons_footer %}
              <div class="has-padding-bottom has-padding-top">
                {% render 'social-icons' %}
              </div>
            {% endif %}
          </div>

        {% elsif block.type == 'html' %}
          {{ block.settings.html_content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}

        {% elsif block.type == 'link_list' %}
          {% comment %} Menu {% endcomment %}
          {% render 'footer__menu', menu_link: block.settings.menu %}

          {% if block.settings.social_icons_footer %}
            <div class="has-padding-bottom has-padding-top">
              {% render 'social-icons' %}
            </div>
          {% endif %}

        {% endif %}


          
          
  {% if block.type != 'text' and block.type != 'newsletter' %}
    </div>
    {% endif %}
      {% endfor %}


    <div class="newslettertext-row">
      {% for block in section.blocks %}
        {% if block.type == 'text' or block.type == 'newsletter' %}
      <div id="shopify-section-{{ block.id }}" class=" footer__block block__{{ block.id }} block__{{ block.type | downcase | replace: '_', '-' }}
          {% render 'column-width', value: section.blocks.size %}
          medium-down--one-whole column">
      {% endif %}  
        {% if block.type == 'text' %}
          {% comment %} Text {% endcomment %}
          {% if block.settings.title != blank %}
            <p class="footer__heading">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.content != blank %}
            {{ block.settings.content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
          {% endif %}

          <div class="footer__logos">
            {% comment %}
            <a>
            {% endcomment %}
              <img
                loading="lazy"
                class="lv-footer-bcorp"
                src="https://cdn.shopify.com/s/files/1/1164/4258/files/certified-b.svg?v=1759240627"
                alt="Certified B Corporation"
                width="auto"
                height="auto"
                tabindex="0"
              >          
              {% comment %} <img
                loading="lazy"
                class="lv-footer-bcorp"
                src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/t/485/assets/bbb.png?v=1753200123"
                alt="BBB"
                width="auto"
                height="auto"
              tabindex="0"
              > {% endcomment %}
            
            {% comment %}
            </a>
            {% endcomment %}
            {% comment %}
            <a href="#">
              <img
                loading="lazy"
                class="lv-footer-bcorp"
                src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/BBB.png?v=1671670895"
                alt="BBB"
                width="auto"
                height="auto"
              >
            </a>          
            <a target="_blank" style="margin-left: -10px;" href="https://app.ecodrive.community/public-dashboard/10c7dc99-ae32-4c3a-98e8-6166eb179558">
              <img
                loading="lazy"
                class="lv-footer-bcorp"
                src="https://cdn.shopify.com/s/files/1/1164/4258/files/5__1_1_-cropped.svg?v=1739884077"
                alt="Ecodrive"
                width="auto"
                height="auto"
                style="width:100%;"
              >
            </a>{% endcomment %}
            
          </div>

          {% if block.settings.social_icons_footer %}
            <div class="has-padding-bottom has-padding-top">
              {% render 'social-icons' %}
            </div>
          {% endif %}

          
            {% elsif block.type == 'newsletter' %}
              {% comment %} Newsletter {% endcomment %}
              <div class="newsletter-text">
              {% if block.settings.newsletter_title != blank %}
                <p class="footer__heading" tabindex="0">
                  {{ block.settings.newsletter_title }}
                </p>
              {% endif %}
      
              {% if block.settings.newsletter_richtext != blank %}
                <div class="content" tabindex="0">
                  {{ block.settings.newsletter_richtext }}
                </div>
              {% endif %}
              </div>
            
              {% render 'newsletter-form',
                type: 'block',
                footer_name: 'desktop',
                display_first_name: block.settings.display_first_name,
                display_last_name: block.settings.display_last_name
              %}

              <div class="social-icons--wrapper">
            <ul class="social-icons is-flex is-flex-wrap ">
              {% if settings.instagram_link != '' %}
                <li>
                  <a
                    href="{{ settings.instagram_link }}"
                    title="{{ shop.name }} on Instagram"
                    rel="me"
                    target="_blank"
                    class="icon-instagram"
                  >
              
                    <span class="icon" data-icon="instagram">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        width="47"
                        height="47"
                        viewBox="3132 1585 47 47"
                      >
                        <title>Instagram</title>
                        <image width="47" height="47" xlink:href="data:image/png;base64," data-name="instagram-icon-white-on-black-circle" transform="translate(3132 1585)"></image>
                      </svg>
                    </span>
                  </a>
                </li>
              {% endif %}
              {% if settings.pinterest_link != '' %}
                <li>
                  <a
                    href="{{ settings.pinterest_link }}"
                    title="{{ shop.name }} on Pinterest"
                    rel="me"
                    target="_blank"
                    class="icon-pinterest"
                  >
                    <span class="icon" data-icon="pinterest">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        width="48"
                        height="46"
                        viewBox="3383 1584 48 46"
                      >
                        <title>Pinterest</title>
                        <image width="48" height="46" xlink:href="data:image/png;base64," data-name="pinterest" transform="translate(3383 1584)"></image>
                      </svg>
                    </span>
                  </a>
                </li>
              {% endif %}
              {% if settings.facebook_link != '' %}
                <li>
                  <a
                    href="{{ settings.facebook_link }}"
                    title="{{ shop.name }} on Facebook"
                    rel="me"
                    target="_blank"
                    class="icon-facebook"
                  >
                    <span class="icon" data-icon="facebook">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        width="47"
                        height="46"
                        viewBox="3216 1586 47 46"
                      >
                        <title>Facebook</title>
                        <image width="47" height="46" xlink:href="data:image/png;base64," data-name="fb" transform="translate(3216 1586)"></image>
                      </svg>
                    </span>
                  </a>
                </li>
              {% endif %}
              {% if settings.tiktok_link != '' %}
                <li>
                  <a
                    href="{{ settings.tiktok_link }}"
                    title="{{ shop.name }} on TikTok"
                    rel="me"
                    target="_blank"
                    class="icon-tiktok"
                  >
                    <span class="icon" data-icon="tiktok">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        width="46"
                        height="46"
                        viewBox="3300 1584 46 46"
                      >
                        <title>Tiktok</title>
                        <image width="46" height="46" xlink:href="data:image/png;base64," data-name="tik-tok-flat-icon-template-black-color-editable-tik-tok-flat-icon-symbol-flat-illustration-for-graphic-and-web-design-free-vector" transform="translate(3300 1584)"></image>
                      </svg>
                    </span>
                  </a>
                </li>
              {% endif %}
            </ul>
          </div>
            {% endif %}
  {% if block.type == 'text' or block.type == 'newsletter' %}
      </div>
            {% endif %}
    {% endfor %}
    </div>
  </div>
  <div class="contanier-nw">  
      <div class="footer__store-info container">
        {% if locale_selector or currency_selector or settings.show_multiple_currencies %}
        <div class="currency-wrapper is-flex">    
            <div class="column">
              <div class="footer-menu__disclosure footer-classic__disclosure">
                {% render 'localization-switcher',
                  additional_classes: 'footer-menu__disclosure',
                  id: 'footer__selector-form',
                  currency_selector: currency_selector,
                  locale_selector: locale_selector,
                  show_currency: show_currency
                %}
              </div>
            </div>
          {% endif %}
          {% if section.settings.display_payment_methods %}
            <div class="footer__payment-methods one-whole column">
              <div class="payment-methods">
                {% for type in shop.enabled_payment_types limit: 6 %}
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                {% endfor %}
              </div>
            </div>      
        </div>
        {% endif %}
        <ul class="footer__policy one-half medium-down--one-whole column">
          <li>
            <p tabindex="0">
              &copy; {{ 'now' | date: '%Y' }}
              {{ shop.name | link_to: shop.url }} & Co.
            </p>
            {{ section.settings.copyright_text }}
            {% if section.settings.display_designed_by %}
              <p>{{ 'layout.general.designer_credits_html' | t }}</p>
            {% endif %}
            {% if section.settings.display_shopify %}
              <p>{{ powered_by_link }}</p>
            {% endif %}
          </li>
        </ul>
        <ul class="footer__policy right one-half medium-down--one-whole column">
          {% for link in linklists['footer-4'].links %}
            <li class="footer__policy-link">
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
            {% if forloop.last != true %}
              <!-- <li>|</li> -->
            {% endif %}
          {% endfor %}
        </ul>
        {% comment %}
          <div class="footer__credits one-whole column">
            <p>
              &copy; {{ 'now' | date: '%Y' }}
              {{ shop.name | link_to: routes.root_url }} & Co.
            </p>
            {{ section.settings.copyright_text }}
            {% if section.settings.display_designed_by %}
              <p>{{ 'layout.general.designer_credits_html' | t }}</p>
            {% endif %}
            {% if section.settings.display_shopify %}
              <p>{{ powered_by_link }}</p>
            {% endif %}
          </div>
        {% endcomment %}
      </div>
    </div>
</div>
