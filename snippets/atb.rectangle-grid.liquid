      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "header",
      "content": "Show slider",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_slider",
      "label": "Show slider",
      "default": false,
      "info": ""
    },
    {
      "type": "header",
      "content": "Content",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_title",
      "label": "Section title",
      "info": ""
    },
    {
      "type": "font_picker",
      "id": "atb_heading_font",
      "label": "Font",
      "default": "open_sans_n4",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_sub_title",
      "label": "Section sub title",
      "info": ""
    },
    {
      "type": "font_picker",
      "id": "atb_sub_title_font",
      "label": "Font",
      "default": "open_sans_n4",
      "info": ""
    },
    {
      "type": "header",
      "content": "Layout",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_gutter",
      "label": "Show gutter",
      "default": true,
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "atb_css_class",
      "label": "CSS Class",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_custom_css",
      "label": "Custom CSS",
      "info": ""
    },
    {
      "type": "text",
      "id": "blocks",
      "label": "Block ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": "",
      "repeatable": "Column"
    },
    {
      "type": "image_picker",
      "label": "Image",
      "id": "block_image",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "text",
      "label": "Image Alt Text",
      "id": "block_image_alt",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "text",
      "label": "Title",
      "id": "block_title",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "label": "Description",
      "id": "block_description",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "text",
      "label": "Button text",
      "id": "block_button_text",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "text",
      "label": "Link",
      "id": "block_button_link",
      "repeatable": "Column",
      "info": ""
    },
    {
      "type": "select",
      "id": "block_button_style",
      "label": "Style",
      "options": [
        {
          "value": "button--primary",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--link-style",
          "label": "Link style"
        }
      ],
      "default": "button--primary",
      "repeatable": "Column",
      "info": ""
    }
  ],
  "warnings": [
    "repeating image fields may not be properly handled"
  ]
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
