{% comment %}
ATB-SCHEMA{
  "name": "Rectangle Grid",
  "class": "rectangle-grid jsRectangleGrid",
  "id": "rectangle-grid",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
