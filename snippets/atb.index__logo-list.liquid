          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "info": ""
    },
    {
      "type": "header",
      "content": "Background",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_background",
      "label": "Background",
