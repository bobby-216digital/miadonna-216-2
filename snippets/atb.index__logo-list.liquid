{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_logos_per_row' -%}
{%- assign atb_logos_per_row = val -%}
{%- include 'atb-render' field:'atb_logo_size' -%}
{%- assign atb_logo_size = val -%}
{%- include 'atb-render' field:'atb_background' -%}
{%- assign atb_background = val -%}
{%- include 'atb-render' field:'atb_gradient' -%}
{%- assign atb_gradient = val -%}
{%- include 'atb-render' field:'atb_gradient_rotation' -%}
{%- assign atb_gradient_rotation = val -%}
{%- include 'atb-render' field:'atb_width' -%}
{%- assign atb_width = val -%}
{%- include 'atb-render' field:'atb_padding_top' -%}
{%- assign atb_padding_top = val -%}
{%- include 'atb-render' field:'atb_padding_bottom' -%}
{%- assign atb_padding_bottom = val -%}
{%- include 'atb-render' field:'atb_padding_left' -%}
{%- assign atb_padding_left = val -%}
{%- include 'atb-render' field:'atb_padding_right' -%}
{%- assign atb_padding_right = val -%}
{%- include 'atb-render' field:'atb_animation' -%}
{%- assign atb_animation = val -%}
{%- include 'atb-render' field:'undefined' -%}
{%- assign undefined = val -%}
{%- include 'atb-render' field:'atb_css_class' -%}
{%- assign atb_css_class = val -%}
{%- include 'atb-render' field:'atb_custom_css' -%}
{%- assign atb_custom_css = val -%}
{%- include 'atb-render' field:'blocks' -%}
{%- assign blocks = val -%}
{%- include 'atb-render' field:'block_image' -%}
{%- assign block_image = val -%}
{%- include 'atb-render' field:'block_link' -%}
{%- assign block_link = val -%}
{%- assign atb_logos_per_row = atb_logos_per_row | plus: 0 -%}
{%- assign atb_gradient_rotation = atb_gradient_rotation | plus: 0 -%}
{%- assign atb_padding_top = atb_padding_top | plus: 0 -%}
{%- assign atb_padding_bottom = atb_padding_bottom | plus: 0 -%}
{%- assign atb_padding_left = atb_padding_left | plus: 0 -%}
{%- assign atb_padding_right = atb_padding_right | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section logo-list">
{% comment %}
** Logo list **
{% endcomment %}

{% comment %} Is the color set to transparent? {% endcomment %}
{%- assign background_alpha = atb_background | color_extract: 'alpha' -%}
{%- assign gradient_alpha = atb_gradient | color_extract: 'alpha' -%}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}
  .section {
    background-image: linear-gradient({{ atb_gradient_rotation }}deg, rgba(255,255,255,0), {{ atb_gradient }});
    background-color: {%- if background_alpha != 0 -%}{{ atb_background }}{%- endif -%};
  }
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section_id }} {
    padding-top: {{ atb_padding_top }}px;
    padding-bottom: {{ atb_padding_bottom }}px;
    padding-left: {{ atb_padding_left }}px;
    padding-right: {{ atb_padding_right }}px;
    {% if atb_width == 'wide' %}
      width: 100%;
    {% elsif atb_width == 'half' %}
      width: 50%;
    {% endif %}
  }
  {% render 'css-loop',
          css: section_css,
          id: section_id
  %}
  {% render 'css-loop',
          css: atb_custom_css,
          id: section_id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section class="section
                {{ atb_css_class }}
                is-width-{{ atb_width }}
                {% if background_alpha != 0 or gradient_alpha != 0  %}
                  has-background
                {% endif %}
                "
                {% if atb_animation != "none" %}
                  data-scroll-class="{{ atb_animation }}"
                {% endif %}>
  <div class="container
              has-column-padding-bottom
              is-justify-center
              is-align-center
              small-down--has-limit
              is-{{ atb_logo_size }}
              logo-list__wrapper
              ">
    {% if blocks.size > 0 %}
      {% for block0 in blocks %}
{%- assign my_image_key0 = block_image[forloop.index0]| split: '/files/' | last -%}
{%- assign my_image0 = images[my_image_key0] -%}

        {% comment %}Add number to id for each loop{% endcomment %}
        {% capture image %}image{{ index }}{% endcapture %}
        {% capture link %}link{{ index }}{% endcapture %}

        {%- assign image = my_image0] -%}

          <div class="logo-list__item
            small-down--one-half
            column
            {% if atb_logos_per_row == 1 %}
              one-whole
            {% elsif atb_logos_per_row == 2 %}
              one-half
            {% elsif atb_logos_per_row == 3 %}
              one-third
            {% elsif atb_logos_per_row == 4 %}
              one-fourth
            {% elsif atb_logos_per_row == 5 %}
              one-fifth
            {% elsif atb_logos_per_row == 6 %}
              one-sixth
            {% elsif atb_logos_per_row == 7 %}
              one-seventh
            {% elsif atb_logos_per_row == 8 %}
              one-eighth
            {% endif %}" {% if type != 'block' %}{{ block.shopify_attributes }}{% endif %}>
            {% if block_link[forloop.index0]] != blank %}
              <a href="{{ block_link[forloop.index0]] }}" class="logo-list__link">
            {% endif %}
            {% if image != blank %}
              {%- assign alt_text = image.alt -%}
              {%
                render 'image-element',
                image: image,
                alt: alt_text,
                focal_point: image.presentation.focal_point,
              %}
            {% else %}
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block_link[forloop.index0]] != blank %}
              </a>
            {% endif %}
          </div>
      {% endfor %}
    {% endif %}
  </div>
</section>



</section>