      "info": ""
    },
    {
      "type": "color",
      "id": "atb_gradient",
      "label": "Gradient",
      "default": "rgba(0,0,0,0)",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_gradient_rotation",
