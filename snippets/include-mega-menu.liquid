<div class="mmdesk">
    <div class="mmdesk-content">
        <!-- Left Panel -->
        <div class="mmleft-panel" role="tablist" aria-label="Shop Categories">
            {%- for block in section.blocks -%}
              {%- if block.type == 'menu' -%}
                {%- assign link_title = linklists[block.settings.menu_1].title -%}
                {%- assign link_title_dn = link_title | handleize | remove:'by-' -%}
                  {% if block.settings.menu_submenu_title != blank and link_title contains 'EXCLUSIVE' %}
                    {%- assign link_title = block.settings.menu_submenu_title -%}
                   {%  endif  %}
                <button id="tab-{{ link_title_dn }}" class="left-panel-item" role="tab" aria-controls="mm{{ link_title_dn }}" aria-selected="true" data-target="mm{{ link_title_dn }}">{{ link_title }}</button>
                  {%- assign link_title = linklists[block.settings.menu_1].title -%}
              {%- endif -%}
            {%- endfor -%}
        </div>

        <!-- Right Panel - By Style -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            {%- assign menu = linklists[block.settings.menu_1] -%}
            {%- assign link_title = menu.title -%}
            {%- assign collectionmenu = '' -%}
            {%  if block.settings.collection_menu !=blank  %}
            {%- assign collectionmenu = linklists[block.settings.collection_menu] -%}
