              <div class="mm-gridboxright {% if block.settings.menu_show_links_only %} mm-linkright{% endif %}">
                  <div class="mm-shopall {% if block.settings.menu_1_title != "" %}{% else %}mm-shopspace{% endif %}"> 
                    <div class="mmobile-subtopbar mm-show">
                      <button type="button" class="botton-bbnone mm-inputbackbutton" aria-label="Go back to {{ title }} navigation">
                        {% render 'leftarrow' %}
                      {{ title }}
                        </button>
                    </div>
                   {% if block.settings.menu_1_title != "" %} <a href="{{ block.settings.menu_1_link }}" class="mm-shopalltext line-hover">{{block.settings.menu_1_title}}</a> {% endif %}
