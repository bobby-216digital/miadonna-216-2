{% comment %}
  Facebook Open Graph meta tags
{% endcomment %}

<meta name="author" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">

{%- capture page_image -%}
  <meta property="og:image" content="{%- if template == 'product.loose-lab-diamond' or collection.handle == 'loose-lab-grown-diamonds' -%}{{ settings.speedsize_url_pfx -}}https:{{ page_image | img_url: '1200x' | append:'&speedsizeIgnore' }}{% else %}{{ settings.speedsize_url_pfx -}}https:{{ page_image | img_url: '1200x' }}{%- endif -%}">
  <meta property="og:image:secure_url" content="{%- if template == 'product.loose-lab-diamond' or collection.handle == 'loose-lab-grown-diamonds' -%}{{ settings.speedsize_url_pfx -}}https:{{ page_image | img_url: '1200x' }}&speedsizeIgnore{% else %}{{ settings.speedsize_url_pfx -}}https:{{ page_image | img_url: '1200x' }}{%- endif -%}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endcapture -%}

{%- if template.name == 'product' -%}
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ product.title | strip_html | escape }}">
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if product.featured_image.size > 0 -%}
    {%- for image in product.images limit: 3 -%}
      <meta property="og:image" content="http:{{ image.src | product_img_url: '600x' }}{%- if template == 'product.loose-lab-diamond' -%}&speedsizeIgnore{%- endif -%}">
      {%- if template == 'product.loose-lab-diamond' -%}
        {%- assign image_src_speedsizeIgnore = image.src | product_img_url: '600x' | prepend: 'https:' -%}
        <meta property="og:image:secure_url" content="{{ image_src_speedsizeIgnore }}">
      {%- else -%}
        <meta property="og:image:secure_url" content="{{ settings.speedsize_url_pfx -}}https:{{ image.src | product_img_url: '600x' }}">
      {%- endif -%}
      {%- if image.alt contains 'youtube' or image.alt contains 'vimeo' -%}
        {% assign src = image.alt | split: 'src="' %}
        {% assign src = src[1] | split: '"' | first %}
        <meta property="og:video" content="{{ src }}">
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- unless template == 'product.loose-lab-diamond' -%}
      {{
        page_image | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
      }}
    {%- else -%}
      {{
        page_image 
        | append: '&speedsizeIgnore' | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx
      }}
    {%- endunless -%}
  {%- endif -%}
{%- elsif template.name == 'collection' -%}
  <meta property="og:type" content="product.group">
  <meta property="og:title" content="{{ collection.title | strip_html | escape }}">
  {%- if collection.products_count > 0 -%}
    {% assign image = collection.products.first.featured_image %}
    <meta property="og:image" content="http:{{ image.src | product_img_url: '600x' }}{% if collection.handle == 'loose-lab-grown-diamonds' %}&speedsizeIgnore{% endif %}">
    {%- liquid
      if collection.handle == 'loose-lab-grown-diamonds' -
        ##speedsizeIgnore##
      endif
    %}
    <meta property="og:image:secure_url" content="{% if collection.handle == 'loose-lab-grown-diamonds' %}{{ settings.speedsize_url_pfx -}}https:{{ image.src | product_img_url: '600x' }}&speedsizeIgnore{% else %}{{ settings.speedsize_url_pfx -}}https:{{ image.src | product_img_url: '600x' }}{% endif %}">
    {%- liquid
      if collection.handle == 'loose-lab-grown-diamonds' -
        ##endSpeedsizeIgnore##
      endif
    %}
  {%- else -%}
    {{
      page_image | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
    }}
  {%- endif -%}
{%- elsif template.name == 'article' -%}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ article.title | strip_html | escape }}">
  {% assign img_tag = '<' | append: 'img' %}
  {%- if article.image -%}
    <meta property="og:image" content="http:{{ article.image | img_url: '600x' }}">
    <meta
      property="og:image:secure_url"
      content="{{ settings.speedsize_url_pfx -}}https:{{ article.image | img_url: '600x' }}"
    >
  {%- elsif article.content contains img_tag -%}
    {% assign src = article.content | split: 'src="' %}
    {% assign src = src[1] | split: '"' | first | remove: 'https:' | remove: 'http:' %}
    {%- if src -%}
      <meta property="og:image" content="http:{{ src }}">
      <meta property="og:image:secure_url" content="https:{{ src }}">
    {%- endif -%}
  {%- else -%}
    {{
      page_image | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
    }}
  {%- endif -%}
{%- elsif template.name == 'blog' -%}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ blog.title | strip_html | escape }}">
  {%- if blog.articles_count > 0 -%}
    {% assign article = blog.articles.first %}
    {% assign img_tag = '<' | append: 'img' %}
    {%- if article.image -%}
      <meta property="og:image" content="http:{{ article.image | img_url: '600x' }}">
      <meta
        property="og:image:secure_url"
        content="{{ settings.speedsize_url_pfx -}}https:{{ article.image | img_url: '600x' }}"
      >
    {%- elsif article.content contains img_tag -%}
      {% assign src = article.content | split: 'src="' %}
      {% assign src = src[1] | split: '"' | first | remove: 'https:' | remove: 'http:' %}
      {%- if src -%}
        <meta property="og:image" content="http:{{ src }}">
        <meta property="og:image:secure_url" content="https:{{ src }}">
      {%- endif -%}
    {%- else -%}
      {{
        page_image | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
      }}
    {%- endif -%}
  {%- endif -%}
{%- elsif template.name == 'page' -%}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ page.title | strip_html | escape }}">
  {% assign img_tag = '<' | append: 'img' %}
  {%- if page.content contains img_tag -%}
    {% assign src = page.content | split: 'src="' %}
    {% assign src = src[1] | split: '"' | first | remove: 'https:' | remove: 'http:' %}
    {%- if src -%}
      <meta property="og:image" content="http:{{ src }}">
      <meta property="og:image:secure_url" content="https:{{ src }}">
    {%- endif -%}
  {%- else -%}
    {{
      page_image | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
    }}
  {%- endif -%}
{%- else -%}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
{%- endif -%}
{%- if template.name == 'index' -%}
  {{
    page_image | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx 
  }}
{%- endif -%}
{%- if page_description -%}
  <meta
    property="og:description"
    content="{{ page_description | escape  }}"
  >
{%- endif -%}

{% comment %}
  Twitter user name of the site, based on theme settings
{% endcomment %}
{%- if settings.twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary">
{%- if template.name == 'product' -%}
  <meta name="twitter:title" content="{{ product.title }}">
  <meta
    name="twitter:description"
    content="{{ product.description | strip_html | truncatewords: 140, '' | escape  }}"
  >
  {% if template == 'product.loose-lab-diamond' %}
    {% render 'ignore-speedsize-meta' %}
  {% else %}
    <meta
      name="twitter:image"
      content="{{ settings.speedsize_url_pfx -}}https:{{ product.featured_image.src | img_url: '240x' }}"
    >
  {% endif %}
  <meta name="twitter:image:width" content="240">
  <meta name="twitter:image:height" content="240">
{%- elsif template.name == 'article' -%}
  <meta name="twitter:title" content="{{ article.title }}">
  <meta
    name="twitter:description"
    content="{{ article.excerpt_or_content | strip_html | truncatewords: 140, '' | escape }}"
  >
  {%- if article.image -%}
    <meta property="twitter:image" content="http:{{ article.image | img_url: '600x' }}">
  {%- elsif article.content contains '<img' -%}
    {% assign src = article.content | split: 'src="' %}
    {% assign src = src[1]
      | split: '"'
      | first
      | replace: '//cdn', 'http://cdn'
      | replace: 'http:http://', 'http://'
      | remove: 'https:'
    %}
    {%- if src -%}
      <meta property="twitter:image" content="{{ src }}">
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
