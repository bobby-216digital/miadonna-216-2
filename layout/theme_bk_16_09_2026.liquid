        <script>
          (function () {
            const originalDefine = customElements.define.bind(customElements);

            customElements.define = function (name, ctor, options) {
              if (name === 'variant-selection') {
                const original = ctor.observedAttributes || [];
                const originalCallback = ctor.prototype.attributeChangedCallback;

                // Add 'product-url' to the observed list
                Object.defineProperty(ctor, 'observedAttributes', {
                  get() {
                    return [...original, 'product-url'];
                  },
                });

                // Handle 'product-url' changes the same way 'variant' is handled natively
                ctor.prototype.attributeChangedCallback = function (attrName, oldValue, newValue) {
                  if (attrName === 'product-url') {
                    if (oldValue === newValue) return;

                    this._loaded = false;
                    this._productFetcher = this._fetchProduct().then((product) => {
                      if (!product) return;
                      const variant = product.variants.find((v) => v.available) || product.variants[0];
                      this.variant = variant.id; // reuses the class's own setter → native dispatch
                    });
                    return;
                  }
                  originalCallback.call(this, attrName, oldValue, newValue);
                };
              }
              return originalDefine(name, ctor, options);
            };
          })();
        </script>
      {%- endif -%}
