  (function () {

    "use strict";

    var yettUnblocked = false;


    /*
     * ---------------------------------------------------------
     * YETT UNBLOCK
     * ---------------------------------------------------------
     */


    /*
     * ---------------------------------------------------------
     * CHECK SHOPIFY CONSENT
     * ---------------------------------------------------------
     */

    function checkConsent() {

        var privacy =
            window.Shopify &&
            window.Shopify.customerPrivacy;


        if (!privacy) {

            console.log(
                "[CONSENT] Customer Privacy API not ready yet."
            );

            return;
        }


        var analyticsAllowed =
            privacy.analyticsProcessingAllowed();


        var marketingAllowed =
            privacy.marketingAllowed();


        console.log(
            "[CONSENT] Current permissions:",
            {
                analytics: analyticsAllowed,
                marketing: marketingAllowed
            }
        );


        /*
         * Your YETT blacklist contains both analytics
         * and marketing-related scripts.
         *
         * Therefore we only release them when both
         * categories are allowed.
         */

        if (
            analyticsAllowed &&
            marketingAllowed
        ) {

            window.yett.unblock();

        } else {

            console.log(
                "[CONSENT] Analytics/marketing not allowed."
            );

            console.log(
                "[CONSENT] Yett remains BLOCKED."
            );
        }
    }


    /*
     * ---------------------------------------------------------
     * LOAD SHOPIFY CUSTOMER PRIVACY API
     * ---------------------------------------------------------
     */

    function loadCustomerPrivacyAPI() {

        /*
         * API already available.
         */

        if (
            window.Shopify &&
            window.Shopify.customerPrivacy
        ) {

            console.log(
                "[CONSENT] Customer Privacy API already available."
            );

            checkConsent();

            return;
        }


        /*
         * Shopify object isn't available yet.
         */

        if (
            !window.Shopify
        ) {

            console.log(
                "[CONSENT] Shopify object not ready."
            );

            setTimeout(
                loadCustomerPrivacyAPI,
                100
            );

            return;
        }


        /*
         * Shopify exists but Customer Privacy API
         * hasn't been loaded.
         */

        if (
            typeof window.Shopify.loadFeatures !== "function"
        ) {

            console.log(
                "[CONSENT] Shopify.loadFeatures not available yet."
            );

            setTimeout(
                loadCustomerPrivacyAPI,
                100
            );

            return;
        }


        console.log(
            "[CONSENT] Loading Customer Privacy API..."
        );


        window.Shopify.loadFeatures(
            [
                {
                    name: "consent-tracking-api",
                    version: "0.1"
                }
            ],
            function (error) {

                if (error) {

                    console.error(
                        "[CONSENT] Customer Privacy API failed:",
                        error
                    );

                    /*
                     * FAIL CLOSED:
                     *
                     * Do NOT unblock Yett.
                     */
                    return;
                }


                console.log(
                    "[CONSENT] Customer Privacy API loaded."
                );


                /*
                 * Now the API should be available.
                 */

                checkConsent();

            }
        );
    }


    /*
     * ---------------------------------------------------------
     * SHOPIFY CONSENT EVENT
     * ---------------------------------------------------------
     *
     * This listener must be registered BEFORE the visitor
     * clicks Accept / Decline.
     */

    
    /*
     * ---------------------------------------------------------
     * START
     * ---------------------------------------------------------
     */

    console.log(
        "[CONSENT] Consent controller starting..."
    );
    loadCustomerPrivacyAPI();
})();
