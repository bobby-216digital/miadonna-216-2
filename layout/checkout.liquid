    <!-- Conversion page tracking events -->
    <script>
      if (window.location.pathname.toLowerCase().indexOf('thank_you') != -1) {
        // Google
        gtag('event', 'conversion', {
            'send_to': 'AW-1054704953/jE1MCMSlw3gQuYr29gM',
            'value': {{ checkout.total_price | money_without_currency | replace: ',', '' }},
            'currency': '{{ shop.currency }}',
            'transaction_id': {{ checkout.order_number | replace: '#', '' }}
        });

        // Bing
        window.uetq = window.uetq || [];
        window.uetq.push({ 'revenue_value': {{ checkout.total_price | money_without_currency | replace: ',', '' }}, 'currency': '{{ shop.currency }}' });
      }
    </script>

    <script
      src="https://polyfill.io/v3/polyfill.js?flags=gated&features=es6%2Cfetch%2CPromise.prototype.finally%2CIntersectionObserver%2CIntersectionObserverEntry%2CObject.entries%2CArray.prototype.includes"
    ></script>
    <script>
      window.__domReady__ = function(callback) {
        if (document.readyState === 'loading') {
          document.addEventListener("DOMContentLoaded", callback);
        } else {
          // `DOMContentLoaded` already fired
          callback();
        }
      }
