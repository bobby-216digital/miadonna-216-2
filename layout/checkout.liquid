</head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TZN98J7"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {{ skip_to_content_link }}

    <div class="banner" data-header>
      <div class="wrap">
        <a href="{{ shop.secure_url }}" title="{{ shop.name }} | Home" style="display:inline-block;">
          <img
            src="{{ 'logo.svg' | asset_url }}"
            width="158"
            height="18"
            alt="{{ shop.name }} logo"
            style="display:block;"
          >
        </a>
      </div>
    </div>

    {{ order_summary_toggle }}
    <div class="content" data-content>
      <div class="wrap">
        <div class="main">
          <header class="main__header" role="banner">
            <div class="main__header" style="text-align: center;">
              <a href="{{ shop.secure_url }}" title="{{ shop.name }} | Home" class="checkout-logo">
                <img
                  src="{{ 'logo.svg' | asset_url }}"
                  width="158"
                  height="18"
                  alt="{{ shop.name }} logo"
                  style="display:inline-block;"
                >
              </a>
              {{ breadcrumb }}
              {{ alternative_payment_methods }}
            </div>
          </header>
          <main class="main__content" role="main">
            {{ content_for_layout }}
          </main>
          <footer class="main__footer" role="contentinfo">
            {{ content_for_footer }}
          </footer>
        </div>
        <aside class="sidebar" role="complementary">
          <div class="sidebar__content">
            {{ content_for_order_summary }}
          </div>
        </aside>
      </div>
    </div>
    {%- if requestPath contains 'thank_you' or requestPath contains '/orders/' -%}
      <!-- BEGIN: NSG_GUARANTEE -->
      <span id="_GUARANTEE_GuaranteeSpan"></span>
      <script type="text/javascript" src="//nsg.symantec.com/Web/Seal/gjs.aspx?SN=945880200"></script>
      <script type="text/javascript">
        if (window._GUARANTEE && _GUARANTEE.Loaded) {
          _GUARANTEE.Hash = "v91y02%2FSGDdHkdlx1cBHPRUZOQDN6wqlPMHAXi6XtGBxpffBbpqWPvrGNDRpkCTxz4Jb5lGWxiRQ72rNCDe0BA%3D%3D";
          _GUARANTEE.Guarantee.order = "{{ checkout.order.order_number }}";
          _GUARANTEE.Guarantee.subtotal = "{{ checkout.subtotal_price }}";
          _GUARANTEE.Guarantee.currency = "USD";
          _GUARANTEE.Guarantee.email = "{{ checkout.email }}";
          _GUARANTEE.WriteGuarantee("JavaScript", "_GUARANTEE_GuaranteeSpan");
        }
      </script>
      <!-- END: NSG_GUARANTEE -->
      {% if first_time_accessed %}
        <img src="https://foursixty.com/conversion-pixel.gif?extension=MiaDonna&value={{ checkout.subtotal_price | money_without_currency | strip_html  }}">
      {% endif %}

      <!-- BEGIN GCR Opt-in Module Code -->
      <script src="https://apis.google.com/js/platform.js?onload=renderOptIn" async defer></script>

      <script>
        window.renderOptIn = function() {
          window.gapi.load('surveyoptin', function() {
            var currDate = new Date();
            // estimate 7 days to build jewelry + 2-day delivery + 1 day of "wiggle room", i.e. 10 days
            // May not be accurate but the alternative is to try to examine the selected shipping method
            // and provide an estimate from that. Yuck.
            var estimatedDeliveryDay = currDate.getDate() + 10;
            // getMonth() is zero-based
            var month = (currDate.getMonth() < 9 ? '0' : '') + (currDate.getMonth() + 1);
            var day = (estimatedDeliveryDay < 10 ? '0' : '') + estimatedDeliveryDay;
            var year = currDate.getFullYear();
            // delivery date format must be YYYY-MM-DD
            var deliveryDate = year + '-' + month + '-' + day;
            window.gapi.surveyoptin.render(
              {
                // REQUIRED
                merchant_id: 5505014,
                order_id: '{{ checkout.order.order_number }}',
                email: '{{ checkout.email }}',
                delivery_country: '{{ checkout.shipping_address.country_code }}',
                estimated_delivery_date: deliveryDate,

                // OPTIONAL
                // "opt_in_style": "OPT_IN_STYLE"
              });
          });
        }
      </script>
      <!-- END GCR Opt-in Module Code -->
    {% else %}
      {% render 'vdb-cart-grouping', page_type_param: 'checkout' %}

      <!-- BEGIN: _GUARANTEE Seal -->
      <span id="_GUARANTEE_SealSpan"></span>
      <img
        style="display:none;"
        src="//nsg.symantec.com/Web/Seal/AltSealInfo.aspx?S=Large&T=M&Elem=ImgTagSeal&HASH=v91y02%2FSGDdHkdlx1cBHPRUZOQDN6wqlPMHAXi6XtGBxpffBbpqWPvrGNDRpkCTxz4Jb5lGWxiRQ72rNCDe0BA%3D%3D&CBF=AB&AB=1&DP=fn=;src=ImgTagSeal;grt=true"
      >
      <script type="text/javascript" src="//nsg.symantec.com/Web/Seal/gjs.aspx?SN=945880200"></script>
      <script type="text/javascript">
        if (window._GUARANTEE && _GUARANTEE.Loaded) {
          _GUARANTEE.Hash = "v91y02%2FSGDdHkdlx1cBHPRUZOQDN6wqlPMHAXi6XtGBxpffBbpqWPvrGNDRpkCTxz4Jb5lGWxiRQ72rNCDe0BA%3D%3D";
          _GUARANTEE.WriteSeal("_GUARANTEE_SealSpan", "GuaranteedSeal");
        }
      </script>
      <!-- END: _GUARANTEE Seal -->
    {% endif %}
    <!-- Chatra -->
    <script>
      window.ChatraSetup = {
      colors: [
      '#f0f0f0', // text color
      '#ffa998' // background color
      ]
      };
    </script>

    {{ 'idme-checkout-style.css' | asset_url | stylesheet_tag }}
    {{ 'idme-checkout-template.js' | asset_url | script_tag }}

    <style>
      /*
        The following style is needed to make the order summary section visible on smaller screens.
        The default Shopify CSS hides the order summary section by default.
      */
      /* @media (max-width: 999px) {
        .js .order-summary--is-collapsed {
          height: auto;
          visibility: visible;
        }
      } */
    </style>

    <script>
      /* Forbid PO Boxes in the Address field */

      const regex = /(po box)|(p\.o\. box)|(p\.o box)|(po\. box)|(pobox)|(p\.o\.box)|(p\.obox)|(po\.box)|(post office box)/i;

      document.getElementById("continue_button").onclick = function(event) {
        let addressField = document.getElementById('checkout_shipping_address_address1');
        let addressFieldContainer = addressField.parentNode.parentNode;
        var addressValue = addressField.value;

        if(regex.test(addressValue)) {
          event.preventDefault();
          addressFieldContainer.classList.add('field--error');

          if(!document.getElementById('error-for-address1-pobox')) {
            addressFieldContainer.innerHTML += "<p class='field__message field__message--error' id='error-for-address1-pobox'>The shipping address can't be a PO Box</p>";
            document.getElementById('checkout_shipping_address_address1').value = addressValue;
          }

          document.getElementById('error-for-address1').remove();
        } else {
          addressFieldContainer.classList.remove('field--error');
          document.getElementById('error-for-address1-pobox').remove();
        }
      }
    </script>

    <script>
      /* Military discount show and hide */
      function waitForElm(selector) {
        const observer = new MutationObserver(mutations => {
          if(document.getElementById('idme-checkout')){
            if (document.querySelector(selector)) {
              document.getElementById('idme-checkout').style.visibility = 'hidden';
            } else {
              document.getElementById('idme-checkout').style.visibility = 'visible';
            }
          }
        });

        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      }

      waitForElm('.tags-list');
    </script>
  </body>
</html>
