    "a0acd91f-cc30-45d9-b642-50ac5fcbe6ac": {
      "type": "index__rich-text",
      "settings": {
        "title": "LEARN ABOUT LAB-GROWN DIAMONDS FROM MIADONNA",
        "heading_font": "montserrat_n5",
        "heading_color": "rgba(0,0,0,0)",
        "heading_alignment": "center",
        "heading_size": 30,
        "text": "<h2><em>Exceptional Quality & Ethics from the Pioneers of the Industry</em></h2><p>MiaDonna is the world’s first<a href=\"/pages/faq-about-us\" title=\"About Us (FAQ)\"> lab grown diamond</a> company, the first B Corp-certified diamond enterprise, and the trailblazing retailer of carbon-negative diamonds. Since 2005, we've fused innovation, sustainability, and philanthropy to create lab-grown diamonds that stand among the rarest diamonds on Earth. Here's why our diamonds reign supreme!</p>",
        "text_font": "montserrat_n4",
