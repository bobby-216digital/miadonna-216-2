    "c1b5de52-5a9e-41b1-ae46-7ab811295333": {
      "type": "image-with-text-2",
      "blocks": {
        "77c09153-8589-423c-bad8-e96caaa3862b": {
          "type": "image-with-text",
          "settings": {
            "image_position": "left",
            "image": "shopify://shop_images/MiaDonna_lab-grown-diamond-pear-cut-engagement-ring-gold_circle_75f77b3c-a566-468a-852c-8f7d4fc7ad4b.png",
            "image_link": "",
            "title": "HIGH QUALITY",
            "content": "<p>MiaDonna's fine jewelry is handcrafted using 100% recycled solid gold and platinum at a higher gram weight, meaning your jewelry will last for generations. Our Lab-Grown Diamonds and Gemstones are among the Top 1% of all diamonds and gems, no matter their origin.</p>"
          }
        },
        "bf41c0c3-b08d-4373-9cb3-7b94a9b2273b": {
          "type": "image-with-text",
          "settings": {
            "image_position": "right",
            "image": "shopify://shop_images/MiadONNA_Heart-shaped-diamond-lab-grown-sustainable-eco-friendly_circle_4295639c-6d55-49c2-907e-e1842531d91b.png",
            "image_link": "",
            "title": "SUSTAINABILITY",
            "content": "<p>We conserve thousands of tons of natural resources by choosing not to mine for diamonds or newly sourced gold and platinum. Instead, we take pride in growing our exceptional diamonds and maintaining a streamlined, sustainable supply chain. By offsetting the carbon emissions from production and minimal shipping with tree planting for every order, we ensure a positive environmental impact. Many of our lab-grown diamonds are also certified carbon-neutral or even carbon-negative, reflecting our commitment to eco-conscious craftsmanship.</p>"
          }
        },
        "cd6b92d8-536e-4abd-a273-ef4c9e99d566": {
          "type": "image-with-text",
          "settings": {
            "image_position": "left",
            "image": "shopify://shop_images/MiaDonna_Gives-Back-The-Greener-Diamond-sustainable-ethical_circle_2ce05c1e-6a84-4146-9bb6-b5e3e6e0ab17.png",
            "image_link": "",
            "title": "GIVING BACK",
            "content": "<p>MiaDonna is a foundation-driven company, committed to donating at least 10% of net profits from every purchase to restore lives and lands impacted by the diamond and gold mining industries. Through our nonprofit, <a href=\"https://www.miadonna.com/pages/the-greener-diamond\" target=\"_blank\" title=\"https://www.miadonna.com/pages/the-greener-diamond\">The Greener Diamond</a>, we actively contribute to meaningful change. As a social enterprise, we prioritize more than profit—giving back is at the core of our mission, not an afterthought.</p>"
          }
        },
        "03478d9d-ca2b-40af-b05f-6637e6d042d6": {
          "type": "image-with-text",
          "settings": {
            "image_position": "right",
            "image": "shopify://shop_images/MiaDonna_B-Corp-Certified-sustainable-ethical-eco-friendly_circle_7e9363c0-380b-483e-872d-2e09a33698d0.png",
            "image_link": "",
            "title": "WE PROVE IT",
            "content": "<p>We hate greenwashing and deceptive marketing as much as you do. We're proud of our many third-party certifications that prove our bold, industry-leading claims. As the first B Corp-certified diamond retailer, we continue to meet the highest standards of social and environmental impact. We use business as a force for good.</p>"
          }
        }
      },
