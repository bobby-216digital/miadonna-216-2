      ],
      "settings": {
        "banner_title": "MIADONNA CORE VALUES",
        "banner_text": "At MiaDonna, our core values are ingrained in our DNA. They guide our attitude, behavior, and business to work towards a conflict-free diamond industry."
      }
    },
    "6e7fd43e-27fa-4da3-977f-bd5269591ec3": {
      "type": "our-pledge_quote",
      "settings": {
        "title": "OUR MISSION & VISION",
        "text": "Our\n <em><span class=\"pink-text\">vision</span></em> is to create a Greener Diamond culture by being the leader in affordable, ethically produced fine jewelry.<br><br>Our\n <em><span class=\"pink-text\">mission</span></em> is to help repair and restore the land and lives damaged by the unethical conflict-diamond trade by offering consumers ethical fine jewelry that alleviates the need to mine for new diamonds. "
      }
    },
    "c808dd2e-57b5-477f-9b48-edeff9009ef7": {
      "type": "our-pledge_icon-with-text",
      "blocks": {
        "49d59928-0043-42c0-9998-76a31fecdcfb": {
          "type": "Text",
          "settings": {
            "image": "shopify://shop_images/b-corp-logo-pledge.svg",
            "title": "CERTIFIED B CORPORATION",
            "content": "As a certified B Corporation, we're committed to meeting the highest standards  for social and environmental performance,  transparency, and accountability."
          }
        },
        "aab29ea6-a96a-48fe-9fc0-2ba3c74b3cb7": {
          "type": "Text",
          "settings": {
            "image": "shopify://shop_images/green-america-icon.png",
            "title": "GREEN AMERICA",
            "content": "We have been awarded the Green America Seal of Approval for going above and beyond product and service quality to set the highest standards in environmental sustainability and social justice, to solve rather than create, environmental and social problems."
          }
        },
        "3a3a3c1a-164c-4cce-b843-218a649cb707": {
          "type": "Text",
          "settings": {
            "image": "shopify://shop_images/carbon-neutral-icon.png",
            "title": "CARBON NEUTRAL SHIPMENTS",
            "content": "We offset the CO2 created when shipping our products to your door by investing in reforestation projects. 1,400 trees each year absorb those emissions, so for every shipment we make, we plant one tree on your behalf through our partnership with ecodrive."
          }
        },
        "42f62625-2517-4e07-a5ec-107f4b1809b7": {
          "type": "Text",
          "settings": {
            "image": "shopify://shop_images/eco-friendly-icon.png",
            "title": "ECO-FRIENDLY JEWELRY CLEANER",
            "content": "We have our own unique blend of jewelry cleaner utilizing a non-toxic formula that is both environmentally safe and packaged within a fully recyclable, grade 1 container. This eco-friendly jewelry cleaner is included free of charge with all domestic orders."
          }
        },
        "12af6d6f-c3fd-4d70-9737-2b186b9c068d": {
          "type": "Text",
          "settings": {
            "image": "shopify://shop_images/recycled-metals-icon.png",
            "title": "RECYCLED METALS",
            "content": "Each and every setting is handcrafted using only the finest recycled solid Gold or 950 Pure Platinum from refineries that represent our commitment to the earth. Metals you’ll love for their beauty and be proud to wear for the positive impact they have on our planet."
          }
        },
        "ef9b5165-6a17-4955-8d6f-7fa491805b74": {
          "type": "Text",
          "settings": {
            "image": "shopify://shop_images/water-recycling-icon.png",
            "title": "WATER RECYCLING",
            "content": "When we create your jewelry, we use a lot of water. However, thanks to a very efficient water filtration system, we’re now able to recycle the water we use in the production of your jewelry, eliminating the need for us to use large amounts of fresh drinking water."
          }
        }
      },
