    "32d6329c-c3f7-4569-8ad3-ff8b742afe21": {
      "type": "index__image-with-text",
      "blocks": {
        "template--15035832991823__32d6329c-c3f7-4569-8ad3-ff8b742afe21-image-1": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/MiaDonna_Lab-Grown-Diamonds-Diamond-Hybrid-Alternative.jpg",
            "image_link": "",
