    "1ba326b5-e65e-40df-95e6-e6e266df5c86": {
      "type": "index__image-with-text",
      "blocks": {
        "2f15e41d-67dc-4035-8068-3ed4b1373fdb": {
          "type": "text",
          "settings": {
            "title": "EBOLA PROJECT, LIBERIA",
            "pre-title": "",
            "heading_size": "small",
            "text": "<p>UNICEF reported almost 18,000 cases and more than 6,000 deaths from Ebola during the 2014 outbreak, creating 7,000 orphaned children. The Greener Diamond supplied grants to families who took in orphans to help cover the increased expenses associated with the additions to their families.</p>",
            "button_label": "",
            "link": "",
            "button_style": "button--primary",
            "background": "rgba(0,0,0,0)",
            "text_color": "rgba(0,0,0,0)",
            "alignment": "left",
