    "32d6329c-c3f7-4569-8ad3-ff8b742afe51": {
      "type": "index__image-with-text",
      "blocks": {
        "template--15035832991823__32d6329c-c3f7-4569-8ad3-ff8b742afe51-text-1": {
          "type": "text",
          "settings": {
            "title": "THE GREENER DIAMOND AGRICULTURAL TRAINING CENTER, LIBERIA",
            "pre-title": "",
            "heading_size": "small",
            "text": "<p>Using the groundbreaking method from <a href=\"https://kisstheground.com/\" target=\"_blank\" title=\"Kiss the Ground\"><em>Kiss The Ground</em></a>, we are creating our first farm that is growing food with 100% organic fertilizer, no pesticides, and no rototilling on 10 acres of land. </p><p>For Phase I, we farmed just the first five acres. In 2021 it was officially a sustainable success! Additional food was sold at markets and provided more funding for the farm. In 2022, we started on Phase II and the additional five acres with the goal of it being our most long-term sustainable farm yet. </p><p>Beyond providing food security and vital education for the local community, our goal is to protect the topsoil and keep it alive to absorb even more carbon out of the atmosphere than trees and oceans.</p>",
            "button_label": "",
            "link": "",
            "button_style": "button--primary",
            "background": "rgba(0,0,0,0)",
            "text_color": "rgba(0,0,0,0)",
            "alignment": "left",
            "vertical_position": "center"
          }
        },
        "template--15035832991823__32d6329c-c3f7-4569-8ad3-ff8b742afe51-image-1": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/MiaDonna-The-Greener-Diamond-Farm-Liberia.jpg",
            "image_link": "",
            "image_text": ""
          }
        }
      },
      "block_order": [
