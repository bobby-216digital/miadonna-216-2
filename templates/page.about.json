        "custom_css": ".slideshow-classic .gallery-cell .image-element__wrap{\npadding: 10px;\n}\n.flickity-button{\ntop: 50%;\n    padding: 0;\n    outline: none;\n    box-shadow: none;\n    background-color: transparent;\n}\n.flickity-button-icon{\nfill: #ffffff;\n    background: #000;\n    padding: 7px;\n    border-radius: 100%;\n    height: 30px;\n    width: 30px;\n}"
