    "600875c1-795d-487d-8754-7f96e53abf3d": {
      "type": "index__image-with-text",
      "blocks": {
        "5f5df8a8-885e-48c2-9bdd-f3d9dea1b181": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/MiaDonna-The-Greener-Diamond-SOS-Technical-School-Togo.jpg",
