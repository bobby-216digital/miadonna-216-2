        "d16cdfc8-2424-490d-9105-cc3b389152f0": {
          "type": "text",
          "settings": {
            "title": "PONPON FAMILY SPONSORSHIP",
            "pre-title": "",
            "heading_size": "small",
            "text": "<p>In addition to sponsoring Ponpon monthly as a child, we have paid for his schooling, college tuition, and sponsored his wages at Youth Action International. We've also provided funds to cover some of his family's basic living expenses for over a decade.</p>",
            "button_label": "",
            "link": "",
            "button_style": "button--primary",
