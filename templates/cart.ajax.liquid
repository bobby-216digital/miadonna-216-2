      <div id="ajax-cart__item-tree-template" class="ajax-cart__item-tree-template is-hidden">
        <div
          class="ajax-cart__product media minicart-item__tree"
          data-cart-item="one-tree"
          data-line-item="{{ forloop.index }}"
        >
          <div class="is-flex is-align-flex-start">

            <figure class="ajax-cart__product-image media-left">

              {% if product.media %}
                {% for media in product.media %}

                  {% if product.featured_media %}
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ product.featured_media | img_url: '320x' }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                      width="100%"
                      height="100%"
                    >
                  {% endif %}
                {% else %}
                  {% if media %}
                    <img
                      src="{{ settings.speedsize_url_pfx_https -}}{{ media | img_url: '320x' }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                      width="100%"
                      height="100%"
                    >
                  {% endif %}
                {% endfor %}
              {% endif %}
            </figure>

            <div class="ajax-cart__product-content media-content">
              <div class="ajax-cart__product-title">
                <h3 class="ajax-cart__product-title-content">{{ product.title }}</h3>
              </div>

              <div class="ajax-cart__line-items">
                <div class="ajax-cart__line-item">
                  <span class="option-title">{{ product.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</span>
                </div>
              </div>
            </div>
          </div>

