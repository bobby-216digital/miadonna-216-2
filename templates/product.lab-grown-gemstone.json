    "c1b5de52-5a9e-41b1-ae46-7ab811295333": {
      "type": "image-with-text-2",
      "blocks": {
        "77c09153-8589-423c-bad8-e96caaa3862b": {
          "type": "image-with-text",
          "settings": {
            "image_position": "left",
            "image": "shopify://shop_images/MiaDonna_lab-grown-diamond-pear-cut-engagement-ring-gold_circle_524d3ff0-c509-48d7-9930-8ea2de46903f.png",
            "image_link": "",
            "title": "HIGH QUALITY",
            "content": "<p>Mia Donna's fine jewelry is handcrafted in America using 100% recycled solid gold and platinum at a higher gram weight, meaning your jewelry will last for generations. Our Lab-Grown Diamonds and Gemstones are among the Top 1% of all diamonds and gems, no matter their origin.</p>"
          }
        },
        "bf41c0c3-b08d-4373-9cb3-7b94a9b2273b": {
          "type": "image-with-text",
          "settings": {
            "image_position": "right",
            "image": "shopify://shop_images/MiadONNA_Heart-shaped-diamond-lab-grown-sustainable-eco-friendly_circle_e2274684-c51c-4afb-a51d-2c1ec40d5cd5.png",
            "image_link": "",
            "title": "SUSTAINABILITY",
            "content": "<p>MiaDonna metals and lab grown diamond are certified sustainable by SCS Global and Carbon Neutral.  Our company is also certified by B Corporation, so you can trust that we not only meet but exceed the highest social and environmental standards.</p>"
          }
        },
        "cd6b92d8-536e-4abd-a273-ef4c9e99d566": {
          "type": "image-with-text",
          "settings": {
            "image_position": "left",
            "image": "shopify://shop_images/MiaDonna_Gives-Back-The-Greener-Diamond-sustainable-ethical_circle_6394fe0c-7f7f-4661-ba29-217f7418635f.png",
            "image_link": "",
            "title": "GIVING BACK",
            "content": "<p>MiaDonna is a foundation-first company that gives at least 10% net profits from every single purchase to rebuild and repair the lives and land devastated by the diamond and gold mining industries. We do this through our foundation, <a href=\"/pages/the-greener-diamond\" title=\"The Greener Diamond\">The Greener Diamond</a>. As a social enterprise, we measure more than profit. Giving back is crucial part of our business, and never an afterthought.<br/><br/></p>"
          }
        },
        "03478d9d-ca2b-40af-b05f-6637e6d042d6": {
          "type": "image-with-text",
          "settings": {
            "image_position": "right",
            "image": "shopify://shop_images/MiaDonna_B-Corp-Certified-sustainable-ethical-eco-friendly_circle_2d59006a-4e1e-48cf-a887-3adf6481d3a3.png",
            "image_link": "",
            "title": "WE PROVE IT",
            "content": "<p>We hate greenwashing and deceptive marketing as much as you do. We're proud of our many third-party certifications that prove our bold, industry-leading claims. As the first B Corp-certified diamond retailer, we continue to meet the highest standards of social and environmental impact. We use business as a force for good.</p>"
          }
        }
      },
