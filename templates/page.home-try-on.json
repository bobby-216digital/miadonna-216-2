        "template--15034167951439__3d58deef-d7a8-4d80-a277-eb3705f7bbc0-column-2": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Try-block.jpg",
            "image_alt": "TRY",
            "text_alignment": "center",
            "title": "TRY",
            "description": "<p>Try on the rings, take photos, and show them off to your friends and family. Get to know the styles you love! Whether or not you find a ring you love, there is no obligation to purchase.<\/p>",
            "button_text": "",
            "button_link": "",
