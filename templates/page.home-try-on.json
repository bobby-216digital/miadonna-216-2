            "image_alt": "SELECT",
            "text_alignment": "center",
            "title": "SELECT",
            "description": "<p>Choose four replica rings from our Home Try-On collection. Your package— with sample rings and helpful information— will ship via USPS First Class Mail and arrive within 1–3 business days.<\/p>",
            "button_text": "",
            "button_link": "",
            "button_style": "button--primary"
