        "template--15034167951439__0d2dade4-7bff-462d-914f-83d3c0c2de38-text-1": {
          "type": "text",
          "settings": {
            "title": "More Information",
            "pre-title": "",
            "heading_size": "regular",
            "text": "<p><\/p><p><strong>COST<\/strong><br\/>Our home try-on program is 100% FREE. We charge a $100 security fee that is refunded in full once your returned package is returned and received. Please note, we allow one (1) complimentary home try-on order per customer\/address. Additional home try-on orders (without a regular purchase) will incur a non-refundable $50 fee.<\/p><p><strong>QUALITY & SIZE<\/strong><br\/>Sample rings are crafted with alloy metal with cubic zirconia. The average ring size is 7 and center stone size varies from style-to-style. These samples represent the style, not quality, of our finished jewelry. These samples come as they are and cannot be customized for ring size, metal type, center stone shape or size.<\/p><p><strong>SHIPPING<\/strong><br\/>All packages are sent via USPS First Class Mail and arrive within 1–3 business days. At this time, we only ship home try-on orders within the United States, including Alaska and Hawaii. Only one (1) home try-on package allotted per customer at a single time. Packages need to be put in the mail no later than 7 days from when they are received. <\/p><p><\/p><p><a href=\"\/pages\/terms-conditions\" title=\"Terms & Conditions\">Click here for full terms and conditions.<\/a><\/p>",
            "button_label": "",
            "link": "",
            "button_style": "button--primary",
            "background": "rgba(0,0,0,0)",
            "text_color": "rgba(0,0,0,0)",
            "alignment": "left",
            "vertical_position": "center"
          }
        }
