{"sections":{"shogun-helper":{"type":"shogun-helper","settings":{}},"main":{"type":"page-content__main","blocks":{"0d10d5e5-ab3a-47cc-8dad-5b87b2151f09":{"type":"default_content","settings":{"content":true}}},"block_order":["0d10d5e5-ab3a-47cc-8dad-5b87b2151f09"],"disabled":true,"settings":{"show_breadcrumb":true,"show_sidebar":false,"menu":"faq-sidebar","show_heading":false,"heading_alignment":"left","width":"standard","padding_top":40,"padding_bottom":40,"css_class":"","custom_css":""}},"shogun-optimizer":{"type":"shogun-optimizer","settings":{}},"index_image_with_text_overlay_HPhXLJ":{"type":"index__image-with-text-overlay","name":"Image with Text Overlay","settings":{"section_background_color":"","tilt_background":false,"link":"","image":"shopify:\/\/shop_images\/Community_Discounts_Banner_687d1739-b82e-47b6-9cbe-69eaa50ecdd0.png","mobile_image":"shopify:\/\/shop_images\/Community_Discounts_Banner_Mobile_f6ed8cd0-0916-458c-8afa-3678e7e1fe40.png","pretext":"","title":"Community Discounts","subtitle":"<p>At MiaDonna, we’re honored to recognize the people who strengthen, protect, and uplift our communities every day. Our <a href=\"\/pages\/specials-and-promotions\" title=\"SPECIALS & PROMOTIONS\"><strong>Community Discounts<\/strong><\/a> offer exclusive savings to eligible groups, with secure verification powered by <strong>ID.me<\/strong>. Whether you serve, teach, heal, protect, or are working toward your future, this is our way of saying thank you for the impact you make.<\/p>","pretext_color":"#001514","heading_color":"#001514","subheading_color":"#001514","text_alignment":"center","text_horizontal_position":"left","text_vertical_position":"middle","background_color":"rgba(0,0,0,0)","background_opacity":0,"border_color":"#ffffff","border_width":0,"text_width":100,"button_1":"","button_1_link":"","button_1_style":"button--secondary","open_new_new_tab_button_1_ink":false,"button_2":"","button_2_link":"","button_2_style":"button--secondary","open_new_new_tab_butt