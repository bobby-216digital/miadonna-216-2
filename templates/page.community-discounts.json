_right":0,"animation":"none","id_sec":"","css_class":"","custom_css":".rich-text__text.content p{\n    max-width:846px;\n    margin: 0 auto;\n}"}},"index_image_with_text_2_7MAQmk":{"type":"index__image-with-text-2","blocks":{"text_bYGm9x":{"type":"text","settings":{"heading_tag":"h2","title":"","title2":"Military","text":"<p>To those who serve and have served – Active Duty, National Guard, and Reserve service members, Veterans, and retired personnel, along with military spouses and immediate family. Your commitment to country and community is one we deeply respect, and we're honored to celebrate life's milestones alongside you.<\/p>","button_label":"","link":"","button_style":"button--secondary","open_new_new_tab_button_1_ink":false,"button_label2":"","link2":"","button_style2":"button--primary","open_new_new_tab_button__2_link":false,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"center","vertical_position":"center"}},"image_aFX8rJ":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Military.png","image_link":"","iframe_video":""}}},"block_order":["text_bYGm9x","image_aFX8rJ"],"name":"Index image with text 2","settings":{"width":"wide","text_style":true,"sectionid":"section1","show_gutter":true,"padding_top":20,"padding_bottom":20,"animation":"none","arialabelledby":"four-cs-heading","id_sec":"","css_class":"image-text-nw","custom_css":""}},"index_image_with_text_2_8XaMcz":{"type":"index__image-with-text-2","blocks":{"image_jDDpXX":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/First_responders.png","image_link":"","iframe_video":""}},"text_UxBw9m":{"type":"text","settings":{"heading_tag":"h2","title":"","title2":"First Responders","text":"<p>For the police officers, firefighters, EMTs, and paramedics who answer the call when it matters most. Your courage and steady presence in moments of crisis embody the kind of devotion worth commemorating with jewelry made to last a lifetime.<\/p>","button_label":"","link":"","button_style":"button--secondary","open_new_new_tab_button_1_ink":false,"button_label2":"","link2":"","button_style2":"button--primary","open_new_new_tab_button__2_link":false,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"center","vertical_position":"center"}}},"block_order":["image_jDDpXX","text_UxBw9m"],"name":"Index image with text 2","settings":{"width":"wide","text_style":true,"sectionid":"section2","show_gutter":true,"padding_top":20,"padding_bottom":20,"animation":"none","arialabelledby":"lab-grown-diamonds-heading","id_sec":"","css_class":"image-text-nw","custom_css":""}},"index_image_with_text_2_nCi4zr":{"type":"index__image-with-text-2","blocks":{"text_kbzjEW":{"type":"text","settings":{"heading_tag":"h2","title":"","title2":"Medical Professionals","text":"<p>Extended to doctors, nurses, technicians, and licensed healthcare providers whose expertise and compassion shape the well-being of countless lives. We're grateful for the care you bring to your patients and proud to offer a meaningful thank-you in return.<\/p>","button_label":"","link":"","button_style":"button--secondary","open_new_new_tab_button_1_ink":false,"button_label2":"","link2":"","button_style2":"button--primary","open_new_new_tab_button__2_link":false,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"center","vertical_position":"center"}},"image_K8jeEy":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Medical.png","image_link":"","iframe_video":""}}},"block_order":["text_kbzjEW","image_K8jeEy"],"name":"Index image with text 2","settings":{"width":"wide","text_style":true,"sectionid":"section3","show_gutter":true,"padding_top":20,"padding_bottom":20,"animation":"none","arialabelledby":"lab-grown-gemstones-heading","id_sec":"","css_class":"image-text-nw","custom_css":""}},"index_image_with_text_2_GKtL6N":{"type":"index__image-with-text-2","blocks":{"image_9AQ4Ty":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Teachers.png","image_link":"","iframe_video":""}},"text_ggNk8t":{"type":"text","settings":{"heading_tag":"h2","title":"","title2":"Teachers & Educators","text":"<p>For the educators who guide students from early childhood through higher education. Your influence reaches far beyond the classroom, shaping curious minds and confident futures — and we're delighted to recognize that lasting impact.<\/p>","button_label":"","link":"","button_style":"button--secondary","open_new_new_tab_button_1_ink":false,"button_label2":"","link2":"","button_style2":"button--primary","open_new_new_tab_button__2_link":false,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"center","vertical_position":"center"}}},"block_order":["image_9AQ4Ty","text_ggNk8t"],"name":"Index image with text 2","settings":{"width":"wide","text_style":true,"sectionid":"section4","show_gutter":true,"padding_top":20,"padding_bottom":20,"animation":"none","arialabelledby":"stone-comparison-heading","id_sec":"","css_class":"image-text-nw","custom_css":""}},"index_image_with_text_2_ckaFhq":{"type":"index__image-with-text-2","blocks":{"text_7djNH9":{"type":"text","settings":{"heading_tag":"h2","title":"","title2":"Students","text":"<p>For those currently enrolled in accredited institutions and pursuing what's next. Whether marking a personal milestone or selecting a meaningful gift, we're glad to support you as you build the future ahead.<\/p>","button_label":"","link":"","button_style":"button--secondary","open_new_new_tab_button_1_ink":false,"button_label2":"","link2":"","button_style2":"button--primary","open_new_new_tab_button__2_link":false,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"center","vertical_position":"center"}},"image_TWFwMR":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Students.png","image_link":"","iframe_video":""}}},"block_order":["text_7djNH9","image_TWFwMR"],"name":"Index image with text 2","settings":{"width":"wide","text_style":true,"sectioni