ch out to <a href=\"https:\/\/help.id.me\/hc\/en-us\" target=\"_blank\" title=\"https:\/\/help.id.me\/hc\/en-us\"><strong>ID.me support<\/strong><\/a>. We’re here to help ensure your experience is seamless, secure, and supportive from start to finish.<\/p><p>MiaDonna reserves the right to change or alter the program at any time.  <\/p>","text_font":"open_sans_n4","text_color":"rgba(0,0,0,0)","text_alignment":"left","text_size":14,"columns":1,"button_label":"","button_link":"","button_alignment":"center","button_background":"#eeeeee","button_text":"#000000","button_style":"button--primary","background":"#ffffff","gradient":"#ffffff","gradient_rotation":0,"width":"wide","padding_top":20,"padding_bottom":40,"padding_left":0,"padding_right":0,"animation":"none","id_sec":"","css_class":"","custom_css":""}},"home_accordion_faq_HaYq3H":{"type":"home-accordion-faq","blocks":{"accordion_item_JV9mgg":{"type":"accordion_item","settings":{"title":"Can I share my discount code with friends or family?","content":"Each discount code is unique to its recipient and cannot be shared. You're welcome to purchase gifts for friends and family using your code, but the purchase must be made by you. MiaDonna reserves the right to deactivate codes and cancel outstanding orders if we believe a code is being misused. Limit one use per customer."}},"accordion_item_dywhyF":{"type":"accordion_item","settings":{"title":"Is the military discount available to allied service members or international military?","content":"We deeply appreciate the service of allied forces and military members from nations around the world. At this time, however, our military discount is available exclusively to members of the United States Armed Forces and their immediate families."}},"accordion_item_3HwDBK":{"type":"accordion_item","settings":{"title":"How do I verify my eligibility?","content":"We partner with ID.me to securely verify eligibility for all Community Discounts. The process takes just a few minutes and protects your personal information."}},"accordion_item_kMwUHp":{"type":"accordion_item","settings":{"title":"Can I combine my Community Discount with other promotions or sales?","content":"Community Discounts cannot be combined with other promotional offers, sale prices, or discount codes. Only one discount may be applied per order."}},"accordion_item_xQdWHG":{"type":"accordion_item","settings":{"title":"Does the discount apply to all MiaDonna jewelry?","content":"Community Discounts apply to most MiaDonna jewelry, with some exclusions such as services and repairs."}}},"block_order":["accordion_item_JV9mgg","accordion_item_dywhyF","accordion_item_3HwDBK","accordion_item_kMwUHp","accordion_item_xQdWHG"],"name":"Home Accordion FAQ","settings":{"background_color":"#f8f8f8","sectionid":"","section_heading":"Community Discount FAQs","columns":2}}},"order":["shogun-helper","main","shogun-optimizer","index_image_with_text_overlay_HPhXLJ","scroll_nav_UCThp4","index_rich_text_GcnymM","index_image_with_text_2_7MAQmk","index_image_with_text_2_8XaMcz","index_image_with_text_2_nCi4zr","index_image_with_text_2_GKtL6N","index_image_with_text_2_ckaFhq","index_image_with_text_2_t8VmNT","index_image_with_text_2_KB8br4","index_rich_text_FxFbyf","index_rich_text_JkFyGy","index_rich_text_cDKz8y","home_accordion_faq_HaYq3H"]}