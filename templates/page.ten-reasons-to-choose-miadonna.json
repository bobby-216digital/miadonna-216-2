0,0,0,0)","text_alignment":"center","text_size":15,"columns":1,"button_label":"","button_link":"","button_alignment":"center","button_background":"#eeeeee","button_text":"#000000","button_style":"button--primary","background":"#f8f8f8","gradient":"rgba(0,0,0,0)","gradient_rotation":0,"width":"one-third","padding_top":50,"padding_bottom":50,"padding_left":45,"padding_right":45,"animation":"none","id_sec":"","css_class":"width-70","custom_css":".rich-text__heading{\n    margin-bottom: 30px;\n}"}},"5be72f9e-22ee-4e1a-a043-e4b489e18b17":{"type":"index__image-with-text","blocks":{"template--15035832991823__f8bea500-5c0d-4262-a369-703910dfb1d4-image-1":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/MiaDonna_Anna-Mieke-Anderson_Lab-Diamond-Expert_web.jpg","image_link":"","image_text":""}},"template--15035832991823__f8bea500-5c0d-4262-a369-703910dfb1d4-text-1":{"type":"text","settings":{"title":"MiaDonna is the world's First Lab Grown Diamond Store","pre-title":"","heading_size":"small","text":"<p><\/p><p>We were founded in 2005 by a mother determined to free children from a lifetime of unethical diamond mining. She started working with scientists to grow the first colorless diamond in a lab, and in turn pioneered the lab-grown diamond industry. She knew the only truly conflict-free diamond was going to be lab-grown.<\/p><p><a href=\"\/pages\/lab-grown-diamonds\" title=\"\/pages\/lab-grown-diamonds\">Learn about Grown Diamonds<\/a><\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}}},"block_order":["template--15035832991823__f8bea500-5c0d-4262-a369-703910dfb1d4-image-1","template--15035832991823__f8bea500-5c0d-4262-a369-703910dfb1d4-text-1"],"settings":{"width":"standard","show_gutter":true,"padding_top":20,"padding_bottom":20,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"f786d97b-2124-4d66-82e3-372afbf31e2a":{"type":"section-table-value","blocks":{"b7da3325-2d4d-44a2-b449-f7556cf48e5a":{"type":"text","settings":{"title":"Ethics","value1":"Profit first, people second","value2":"Foundation first, certified B Corp"}},"6947ffc1-45fb-4196-a351-182e28a06f8a":{"type":"text","settings":{"title":"Quality","value1":"Mass produced overseas","value2":"Handcrafted by experts"}},"2cca165a-a5ac-48a6-a141-ae2b25cfb90e":{"type":"text","settings":{"title":"Center Stones","value1":"Earth-mined and or lab-grown gems, regardless of the origin or ethics","value2":"Lab-grown diamonds and gems from very select reputable sources"}},"17ca2189-d59e-409d-a929-9b2634d5e08a":{"type":"text","settings":{"title":"Metals","value1":"Newly mined","value2":"100% recycled"}},"1eeb1cb0-605a-42c5-b679-f2ddd2a3bb74":{"type":"text","settings":{"title":"Styles","value1":"Cookie cutter designs with limited customization","value2":"600+ customizable designs"}},"d5879075-4800-4bc8-9701-cca14c799651":{"type":"text","settings":{"title":"Expertise","value1":"New to lab-grown or sell conflict earth mined diamonds","value2":"18 years offering only lab-grown diamonds"}},"e3cfa0a3-76b7-48d5-9c1f-01a8deb356b0":{"type":"text","settings":{"title":"Customer Service","value1":"Commissioned sales people not advocating for the consumer","value2":"Full-service jewelers with invested, non-commissioned personal shoppers"}},"5a139e35-41b6-446c-ad49-b3f3c0e31640":{"type":"text","settings":{"title":"Business Structure","value1":"Publicly traded large corporations","value2":"Women founded and led"}}},"block_order":["b7da3325-2d4d-44a2-b449-f7556cf48e5a","6947ffc1-45fb-4196-a351-182e28a06f8a","2cca165a-a5ac-48a6-a141-ae2b25cfb90e","17ca2189-d59e-409d-a929-9b2634d5e08a","1eeb1cb0-605a-42c5-b679-f2ddd2a3bb74","d5879075-4800-4bc8-9701-cca14c799651","e3cfa0a3-76b7-48d5-9c1f-01a8deb356b0","5a139e35-41b6-446c-ad49-b3f3c0e31640"],"custom_css":[],"settings":{"header1":"TRADITIONAL","header2":"MIADONNA"}},"37f4ea04-a4d8-410c-9d22-2ce06acd8ab3":{"type":"index__image-with-text","blocks":{"c5d9e5b9-badf-4240-aa4d-a64a633ced8d":{"type":"text","settings":{"title":"We Exist to Give Back!","pre-title":"","heading_size":"small","text":"<p>MiaDonna is a Social Enterprise. How? We measure more than profit and use business as a force for good! <\/p><p>Simply put, MiaDonna sells conflict-free fine jewelry to be the sustainable funding source for our foundation, <a href=\"https:\/\/www.miadonna.com\/pages\/the-greener-diamond\" title=\"The Greener Diamond\">The Greener Diamond<\/a>. Year-round, at least 10% of the net profits from every purchase are used to fund educational programs, micro-business loans, and agricultural farms in diamond mining communities.<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}},"a7546482-f8b0-4ef2-b658-f5465afcc664":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/2_we_exsit_to_give_back_1_7d122a2c-5642-44bb-9c3a-15ff331b1cd0.jpg","image_link":"","image_text":""}}},"block_order":["c5d9e5b9-badf-4240-aa4d-a64a633ced8d","a7546482-f8b0-4ef2-b658-f5465afcc664"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"031d7289-a149-4af2-87c6-7481a07131bc":{"type":"designer_style","blocks":{"6d38f5f7-22eb-4f43-a1e7-0bf2d43e0657":{"type":"text","settings":{"image":"shopify:\/\/shop_images\/trending-solitaire.webp","title":"Solitaire","link":"\/collections\/solitaire-engagement-rings"}},"36f0fda6-bd73-49e1-b8e1-fd921ba5cf8b":{"type":"text","settings":{"image":"shopify:\/\/shop_images\/trending-primary.webp","title":"Vintage","link":"\/collections\/vintage-and-antique-style-engagement-rings"}},"3f9350f1-3d80-488c-98ab-2414d9cb930e":{"type":"text","settings":{"image":"shopify:\/\/shop_images\/trending-halo.webp","title":"Halo"