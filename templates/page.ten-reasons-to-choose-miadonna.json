"button_label":""}},"template--15036422193231__adf9f8e8-6db7-4cf0-ac13-eaf6e5f0d923-collection-3":{"type":"collection","settings":{"feature_collection":"","image":"shopify:\/\/shop_images\/trending-halo.jpg","title":"Halo","button_label":""}},"cdd8536a-caa3-44f8-ba4b-229f051ec01c":{"type":"collection","settings":{"feature_collection":"lab-grown-diamond-jewelry","image":"shopify:\/\/shop_images\/trending-jewelry.jpg","title":"Jewelry","button_label":""}}},"block_order":["template--15036422193231__adf9f8e8-6db7-4cf0-ac13-eaf6e5f0d923-collection-1","template--15036422193231__adf9f8e8-6db7-4cf0-ac13-eaf6e5f0d923-collection-2","template--15036422193231__adf9f8e8-6db7-4cf0-ac13-eaf6e5f0d923-collection-3","cdd8536a-caa3-44f8-ba4b-229f051ec01c"],"settings":{"collections_per_row":4,"align_height":false,"collection_height":400,"enable_zoom":true,"button_style":"button--secondary","overlay_background":"rgba(0,0,0,0)","overlay_background_opacity":70,"overlay_text":"#000000","collection_title_below_image":false,"width":"standard","show_gutter":true,"padding_top":0,"padding_bottom":50,"animation":"none","css_class":"custom-collection-list","custom_css":""}},"ece35b6d-58f7-4265-bc80-1eebb8e4e302":{"type":"index__image-with-text","blocks":{"f194f157-225d-428a-9d58-7c3eb65561ca":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/3_our_jewelry_is_better_1.webp","image_link":"","image_text":""}},"321b56fe-91d3-4a38-b75f-640100e071b7":{"type":"text","settings":{"title":"Superior Quality Fine Jewelry","pre-title":"","heading_size":"small","text":"<p>All our jewelry is handcrafted within 10 to 14 days. Most other jewelry companies mass produce their rings in pre-stocked, limited sizes with lower gram weights. At MiaDonna, we make your ring when you order it, in the size you order, using a higher gram weight of metal, creating beautiful jewelry that is made to last a lifetime and beyond. Our jewelry makes exceptional heirlooms!<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}}},"block_order":["f194f157-225d-428a-9d58-7c3eb65561ca","321b56fe-91d3-4a38-b75f-640100e071b7"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"6d42cc61-45af-4fe7-bfe1-23b7430e3a6c":{"type":"index__image-with-text","blocks":{"12d84744-b846-4a18-ba87-bcd5ad315b91":{"type":"text","settings":{"title":"Our Diamonds And Gems Are Conflict-Free And More Affordable","pre-title":"","heading_size":"small","text":"<p>We exclusively offer diamonds and gems free of humanitarian and environmental concerns because they are grown in a modern-day lab environment. Not only will you feel proud of the jewelry you wear, you will save up to 40% compared to an earth-mined diamond.<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}},"bc5c4aa8-bc94-46cd-a8b7-a8f0dcab3cca":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/4_Diamonds_and_Gems_1_179fed12-364f-45b9-bd93-2ec3255a89ae.jpg","image_link":"","image_text":""}}},"block_order":["12d84744-b846-4a18-ba87-bcd5ad315b91","bc5c4aa8-bc94-46cd-a8b7-a8f0dcab3cca"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"71259de7-1fe4-491f-874a-f272ad3eb78c":{"type":"index__image-with-text","blocks":{"ddacc050-3171-4c9d-ad56-7d1ce25761ca":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/5_gold_and_platinum_1_f2482252-7d84-4e26-9f08-03f5cd0062a4.jpg","image_link":"","image_text":""}},"c801a9ac-6b5b-4548-832c-2f995b85c262":{"type":"text","settings":{"title":"100% Recycled Solid Gold and Platinum","pre-title":"","heading_size":"small","text":"<p>All of our precious metals are 100% recycled. This is extremely important because precious metals can be as conflicted as diamonds. Most competitors that offer recycled metals only use up to 60% recycled metals.<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}}},"block_order":["ddacc050-3171-4c9d-ad56-7d1ce25761ca","c801a9ac-6b5b-4548-832c-2f995b85c262"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"486809c6-a298-41b4-a752-d20141a5f31d":{"type":"index__image-with-text","blocks":{"a1eb0403-6c9b-4ad7-bc0b-a092c07fc0cb":{"type":"text","settings":{"title":"You Build Your Jewelry Just The Way You Want","pre-title":"","heading_size":"small","text":"<p>Our online Ring Builder makes it so easy! Start by choosing a design from our ethical and affordable collection of engagement rings, wedding bands, wedding sets, and accessories. Then, make it your own by selecting your center stone type, shape, and carat weight (lab-grown diamonds or colored gemstones), recycled metal color, and ring size.<\/p><p><a href=\"https:\/\/www.miadonna.com\/collections\/engagement-rings\" title=\"Let's Handcraft Your Dream Ring!\">Start building your dream ring now.<\/a><\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}},"6992bb23-0415-44a3-a5a7-d73a5c808c43":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/6_build_your_jewelry_1_1.jpg","image_link":"","image_text":""}}},"block_order":["a1eb0403-6c9b-4ad7-bc0b-a092c07fc0cb","6992bb23-0415-44a3-a5a7-d73a5c808c43"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"bc23e47a-2f9d-4431-8fdc-4a45ffe9a728":{"type":"index__image-with-text","blocks":{"81ecd444-0e4a-42c6-aaa8-6843065e592f":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/7_B_corp_logo_1.jpg","image_link":"","image_text":""}},"f2b8fa11-8bcb-4d08-9bb6-52240f4878c8":{"type":"text","settings":{"title":"Our Sustainable Practices Are The Best In The Industry","pre-title":"","heading_size":"small","text":"<p>We hate greenwashing just as much as you do. You can trust our sustainable practices because we are <a href=\"https:\/\/www.miadonna.com\/pages\/our-pledge\">B Corp Certified<\/a>! This means we have not only met but exceeded the highest level of sustainable practices. <\/p><p>Among numerous other third-party certifications, MiaDonna also ranked #36 in the list of the ‘Top 100 Corporate Social Responsibility’ leading brands worldwide, beating out such heavyweights as Land Rover, Delta Airlines, Prada, and REI.<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}}},"block_order":["81ecd444-0e4a-42c6-aaa8-6843065e592f","f2b8fa11-8bcb-4d08-9bb6-52240f4878c8"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"2b177576-6e37-4f26-8f60-2af0142a0105":{"type":"index__image-with-text","blocks":{"893c4c5c-48b8-4059-b7f6-596ffb76f409":{"type":"text","settings":{"title":"Our Service Is Exceptional","pre-title":"","heading_size":"small","text":"<p>Our goal is to make your engagement ring shopping experience fun, relaxing, and safe. Our non-commissioned Lab-Grown Diamond and fine jewelry experts are standing by to be your advocate in finding the best quality at the best price. We offer free 2-day insured domestic shipping, 60-DAY returns, and complimentary 90-day resizing.<\/p><p><a href=\"\/pages\/reviews\" title=\"\/pages\/reviews\">Read our reviews.<\/a><\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}},"ce38901e-694e-49c4-934c-965f57ffbc75":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/8_service_1_489604ab-39bd-434b-bc1b-00aa8c94ec15.jpg","image_link":"","image_text":""}}},"block_order":["893c4c5c-48b8-4059-b7f6-596ffb76f409","ce38901e-694e-49c4-934c-965f57ffbc75"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"40b1a505-5fb6-4671-a1d7-936e05fb6f99":{"type":"index__image-with-text","blocks":{"fd26b0e7-eed6-417d-aa95-e79c4d5706b3":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/9_this_generation_1.jpg","image_link":"","image_text":""}},"41815293-7cf9-482b-bda1-647dbc148c0b":{"type":"text","settings":{"title":"MiaDonna Is Woman-Founded, Women-Led, And Privately Operated","pre-title":"","heading_size":"small","text":"<p>MiaDonna's founder, Anna-Mieke, is our active CEO, single mum, and lead activist for our foundation. She continues to change outdated humanitarian and environmental policies and laws surrounding mining communities. <\/p><p>We do not answer to shareholders, board members, large corporations, or DeBeers. We only answer to you, diamond mining communities, and the earth.<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}}},"block_order":["fd26b0e7-eed6-417d-aa95-e79c4d5706b3","41815293-7cf9-482b-bda1-647dbc148c0b"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"1863655b-6e61-47c9-9fb7-58bde0d37ccd":{"type":"index__image-with-text","blocks":{"d78505c4-3956-4c39-b6b8-adfcdedc3c20":{"type":"text","settings":{"title":"We Are this Generation's Diamond Store","pre-title":"","heading_size":"small","text":"<p>When our founder, Anna-Mieke Anderson, discovered she had accidentally purchased a blood diamond, she became passionate about finding a conflict-free option. Knowing there had to be others who felt the same, she set out on a life-long mission to create the Greenest Diamond store the world had ever seen. As a result, MiaDonna & Company and The Greener Diamond Foundation were born. Since then customers like you have helped fund agricultural and education projects in West Africa, where former child soldiers are supported to grow food instead of mine for diamonds.<\/p>","button_label":"","link":"","button_style":"button--primary","background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"left","vertical_position":"center"}},"227e6393-2ccf-4227-9d10-9741602d9746":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/10_woman_owned_1.jpg","image_link":"","image_text":""}}},"block_order":["d78505c4-3956-4c39-b6b8-adfcdedc3c20","227e6393-2ccf-4227-9d10-9741602d9746"],"settings":{"width":"standard","show_gutter":false,"padding_top":50,"padding_bottom":50,"animation":"none","id_sec":"","css_class":"section-one-half more-space","custom_css":""}},"e65475c6-698e-4341-a70c-ec4e9c09d5ad":{"type":"testimonial-slider","blocks":{"67a50724-c270-4330-b985-29a96785e0ba":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/quote-gq_74bbebc4-665a-42b6-90c9-0033c10c3a4e.png","title":"","quote":"Lab-Grown Diamonds are here to stay. They are real diamonds, available at a fraction of the cost, without the need for destructive mining or conflict.","author":"GQ MAGAZINE"}},"2f057b0d-9ee7-4764-9878-521b2bfda807":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/quote-trustpilot_a927ae13-b7dd-4119-be73-b61ff4758cdd.png","title":"","quote