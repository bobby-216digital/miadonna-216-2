:{"width":"wide","text_style":false,"sectionid":"section3","show_gutter":false,"padding_top":20,"padding_bottom":20,"animation":"none","arialabelledby":"ethical-jewelry-heading","id_sec":"","css_class":"image-text-nw mob-textup","custom_css":""}},"index_image_with_text_2_MawLYT":{"type":"index__image-with-text-2","blocks":{"image_nxWj8P":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Promo_Block4.jpg","image_link":"","iframe_video":""}},"text_7f4g6B":{"type":"text","settings":{"heading_tag":"h2","title":"OUR PROMISE TO YOU","title2":"","text":"<p>Exceptional quality, intentional design, and a personalized experience.<br\/><br\/>From the first glance to the final polish, our pieces are made to last, thoughtfully crafted with high-quality materials, refined settings, and timeless appeal.<br\/><br\/>We\u2019re here to help you celebrate what matters most, with jewelry that feels as special as the moments you wear it for.<\/p>","button_label":"","link":"","button_style":"button--primary","open_new_new_tab_button_1_ink":false,"button_label2":"","link2":"","button_style2":"button--primary","open_new_new_tab_button__2_link":false,"background":"rgba(0,0,0,0)","text_color":"rgba(0,0,0,0)","alignment":"center","vertical_position":"center"}}},"block_order":["image_nxWj8P","text_7f4g6B"],"disabled":true,"name":"Index image with text 2","settings":{"width":"wide","text_style":false,"sectionid":"section4","show_gutter":false,"padding_top":20,"padding_bottom":50,"animation":"none","arialabelledby":"our-promise-heading","id_sec":"","css_class":"image-text-nw mob-textup","custom_css":""}},"home_category_slider_jFU6gH":{"type":"home-category-slider","blocks":{"category_ncVJXm":{"type":"category","settings":{"collection":"lab-grown-diamond-engagement-rings","title":"Engagement Ring","image":"shopify:\/\/shop_images\/Promo_Block_b6367e8b-0314-402d-935b-e18db8694fa8.jpg"}},"category_PTHDEF":{"type":"category","settings":{"collection":"shop-all-wedding","title":"Wedding Bands","image":"shopify:\/\/shop_images\/Promo_Block-1.jpg"}},"category_g4kQ8V":{"type":"category","settings":{"collection":"lab-grown-diamond-necklaces","title":"Necklaces","image":"shopify:\/\/shop_images\/Promo_Block-2.jpg"}},"category_GknKF7":{"type":"category","settings":{"collection":"lab-grown-diamond-earrings","title":"Earrings","image":"shopify:\/\/shop_images\/Promo_Block-3.jpg"}},"category_84WVLm":{"type":"category","settings":{"collection":"lab-grown-diamond-bracelets","title":"Bracelets","image":"shopify:\/\/shop_images\/Shop_Lab_Grown_Diamond_Bracelets.png"}}},"block_order":["category_ncVJXm","category_PTHDEF","category_g4kQ8V","category_GknKF7","category_84WVLm"],"disabled":true,"custom_css":[],"name":"Home Category Slider","settings":{"class":"common-spacing text-center","title":"SHOP COLLECTIONS","content":""}},"home_accordion_faq_fjNYG7":{"type":"home-accordion-faq","blocks":{"accordion_item_iFPzPz":{"type":"accordion_item","settings":{"title":"Do I need an appointment to visit?","content":"Appointments aren't required, but they're recommended. Booking ahead guarantees you'll have a dedicated jewelry specialist and the full experience, including a glass of champagne or artisanal tea while you browse. Walk-ins are always welcome, and we'll do our best to assist you based on availability."}},"accordion_item_GajM9p":{"type":"accordion_item","settings":{"title":"Can I see loose diamonds in person?","content":"Absolutely. One of the advantages of visiting in person is the chance to view our loose stones up close. Our jewelry specialists can walk you through diamond options side by side, so you can compare cut, color, and clarity in real life before deciding. It's the best way to find the stone that's right for you."}},"accordion_item_QGXRY8":{"type":"accordion_item","settings":{"title":"Is there sales tax in Oregon?","content":"No. Oregon is one of a handful of states with no sales tax, so the price you see is the price you pay. Whether you're visiting from out of state or shopping locally, you won't pay any sales tax on your purchase at our Bridgeport Village flagship store."}},"accordion_item_3FyCw4":{"type":"accordion_item","settings":{"title":"Where do I park?","content":"Parking is easy and complimentary at Bridgeport Village. The open-air center has ample parking throughout, and you'll find spaces close to our store."}},"accordion_item_EdmxPE":{"type":"accordion_item","settings":{"title":"Can I make an appointment?","content":"Yes! Our jewelry specialists are available for appointments in our flagship store in Bridgeport Village in Portland, Oregon. During your shopping appointment, settle in and savor a selection of refreshments. Enjoy a glass of champagne or a perfectly brewed cup of artisanal tea while browsing our fine jewelry with one of our expert jewelry specialists.\n\nAppointments are typically set for 60 minutes. Feel free to bring family and friends along."}},"accordion_item_Q63YfL":{"type":"accordion_item","settings":{"title":"Can I bring family and friends?","content":"Of course. Choosing fine jewelry is often a shared experience, and you're welcome to bring the people whose opinions matter most. Your appointment space comfortably accommodates a small group, so bring along whoever you'd like to share the moment with."}},"accordion_item_K3GPWK":{"type":"accordion_item","settings":{"title":"What should I bring to my appointment?","content":"Just yourself and any inspiration you've gathered. If you have saved designs, screenshots, or ideas from our website, bring them along so your specialist can tailor the experience. If you're shopping for an engagement ring and know a ring size or have a ring to match, that's helpful too, but not required."}},"accordion_item_zDUNaU":{"type":"accordion_item","settings":{"title":"What products are available in the store?","content":"While we'd love to have our entire collection of jewelry on display in our store, it simply wouldn't all fit since we offer thousands of variations of popular jewelry styles. However, our Portland Oregon store carries hundreds of our most popular styles to purchase right in the store. \n\nAdditionally, our jewelry specialists are available to find just the right piece from our online assortment, or even to customize the piece of your dreams. \n\nIf there is a particular style or diamond you\u2019d like to see, please Contact Us or Book an Appointment and we'll be happy to help!"}}},"block_order":["accordion_item_iFPzPz","accordion_item_GajM9p","accordion_item_QGXRY8","accordion_item_3FyCw4","accordion_item_EdmxPE","accordion_item_Q63YfL","accordion_item_K3GPWK","accordion_item_zDUNaU"],"name":"Home Accordion FAQ","settings":{"background_color":"#f8f8f8","sectionid":"","section_heading":"Store FAQs","columns":2}},"e0422252-b178-4354-aaae-d4a69aa9b4f3":{"type":"custom-liquid","settings":{"custom_liquid":"{% render 'request-quote-popup' %}"}},"5fb0f164-ba84-4c8f-aafc-9582d8ca0103":{"type":"collection-block","blocks":{"40c78440-4092-4072-bb64-fcb27b329b94":{"type":"collection_block","settings":{"image":"shopify:\/\/shop_images\/millie-engagement-ring-pl_2_400x_a1db46c5-363d-4a3a-ae94-1a2a03f4a497.webp","image_alt":"","title":"Engagement Rings","url":"\/collections\/halo-engagement-rings"}},"fad8f26d-cadf-4669-8f13-e47715ebac24":{"type":"collection_block","settings":{"image":"shopify:\/\/shop_images\/wedding-bands_400x_91dc1f6e-d934-4c4d-93f6-56f3203415aa.webp","image_alt":"","title":"Wedding Bands","url":"\/collections\/wedding-bands"}},"6597e72c-07de-41b3-aaf5-35a341d1025c":{"type":"collection_block","settings":{"image":"shopify:\/\/shop_images\/martini-stud-earrings2_400x_40a3b05e-2e84-4f0f-8080-2594f3ae3009.webp","image_alt":"","title":"Earrings","url":"\/collections\/earrings"}},"326dd769-fa6a-4103-8428-37677198bd2d":{"type":"collection_block","settings":{"image":"shopify:\/\/shop_images\/bracelets_page_400x_5151fd3a-9fdd-4530-aa69-e7066a386810.webp","image_alt":"","title":"Bracelets","url":"\/coll