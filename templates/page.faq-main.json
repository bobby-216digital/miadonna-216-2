      <li class=\"faq-categorybox\">Returns & Exchanges<\/li>\n            <li class=\"faq-categorybox\">Care & Repair<\/li>\n            <li class=\"faq-categorybox\">Sizing<\/li>\n            <li class=\"faq-categorybox\">Jewelry<\/li>\n            <li class=\"faq-categorybox\">Lab Grown Diamonds<\/li>\n            <li class=\"faq-categorybox\">Diamonds<\/li>\n            <li class=\"faq-categorybox\">Lab Grown Gems<\/li>\n            <li class=\"faq-categorybox\">Origins & Certifications<\/li>\n            <li class=\"faq-categorybox\">International Orders<\/li>\n            <li class=\"faq-categorybox\">The Foundation<\/li>\n            <li class=\"faq-categorybox\">About Miadonna<\/li>\n        <\/ul>\n    <\/div>\n<\/div>\n<script>\n    const faqSelect = document.getElementById('faqSelectCategory');\n    const faqList = document.getElementById('faqCategory');\n    const faqItems = document.querySelectorAll('.faq-categorybox');\n    const faqArrow = document.querySelector('.faq-arrow');\n\n    \/\/ Toggle dropdown on button click\n    faqSelect.addEventListener('click', () => {\n        faqList.classList.toggle('show');\n        faqArrow.classList.toggle('rotate');\n    });\n\n    \/\/ Handle category selection\n    faqItems.forEach(item => {\n        item.addEventListener('click', () => {\n            \/\/ Update button text\n            faqSelect.childNodes[0].nodeValue = item.textContent;\n\n            \/\/ Remove previous selection\n            faqItems.forEach(i => i.classList.remove('faq-selected'));\n\n            \/\/ Highlight selected\n            item.classList.add('faq-selected');\n\n            \/\/ Close dropdown\n            faqList.classList.remove('show');\n            faqArrow.classList.remove('rotate');\n        });\n    });\n\n    \/\/ Close dropdown if clicked outside\n    document.addEventListener('click', (e) => {\n        if (!e.target.closest('.faq-categorydropdown')) {\n            faqList.classList.remove('show');\n            faqArrow.classList.remove('rotate');\n        }\n    });\n<\/script>"}},"lab_diamonds_sub_footer_faq_cinxxz":{"type":"lab-diamonds-sub-footer-faq","blocks":{"content_DXrmnL":{"type":"content","settings":{"faqs_menu__title":"All FAQs","faqs_menu":"","faq_schema":""}},"content_NxzBax":{"type":"content","disabled":true,"settings":{"faqs_menu__title":"Popular FAQs","faqs_menu":"popular-faqs","faq_schema":""}},"content_tmnapH":{"type":"content","settings":{"faqs_menu__title":"About MiaDonna","faqs_menu":"about-miadonna","faq_schema":""}},"content_WPYpDg":{"type":"content","settings":{"faqs_menu__title":"Online Ordering","faqs_menu":"ordering-financing","faq_schema":""}},"content_DyFwG6":{"type":"content","settings":{"faqs_menu__title":"Warranty & Repair","faqs_menu":"faqs-care-repair","faq_schema":""}},"content_HLwTQW":{"type":"content","settings":{"faqs_menu__title":"Pricing & Discounts","faqs_menu":"pricing-discounts-faqs","faq_schema":""}},"content_ttki8E":{"type":"content","settings":{"faqs_menu__title":"Payments & Financing","faqs_menu":"payments-financing-faqs-1","faq_schema":""}},"content_NBW36y":{"type":"content","settings":{"faqs_menu__title":"Shipping & Delivery","faqs_menu":"shipping-and-delivery-faqs","faq_schema":""}},"content_LfR4M7":{"type":"content","settings":{"faqs_menu__title":"Returns & Exchanges","faqs_menu":"new-returns-exchanges-faqs","faq_schema":""}},"content_yaaG6K":{"type":"content","settings":{"faqs_menu__title":"Diamond Education","faqs_menu":"diamond-education-faqs","faq_schema":""}},"content_8Ewwhe":{"type":"content","settings":{"faqs_menu__title":"Gemstone Education","faqs_menu":"gemstone-education-faqs","faq_schema":""}},"content_VhKq3T":{"type":"content","settings":{"faqs_menu__title":"Jewelry Education","faqs_menu":"jewelry-education-faqs","faq_schema":""}},"content_BEW8KU":{"type":"content","settings":{"faqs_menu__title":"Care & Cleaning","faqs_menu":"care-cleaning-faqs","faq_schema":""}},"content_kLBg6U":{"type":"content","settings":{"faqs_