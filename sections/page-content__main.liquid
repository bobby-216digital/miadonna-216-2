{% comment %}
  ** Page content **
{% endcomment %}

<style>
  #map {
    height: 400px;
    width: 100%;
  }
</style>
{{ 'page-content-main.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'page-content-main.css' | asset_url | stylesheet_tag }}</noscript>

<script src="https://connect.breadpayments.com/sdk.js"></script>

<script src="{{ 'select-menu.js' | asset_url }}" defer="defer"></script>

{% assign id = section.id %}
{% comment %}Layout{% endcomment %}
{% assign width = section.settings.width %}
{% assign padding_top = section.settings.padding_top %}
{% assign padding_bottom = section.settings.padding_bottom %}
{% assign animation = section.settings.animation | default: 'none' %}
{% comment %}Advanced{% endcomment %}
{% assign css_class = section.settings.css_class %}
{% assign custom_css = section.settings.custom_css %}

{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  {% if section.settings.image == blank %}
  .page__main-content .heading-wrapper{
    margin-top: 15px;
  }
  {% endif %}

  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

<section
  class="
    section
    {% if section.settings.menu != blank %}
    static_page-section
    {% endif %}
    section-page-{{ page.handle | escape }}
    {{ css_class }}
    is-width-{{ width }}
  "
  {% if animation != 'none' %}
    data-scroll-class="{{ animation }}"
  {% endif %}
>
  {%- if section.settings.show_breadcrumb -%}
    <div class="container breadcrumb-wrapper is-hidden-mobile-only">
      {% render 'breadcrumb' %}
    </div>
  {%- endif -%}
  {% if page.handle == 'all-snippets' %}
    <div class="h2">
      Font Sizes Desktop ---- H1 - {{ settings.heading_size | append: 'px' }} ---- H2 -
      {{ settings.heading_size | times: 0.625 | floor | append: 'px' }} ---- H3 -
      {{ settings.heading_size | times: 0.5 | floor | append: 'px' }} ---- H4 -
      {{ settings.heading_size | times: 0.5 | floor | append: 'px' }}
    </div>
    <div class="h2">
      Font Sizes Mobile ---- H1 - {{ settings.heading_size | times: 0.73 | floor | append: 'px' }} ---- H2 -
      {{ settings.heading_size | times: 0.54 | floor | append: 'px' }} ---- H3 -
      {{ settings.heading_size | times: 0.42 | floor | append: 'px' }} ---- H4 -
      {{ settings.heading_size | times: 0.42 | floor | append: 'px' }}
    </div>
  {% endif %}
  <div class="container">
    {%- if section.settings.show_sidebar -%}
      {% comment %} Pages Sidebar {% endcomment %}
      {% render 'dynamic_pages-sidebar', menu: section.settings.menu %}
    {%- endif -%}
    {%- if section.settings.show_sidebar -%}
      <div
        class="
          page__main-content{% if section.settings.menu != blank %} four-fifths large-down--three-fourths{% else %} one-whole{% endif %} medium-down--one-whole
          column
          has-margin-bottom
        "
      >
    {%- endif -%}
    {% if section.settings.image != blank %}
      <div class="image__wrapper medium-up--hide">
        {% render 'image-element',
          image: section.settings.image,
          alt: section.settings.image.alt,
          stretch_width: true,
          focal_point: section.settings.image.presentation.focal_point
        %}
      </div>
    {% endif %}
    {%- if section.settings.show_heading != blank -%}
      {% render 'heading',
        title: page.title,
        heading_tag: 'h1',
        context: 'page',
        text_alignment: section.settings.heading_alignment
      %}
    {%- endif -%}
    {% if section.settings.image != blank %}
      <div class="image__wrapper one-whole medium-down--hide column has-padding-bottom">
        {% render 'image-element',
          image: section.settings.image,
          alt: section.settings.image.alt,
          stretch_width: true,
          focal_point: section.settings.image.presentation.focal_point
        %}
      </div>
    {% endif %}
    <div class="page__content content container {% if settings.table_styles_enabled %} table is-striped is-bordered {% endif %}">
      {% if section.blocks.size > 0 %}
        <div class="page__content-inner one-whole medium-down--one-whole column">
          {% for block in section.blocks %}
            {% if block.type == 'content' %}
              <dl
                class="
                  {{ section.settings.css_class }}
                  faq-accordion block--{{ forloop.index }}
                  accordion-icon--{{ settings.toggle_icon_style }} {% if block.settings.column == 'whole' %}has-no-side-gutter{% endif %} has-margin-bottom
                "
              >
            {% endif %}
            {% if block.type == 'image' %}
              <div class="block--{{ forloop.index }} image__wrapper">
                {% if block.settings.image != blank %}
                  {% render 'image-element',
                    image: block.settings.image,
                    alt: block.settings.image.alt,
                    stretch_width: true,
                    focal_point: block.settings.image.presentation.focal_point
                  %}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% elsif block.type == 'content' %}
              {% if block.settings.column == 'whole' %}
                <div
                  class="faq-accordion-items one-{{ block.settings.column }} medium-down--one-whole"
                >
                  {% for link in block.settings.faqs_menu.links %}
                    {% if link.links != blank %}
                      <div class="faq-accordion-item" data-index="{{ forloop.index }}">
                        <dt>
                          <button
                            class="accordion-style--{{ settings.toggle_icon_style }} accordion__button"
                            type="button"
                            aria-controls="panel-{{ block.id }}"
                            aria-expanded="true"
                          >
                            <span
                              {% unless page.handle contains 'faq' %}
                                class="" style="font-weight:400;"
                              {% else %}
                                style="font-weight:400;"
                              {% endunless %}
                            >
                              {{- link.title | escape -}}
                            </span>
                            {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
                          </button>
                        </dt>
                        <dd
                          id="panel-{{ block.id }}"
                          aria-hidden="false"
                          class="panel"
                        >
                          <div class="content">
                            {% for childLink in link.links %}
                              {% if childLink.links == blank %}
                                {% if childLink.url != routes.root_url %}
                                  <a href="{{ childLink.url }}" style="text-decoration:underline;">
                                {% endif %}
                                {{ childLink.title | remove: '<br>' | escape -}}
                                {%- if childLink.title == '<br>' -%}
                                  <br>
                                {% elsif childLink.title == '<br><br>' -%}
                                  <br>
                                  <br>
                                {% endif %}
                                {% if childLink.url != routes.root_url %}
                                  </a>
                                {% endif %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% else %}
                {% capture lastFAQ %}
                  {% for link in block.settings.faqs_menu.links %}
                    {% if forloop.last %}
                      <div class="faq-accordion-item" data-index="{{ forloop.index }}">
                        <dt>
                          <button
                            class="accordion-style--{{ settings.toggle_icon_style }} accordion__button"
                            type="button"
                            aria-controls="panel-{{ block.id }}"
                            aria-expanded="true"
                          >
                            <span
                              {% unless page.handle contains 'faq' %}
                                class="" style="font-weight:400;"
                              {% else %}
                                style="font-weight:400;"
                              {% endunless %}
                            >
                              {{- link.title | escape -}}
                            </span>
                            {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
                          </button>
                        </dt>
                        <dd
                          id="panel-{{ block.id }}"
                          aria-hidden="false"
                          class="panel"
                        >
                          <div class="content">
                            {% for childLink in link.links %}
                              {% if childLink.links == blank %}
                                {% if childLink.url != routes.root_url %}
                                  <a href="{{ childLink.url }}" style="text-decoration:underline;">
                                {% endif %}
                                {{ childLink.title | remove: '<br>' | escape -}}
                                {%- if childLink.title == '<br>' -%}
                                  <br>
                                {% elsif childLink.title == '<br><br>' -%}
                                  <br>
                                  <br>
                                {% endif %}
                                {% if childLink.url != routes.root_url %}
                                  </a>
                                {% endif %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endcapture %}
                <div
                  class="faq-accordion-items one-{{ block.settings.column }} medium-down--one-whole"
                >
                  {% assign blockSizeLast = block.settings.faqs_menu.links.size | modulo: 2 %}
                  {% assign blockSize = block.settings.faqs_menu.links.size | divided_by: 2 %}
                  {% for link in block.settings.faqs_menu.links limit: blockSize %}
                    {% if link.links != blank %}
                      <div class="faq-accordion-item" data-index="{{ forloop.index }}">
                        <dt>
                          <button
                            class="accordion-style--{{ settings.toggle_icon_style }} accordion__button"
                            type="button"
                            aria-controls="panel-{{ block.id }}"
                            aria-expanded="true"
                          >
                            <span
                              {% unless page.handle contains 'faq' %}
                                class="" style="font-weight:400;"
                              {% else %}
                                style="font-weight:400;"
                              {% endunless %}
                            >
                              {{- link.title | escape -}}
                            </span>
                            {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
                          </button>
                        </dt>
                        <dd
                          id="panel-{{ block.id }}"
                          aria-hidden="false"
                          class="panel"
                        >
                          <div class="content">
                            {% for childLink in link.links %}
                              {% if childLink.links == blank %}
                                {% if childLink.url != routes.root_url %}
                                  <a href="{{ childLink.url }}" style="text-decoration:underline;">
                                {% endif %}
                                {{ childLink.title | remove: '<br>' | escape -}}
                                {%- if childLink.title == '<br>' -%}
                                  <br>
                                {% elsif childLink.title == '<br><br>' -%}
                                  <br>
                                  <br>
                                {% endif %}
                                {% if childLink.url != routes.root_url %}
                                  </a>
                                {% endif %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                  {% if blockSizeLast != 0 %}
                    {{ lastFAQ }}
                  {% endif %}
                </div>

                <div
                  class="faq-accordion-items one-{{ block.settings.column }} medium-down--one-whole"
                >
                  {% for link in block.settings.faqs_menu.links limit: blockSize offset: continue %}
                    {% if link.links != blank %}
                      <div class="faq-accordion-item" data-index="{{ forloop.index }}">
                        <dt>
                          <button
                            class="accordion-style--{{ settings.toggle_icon_style }} accordion__button"
                            type="button"
                            aria-controls="panel-{{ block.id }}"
                            aria-expanded="true"
                          >
                            <span
                              {% unless page.handle contains 'faq' %}
                                class="" style="font-weight:400;"
                              {% else %}
                                style="font-weight:400;"
                              {% endunless %}
                            >
                              {{- link.title | escape -}}
                            </span>
                            {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
                          </button>
                        </dt>
                        <dd
                          id="panel-{{ block.id }}"
                          aria-hidden="false"
                          class="panel"
                        >
                          <div class="content">
                            {% for childLink in link.links %}
                              {% if childLink.links == blank %}
                                {% if childLink.url != routes.root_url %}
                                  <a href="{{ childLink.url }}" style="text-decoration:underline;">
                                {% endif %}
                                {{ childLink.title | remove: '<br>' | escape -}}
                                {%- if childLink.title == '<br>' -%}
                                  <br>
                                {% elsif childLink.title == '<br><br>' -%}
                                  <br>
                                  <br>
                                {% endif %}
                                {% if childLink.url != routes.root_url %}
                                  </a>
                                {% endif %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

            {% elsif block.type == 'heading' %}
              {% if block.settings.title != blank %}
                <style>
                  .title-{{ block.id }}{
                    font-weight: 500;
                    margin-bottom: 0 !important;
                    text-transform: uppercase;
                    font-family: {{ block.settings.richtext_font }} !important;
                  }
                </style>
                <h2 class="block--{{ forloop.index }} title-{{ block.id }} faq-title">{{ block.settings.title }}</h2>
              {% endif %}
            {% elsif block.type == 'richtext' %}
              <style>
                .page-contact .richtext-content-{{ block.id }} > *{
                  font-style: italic;
                  font-weight: 500;
                }
                .richtext-content-{{ block.id }} > *{
                  line-height: normal;
                  margin-bottom: 20px !important;
                  font-family: {{ block.settings.richtext_font }} !important;
                }
              </style>
              <div
                class="block--{{ forloop.index }} richtext-content-{{ block.id }} text-align-{{ block.settings.richtext_alignment }} has-padding-bottom"
              >
                {{ block.settings.richtext }}
              </div>
            {% elsif block.type == 'richtext_2' %}
              <style>
                .richtext-content-{{ block.id }} > *{
                  font-family: {{ block.settings.richtext_2_font }} !important;
                }
                .richtext-content-{{ block.id }} > h4,
                .richtext-content-{{ block.id }} > p:first-of-type{
                  color: #777777;
                  font-style: normal;
                }
                .richtext-content-{{ block.id }} a{
                  text-decoration: underline;
                }
                .richtext-content-{{ block.id }} strong{
                  font-weight: 500;
                }
              </style>
              <div class="block--{{ forloop.index }} is-flex is-justify-center has-margin-bottom has-padding-bottom">
                <div
                  class="richtext-content-{{ block.id }} one-half medium-down--one-whole text-align-{{ block.settings.richtext_2_alignment }}"
                >
                  {{
                    block.settings.richtext_column_1
                    | replace: 'href="/"', "href=javascript:void(0); onclick=Chatra('openChat',true)"
                  }}
                  {{ block.settings.content_html | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                </div>
                <div
                  class="richtext-content-{{ block.id }} one-half medium-down--one-whole text-align-{{ block.settings.richtext_2_alignment }}"
                >
                  {{ block.settings.richtext_column_2 -}}
                  {{ block.settings.content_html_2 | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                </div>
              </div>
            {% elsif block.type == 'image_with_text' %}
              <style>
                .image-text-{{ block.id }} .image-text-item:first-child{
                  padding: 1.5rem;
                  background-color: #f6f6f6;
                }
                .image-text-{{ block.id }} .image-text-item > *:first-child{
                  font-size: 1.4em;
                  font-family: Playfair Display,serif !important;
                }
                .image-text-{{ block.id }} .image-text-item > *:last-child{
                  font-family: Montserrat,sans-serif !important;
                }
              </style>
              <div class="block--{{ forloop.index }} image-text-{{ block.id }} is-flex is-justify-center has-no-side-gutter has-padding-bottom has-margin-bottom text-align-{{ block.settings.alignment }}">
                <div
                  class="image-text-item one-half column is-flex medium-down--one-whole is-justify-center is-flex-column"
                  {% if block.settings.position == 'left' %}
                    style="order: 2;"
                  {% endif %}
                >
                  {{ block.settings.title }}
                  {{ block.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                </div>
                <div class="image-text-item one-half medium-down--one-whole column">
                  {%- assign iframe_video = block.settings.iframe_video -%}
                  {% liquid
                    if iframe_video.type == 'youtube'
                      if block.settings.autoplay
                        assign autoplay = 'autoplay=1'
                      endif
                      if block.settings.autoloop
                        assign autoloop = 'loop=1'
                      endif
                      if block.settings.mute
                        assign mute = 'mute=1'
                      endif
                      if block.settings.controls
                        assign controls = 'controls=1'
                      endif
                    else
                      if block.settings.autoplay
                        assign autoplay = 'autoplay=1'
                      endif
                      if block.settings.autoloop
                        assign autoloop = 'loop=1'
                      endif
                      if block.settings.mute
                        assign mute = 'muted=1'
                      endif
                      if block.settings.controls
                        assign controls = 'controls=1'
                      endif
                    endif
                  %}
                  {% if iframe_video != blank %}
                    <div class="plyr__video-embed video-{{ id }}">
                      <div class="lazyframe" data-ratio="{{ block.settings.aspect_ratio }}">
                        {% if iframe_video.type == 'youtube' %}
                          <iframe
                            src="https://www.youtube.com/embed/{{ iframe_video.id  }}?playlist={{ iframe_video.id  }}&rel=0&{{ autoloop  }}&{{ autoplay  }}&{{ mute  }}&{{ controls  }};showsearch=0&version=3&showinfo=0&modestbranding=1&fs=1"
                            allowfullscreen
                            allowtransparency
                            allow="autoplay"
                            width="100%"
                            height="100%"
                          ></iframe>
                        {% elsif iframe_video.type == 'vimeo' %}
                          <iframe
                            src="https://player.vimeo.com/video/{{ iframe_video.id  }}?{{ autoloop  }}&amp;pip=0&amp;{{ autoplay  }}&amp;{{ mute  }}&amp;byline=false&amp;portrait=false&amp;title=false&amp;speed=true&amp;transparent=0&amp;gesture=media"
                            allowfullscreen
                            allowtransparency
                            allow="autoplay"
                            width="100%"
                            height="100%"
                          ></iframe>
                        {% endif %}
                      </div>
                    </div>
                  {% else %}
                    {% if block.settings.image != blank %}
                      {% render 'image-element',
                        image: block.settings.image,
                        alt: block.settings.image.alt,
                        stretch_width: true,
                        focal_point: block.settings.image.presentation.focal_point
                      %}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  {% endif %}
                  <div
                    class="text-align-{% if block.settings.position == 'left' %}left{% else %}right{% endif %}"
                    style="font-size: 11px;margin-top: 3px;"
                  >
                    {{ block.settings.image_title | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                  </div>
                </div>
              </div>
            {% elsif block.type == 'map_with_text' %}
              <style>
                .map-text-{{ block.id }}{
                  background-color: #f6f6f6;
                }
                .map-text-{{ block.id }} .map-text-item:first-child{
                  padding: 1.5rem;
                }
                .map-text-{{ block.id }} .map-text-item:first-child h3{
                  font-weight: 500;
                }
                .map-text-{{ block.id }} .map-text-item > *{
                  font-family: {{ block.settings.richtext_font }};
                }
                .map-text-{{ block.id }} .map-text-item > *:first-child{
                  font-size: 1.4em;
                }
              </style>
              <div class="block--{{ forloop.index }} map-text-{{ block.id }} is-flex is-justify-center has-no-side-gutter has-margin-bottom text-align-{{ block.settings.alignment }}">
                <div
                  class="map-text-item two-fifths column is-flex medium-down--one-whole is-justify-center is-flex-column"
                  {% if block.settings.position == 'left' %}
                    style="order: 2;"
                  {% endif %}
                >
                  {{ block.settings.title }}
                  {{ block.settings.content_html | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                  {{ block.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                </div>
                <div class="map-text-item three-fifths medium-down--one-whole column">
                  {{ block.settings.html }}
                </div>
              </div>
            {% elsif block.type == 'contact_form' %}
              <div id="contact-form-container"></div>
              <div class="block--{{ forloop.index }} contact-form-wrapper has-margin-top has-padding-top has-margin-bottom text-align-center">
                <div class="contact-form-container">
                  <header class="form-title">{{ block.settings.title }}</header>
                  <br>
                  {{ block.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                  {% form 'contact' %}
                    {% if form.posted_successfully? %}
                      <script>
                        $(document).ready(function () {
                          $(".successForm").dialog({
                            modal: true,
                            dialogClass: "successFormDiolog",
                            draggable: false,
                          });
                        });
                      </script>

                      <div class="successForm feedback">
                        <h2 class="pink-text">Success!</h2>
                        <p>We have received your message and we will be getting back to you soon.</p>
                      </div>
                    {% endif %}
                    {% if form.errors %}
                      <div class="errorForm feedback">
                        <!-- {{ form.errors.size }} or {{ form.errors | size }} -->
                        <p>
                          Your contact form has {{ form.errors | size | pluralize: 'an error', 'a few errors' }}. To
                          submit your form, make the following changes and try again:
                        </p>
                        {% for field in form.errors %}
                          <p>
                            The {{ field | capitalize | replace: 'Body', 'Message' }} field
                            {{ form.errors.messages[field] }}.
                          </p>
                        {% endfor %}
                      </div>
                    {% endif %}
                    <fieldset>
                      <div class="field">
                        <select name="contact[subject]" id="subject" class="field-subject" required>
                          <option selected="selected">{{ block.settings.option1 }}</option>
                          <option>{{ block.settings.option2 }}</option>
                          <option>{{ block.settings.option3 }}</option>
                          <option>{{ block.settings.option4 }}</option>
                          <option>{{ block.settings.option5 }}</option>
                        </select>
                        <div class="select-button">
                          <i class="icon-solid-caret"></i>
                        </div>
                      </div>
                      <div class="field">
                        <input
                          id="name"
                          name="contact[name]"
                          placeholder="{{ block.settings.name }}"
                          class="field-name"
                          type="text"
                          required=""
                        >
                      </div>
                      <div class="field">
                        <input
                          id="email"
                          name="contact[email]"
                          class="field-email"
