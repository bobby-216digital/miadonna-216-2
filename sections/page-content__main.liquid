<script>
  function initMap() {
    var map = new google.maps.Map(document.getElementById('map'), {
      center: { lat: 45.44609267107371, lng: -122.77756132389618 },
      zoom: 15
    });

    var service = new google.maps.places.PlacesService(map);

    var request = {
      placeId: 'ChIJwQXkP_sMlVQRITAxQL2pP1I'
    };

    service.getDetails(request, function (place, status) {
      if (status === google.maps.places.PlacesServiceStatus.OK) {
        var openingHours = place.opening_hours;
        var storeAddress = place.adr_address;
        var mapUrl = place.url;
        console.log(place);

        var marker = new google.maps.Marker({
          position: place.geometry.location,
          map: map,
          title: place.name
        });

        var infoWindow = new google.maps.InfoWindow({
          content: place.name
        });

        marker.addListener('click', function () {
          infoWindow.open(map, marker);
        });

        // Format the opening hours
        var formattedOpeningHours = formatOpeningHours(openingHours);

        // Display opening hours in a separate div
        var openingHoursDivs = document.querySelectorAll('.openingHours');
        console.log(openingHoursDivs);
        openingHoursDivs.forEach((openingHoursDiv) => {
          openingHoursDiv.innerHTML =  formattedOpeningHours;
        });
        var storeAddressDiv = document.getElementById('storeAddress');
        storeAddressDiv.innerHTML =  storeAddress;
        storeAddressDiv.setAttribute('href', mapUrl);
        storeAddressDiv.setAttribute('target', '_blank');
        storeAddressDiv.setAttribute('title', 'Address');
        var storeDirectionLink = document.querySelector('[title="Directions"]');
        storeDirectionLink.setAttribute('href', mapUrl);
      }
    });
  }

  function formatOpeningHours(openingHours) {
    var weekdays = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    var combinedDays = [];
    var formattedOpeningHours = '';

    weekdays.forEach(function (weekday, index) {
      var dayOpeningHours = openingHours.weekday_text[index];
      var hours = dayOpeningHours.split(': ')[1];

      if (weekday === 'Friday' || weekday === 'Saturday') {
        return; // Skip Friday and Saturday for now
      }

      var previousHours = combinedDays.length > 0 ? combinedDays[combinedDays.length - 1].hours : null;

      if (previousHours === hours) {
        combinedDays[combinedDays.length - 1].days.push(weekday);
      } else {
        combinedDays.push({ hours: hours, days: [weekday] });
      }
    });

    var fridayHours = openingHours.weekday_text[4].split(': ')[1];
    var saturdayHours = openingHours.weekday_text[5].split(': ')[1];

    // Combine Friday with Monday and Tuesday
    var combinedFriday = combinedDays.find(function (combinedDay) {
      return combinedDay.hours === fridayHours;
    });

    if (combinedFriday) {
      combinedFriday.days.push('Friday');
    } else {
      combinedDays.push({ hours: fridayHours, days: ['Friday', 'Monday', 'Tuesday'] });
    }

    // Combine Saturday with Wednesday and Thursday
    var combinedSaturday = combinedDays.find(function (combinedDay) {
      return combinedDay.hours === saturdayHours;
    });

    if (combinedSaturday) {
      combinedSaturday.days.push('Saturday');
    } else {
      combinedDays.push({ hours: saturdayHours, days: ['Saturday', 'Wednesday', 'Thursday'] });
    }

    combinedDays.forEach(function (combinedDay, index) {
      var formattedDays = combinedDay.days.join(', ');
      var formattedHours = combinedDay.hours.replace(/ AM – /g, 'AM ~ ').replace(/ PM – /g, 'PM ~ ');

      formattedOpeningHours += formattedDays + ':<br>' + formattedHours + '<br>';

      if (index === 0) {
        formattedOpeningHours += '<br>'; // Add a line break after the first group of days
      }
    });

    return formattedOpeningHours;
  }
</script>

<script>
  function openPopup(popupId) {
    const popupWrapper = document.getElementById(popupId);
    popupWrapper.style.display = "block";
    popupWrapper.style.opacity = "1";
    popupWrapper.style.visibility = "visible";
    popupWrapper.style.zIndex = "99992";
  }

  function closePopup(popupId) {
    const popupWrapper = document.getElementById(popupId);
    popupWrapper.style.display = "none";
    popupWrapper.style.opacity = "0";
    popupWrapper.style.visibility = "hidden";
    popupWrapper.style.zIndex = "-99999999999";
  }

  function requestQuotePopup() {
    openPopup("request-qoute-popup");
  }

  function requestQuoteClosePopup() {
    closePopup("request-qoute-popup");
  }
</script>

