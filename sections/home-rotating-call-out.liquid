<style>
  #shopify-section-{{ section.id }} .rotating-collection-block--slider{
    width: 95%;
  }
  {% comment %} #shopify-section-{{ section.id }} .flickity-viewport{
    margin-left: -5px;
  } {% endcomment %}
  #shopify-section-{{ section.id }} .flickity-button{
    top: 45%;
    padding: 0;
    outline: none;
    box-shadow: none;
    background-color: transparent;
  }
  .flickity-prev-next-button .flickity-button-icon{
    margin: 0;
  }
  #shopify-section-{{ section.id }} .flickity-prev-next-button.previous{
    left: -20px;
  }
  #shopify-section-{{ section.id }} .flickity-prev-next-button.next{
    right: -30px;
  }
  #shopify-section-{{ section.id }} .column{
    margin-left: 10px;
    margin-right: 10px;
  }
  .collection-block-wrapper h2 {
    font-size: 19px;
    line-height: 24px;
    font-weight: 500;
}
   #shopify-section-{{ section.id }} .collection-block h5 {
    font-size:20px;
    text-transform: uppercase !important;
    line-height: 26px;
    font-weight:500;
  }
   #shopify-section-{{ section.id }} .collection-block .holding-p{
    text-transform: uppercase !important;
    font-size:14px;
  }
  
   #shopify-section-{{ section.id }} .collection-block{
       text-align:center;
  }
  
  #shopify-section-{{ section.id }} .rotating-collection-block--slider.no-slider .image-element__wrap{
    margin: 0;
  }
   #shopify-section-{{ section.id }} .collection-block .image-element__wrap {
    height: auto;
    /* max-width: 100% !important; */
    border-radius:0;
     width:120px;
  }
  .collection-block img {
    max-width: 100%;
    height: auto;
    margin-bottom: 0;
  }
  .collection-block h6{
    text-align: center;
    margin-top: 15px;
    font-style: italic;
    font-family: 'Playfair Display', serif;
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section.id }} .flickity-prev-next-button.previous{
      left: -5px;
    }
    #shopify-section-{{ section.id }} .flickity-prev-next-button.next{
      right: -5px;
    }
  }
  @media screen and (max-width: 767px){
    .collection-block-wrapper h3{
      font-size: 18px;
    }
    .collection-block h6{
      font-size: 15px;
    }
    .flickity-prev-next-button .flickity-button-icon {
      width: 20px;
      height: 20px;
    }
     #shopify-section-{{ section.id }} .collection-block h5 {
      font-size:16px;
    }
     #shopify-section-{{ section.id }} .collection-block .holding-p{
      font-size:12px;
    }
  }
</style>

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if section.settings.hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section.id }} .rotating-collection-block--slider.no-slider:after {
    content: "flickity";
    display: none; /* hide :after */
  }
  @media screen and (min-width: 1025px) {
    /* disable Flickity for large devices */
    #shopify-section-{{ section.id }} .rotating-collection-block--slider.no-slider:after {
      content: "";
    }
  }
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-collection-blocks
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div class="collection-block-wrapper">
    {% if section.settings.main_title != blank %}
      <div style="color: {{ section.settings.text_color }};">{{ section.settings.main_title }}</div>
    {% endif %}
    <div
      class="container rotating-collection-block--slider {% if section.blocks.size <= 6 %}no-slider{% endif %}"
      style="flex-wrap: nowrap;"
      data-products-per-slide="6"
      data-products-limit="{% if section.blocks.size > 6 %}15{% else %}6{% endif %}"
      data-products-available="{% if section.blocks.size > 6 %}15{% else %}6{% endif %}"
    >
      {% for block in section.blocks %}
        <div class="collection-block one-sixth column large-down--one-fourth medium-down--one-third small-down--one-half">
         
          {% if block.settings.image != blank %}
            {%
              render 'image-element',
              image: block.settings.image,
              alt: block.settings.image_alt,
               additional_classes:'before-image',
            %}
          {% else %}
           {% if block.settings.title != blank %}
            <div style="color: {{ section.settings.text_color }};" class="holding-p">{{ block.settings.title }}</div>
          {% endif %}
          {% endif %}
        
          
          
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rotating Call Out",
  "class": "rotating-block",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "text",
      "label": "Main Title",
      "id": "main_title",
      "default": "Find your perfect Wedding Ring"
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
        
        {
          "type": "text",
          "label": "Image Alt Text",
          "id": "image_alt"
        },
        {
          "type": "html",
          "label": "Title",
          "id": "title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rotating Call Out"
    }
  ]
}
{% endschema %}
