      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image",
          "info": "Recommended Size: 500 x 500px"
        },
        {
          "type": "text",
          "label": "Image Alt Text",
          "id": "image_alt"
        },
        {
          "type": "text",
          "label": "Title",
          "id": "title"
        },
        {
          "type": "url",
          "label": "Link",
          "id": "link"
        },
        {
          "type": "select",
