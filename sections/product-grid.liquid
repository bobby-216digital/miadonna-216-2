<style>
  #shopify-section-{{ section.id }} .section-heading{
    margin-bottom: 50px;
  }
   #shopify-section-{{ section.id }} .section-heading .common-hd{
    padding-bottom: 15px;
  }
  #shopify-section-{{ section.id }} .section-heading h3{
    margin-top: 0;
    font-weight: 600;
    margin-bottom: 18px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .section-heading .main-subheading{
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0.7px;
    max-width: 550px;
    margin:0 auto;
  }
  #shopify-section-{{ section.id }} h3 {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .images-container figure.column,
  #shopify-section-{{ section.id }} .large-image-container figure.column{
    position: relative;
  }
  #shopify-section-{{ section.id }} .images-container figure.column:nth-child(1),
  #shopify-section-{{ section.id }} .images-container figure.column:nth-child(2){
    margin-bottom: 30px;
  }
  #shopify-section-{{ section.id }} figure .image-text--small,
  #shopify-section-{{ section.id }} .large-image-container figure .image-text{
    font-size: {{ settings.regular_font_size | times: 0.95 | floor | append: 'px' }};
    font-weight: 500;
    position: absolute;
    bottom: 20px;
    left:0;
    right:0;
  }
  #shopify-section-{{ section.id }} .large-image-container figure .image-text{
    left: 0;
    width: 260px;
    padding: 10px 20px;
    background-color: #fff;
  }
  #shopify-section-{{ section.id }} .equal-columns--outside-trim .one-half .img-hover-effect{
            flex-direction: column;
  }
  #shopify-section-{{ section.id }} .large-image-container figure .image-text > *{
    font-weight: 600;
    /* line-height: 30px;
    letter-spacing: 1.4px;
    font-size: {{ settings.heading_size | times: 0.5 | floor | append: 'px' }}; */
  }
  #shopify-section-{{ section.id }} .large-image-container .image-text em{
    font-weight: 400;
    font-family: 'Playfair Display';
  }
  @media screen and (min-width: 1025px){
    #shopify-section-{{ section.id }} .large-image-container,
    #shopify-section-{{ section.id }} .images-container,
    #shopify-section-{{ section.id }} .images-container figure{
      width: calc(50% - 30px);
    }
    #shopify-section-{{ section.id }} .images-container figure.column{
      margin: 0 15px;
    }
  }
  @media screen and (min-width: 1024px){
    #shopify-section-{{ section.id }} .images-container figure .image-text--small,
    #shopify-section-{{ section.id }} .large-image-container figure .image-text{
      font-size: {{ settings.regular_font_size | append: 'px' }};
      bottom: 20px;
    }
    #shopify-section-{{ section.id }} .large-image-container figure .image-text{
      width: 350px;
      padding: 15px 30px;
    }
  }
 @media screen and (max-width: 1199px){
     #shopify-section-{{ section.id }} .section-heading .main-subheading{
      font-size: 15px;
    }
  }
  @media screen and (max-width: 1024px){
    #shopify-section-{{ section.id }} .section-heading{
      margin-bottom: 30px;
    }
    #shopify-section-{{ section.id }} .images-container figure{
      margin: 0 5px !important;
      width: calc(50% - 10px);
    }
    #shopify-section-{{ section.id }} .images-container figure{
      margin-bottom: 10px !important;
    }
    #shopify-section-{{ section.id }} .large-image-container{
      order: -1 !important;
      margin: 0 0px 10px !important;
    }
  }

@media (max-width: 575px) {
   #shopify-section-{{ section.id }} figure .image-text--small,
  #shopify-section-{{ section.id }} .large-image-container figure .image-text{ bottom:10px;}
}
</style>
{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if section.settings.hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text common-spacing
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
  {% if section.settings.arialabelledby != blank %}role="region" aria-labelledby="{{ section.settings.arialabelledby }}"{% endif %}
>
  {% if section.settings.main_title != blank %}
    <div class="contanier-nw">
      <div class="section-heading text-center">
        <h2 class="common-hd" tabindex="0" id="{{ section.settings.arialabelledby }}" tabindex="0">{{ section.settings.main_title }}</h2>
        {% if section.settings.main_subheading != blank %}
          <div class="main-subheading" tabindex="0">
            {{ section.settings.main_subheading }}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="container contanier-nw">
    {% for block in section.blocks %}
      {% if block.type == 'big_image_block' %}
            {% assign flag_assign = false  %}
             {% assign video_url = block.settings.video_url %}
            {% assign main_image = block.settings.main_image %}
            {% if video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
            {% elsif video_url contains 'vimeo.com' %}
            {% elsif video_url != blank %}
            {% elsif main_image != blank %}
              {% assign flag_assign = true %}
            {% else %}
             {% endif %}  

        <div
          class="large-image-container one-half column medium-down--one-whole has-no-side-gutter"
          style="order: {% if block.settings.main_image_position == 'right' %}1{% else %}0{% endif %};margin: 0 15px;"
        >
         <figure class="one-whole column">
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="img-hover-effect radius-2" aria-label="{{ section.settings.main_title }}" >
              {% endif %}

              <div class="media-wrapper radius-2">
                <div class="desktop-media video-fullview">
             

                  {% if video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
                    <iframe
                      width="100%"
                      height="100%"
                      src="https://www.youtube.com/embed/{{ video_url | split: '/' | last | split: '?' | first }}?autoplay=1&mute=1&loop=1&playlist={{ video_url | split: '/' | last | split: '?' | first }}"
                      frameborder="0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                    ></iframe>

                  {% elsif video_url contains 'vimeo.com' %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ video_url | split: '/' | last }}?autoplay=1&muted=1&loop=1"
                      width="100%"
                      height="100%"
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>

                  {% elsif video_url != blank %}
                    <video preload="none"  autoplay muted loop playsinline {% if main_image != blank %}poster="{{ settings.speedsize_url_pfx_https -}}{{ main_image | image_url: width: 800 }}"{% endif %} data-video-src="{{ video_url | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}">
                      {% comment %} <source src="{{ video_url | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}" type="video/mp4"> {% endcomment %}
                      
                    </video>

                  {% elsif main_image != blank %}
                    {%
                      render 'image-element',
                      image: main_image,
                      alt: block.settings.image_alt
                    %}

                  {% else %}
                    <div class="image-element__wrap">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>

                <div class="mobile-media video-fullview">
                  {% assign mobile_video_url = block.settings.mobile_video_url %}
                  {% assign mobile_image = block.settings.mobile_image %}

                  {% if mobile_video_url contains 'youtube.com' or mobile_video_url contains 'youtu.be' %}
                    <iframe
                      width="100%"
                      height="100%"
                      src="https://www.youtube.com/embed/{{ mobile_video_url | split: '/' | last | split: '?' | first }}?autoplay=1&mute=1&loop=1&playlist={{ mobile_video_url | split: '/' | last | split: '?' | first }}"
                      frameborder="0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                    ></iframe>

                  {% elsif mobile_video_url contains 'vimeo.com' %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ mobile_video_url | split: '/' | last }}?autoplay=1&muted=1&loop=1"
                      width="100%"
                      height="100%"
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>

                  {% elsif mobile_video_url != blank %}
                    <video preload="none"  autoplay muted loop playsinline {% if mobile_image != blank %}poster="{{ settings.speedsize_url_pfx_https -}}{{ mobile_image | image_url: width: 800 }}"{% endif %} data-video-src="{{ mobile_video_url | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}">
                      <source src="{{ mobile_video_url | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}" type="video/mp4">
                      
                    </video>

                  {% elsif mobile_image != blank %}
                    {%
                      render 'image-element',
                      image: mobile_image,
                      alt: block.settings.image_alt
                    %}

                  {% endif %}
                </div>
              </div>

               {% if block.settings.main_image_text != blank %}
                  <p
                    class="image-text--small"
                    style="{% if block.settings.main_image_text_position == 'right' %}left: auto;right: 12px;{% endif %} {% if block.settings.main_image_text_position == 'center' %}width: 100%; text-align: center;{% endif %}"
                  >
                    <span class="line-hover">{{ block.settings.main_image_text | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</span>
                  </p>
                {% endif %}
                

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </figure>

        </div>
      {% endif %}
    {% endfor %}

    {% assign bigImageBlock = false %}
    {% for block in section.blocks %}
      {% if block.type == 'big_image_block' %}
        {% assign bigImageBlock = true %}
      {% endif %}
    {% endfor %}

    <div
      class="container images-container {% if bigImageBlock %}one-half{% else %}one-whole{% endif %} column medium-down--one-whole promoright-box"
      style="margin: 0;"
    >
      {% for block in section.blocks %}
        {% if block.type == 'image_block' %}
          <figure class="one-half column medium-down--one-half giftright-twobox">
            {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="img-hover-effect radius-2"{% if block.settings.image == blank or block.settings.image_alt == blank %}{% if block.settings.title == blank %} aria-label="{{ section.settings.main_title | escape }}"{% endif %}{% endif %}>
            {% endif %}
              <div class="small-image">
                {% if block.settings.image != blank %}
                  {%
                    render 'image-element',
                    image: block.settings.image,
                    alt: block.settings.image_alt,
                  %}
                {% else %}
                  <div class="image-element__wrap">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <p
                    class="image-text--small"
                    style="{% if block.settings.text_position == 'right' %}left: auto;right: 12px;{% endif %} {% if block.settings.text_position == 'center' %}width: 100%; text-align: center;{% endif %}"
                  >
                    <span class="line-hover">{{ block.settings.title }}</span>
                  </p>
                {% endif %}
              </div>
            {% if block.settings.link != blank %}
            </a>
            {% endif %}
          </figure>
        {% endif %}
          {% if block.type == 'gift_box' %}
           <figure 
              class="gift-box-wrapper one-whole column" 
              aria-labelledby="gift-heading"
              {{ block.shopify_attributes }}
            >
              <a href="{{ block.settings.imglink }}" class="img-hover-effect gift-with-purchase">
                  <span class="gift-with-purchase-text">
                      <span class="gift-image">
                          <img 
                            src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | image_url: width: 800 }}"
                            alt="{% if block.settings.image_alt != blank %}{{ block.settings.image_alt | escape }}{% else %}{{ block.settings.heading | escape }}{% endif %}"
                            loading="lazy"
                            width="342px"
                            height="167px"
                          >
                      </span>
                      <span class="gift-content">
                        {% if block.settings.heading != blank %}
                          <span class="gift-heading" id="gift-heading">
                              {{ block.settings.heading }}
                          </span>
                        {% endif %}

                        {% if block.settings.text != blank %}
                            <span class="gift-desc">{{ block.settings.text }}</span>
                        {% endif %}
                      </span>
                  </span>
                </a>

                {% if block.settings.terms != blank and block.settings.link != blank %}
                  <a 
                    href="{{ block.settings.link }}" 
                    class="terms"
                  >
                    {{ block.settings.terms }}
                  </a>
                {% endif %}
            </figure>
          {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "class": "product-grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "text",
      "label": "Main Title",
      "id": "main_title",
      "default": "Find your perfect Wedding Ring"
    },
    {
      "type": "richtext",
      "label": "Main Subheading",
      "id": "main_subheading",
      "default": "<p>Add subtitle here</p>"
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "arialabelledby",
      "label": "aria labelledby"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
