{% comment %}
  ** Image with Text **
{% endcomment %}

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .plyr__video-embed {
    width: 100%;
  }
  #shopify-section-{{ section.id }} .image-with-text__heading {
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 1.4px;
  }
  #shopify-section-{{ section.id }} .image-with-text__text > p {
    line-height: 24px;
    letter-spacing: 0.35px;
  }
  #shopify-section-{{ section.id }} .image-with-text__text > p a {
    font-weight: 600;
    text-decoration: underline;
  }
  .section-one-half .image-with-text__column{
    flex-wrap: wrap;
  }
  .green-section .image-with-text__column, .green-section .image-with-text__column .image-with-text__heading {
      font-family: Playfair Display,serif;
  }
  .green-section .image-with-text__text-column .image-with-text__wrapper{
      padding-top: 40px;
    position: relative;
  }
  .green-section .image-with-text__text-column .image-with-text__wrapper:after{
    position: absolute;
    content: '';
    top: 0;
    left: 0;
    height: 3px;
    width: 80px;
    background-color: #c2edd5;
  }
  
  @media screen and (min-width: 799px){
    .section-one-half .image-with-text__column{
      width: calc(50% - 20px);
    }
  }
  @media screen and (max-width: 767px){
    .section-one-half .image-with-text__column .image-element__wrap {
      max-width: 100% !important;
    }
    #shopify-section-{{ section.id }} {
    padding-top: 30px;
    padding-bottom: 30px;
  }
  
  .more-space .image-element__wrap {
    height: auto;
  }
}
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'video' %}
    {% assign hasVideoBlock = 'has-video-block' %}
  {% endif %}
{% endfor %}

{% comment %} HTML markup {% endcomment %}
<section id="{{ section.settings.id_sec }}"
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
    {{ hasVideoBlock  }}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="container"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
         {% if block.type == 'counter' %}
           {%- assign text = block.settings.content -%}
          {% style %}
            #block-{{forloop.index }}-counter {
              background-color: {{ block.settings.background_color}};
              color: {{ block.settings.text_color}};
            }
            #block-{{forloop.index }}-counter .image-with-text__wrapper{
              padding-bottom: 40px;
            }
            #block-{{forloop.index }}-counter .image-with-text__wrapper .image-with-text__preheading{
              font-size: 140px;
              font-family: Playfair Display,serif;
              line-height: 1.8;
              color: {{ block.settings.text_color}};              
            }
            #block-{{forloop.index }}-counter .image-with-text__wrapper .image-with-text__heading{
              line-height: 1.8;
              margin-bottom: 30px;
              @media only screen and (max-width: 767px) {
              margin-bottom: 0px;
              }
            }
            #block-{{forloop.index }}-counter .image-with-text__heading, #block-{{forloop.index }}-counter .image-with-text__text-column{
              color: {{ block.settings.text_color}};              
            }
          {% endstyle %}
          
           <div id="block-{{forloop.index }}-counter" class="image-with-text__text-column image-with-text__column {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                two-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right">
             <div class="image-with-text__wrapper">
               {% if block.settings.counter != blank %}
                    <h2 class="image-with-text__preheading text-align-{{ block.settings.alignment }} counter is-{{ block.settings.heading_size }}"
                      data-countto="{{ block.settings.counter }}" data-duration="4000">
                      100
                    </h2>
                {% endif %}
               {% if block.settings.title != blank %}
                <h3 class="image-with-text__heading text-align-{{ block.settings.alignment }} is-{{ block.settings.heading_size }}">
                  {{ block.settings.title }}
                </h3>
              {% endif %}
              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block.settings.alignment }} content">
                  {{ text }}
                </div>
              {% endif %}
             </div>
           </div>
        {% elsif block.type == 'text' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block.settings.text -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block.settings.background | color_extract: 'alpha' -%}
          {%- assign text_alpha = block.settings.text_color | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ block.id }} {
                background-color: {%- if background_alpha != 0 -%}{{ block.settings.background }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: block.id
            %}
          {% endstyle %}

          <div
            class="
              image-with-text__text-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                two-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex
              is-flex-wrap
              is-justify-{{ block.settings.alignment }}
              is-align-{{ block.settings.vertical_position }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            <div class="image-with-text__wrapper">
              {% if block.settings.pre-title != blank %}
                <h2 class="image-with-text__preheading text-align-{{ block.settings.alignment }} is-{{ block.settings.heading_size }}">
                  {{ block.settings.pre-title }}
                </h2>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="image-with-text__heading text-align-{{ block.settings.alignment }} is-{{ block.settings.heading_size }}">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block.settings.alignment }} content">
                  {{ text }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="buttons is-{{ block.settings.alignment }}">
                  {% render 'button',
                    label: block.settings.button_label,
                    href: block.settings.link,
                    style: block.settings.button_style,
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block.type == 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = block.settings.image -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              image-with-text__image-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                three-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              is-flex
              is-align-center
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            {% if block.settings.image_link %}
              <a class="image-with-text__link" href="{{ block.settings.image_link }}">
            {% endif %}
            {% if image != blank %}
              {%
                render 'image-element',
                image: image,
                alt: image.alt,
                stretch_width: true,
                additional_classes: 'image-with-text__image',
                focal_point: image.presentation.focal_point,
              %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block.settings.image_link %}
              </a>
            {% endif %}
          {% if block.settings.image_text != '' %}
            <div class="image-with-text__text content">
              <p> {{ block.settings.image_text | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
            </div>
          {% endif %}
          </div>
          
         
        {% elsif block.type == 'video' %}
          <div
            class="
              image-with-text__video-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                three-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              is-flex
              is-align-center
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            {%- assign iframe_video = block.settings.iframe_video -%}
            {% if iframe_video != blank %}
              <div
                class="plyr__video-embed video-{{ block.id }}"
                style="{% if block.settings.aspect_ratio == '1:1' %}padding-bottom: 100%;{% elsif block.settings.aspect_ratio == '4:3' %}{% endif %}"
              >
                <div class="lazyframe" data-ratio="{{ block.settings.aspect_ratio }}">
                  {% if iframe_video.type == 'youtube' %}
                    <iframe
                      src="https://www.youtube.com/embed/{{ iframe_video.id  }}?origin=https://plyr.io&amp;autoplay=true&amp;mute=true&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                      allowfullscreen
                      allowtransparency
                      allow="autoplay"
                    ></iframe>
                  {% elsif iframe_video.type == 'vimeo' %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;pip=0&amp;controls=0&amp;autoplay=1&amp;muted=1&amp;byline=false&amp;portrait=false&amp;title=false&amp;speed=true&amp;transparent=0&amp;gesture=media"
                      allowfullscreen
                      allowtransparency
                      allow="autoplay"
                      width="100%"
                      height="100%"
                    ></iframe>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "class": "image-with-text image-with-text-1",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "id_sec",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1024 x 1024px recommended"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Link"
        },
        {
           "type": "richtext",
          "id": "image_text",
          "label": "Image Below Text"
        }
        
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "header",
          "content": "Video"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio",
          "options": [
            {
              "value": "16:9",
              "label": "16:9"
            },
            {
              "value": "4:3",
              "label": "4:3"
            },
            {
              "value": "1:1",
              "label": "1:1"
            }
          ],
          "default": "16:9"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay video",
          "info": "Limited browser support for autoplaying video. [Learn more](https:\/\/help.outofthesandbox.com\/hc\/en-us\/articles\/360000661568)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "autoloop",
          "label": "Autoloop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "mute_video",
          "label": "Mute video",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "controls",
          "label": "Show video controls",
          "default": true
        },
        {
          "type": "video_url",
          "id": "iframe_video",
          "label": "YouTube or Vimeo video URL",
          "accept": ["youtube", "vimeo"],
          "default": "https://www.youtube.com/watch?v=8NxS0vrPcsA"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Heading text here"
        },
         {
          "type": "text",
          "id": "pre-title",
          "label": "Pre Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Base size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "regular",
              "label": "Regular"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "regular"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "button--primary",
              "label": "Primary"
            },
            {
              "value": "button--secondary",
              "label": "Secondary"
            },
            {
              "value": "button--link-style",
              "label": "Link style"
            }
          ],
          "default": "button--primary"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "vertical_position",
          "label": "Vertical position",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "end",
              "label": "Bottom"
            }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "counter",
      "name": "Counter",
      "settings": [
        {
          "type": "text",
          "label": "Counter",
          "id": "counter"
        },{
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Heading text here"
        },
         {
          "type": "text",
          "id": "content",
          "label": "Content",
          "default": "Average amount of earth extracted to find a 1.0ct rough diamond."
        },
        {
           "type": "header",
           "content": "Layout"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#c2ecd3"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#696969"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Base size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "regular",
              "label": "Regular"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "regular"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "vertical_position",
          "label": "Vertical position",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "end",
              "label": "Bottom"
            }
          ],
          "default": "center"
        }
        
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text",
      "category": "Image",
      "settings": {
          "padding_top": 20,
          "padding_bottom": 20
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
