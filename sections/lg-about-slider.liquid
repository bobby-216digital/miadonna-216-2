<style>
  #shopify-section-{{ section.id }} .home-collection-block--slider{
    width: 95%;
  }
  {% comment %} #shopify-section-{{ section.id }} .flickity-viewport{
    margin-left: -5px;
  } {% endcomment %}
  #shopify-section-{{ section.id }} .flickity-button{
    top: 50%;
    padding: 0;
    outline: none;
    box-shadow: none;
    background-color: transparent;
  }
  .about-block img{
    width:100%;
  }
  
  #shopify-section-{{ section.id }} .flickity-button-icon {
    fill: #ffffff;
    background: #000;
    padding: 7px;
    border-radius: 100%;
  }
  .flickity-prev-next-button .flickity-button-icon{
    margin: 0;
  }
  #shopify-section-{{ section.id }} .flickity-prev-next-button.previous{
    left: -10px;
  }
  #shopify-section-{{ section.id }} .flickity-prev-next-button.next{
    right: -10px;
  }
  #shopify-section-{{ section.id }} .column{
    margin-left: 10px;
    margin-right: 10px;
  }
  .collection-block-wrapper h2 {
    font-size: 19px;
    line-height: 24px;
    font-weight: 500;
}
  .home-collection-block .collection-block-wrapper h3 {
    font-size: 14px;
    text-align: left !important;
    font-weight: 300 !important;
    font-family: 'Montserrat';
    text-transform: initial !important;
    line-height: 26px;
  }
  .home-collection-block .collection-block .hover-image{
    display:none;
  }
  .home-collection-block .collection-block:hover .before-image{
    display:none;
  }
  .home-collection-block .collection-block:hover .hover-image{
    display:block;
  }
   .home-collection-block .collection-block{
     position:relative;
   }
  .home-collection-block .collection-block:after{
    background-color: #dea595;
    bottom: 10px;
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    transition: width .8s;
    width: 80px;
    z-index: 0;
  }
  
  #shopify-section-{{ section.id }} .home-collection-block--slider.no-slider .image-element__wrap{
    margin: 0;
  }
   #shopify-section-{{ section.id }} .about-block .image-element__wrap {
    height: auto;
    max-width: 100% !important;
    border-radius:0;
  }
  .about-img-slider img{
    
    object-fit:cover;
  }
  .abt-content{
    max-height: 250px;
    padding: 40px 15px 40px 15px;
    position: relative;
    background: #fbf0e8;
    text-align: center;
  }
  .abt-content h2{
    margin: 0 auto;  
    font-size: 1.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 40px;   
    text-transform: uppercase;
  }
  .abt-content p{
    margin: 8px auto 0;
    line-height: 24px;
    font-size:14px;
  }
  .collection-block img {
    max-width: 100%;
    height: auto;
    margin-bottom: 0;
  }
  .collection-block h6{
    text-align: center;
    margin-top: 15px;
    font-style: italic;
    font-family: 'Playfair Display', serif;
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section.id }} .flickity-prev-next-button.previous{
      left: -10px;
    }
    #shopify-section-{{ section.id }} .flickity-prev-next-button.next{
      right: -10px;
    }
  }
  @media screen and (max-width: 767px){
    .collection-block-wrapper h3{
      font-size: 18px;
    }
    .collection-block h6{
      font-size: 15px;
    }
    .flickity-prev-next-button .flickity-button-icon {
      width: 20px;
      height: 20px;
    }
    .abt-content{
      max-height:100%;
    }
  }
</style>

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
    {% if section.settings.hide_mobile %}
      @media screen and (max-width: 798px){
        display: none;
      }
    {% endif %}
  }
  #shopify-section-{{ section.id }} .home-collection-block--slider.no-slider:after {
    content: "flickity";
    display: none; /* hide :after */
  }
  @media screen and (min-width: 1025px) {
    /* disable Flickity for large devices */
    #shopify-section-{{ section.id }} .home-collection-block--slider.no-slider:after {
      content: "";
    }
  }
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section id="{{ section.settings.id_sec }}"
  class="
    section
    section-collection-blocks
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div class="collection-block-wrapper">
    {% if section.settings.main_title != blank %}
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.main_title }}</h2>
    {% endif %}
    <div class="top-description">
      {{ section.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
    </div>
    <div
      class="container {% if section.blocks.size <= 5 %}no-slider{% endif %}"
    >
      {% for block in section.blocks %}
        <div class=" about-block one-third column  medium-down--one-whole small-down--one-whole">
           {% if block.settings.image-2 != blank %}
             <div class="about-img-slider"  data-products-per-slide="1"
            data-products-limit="20"
            data-products-available="20">
            {% endif %}
          {% if block.settings.image != blank %}
            <div class="one-whole-div">
            {%
              render 'image-element',
              image: block.settings.image,
              alt: block.settings.image_alt,
               additional_classes:'before-image',
            %}
            </div>
          {% else %}
            <div class="image-element__wrap" style="height: auto;">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% if block.settings.image-2 != blank %}
           <div class="one-whole-div">
            {%
              render 'image-element',
              image: block.settings.image-2,
              alt: block.settings.image_alt,
              additional_classes:'hover-image',
            %}
          </div>
        {% endif %}
        {% if block.settings.image-2 != blank %}
             </div>
            {% endif %}
          {% if block.settings.title != blank %}
          <div class="abt-content">
            <h2 style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</h2>
            <p>{{ block.settings.content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
          </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Slider",
  "class": "collection-block about-slider",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "text",
      "label": "Main Title",
      "id": "main_title",
      "default": "Find your perfect Wedding Ring"
    },
    {
      "type": "html",
      "label": "Description",
      "id": "description",
      "default": "Description text"
    },
    {
      "type": "url",
      "label": "About Button URL",
      "id": "main-btn"
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "id_sec",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
        {
          "type": "image_picker",
          "label": "Hover Image",
          "id": "image-2"
        },
        {
          "type": "text",
          "label": "Image Alt Text",
          "id": "image_alt"
        },
        {
          "type": "text",
          "label": "Title",
          "id": "title"
        },
        {
          "type": "richtext",
          "label": "Content",
          "id": "content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Slider"
    }
  ]
}
{% endschema %}
