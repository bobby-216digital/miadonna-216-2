<section
  class="
    section
    section-collection-blocks
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="container quotes-slider {% if section.blocks.size <= 1 %}no-slider{% endif %}"
    style="flex-wrap: nowrap;"
    data-products-per-slide="1"
    data-products-limit="{% if section.blocks.size > 1 %}15{% else %}5{% endif %}"
    data-products-available="{% if section.blocks.size > 1 %}15{% else %}5{% endif %}"
  >
    {% for block in section.blocks %}
      <div class="body-cell layout-table one-whole column{% if forloop.index > 1 %} is-hidden{% endif %}">
        <div class="logo-quote">
          <img
            src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | image_url: width: 300 }}"
            width="{{ block.settings.image.width }}"
            height="100%"
            loading="lazy"
            alt="slide"
          >
        </div>
        <div class="quote-titles">
          <div class="readability-insets">
            <!-- <h2 class="text-style-subtitle">{{ block.settings.title }}</h2> -->
            <p class="offset-cell text-style-title">{{ block.settings.quote }}</p>
            <span>{{ block.settings.author }}</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsQuotesSlider.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Home quote slider",
    "class": "quotes-slider jsQuotesSlider",

  "settings": [
      {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
          {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
         {
          "type": "text",
          "label": "title",
          "id": "title"
        },
        {
          "type": "text",
          "label": "Quote",
          "id": "quote"
        },
        {
          "type": "text",
          "label": "Author",
          "id": "author"
        }
      ]
    }
  ],
  "presets": [
     {
      "name": "Home quote slider"
    }
  ]
}
{% endschema %}
