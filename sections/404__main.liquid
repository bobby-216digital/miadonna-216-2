{% comment %}
  ** 404 page - main content area **
  - Appears when a file path cannot be found
{% endcomment %}

<style>
  #notfound-page {
    position: relative;
    padding: 5rem 15px;
    background-color: white !important;
  }
  #notfound-page .text-img {
    max-width: 600px;
    min-width: 300px;
    display: block;
    margin: auto;
    width: 100% !important;
  }
  #notfound-page #search-box-custom {
    max-width: 540px !important;
    margin: 30px auto !important;
  }
  #notfound-page .search-overwrite-custom {
    text-align: left !important;
    font-size: 20px !important;
  }
  ::placeholder {
    text-transform: lowercase !important;
    text-align: center !important;
    font-size: 20px !important;
  }
  #notfound-page #search-wrapper-custom {
    border: 1px solid gray !important;
    max-width: 808px;
    min-height: auto;
    margin: 0 auto;
    padding-top: 54px;
    padding-bottom: 24px;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  #notfound-page #search-wrapper-custom input {
    width: 100%;
    background: transparent;
    border: 0;
    display: inline-block;
    padding: 5.5px 17px;
    border-bottom: 2px solid rgba(0,0,0,.87);
    border-radius: 0;
  }
  #notfound-page .search__results {
    margin-top: 0;
    margin-left: 0;
    display: grid;
    padding: 20px;
    grid-template-columns: repeat(2, 1fr);
  }
  #notfound-page .search__results .all-results {
    margin: 0 10px;
    grid-area: 1 / 1 / 2 / 3;
  }
  #notfound-page .search__results .item-result {
    width: calc(100% - 20px);
    margin: 0 10px;
    border: 0;
  }
  #notfound-page .search__results .item-result a {
    padding-bottom: 0;
    flex-direction: column;
  }
  #notfound-page .search__results .thumbnail{
    max-width: 100%;
  }
  .error-info-container {
    max-width: 808px;
    margin: auto;
    text-align: center;
    background: #fedcd3;
    padding: 10px;
    font-family: Montserrat,sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: .28em;
    text-transform: uppercase;
  }
  .dark-gray-btn{
    background-color: #4a4a4a;
    color: #fff;
    display: block;
    font-family: Montserrat,sans-serif;
    font-size: 13px;
    font-weight: 400;
    margin-left: auto;
    margin-right: auto;
    max-width: 270px;
    padding: 15px 0;
    text-transform: uppercase;
    transition: background .3s ease-in-out;
  }
  .error-cta {
    text-align: center;
    color: #000;
    background-color: #eae0d4;
    margin-bottom: 5rem;
    max-width: 270px;
    transition: 0.4s ease;
  }
  .error-cta:hover {
    background: #000;
    color: #fff;
  }
</style>

{% assign id = section.id %}
{% comment %}Layout{% endcomment %}
{% assign width = section.settings.width %}
{% assign padding_top = section.settings.padding_top %}
{% assign padding_bottom = section.settings.padding_bottom %}
{% assign animation = section.settings.animation | default: 'none' %}
{% comment %}Advanced{% endcomment %}
{% assign css_class = section.settings.css_class %}
{% assign custom_css = section.settings.custom_css %}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
      max-width: 95%;
    {% endif %}
  }

  {% render 'css-loop',
          css: section_css,
          id: id
  %}
  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

<section
  class="
    section
    {{ css_class }}
    is-width-{{ width }}
  "
  {% if animation != 'none' %}
    data-scroll-class="{{ animation }}"
  {% endif %}
>
  <header class="container hide-when-banner-enabled is-hidden">
    {% capture heading_title %}{{ 'general.404.title' | t }}{% endcapture %}
    {% render 'heading', title: heading_title, heading_tag: 'h1', context: 'page-not-found', text_alignment: 'left' %}
  </header>

  <div class="container has-no-side-gutter">
    <div class="one-whole column content" data-autocomplete-{{ settings.enable_autocomplete }}>
      <div class="is-hidden">
        {% if section.settings.not_found_text == '' %}
          <p>{{ 'general.404.continue_shopping_html' | t: continue_link: routes.all_products_collection_url }}</p>
        {% else %}
          {{ section.settings.not_found_text }}
        {% endif %}
      </div>

      <div class="one-whole columns" id="notfound-page">
        <div id="search-wrapper-custom">
          <img
            class="text-img"
            src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/404-page-not-found-01-05-21.png?v=1609892122"
            alt="404 Page Not Found"
            width="auto"
            height="auto"
            loading="eager"
          >
          <div id="search-box-custom" class="search-box-wrapper">
            {% if section.settings.display_search_field %}
              <form class="search-form" action="{{ routes.search_url }}">
                <div class="search__fields">
                  <input type="hidden" name="type" value="{{ settings.search_option }}">
                  <label for="q" class="visually-hidden">{{ settings.search_placeholder }}</label>
                  <div class="field">
                    <div class="control has-icons-left">
                      <input
                        class="input search-overwrite-custom"
                        type="text"
                        name="q"
                        placeholder="type to search"
                        value="{{ search.terms }}"
                        x-webkit-speech
                        autocapitalize="off"
                        autocomplete="off"
                        autocorrect="off"
                        data-q
                      >
                      {% comment %}
                        {% render 'icon', name: 'search', class: 'icon is-left' %}
                      {% endcomment %}
                    </div>
                  </div>
                  <input type="submit" name="search" class="visually-hidden" value="" aria-label="Search">
                </div>
              </form>
            {% endif %}
          </div>
        </div>
        <div class="error-info-container">Free U.S. Shipping &amp; Free 60-Day Returns</div>
      </div>
      <a href="/collections/best-sellers" class="dark-gray-btn error-cta">Continue Shopping</a>

      {% if section.settings.display_search_field %}
        <form class="search-form is-hidden" action="{{ routes.search_url }}">
          <div class="search__fields">
            <input type="hidden" name="type" value="{{ settings.search_option }}">
            <label for="q" class="visually-hidden">{{ settings.search_placeholder }}</label>
            <div class="field">
              <div class="control has-icons-left">
                <input
                  class="input"
                  type="text"
                  name="q"
                  placeholder="{{ settings.search_placeholder }}"
                  value="{{ search.terms }}"
                  x-webkit-speech
                  autocapitalize="off"
                  autocomplete="off"
                  autocorrect="off"
                  data-q
                >
                {% render 'icon', name: 'search', class: 'icon is-left' %}
              </div>
            </div>
            <input type="submit" name="search" class="visually-hidden" value="" aria-label="Search">
          </div>
        </form>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page not found",
  "class": "not-found-404__page",
  "settings": [
    {
      "type": "richtext",
      "id": "not_found_text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "display_search_field",
      "label": "Display search field",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ]
}
{% endschema %}
