{% assign id = section.id %}
{% comment %}Layout{% endcomment %}
{% assign width = section.settings.width %}
{% assign padding_top = section.settings.padding_top %}
{% assign padding_bottom = section.settings.padding_bottom %}
{% assign animation = section.settings.animation | default: 'none' %}
{% comment %} Advanced {% endcomment %}
{% assign css_class = section.settings.css_class %}
{% assign custom_css = section.settings.custom_css %}

{% comment %} CSS {% endcomment %}
{% style %}
  #shopify-section-{{ id }} {
    display:none;
  }
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  .sidebar-section {
    {% if section.settings.sidebar_position == 'right' %}
      order: 1;
    {% endif %}
  }

  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section is-width-wide section-blog-menu blog-mobile-menu
    {{ css_class }}
    is-width-{{ width }}
  "
  {% if animation != 'none' %}
    data-scroll-class="{{ animation }}"
  {% endif %}
>
  {% if section.settings.breadcrumb %}
    <div class="section">
      <div class=" breadcrumbs">
        {% render 'blog-breadcrumb' %}
      </div>
    </div>
  {% endif %}
  {% if section.settings.blog_title %}
    <div class="section topic-banner">
      <h2 class="image-with-text-overlay__heading banner__heading title" style="color: #000;text-align:center;">
        <span>THE <span>Blog</span></span>
      </h2>
    </div>
  {% endif %}
  <div class="container top-blog-section">
    <select-menu>
      <div class="sidebar-block__select-wrapper">
        <div id="selectBtn" class="sidebar-block__select">
          <span class="sidebar-block__links">
            {% for link in section.settings.blog_menu.links %}
              {% if link.active %}
                {% if link.title == 'All' %}
                  Blog Filter
                {% else %}
                  {{ link.title | escape }}
                {% endif %}
              {% endif %}
            {% endfor %}
          </span>
          <span class="icon-caret-wrapper">
            <i class="icon-solid-caret"></i>
          </span>
        </div>
        <div
          class="sidebar-block__contents hide"
        >
          {% if section.settings.blog_menu %}
            <div class="blog-menu column medium-down--one-whole">
              {% render 'sidebar__menu', menu: section.settings.blog_menu %}
            </div>
          {% endif %}
          {% for block in section.blocks %}
            <div class="blog-search-bar column one-fifth medium-down--one-whole">
              {% if block.type == 'search' %}
                {% render 'sidebar__search', block: block, context: 'sidebar' %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </select-menu>
  </div>
</section>

<script src="{{ 'select-menu.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Blog Mobile Menu",
  "settings": [

    {
      "type": "link_list",
      "id": "blog_menu",
      "label": "Select Menu"
    },

    {
      "type": "checkbox",
      "id": "breadcrumb",
      "default": false,
      "label": "Show/Hide breadcrumb"
    },

    {
      "type": "checkbox",
      "id": "blog_title",
      "default": false,
      "label": "Show/Hide Top Blog Title"
    }
  ],
  "blocks":[
    {
    "type": "search",
    "name": "Search form",
    "limit": 1,
    "settings": [

      {
        "type": "select",
        "id": "search_results",
        "label": "Search results",
        "options": [
          {
            "value": "article",
            "label": "Blog posts"
          }
        ],
        "default": "article"
      }
    ]
  }
  ],
  "presets": [
  {
    "category": "blogs",
    "name": "Blog Mobile Menu"
  }
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
