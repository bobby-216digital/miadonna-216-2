{% comment %} Section specific CSS {% endcomment %}
{% style %}
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.width == 'wide' %}
        width: 100%;
      {% endif %}
      {% if section.settings.hide_mobile %}
        @media screen and (max-width: 798px){
          display: none;
        }
      {% endif %}
    }
    #shopify-section-{{ section.id }} .container{
      align-items: flex-end;
    }
    #shopify-section-{{ section.id }} .content-wrapper{
      padding: 100px 80px;
      margin-right: -45%;
      z-index: 1;
      position: relative;
      max-width: 662px;
      margin-bottom: 80px;
    }
    #shopify-section-{{ section.id }} .image-element__wrap{
      height: auto;
    }
    #shopify-section-{{ section.id }} .section-title{
      font-weight: 600;
      line-height: 38.4px;
      margin-bottom: 30px;
      letter-spacing: 1.4px;
      font-size:22px;
    }
    #shopify-section-{{ section.id }} .description {
      font-weight: 500;
      line-height: 24px;
      margin-top: 0;
      margin-bottom: 45px;
      letter-spacing: 0.35px;
    }
    #shopify-section-{{ section.id }} .buttons{
      display: block;
    }
    #shopify-section-{{ section.id }} .button{
      width: 300px;
      color: #000;
      margin: auto;
      min-height: 54px;
      font-weight: 600;
      font-size: {{ settings.regular_font_size | append: 'px' }};
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }
    #shopify-section-{{ section.id }} .button.button--primary{
      color: #fff;
      background-color: #3b3737;
    }
    #shopify-section-{{ section.id }} .button.button--primary:hover{
      color: #000;
      border-width: 3px;
      border-color: #3b3737;
      background-color: transparent;
    }
    #shopify-section-{{ section.id }} .button.button--secondary{
      border-width: 3px;
      border-color: #3b3737;
    }
    #shopify-section-{{ section.id }} .button.button--secondary:hover{
      color: #fff;
    }
    #shopify-section-{{ section.id }} .button.button--link-style{
      width: auto;
      border: none;
      position: relative;
      min-height: inherit;
      padding-bottom: 4px;
      display: inline-block;
    }
    #shopify-section-{{ section.id }} .button.button--link-style::before{
      background-color: #d4a696;
      bottom: 0;
      content: '';
      height: 2px;
      left: 50%;
      position: absolute;
      transition: width .8s;
      transform: translateX(-50%);
      width: 80%;
      z-index: 0;
    }
    #shopify-section-{{ section.id }} .button.button--link-style:hover::before {
      width: 0;
    }
    .box-slider .flickity-page-dots .dot {
      display: inline-block;
      width: 60px;
      height: 4px;
      margin: 0px 4px;
      background: #333;
      border-radius: 0;
      cursor: pointer;
    opacity:1;
  }
  .box-slider  li.dot.is-selected {
      background: #fff;
  }
  .box-slider    ol.flickity-page-dots {
      bottom: 10px;
  }
  /* @media screen and (min-width: 991px){
    #shopify-section-{{ section.id }} .content-wrapper{
      margin-left: -45%;
      margin-right: 0;
    }
  } */
  @media screen and (max-width: 1200px){
    #shopify-section-{{ section.id }} .content-wrapper{
      padding: 40px;
    }
  }
  @media screen and (max-width: 1024px){
    #shopify-section-{{ section.id }} .container {
      align-items: center;
    }
    #shopify-section-{{ section.id }} .content-wrapper{
      margin-bottom: 0;
    }
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section.id }} .content-wrapper{
      padding: 20px;
    }
    #shopify-section-{{ section.id }} .section-title {
      line-height: 32px;
      margin-bottom: 15px;
    }
    #shopify-section-{{ section.id }} .description {
      margin-bottom: 18px;
    }
    #shopify-section-{{ section.id }} .button {
      min-height: 50px;
    }
  }
  @media screen and (max-width: 767px){
    #shopify-section-{{ section.id }} .content-wrapper{
      margin: -100px 2rem 0;
      text-align: center !important;
    }
    #shopify-section-{{ section.id }} .button {
      width: 100%;
      font-size: 13px !important;
      font-weight:600;
    }
    #shopify-section-{{ section.id }} .container .two-thirds{
      order: -1;
    }
    #shopify-section-{{ section.id }} .description {
      font-size: {{ settings.regular_font_size | times: 0.9 | floor | append: 'px' }};
    }
     #shopify-section-{{ section.id }} .section-title{
       font-size:18px;
     }
  }
  @media screen and (min-width: 768px){
    #shopify-section-{{ section.id }} .content-right {
      margin-left: -45%;
      margin-right: 0;
    }
  }

  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    section-image-with-text

    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="container box-slider has-no-side-gutter {% if section.blocks.size <= 1 %}no-slider{% endif %}"
    style="flex-wrap: nowrap;"
    data-products-per-slide="1"
    data-products-limit="{% if section.blocks.size > 1 %}15{% else %}1{% endif %}"
    data-products-available="{% if section.blocks.size > 1 %}15{% else %}1{% endif %}"
  >
    {% for block in section.blocks %}
      <div class="box-cell  layout-table one-whole column ">
        <div class="container has-no-side-gutter">
          <div class="one-third column small-down--one-whole">
            <div
              class="content-wrapper text-left {% if block.settings.image_position == 'left' %}content-right{% endif %}"
              style="background-color: {{ block.settings.background_color }}"
            >
              <h3 class="h6 section-title ">{{ block.settings.title }}</h3>
              <div class="description">
                {{ block.settings.content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
              </div>
              {% if block.settings.button_text != blank %}
                <div class="buttons">
                  {% render 'button',
                    label: block.settings.button_text,
                    href: block.settings.url,
                    style: block.settings.button_style,
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

          <div
            class="two-thirds column small-down--one-whole"
            {% if block.settings.image_position == 'left' %}
              style="order: -1;"
            {% endif %}
          >
            {% if block.settings.image != blank %}
              {% render 'image-element', image: block.settings.image, alt: block.settings.image_alt %}
            {% else %}
              <div class="image-element__wrap">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsBoxSlider.js' | asset_url }}"></script>
{% schema %}
{
  "name": "Home Box in Box",
   "class": "jsBoxsSlider",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Box",
      "settings": [
        {
          "type": "select",
          "label": "Image Position",
          "id": "image_position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "right"
        },
        {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
        {
          "type": "text",
          "label": "Image Alt Text",
          "id": "image_alt"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background",
          "default": "#58717a"
        },
        {
          "type": "text",
          "label": "Title",
          "id": "title"
        },
        {
          "type": "html",
          "label": "Content",
          "id": "content"
        },
        {
          "type": "text",
          "label": "Button Text",
          "id": "button_text"
        },
        {
          "type": "url",
          "label": "Button Link",
          "id": "url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Box in Box"
    }
  ]
}
{% endschema %}
