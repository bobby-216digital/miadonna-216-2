<style>
  .pink-text {
    color: #e5b6aa;
    text-transform: uppercase;
  }
  .contact-form-wrapper .contact-form-container {
    max-width: 650px;
    margin: 0 auto;
    background: #ffffff;
    width: 100%;
    padding: 2em;
  }

  .contact-form-wrapper .form-title {
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-form-wrapper p {
    color: #3c3737;
    font-size: 13px;
  }

  .contact-form-wrapper p a {
    font-weight: 500;
    text-decoration: underline;
  }

  .contact-form-wrapper .required-text {
    color: #ffa998;
    margin-top: 15px;
    font-size: 12px;
    text-transform: uppercase;
  }

  .contact-form-wrapper .field {
    margin: 0;
    position: relative;
  }

  .contact-form-wrapper .field select {
    -webkit-appearance: none;
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    text-transform: uppercase;
    color: #777777;
    width: 100%;
    height: 52px;
    border-radius: 0;
    padding: 0;
    margin: 14px 0;
    border: 1px solid #d2d2d2;
    background: #ffffff;
    text-align: center;
  }

  .contact-form-wrapper .field .select-button {
    background-color: transparent;
    right: 0px;
    border-left: 1px solid #d2d2d2;
    height: 52px;
    top: 0;
    margin: 14px 0;
    position: absolute;
    pointer-events: none;
    padding: 1.2em 1.3em;
  }

  .contact-form-wrapper .field .select-button i {
    margin: 0;
    vertical-align: middle;
  }

  .contact-form-wrapper .field input,
  .contact-form-wrapper .field textarea {
    width: 100%;
    font-size: 15px;
    font-weight: 300;
    color: #525252;
    text-align: center;
    line-height: 1.55;
    letter-spacing: 0.02em;
    -webkit-font-smoothing: antialiased;
    margin: 1em 0;
    background: #f6f6f6;
    border: #f6f6f6;
    padding: 12px 17px;
  }

  .contact-form-wrapper .field textarea {
    text-align: left;
  }

  .contact-form-wrapper .field input::placeholder,
  .contact-form-wrapper .field textarea::placeholder {
    font-weight: 500;
    text-transform: uppercase;
  }

  .contact-form-wrapper .field textarea::placeholder {
    text-align: center;
  }

  .contact-form-wrapper .field textarea {
    margin-bottom: 0;
  }

  .contact-form-wrapper .field .submit-button {
    position: absolute;
    right: 0;
    bottom: 6px;
    width: 50px;
    height: 50px;
    padding: 0;
    margin: 0;
    display: block;
  }
  @media only screen and (max-width: 767px) {
      .contact-form-wrapper .contact-form-container {
      padding: 0;
    }

    }
</style>
<div id="contact-form-container"></div>
<div class="block--{{ forloop.index }} contact-form-wrapper has-margin-top has-padding-top has-margin-bottom text-align-center">
  <div class="contact-form-container">
    <header class="form-title">{{ section.settings.title }}</header>
    <br>
    {{ section.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <script>
          $(document).ready(function () {
            $(".successForm").dialog({
              modal: true,
              dialogClass: "successFormDiolog",
              draggable: false,
            });
          });
        </script>

        <div class="successForm feedback">
          <h2 class="pink-text">Success!</h2>
          <p>We have received your message and we will be getting back to you soon.</p>
        </div>
      {% endif %}
      {% if form.errors %}
        <div class="errorForm feedback">
          <!-- {{ form.errors.size }} or {{ form.errors | size }} -->
          <p>
            Your contact form has {{ form.errors | size | pluralize: 'an error', 'a few errors' }}. To submit your form,
            make the following changes and try again:
          </p>
          {% for field in form.errors %}
            <p>The {{ field | capitalize | replace: 'Body', 'Message' }} field {{ form.errors.messages[field] }}.</p>
          {% endfor %}
        </div>
      {% endif %}
      <fieldset>
        <div class="field">
          <div class="select-button">
            <i class="icon-solid-caret"></i>
          </div>
        </div>
        <div class="field">
          <input
            id="name"
            name="contact[name]"
            placeholder="{{ section.settings.name }}"
            class="field-name"
            type="text"
            required=""
          >
        </div>
        <div class="field">
          <input
            id="email"
            name="contact[email]"
            class="field-email"
            placeholder="{{ section.settings.email }}"
            type="email"
            required=""
          >
        </div>
        <div class="field">
          <textarea
            name="contact[body]"
            id="message"
            placeholder="{{ section.settings.message }}"
            maxlength="250"
            class="field-message"
            rows="5"
          ></textarea>
          <input
            type="image"
            id="contactFormSubmit"
            class="submit-button"
            name="submit"
            src="https://scdn.speedsize.com/d9acbe11-c0cc-4d19-a1ce-748a0fd38b05/cdn.shopify.com/s/files/1/1164/4258/files/submit-button.png?v=11069712008357948348"
            border="0"
            alt="Submit"
          >
        </div>
      </fieldset>
    {% endform %}
    <p class="required-text">{{ section.settings.required_text }}</p>
  </div>
</div>
{% schema %}
{
  "name": "Contact Form",
  "class": "contact-form",
  "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Submit An Email"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "header",
        "content": "Select options"
      },

      {
        "type": "header",
        "content": "Input placeholders"
      },
      {
        "type": "text",
        "id": "name",
        "label": "Name placeholder"
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email placeholder"
      },
      {
        "type": "text",
        "id": "message",
        "label": "Message placeholder"
      },

      {
        "type": "text",
        "id": "required_text",
        "label": "Required text"
      }
    ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
