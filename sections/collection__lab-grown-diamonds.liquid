{% comment %}
  ** Collection template with sidebar **
{% endcomment %}

{%- capture labGrownContentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
{%- assign labGrownPageUrl = labGrownContentForQuerystring | split:'"pageurl":"' | last | split:'"' | first | split:'.myshopify.com' | last | replace:'\/','/' | replace:'%20',' ' | replace:'\u0026','&' -%}
{%- assign labGrownPageQueryStringReplace = labGrownPageUrl | replace: request.path, "" | replace: request.host, '' -%}
{%- assign labGrownPageQueryString = labGrownPageQueryStringReplace | split:'?' | last -%}
{%- assign labGrownPageQueryArray = labGrownPageQueryString | split:'&' -%}

{% if template.name == 'collection' %}
  {{ 'template-collection.css' | asset_url | stylesheet_tag }}

  <noscript>{{ 'template-collection.css' | asset_url | stylesheet_tag }}</noscript>
{% endif %}

{% assign id = section.id %}
{% comment %}Layout{% endcomment %}
{% assign width = section.settings.width %}
{% assign padding_top = section.settings.padding_top %}
{% assign padding_bottom = section.settings.padding_bottom %}
{% assign animation = section.settings.animation | default: 'none' %}
{% comment %} Advanced {% endcomment %}
{% assign css_class = section.settings.css_class %}
{% assign custom_css = section.settings.custom_css %}

{% comment %} CSS {% endcomment %}
{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  .sidebar-section {
    {% if section.settings.sidebar_position == 'right' %}
      order: 1;
    {% endif %}
  }

  {% if section.settings.collection_breadcrumb == false %}
    .breadcrumb__container {
      display: none;
    }
  {% endif %}

  {% if section.settings.pagination_type != 'basic_pagination' %}
    .breadcrumb__page-count {
      display: none;
    }
  {% endif %}

  {% if section.settings.collection_tags == false %}
    .collection__tag-filter {
      display: none;
    }
  {% endif %}

  {% if section.settings.collection_sort == false %}
    .collection__sort-by-filter {
      display: none;
    }
  {% endif %}

  

  {% render 'css-loop', css: custom_css, id: id %}
{% endstyle %}

<section class="section {{ css_class }} is-width-{{ width }}" {% if animation != 'none' %}data-scroll-class="{{ animation }}"{% endif %}>
  <div class="collection__banner">
    <div class="container">
      <div class="collection__breadcrumb two-fifths large-down--one-whole column has-padding-bottom">
        <div class="breadcrumb__container">
          {% render 'breadcrumb', context: 'collection' %}
        </div>
      </div>
    </div>
    
    <div class="container {% if settings.heading_divider_style == 'long' %}has-heading-divider-below {% endif %}">
        <div class="collection__spacer three-fifths large-down--hide column hide-when-banner-enabled hidden"></div>
        <div class="one-third large-down--one-whole column has-no-side-gutter hide-when-banner-enabled heading-container">
          {% render 'heading',
            title: collection.title,
            heading_tag: 'h1',
            context: 'collection',
            text_alignment: 'center'
          %}
          {% if collection.description != blank %}
            <div class="collection__description content">
              {{ collection.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
            </div>
          {% endif %}
        </div>
      {% if settings.heading_divider_width != 0 and settings.heading_divider_style == 'long' %}
        <div class="heading-divider-below heading-wrapper one-whole column hide-when-banner-enabled">
          <div
            class="
              heading-divider
              heading-divider--{{ settings.heading_divider_style }}
            "
            {% if settings.heading_divider_animation != 'none' %}
              data-scroll-class="{{ settings.heading_divider_animation }}"
            {% endif %}
          ></div>
        </div>
      {% endif %}
    </div>
  </div>

  {% if collection.description != blank %}
  {% endif %}

  {% 
    render 'collection__content-lab-created-diamonds',
    labGrownPageQueryArray: labGrownPageQueryArray,
    carat_metafields: collection.metafields.custom-range.filter-carat,
    price_metafields: collection.metafields.custom-range.filter-price
  %}
</section>
<script>
  const headingEvent = document.querySelector('.heading-e');

  headingEvent.addEventListener('click', function() {
    headingEvent.parentElement.classList.toggle('active');
  });
</script>
<script data-theme-editor-load-script src="{{ 'z__jsSidebar.js' | asset_url }}"></script>
<script src="{{ 'z__jsCollection.js' | asset_url }}"></script>
