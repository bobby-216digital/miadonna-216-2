<section class="testimonial-inner {{ section.settings.sectionid | escape }} section-scroll" aria-labelledby="testimonial-title">
  <div class="contanier-nw">
    {%- if section.settings.section_title != blank -%}
      <div class="title-header">
        <h2 id="testimonial-title" class="common-hd mob-same-center">
          {{ section.settings.section_title | escape }}
        </h2>
      </div>
    {%- endif -%}

    <div class="testimonial-inrslider sl-space slick-cls progress-sl" role="region" aria-roledescription="carousel" aria-label="Customer Testimonials">
      {% for block in section.blocks %}
        <div class="slide">
          <div class="slide-cls sl-spacebox" {{ block.shopify_attributes }}>
            <div class="testimonial-box">
              <div class="testimonial-image">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.name | default: block.settings.product_title | escape }}"
                    class="image-full{% if block.settings.mobile_image != blank %} desktop-image{% endif %}"
                    width="510"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  >
                {% endif %}

                {% if block.settings.mobile_image != blank %}
                  <img
                    src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.mobile_image | image_url: width: 600 }}"
                    alt="{{ block.settings.name | default: block.settings.product_title | escape }}"
                    class="image-full mobile-image"
                    width="600"
                    height="330"
                    loading="lazy"
                    decoding="async"
                  >
                {% endif %}

                {% if block.settings.verified_reviewer %}
                  <div class="verified-badge">
                    <svg class="verified-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <polyline points="9 12 11 14 15 10"/>
                    </svg>
                    <span>{{ block.settings.verified_text | default: 'Verified Reviewer' | escape }}</span>
                  </div>
                {% endif %}
              </div>
              <div class="testimonial-content">
                {% if block.settings.name != blank %}
                  <h3>{{ block.settings.name | escape }}</h3>
                {% endif %}

                {% if block.settings.quote != blank %}
                  <p class="testimonial-quote">{{ block.settings.quote | escape | newline_to_br }}</p>
                {% endif %}

                {% if block.settings.product_title != blank or block.settings.product_details != blank %}
                  <div class="testimonial-divider"></div>
                {% endif %}

                {% if block.settings.product_title != blank %}
                  <h4 class="testimonial-product-title">{{ block.settings.product_title | escape }}</h4>
                {% endif %}

                {% if block.settings.product_details != blank %}
                  <p class="testimonial-product-details">{{ block.settings.product_details | escape }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="progress-container progress-center-mob" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="10" aria-label="Slider progress">
      <div class="progress-bar progress-bar-testimonial" style="width: 10%;"></div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Testimonial static Slider",
  "class": "testimonial-section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "YOUR DESIGN, YOUR STORY"
    },
    {
      "type": "text",
      "id": "sectionid",
      "label": "scroll id class"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Testimonial Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Testimonial Image"
        },
        {
          "type": "checkbox",
          "id": "verified_reviewer",
          "label": "Show Verified Reviewer Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified Badge Text",
          "default": "Verified Reviewer"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "LISSETTE & CHRISTOPHER"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonial Quote",
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
        },
        {
          "type": "text",
          "id": "product_details",
          "label": "Product Details / Specs",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial static Slider",
      "category": "Testimonials"
    }
  ]
}
{% endschema %}