                                                    {{ block.settings.card_description8 | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                                                    <br/>
                                                    {% if block.settings.card_link_url8 != blank %}
                                                        <a href="{{ block.settings.card_link_url8 }}" class="card-link">
                                                        {{ block.settings.card_link_label8 }}
                                                        </a>
                                                    {% endif %}
                                                    </p>
                                                {% endif %}
                                            </div>

                                        </div>

                                    </div>
                                  {% endif %}

                                </div>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div> 
      </div>
    </div>
</div>


