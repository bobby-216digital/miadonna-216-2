{% comment %} <script>
  document.querySelector('.default-list').addEventListener('click', function() {
  const mobileList = document.querySelector('.mobile-list');

  if (mobileList.style.display === 'none' || mobileList.style.display === '') {
    mobileList.style.display = 'block';
  } else {
    mobileList.style.display = 'none';
  }
});


document.querySelectorAll('.mobile-list li').forEach(function(item) {

  item.addEventListener('click', function() {

    var target = this.getAttribute('data-title');
    var data_id = this.getAttribute('data-id');

    document.querySelector('.default-list a').textContent = target;
    document.querySelector('.mobile-list').style.display = 'none';

    var section = document.getElementById(data_id);

    if (section) {
      window.scrollTo({
        top: section.offsetTop,
        behavior: 'smooth'
      });
    }

  });

});
</script> {% endcomment %}
<script>
  document.getElementById('faqSelectCategory').addEventListener('click', function() {
  var list = document.getElementById('faqCategory');

  if (list.style.display === 'none' || list.style.display === '') {
    list.style.display = 'block';
  } else {
    list.style.display = 'none';
  }
});


document.querySelectorAll('#faqCategory li').forEach(function(item) {

  item.addEventListener('click', function() {

    var target = this.getAttribute('data-title');
    var icons = '<span class="faq-arrow"><svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.02246 6.82764L1.02246 1.82764C0.834961 1.64014 0.834961 1.29639 1.02246 1.10889C1.20996 0.921387 1.55371 0.921387 1.74121 1.10889L6.39746 5.76514L11.0225 1.10889C11.21 0.921387 11.5537 0.921387 11.7412 1.10889C11.9287 1.29639 11.9287 1.64014 11.7412 1.82764L6.74121 6.82764C6.55371 7.01514 6.20996 7.01514 6.02246 6.82764Z" fill="white"></path></svg></span>';
    var data_id = this.getAttribute('data-id');

    document.getElementById('faqSelectCategory').innerHTML  = target + icons;

    document.getElementById('faqCategory').style.display = 'none';

    var section = document.getElementById(data_id);

    if (section) {
      window.scrollTo({
        top: section.offsetTop-110,
        behavior: 'smooth'
      });
    }

  });

});

window.addEventListener('scroll', function () {

  var scrollPos = document.documentElement.scrollTop || document.body.scrollTop;

  var sections = document.querySelectorAll('.dmdblock-advantages');

  sections.forEach(function (section) {

    var sectionTop = section.offsetTop - 200;
    var sectionBottom = sectionTop + section.offsetHeight;
    var sectionId = section.getAttribute('id');

    if (scrollPos >= sectionTop && scrollPos <= sectionBottom) {

      var links = document.querySelectorAll('.lab-sidebar-list-tem a');
      
      links.forEach(function (link) {
        link.classList.remove('active');
      });

      var activeLink = document.querySelector('.lab-sidebar-list-tem a[href="#' + sectionId + '"]');

      if (activeLink) {
        activeLink.classList.add('active');
      }

    }

  });

});
</script>