                    <path d="M6.02246 6.82764L1.02246 1.82764C0.834961 1.64014 0.834961 1.29639 1.02246 1.10889C1.20996 0.921387 1.55371 0.921387 1.74121 1.10889L6.39746 5.76514L11.0225 1.10889C11.21 0.921387 11.5537 0.921387 11.7412 1.10889C11.9287 1.29639 11.9287 1.64014 11.7412 1.82764L6.74121 6.82764C6.55371 7.01514 6.20996 7.01514 6.02246 6.82764Z" fill="white"></path>
                  </svg>
                </span>
              </button>
              <ul class="faq-categorylist" id="faqCategory">
                {% for block in section.blocks %}
                  <li href="#{{ block.settings.main_title | handleize }}" class="faq-categorybox aboutnav-link" data-title="{{ block.settings.main_title }}" data-id="{{ block.settings.main_title | handleize }}">{{ block.settings.main_title }}</li>
                {% endfor %}
                <li href="#accordion-heading" class="faq-categorybox aboutnav-link" data-title="FAQ's" data-id="accordion-heading">FAQ's</li>
              </ul>
            </div>
          </div>
        </div>
