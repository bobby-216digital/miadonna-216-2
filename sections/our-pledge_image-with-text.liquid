<style>
  #shopify-section-{{ section.id }} .shaded {
    background: rgba(0,0,0,.04);
  }
  #shopify-section-{{ section.id }} .offset-group>*+* {
    margin-top: 26px;
    font-family: Playfair Display,serif;
  }
  #shopify-section-{{ section.id }} ._body {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .content-cell {
    padding: 50px 26px;
  }
  #shopify-section-{{ section.id }} .text-style-subtitle {
    color: #000;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} p:not(.text-style-title):not(h1):not(.text-style-title-2):not(h2) {
    font-size: 15px;
  }
  @media only screen and (min-width: 750px){
    #shopify-section-{{ section.id }} .content-cell {
      padding: 50px;
    }
  }
  @media only screen and (min-width: 1024px){
    #shopify-section-{{ section.id }} .content-cell {
      padding: 100px 50px;
    }
    #shopify-section-{{ section.id }} .text-style-subtitle {
      font-size: 18px;
    }
  }
  @media only screen and (max-width: 749px){
    #shopify-section-{{ section.id }} ._image {
      order: 0 !important;
    }
  }
</style>

<section class="body-cell section is-standard">
  <div class="media-grid-layout -square cell-style-A shaded">
    {% for block in section.blocks %}
      <section class="container has-no-side-gutter shaded">
        <figure
          class="_image formatted-image one-half small-down--one-whole column"
          {% if block.settings.image_position == 'right' %}
            style="order: 2"
          {% endif %}
        >
          {% if block.settings.image != blank %}
            {%
              render 'image-element',
              image: block.settings.image,
              alt: block.settings.image.alt,
              stretch_width: true,
              additional_classes: 'media-grid__image',
              focal_point: block.settings.image.presentation.focal_point,
            %}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </figure>
        <section class="_body one-half small-down--one-whole column text-center">
          <div class="_content content-cell offset-group">
            <h2 class="text-style-subtitle black-text">{{ block.settings.title }}</h2>
            <p>{{ block.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
          </div>
        </section>
      </section>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Our Pledge - Imagetext",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "Image",
      "name": "Image Text",
      "settings": [
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text"
        }
      ]
    }
   ],
   "presets": [
  {
    "name": "Our Pledge - Imagetext",
    "category": "Image"
  }
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
