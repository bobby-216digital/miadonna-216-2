{% comment %}
  ** Image with text **
{% endcomment %}

{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}</noscript>
<style>
  .cta-table table td,.cta-table table th {
    padding: 2em;
    text-align: center;
}

.cta-table {
    font-family: Montserrat,sans-serif;
    font-weight: 500;
    overflow-x: auto;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
}

.cta-table table th {
    background: #e2e2e2;
    color: #000;
    text-transform: uppercase;
    border: 1px solid #fff;
}

.cta-table table tr:nth-child(2n) td {
    background: #f4f4f4;
    border: 1px solid #fff;
}

.cta-table table tr:nth-child(odd) td {
    background: #f9f9f9;
    border: 1px solid #fff;
}
  </style>
{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .plyr__video-embed{
    width: 100%;
    /* height: 100%; */
  }
  @media screen and (min-width: 1300px){
    #shopify-section-{{ section.id }} .image-with-text__heading{
      margin-bottom: 3rem;
    }
  }
  @media screen and (max-width: 768px){
    #shopify-section-{{ section.id }} {
    padding-top: 30px;
    padding-bottom: 30px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  }
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="container"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% if block.type == 'text' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block.settings.text -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block.settings.background | color_extract: 'alpha' -%}
          {%- assign text_alpha = block.settings.text_color | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ block.id }} {
                background-color: {%- if background_alpha != 0 -%}{{ block.settings.background }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: block.id
            %}
          {% endstyle %}

          <div
            class="
              one-half
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex
              is-flex-wrap
              is-justify-{{ block.settings.alignment }}
              is-align-{{ block.settings.vertical_position }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ block.id }}"
            {% endif %}
          >
      
            <div class="image-with-text__wrapper">
           
                <h3 class="image-with-text__heading text-align-{{ block.settings.alignment }} is-{{ block.settings.heading_size }}"  style="font-size: 28px;font-weight: 600;line-height: 1.2 !important;    margin-bottom: 0;">
                
                  {{ block.settings.title2 }}
                </h1>
           

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block.settings.alignment }} content">
                  {{ text }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="buttons is-{{ block.settings.alignment }}">
                  {% render 'button',
                    label: block.settings.button_label,
                    href: block.settings.link,
                    style: block.settings.button_style,
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block.type == 'table' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = block.settings.image -%}
          {%- assign iframe_video = block.settings.iframe_video -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              one-half
              medium-down--one-whole
              column
              is-align-center
              {% if iframe_video %}column-has-video{% endif %}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
            style="position: relative;"
          >
         <div class="cta-table">
          <table>
            <tbody>
              <tr>
                <th>{{ block.settings.heading1 }}</th>
                <th>{{ block.settings.heading2 }}</th>
                <th>{{ block.settings.heading3 }}</th>
                <th>{{ block.settings.heading4 }}</th>
              </tr>
              <tr>
                <td>{{ block.settings.r1v1 }}</td>
                <td>{{ block.settings.r1v2 }}</td>
                <td>{{ block.settings.r1v3 }}</td>
                <td>{{ block.settings.r1v4 }}</td>
              </tr>
              <tr>
              <td>{{ block.settings.r2v1 }}</td>
                <td>{{ block.settings.r2v2 }}</td>
                <td>{{ block.settings.r2v3 }}</td>
                <td>{{ block.settings.r2v4 }}</td>
              </tr>
              <tr>
                <td>{{ block.settings.r3v1 }}</td>
                <td>{{ block.settings.r3v2 }}</td>
                <td>{{ block.settings.r3v3 }}</td>
                <td>{{ block.settings.r3v4 }}</td>
              </tr>
              <tr>
                <td>{{ block.settings.r4v1 }}</td>
                <td>{{ block.settings.r4v2 }}</td>
                <td>{{ block.settings.r4v3 }}</td>
                <td>{{ block.settings.r4v4 }}</td>
              </tr>
            </tbody>
          </table>
        </div>
              {% if block.settings.image_text != blank %}
              <p><strong>Ring Shown:</strong> {{ block.settings.image_text | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>
<style>
  @media screen and (max-width:768px){
    .image-with-text .image-element__wrap {
    margin: 0;
    width: 100%;
}

.image-with-text .one-half {
    margin-bottom: 20px;
    margin-top: 20px;
    margin-left: 0;
    margin-right: 0;
    width: 100%;
}

.image-with-text .image-with-text__wrapper h1, .image-with-text .image-with-text__wrapper p,  .image-with-text .image-with-text__wrapper .buttons {
    text-align: left;
    padding-left: 10px;
    padding-right: 10px;
}
  }
</style>
