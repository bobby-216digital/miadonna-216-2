<style>
  #shopify-section-{{ section.id }} {
    padding: 50px 26px;
  }
  #shopify-section-{{ section.id }}.bottom-padding-only {
    padding-top: 0;
  }
  @media only screen and (min-width: 750px){
    #shopify-section-{{ section.id }} {
      padding: 50px;
    }
  }
  @media only screen and (min-width: 1024px){
    #shopify-section-{{ section.id }} {
      padding: 100px 50px;
    }
  }
  @media only screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .founder-video .video-col {
      padding-top: 1em;
      padding-bottom: 1em;
    }
    #shopify-section-{{ section.id }} .founder-video .video-col:first-child {
      padding-top: 0;
    }
    #shopify-section-{{ section.id }} .founder-video .video-col:last-child {
      padding-bottom: 0;
    }
  }
</style>

<section class="section is-standard content-cell -bottom-padding-only founder-video">
  <div class="body-cell">
    <div class="container video-grid">
      <div class="one-half small-down--one-whole column video-col">
        <iframe
          src="{{ section.settings.video_url1  }}?color=ffa998&amp;title=0&amp;byline=0&amp;portrait=0"
          width="640"
          height="360"
          frameborder="0"
          webkitallowfullscreen=""
          mozallowfullscreen=""
          allowfullscreen=""
        ></iframe>
      </div>
      <div class="one-half small-down--one-whole column video-col">
        <iframe
          src="{{ section.settings.video_url2  }}?color=ffa998&amp;title=0&amp;byline=0&amp;portrait=0"
          width="640"
          height="360"
          frameborder="0"
          webkitallowfullscreen=""
          mozallowfullscreen=""
          allowfullscreen=""
        ></iframe>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Videos",
  "class": "bottom-padding-only",
  "settings": [ {
      "type": "text",
      "id": "video_url1",
      "label": "Vimeo Url 1"
    },
    {
      "type": "text",
      "id": "video_url2",
      "label": "Vimeo Url 2"
    }
  ],
   "presets": [
  {
    "name": "Founder Videos",
    "category": "Image"
  }
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

