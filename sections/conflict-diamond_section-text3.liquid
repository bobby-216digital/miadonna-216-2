<style>
  #shopify-section-{{ section.id }} .content-cell {
    padding: 50px 26px;
  }
  #shopify-section-{{ section.id }} .content-cell.-bottom-padding-only {
    padding-top: 0px;
  }
  #shopify-section-{{ section.id }} .readability-insets>* {
    max-width: 76rem;
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }} .offset-group>*+* {
    margin-top: 26px;
    font-family: Playfair Display,serif;
  }
  #shopify-section-{{ section.id }} .text-style-chapter-title {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .text-style-title {
    color: #000000de;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: .02em;
    font-family: Playfair Display,serif;
  }
  #shopify-section-{{ section.id }} p:not(.text-style-title):not(h1):not(.text-style-title-2):not(h2) {
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .percentages img {
    margin: 1em 0;
    height: 70px;
    width: auto;
  }
  #shopify-section-{{ section.id }} .percentages p {
    margin: 1em;
    font-family: Playfair Display,serif;
  }
  @media only screen and (min-width: 750px){
    #shopify-section-{{ section.id }} .content-cell {
      padding: 50px;
    }
    #shopify-section-{{ section.id }} .text-style-title {
      font-size: 36px;
    }
  }
  @media only screen and (min-width: 1024px){
    #shopify-section-{{ section.id }} .content-cell {
      padding: 100px 50px;
    }
    #shopify-section-{{ section.id }} .text-style-chapter-title {
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .text-style-title {
      font-size: 40px;
    }
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .green-practices {
      padding: 2rem;
    }
  }
</style>

<section class="section is-standard">
  <div class="content-cell cell-style-A text-center">
    <div class="body-cell offset-group readability-insets">
      {% if section.settings.subtitle != blank %}
        <h2 class="text-style-chapter-title">{{ section.settings.subtitle }}</h2>
      {% endif %}
      {% if section.settings.title != blank %}
        <p class="text-style-title ">{{ section.settings.title }}</p>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
  <div class="content-cell cell-style-A -bottom-padding-only text-center">
    <div class="body-cell">
      <div class="container percentages">
        {% for block in section.blocks %}
          <div class="one-third small-down--one-whole column">
            {% if block.settings.image != blank %}
              <img height="104" width="305" alt="50%" src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | img_url:'305x'}}">
            {% endif %}
            {% if block.settings.description != blank %}
              <p>
                {{ block.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx -}}
              </p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CD - Text with Block",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle",
      "default": "You Hold the Power to End Conflict Diamonds"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title"
    },
     {
      "type": "textarea",
      "id": "text",
      "label": "Text"

    }
  ],
  "blocks": [
     {
      "type": "Image",
      "name": "Image Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text"
        }
      ]
     }
  ],
        "presets": [
  {
    "name": "CD - Text With Block",
    "category": "Text"
  }
]

}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
