{% comment %}
  ** Mega menu - static **
{% endcomment %}

{% assign id = section.id %}

{% comment %} HTML markup {% endcomment %}
<div class="mega-menu__section mega-menu__{{ section.id }}">
  {% include 'include-mega-menu', id: id ,title:section.settings.parent_link %}

  {% comment %}JavaScript{% endcomment %}
  <script
    type="application/json"
    data-section-id="{{ section.id }}"
    data-section-data
  >
    {
      "parent_link": {{ section.settings.parent_link | handleize | json }},
      "section_id": {{ section.id | json }}
    }
  </script>
  {% comment %} <script src="{{ 'z__jsMegaMenu.js' | asset_url }}"></script> {% endcomment %}
</div>

{% schema %}
