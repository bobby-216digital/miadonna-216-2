{% comment %}
  ** Header 2 Centered - static **
{% endcomment %}

{{ 'section-header-centered.css' | asset_url | stylesheet_tag }}

<noscript>
  {{ 'section-header-centered.css' | asset_url | stylesheet_tag }}
</noscript>

<style>
  .header .section,
  .header .sticky-menu-wrapper {
    max-width: 1920px;
  }
</style>

{% assign id = section.id %}
{% comment %} Logo {% endcomment %}
{% assign logo = section.settings.logo %}
{% comment %} Overlay {% endcomment %}
{% assign overlay_logo = section.settings.overlay_logo %}
{% assign text = section.settings.text_color %}
{% comment %} Advanced {% endcomment %}
{% assign width = section.settings.width %}
{% assign css_class = section.settings.css_class %}
{% assign custom_css = section.settings.custom_css %}

{% comment %} Is the color set to transparent? {% endcomment %}
{% assign header_alpha = settings.header_background | color_extract: 'alpha' | floor %}
{% assign overlay_alpha = section.settings.overlay_background | color_extract: 'alpha' %}
{% assign overlay_link_alpha = section.settings.overlay_link_color | color_extract: 'alpha' | floor %}
{% assign overlay_link_hover_alpha = section.settings.overlay_link_hover_color | color_extract: 'alpha' | floor %}

{% comment %} Opacity level {% endcomment %}
{% if header_alpha != 0 %}
  {% assign sticky_background_alpha = section.settings.sticky_background_opacity | divided_by: 100.00 %}
  {% assign overlay_background_alpha = section.settings.overlay_background_opacity | divided_by: 100.00 %}
{% endif %}

{% comment %} Section specific CSS {% endcomment %}
{% capture section_css -%}
  .header__logo,
  .logo__content {
    width: {{ section.settings.logo_width }}px;
  }

  .sticky-logo{
    opacity: 0;
    display: none;
    visibility: hidden;
  }

  .is-sticky .header__logo,
  .is-sticky #mobile-header .mobile-header__logo {
    width: {{ section.settings.scroll_logo_width }}px;
  }

  .is-sticky img.primary-logo{
    opacity: 0;
    display: none;
    visibility: hidden;
  }

  .is-sticky img.sticky-logo{
    opacity: 1;
    display: block;
    visibility: visible;
  }

  {%- if section.settings.enable_overlay -%}
    [data-enable_overlay="true"] .header {
      background-color: {%- if overlay_alpha != 0 -%}{{ section.settings.overlay_background | color_modify: 'alpha', overlay_background_alpha }}{%- else -%}{{ settings.header_background | color_modify: 'alpha', overlay_background_alpha }}{%- endif -%};
    }

    [data-enable_overlay="true"] .header__logo,
    .overlay-logo__content {
      width: {{ section.settings.overlay_logo_width }}px;
    }

    [data-enable_overlay="true"] .header__link,
    [data-enable_overlay="true"] .select select {
      color: {%- if overlay_link_alpha != 0 -%}{{ section.settings.overlay_link_color }}{%- endif -%};
      fill: {%- if overlay_link_alpha != 0 -%}{{ section.settings.overlay_link_color }}{%- endif -%};
      {% if section.settings.show_text_shadow %}
        text-shadow: 0 1px 1px rgba(0, 0, 0, .4);
      {% endif %}
    }

    [data-enable_overlay="true"] .header__link:hover,
    [data-enable_overlay="true"] .header__link.is-active,
    [data-enable_overlay="true"] .select select:hover {
      color: {%- if overlay_link_hover_alpha != 0 -%}{{ section.settings.overlay_link_hover_color }}{%- endif -%};
      fill: {%- if overlay_link_hover_alpha != 0 -%}{{ section.settings.overlay_link_hover_color }}{%- endif -%};
    }
  {%- endif -%}
  {%- if section.settings.enable_sticky -%}    
    .header-sticky-wrapper.is-sticky .header {
      background-color: {{ settings.header_background | color_modify: 'alpha', sticky_background_alpha }};
    }

    #mobile-header-sticky-wrapper.is-sticky .mobile-header {
      background-color: {{ settings.header_background | color_modify: 'alpha', sticky_background_alpha }};
    }

    .mobile-menu--opened #mobile-header-sticky-wrapper.is-sticky .mobile-header {
      background-color: {{ settings.header_background }};
    }
  {%- endif -%}
{%- endcapture -%}

{% style %}
  #shopify-section-{{ id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if width == 'wide' %}
      width: 100%;
    {% endif %}
  }

  {% render 'css-loop',
          css: section_css,
          id: id
  %}
  {% render 'css-loop',
          css: custom_css,
          id: id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<div
  class="is-relative {{ css_class }}"
  data-enable_overlay="{{ section.settings.enable_overlay }}"
  data-enable_sticky="{{ section.settings.enable_sticky }}"
>
  <header
    id="header"
    class="header header--centered dropdown-style-{{ settings.dropdown_style }} box-shadow-{{ settings.show_dropdown_shadow }}" role="banner" aria-label="Site Header"
  >
     <div class="header__inner-content">
          <div class="contanier-nw navbar-container is-width-{{ width }}">
            {%- comment -%}
            {% if section.settings.side_linklist.links != blank %}
              <div class="header__left-links">
                <ul class="header__left-list">
                  {% for link in section.settings.side_linklist.links %}
                    <li class="link-item header__link">
                      <a href="{{ link.url }}">{{ link.title | escape }}</a>
                    </li>
                  {% endfor %}
                  <!--
                    <li class="link-item">
                      <a href="/pages/appointments">APPOINTMENT</a>
                    </li>
                    <li class="link-item">
                      <a href="/pages/contact-us">Contact</a>
                    </li>
                    <li class="link-item">
                      <a href="">EDUCATION CENTER</a>
                    </li>
                  -->
                </ul>
              </div>
            {% endif %}
            {%- endcomment -%}
            {% assign main_menu = linklists[section.settings.main_linklist] %}
            <nav class="sticky-menu-wrapper" role="navigation"   aria-label="main navigation">
              {% comment %} Sticky menu {% endcomment %}
              <div class="sticky-header__menu">
                <div
                  class="
                    header__menu-items
                    is-flex
                    is-flex-wrap
                    dropdown-click--{{ section.settings.dropdown_click }}
                    {% if section.settings.logo_position == 'above' %}
                      {% if section.settings.menu_spacing == 'default' %}
                        is-justify-center
                      {% elsif section.settings.menu_spacing == 'minimum' %}
                        is-justify-space-around
                      {% elsif section.settings.menu_spacing == 'maximum' %}
                        is-justify-space-between
                      {% endif %}
                    {% elsif section.settings.logo_position == 'between' %}
                      is-justify-center
                    {% endif %}
                  "
                >
                  {% for link in main_menu.links %}
                    {% if link.links == blank %}
                      <div
                        class="navbar-item header__item {% if link.active or link.child_active %}is-active{% endif %}"
                        data-navlink-handle="{{ link.title | handleize }}"
                      >
                        <label for="mega-{{ link.title | handleize }}">
                          <a
                            href="{{ link.url }}"
                            class="navbar-link header__link {% if link.active %}is-active{% endif %} is-arrowless"
                          >
                            {{ link.title }}
                          </a>
                        </label>
                      </div>
                    {% else %}
                      <div
                        class="navbar-item header__item has-dropdown has-dropdown--{{ settings.dropdown_style }} is-hoverable {% if link.active or link.child_active %}is-active{% endif %}"
                        aria-haspopup="true"
                        aria-expanded="false"
                        data-navlink-handle="{{ link.title | handleize }}"
                      >
                        <label for="dropdown-{{ link.title | handleize }}">
                          <a
                            class="navbar-link header__link {% if link.active or link.child_active %}is-active{% endif %}"
                            {% unless link.url == 'http://' or link.url == '' or link.url == 'https://' or link.url == '#' %}
                              href="{{ link.url }}"
                            {% endunless %}
                          >
                            {{ link.title }}
                          </a>
                        </label>

                        {% render 'header__dropdown-menu', link: link, index: forloop.index, prefix: 'sticky-' %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </nav>
            <div class="header__brand logo-desktop is-align-center is-justify-space-between is-flex text-align-center">
                {% if section.settings.enable_overlay and section.settings.overlay_logo != blank %}
                  {% if template.name == 'index' %}
                    <h1 class="visually-hidden">{{ shop.name }} - Ethical Engagement Rings & Conflict Free Jewelry</h1>
                  {% endif %}
                  <div class="overlay-logo__content">
                    <a class="header__logo header__link overlay-logo" href="{{ routes.root_url }}" title="{{ shop.name }}" aria-label="MiaDonna Logo">
                      {%
                        render 'image-element',
                        image: section.settings.overlay_logo,
                        alt: section.settings.overlay_logo.alt,
                        additional_classes: 'overlay-logo',
                        back_to_basics: true,
                        focal_point: section.settings.overlay_logo.presentation.focal_point,
                      %}
                    </a>
                  </div>
                  <div class="logo__content">
                    {% if section.settings.logo != blank %}
                      <a class="header__logo header__link primary-logo" href="{{ routes.root_url }}" aria-label="MiaDonna Logo">
                        {%
                          render 'image-element',
                          image: section.settings.logo,
                          alt: section.settings.logo.alt,
                          additional_classes: 'primary-logo',
                          focal_point: section.settings.logo.presentation.focal_point,
                        %}
                      </a>
                    {% endif %}
                  </div>
                {% elsif section.settings.logo != blank %}
                  {% if template.name == 'index' %}
                    <h1 class="visually-hidden">{{ page_title }}</h1>
                  {% endif %}
                  <a class="header__logo header__link primary-logo" href="{{ routes.root_url }}" aria-label="MiaDonna Logo">
                    {%
                      render 'image-element',
                      image: section.settings.logo,
                      alt: section.settings.logo.alt,
                      image_section: 'header',
                      additional_classes: 'primary-logo',
                      focal_point: section.settings.logo.presentation.focal_point,
                    %}
                    {% if section.settings.enable_sticky and section.settings.sticky_logo != blank %}
                      {%
                        render 'image-element',
                        image: section.settings.sticky_logo,
                        alt: section.settings.sticky_logo.alt,
                        image_section: 'header',
                        additional_classes: 'sticky-logo',
                        focal_point: section.settings.sticky_logo.presentation.focal_point,
                      %}
                    {% endif %}
                  </a>
                {% else %}
                  {% if template.name == 'index' %}
                    <h1 class="header__logo-text">
                      <a class="header__link primary-brand" href="{{ routes.root_url }}">
                        {{ shop.name }}
                      </a>
                    </h1>
                  {% else %}
                    <a class="header__logo-text header__link primary-brand" href="{{ routes.root_url }}">
                      {{ shop.name }}
                    </a>
                  {% endif %}
                {% endif %}
              </div>
            {% comment %} <nav
              class="navbar dropdown-click--{{ section.settings.dropdown_click }} is-align-center header-layout--{{ section.settings.logo_position }}"
              role="navigation"
              aria-label="main navigation"
            >
              <div class="header__link header__menu-toggle is-medium">
                <div class="header__open-menu">
                  {% render 'icon', name: 'menu' %}
                </div>
                <div class="header__close-menu">
                  {% render 'icon', name: 'x' %}
                </div>
              </div>

              {% capture logo %}
              {% comment %} Logo {% endcomment %}
              <div class="header__brand is-align-center is-justify-space-between is-flex text-align-center">
                {% if section.settings.enable_overlay and section.settings.overlay_logo != blank %}
                  {% if template.name == 'index' %}
                    <h1 class="visually-hidden">{{ shop.name }} - Ethical Engagement Rings & Conflict Free Jewelry</h1>
                  {% endif %}
                  <div class="overlay-logo__content">
                    <a class="header__logo header__link overlay-logo" href="{{ routes.root_url }}" title="{{ shop.name }}">
                      {%
                        render 'image-element',
                        image: section.settings.overlay_logo,
                        alt: section.settings.overlay_logo.alt,
                        additional_classes: 'overlay-logo',
                        back_to_basics: true,
                        focal_point: section.settings.overlay_logo.presentation.focal_point,
                      %}
                    </a>
                  </div>
                  <div class="logo__content">
                    {% if section.settings.logo != blank %}
                      <a class="header__logo header__link primary-logo" href="{{ routes.root_url }}" title="{{ shop.name }}">
                        {%
                          render 'image-element',
                          image: section.settings.logo,
                          alt: section.settings.logo.alt,
                          additional_classes: 'primary-logo',
                          focal_point: section.settings.logo.presentation.focal_point,
                        %}
                      </a>
                    {% endif %}
                  </div>
                {% elsif section.settings.logo != blank %}
                  {% if template.name == 'index' %}
                    <h1 class="visually-hidden">{{ page_title }}</h1>
                  {% endif %}
                  <a class="header__logo header__link primary-logo" href="{{ routes.root_url }}" title="{{ shop.name }}">
                    {%
                      render 'image-element',
                      image: section.settings.logo,
                      alt: section.settings.logo.alt,
                      image_section: 'header',
                      additional_classes: 'primary-logo',
                      focal_point: section.settings.logo.presentation.focal_point,
                    %}
                    {% if section.settings.enable_sticky and section.settings.sticky_logo != blank %}
                      {%
                        render 'image-element',
                        image: section.settings.sticky_logo,
                        alt: section.settings.sticky_logo.alt,
                        image_section: 'header',
                        additional_classes: 'sticky-logo',
                        focal_point: section.settings.sticky_logo.presentation.focal_point,
                      %}
                    {% endif %}
                  </a>
                {% else %}
                  {% if template.name == 'index' %}
                    <h1 class="header__logo-text">
                      <a class="header__link primary-brand" href="{{ routes.root_url }}">
                        {{ shop.name }}
                      </a>
                    </h1>
                  {% else %}
                    <a class="header__logo-text header__link primary-brand" href="{{ routes.root_url }}">
                      {{ shop.name }}
                    </a>
                  {% endif %}
                {% endif %}
              </div>
              {% endcapture %}

              {% if section.settings.logo_position == 'above' %}
                {{ logo }}

                {% comment %} Menu {% endcomment %}
                <div class="header__menu">
                  <div
                    class="
                      header__menu-items
                      header__dropdown--{{ settings.dropdown_position }}
                      is-flex
                      is-flex-wrap
                      {% if section.settings.menu_spacing == 'default' %}
                        is-justify-center
                      {% elsif section.settings.menu_spacing == 'minimum' %}
                        is-justify-space-around
                      {% elsif section.settings.menu_spacing == 'maximum' %}
                        is-justify-space-between
                      {% endif %}
                    "
                  >
                    {% for link in main_menu.links %}
                      {% if link.links == blank %}
                        <div
                          class="navbar-item header__item {% if link.active or link.child_active %}is-active{% endif %}"
                          data-navlink-handle="{{ link.title | handleize }}"
                        >
                          <label for="mega-{{ link.title | handleize }}">
                            <a
                              href="{{ link.url }}"
                              class="navbar-link header__link {% if link.active %}is-active{% endif %} is-arrowless"
                            >
                              {{ link.title }}
                            </a>
                          </label>
                        </div>
                      {% else %}
                        <div
                          class="navbar-item header__item has-dropdown has-dropdown--{{ settings.dropdown_style }} is-hoverable {% if link.active or link.child_active %}is-active{% endif %}"
                          aria-haspopup="true"
                          aria-expanded="false"
                          data-navlink-handle="{{ link.title | handleize }}"
                        >
                          <label for="dropdown-{{ link.title | handleize }}">
                            <a
                              class="navbar-link header__link {% if link.active or link.child_active %}is-active{% endif %}"
                              {% unless link.url == 'http://'
                                or link.url == ''
                                or link.url == 'https://'
                                or link.url == '#'
                              %}
                                href="{{ link.url }}"
                              {% endunless %}
                            >
                              {{ link.title }}
                            </a>
                          </label>

                          {% render 'header__dropdown-menu', link: link, index: forloop.index %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>

              {% elsif section.settings.logo_position == 'between' %}
                {% assign remainder = main_menu.links.size | modulo: 2 %}
                {% assign menu_breakpoint = main_menu.links.size | divided_by: 2 | plus: remainder %}

                {% comment %} Menu (first half) {% endcomment %}
                <div class="header__menu header__menu--1">
                  <div
                    class="
                      header__menu-items
                      is-flex
                      is-flex-wrap
                      {% if section.settings.menu_spacing == 'default' %}
                        is-justify-end
                      {% elsif section.settings.menu_spacing == 'minimum' %}
                        is-justify-center
                      {% elsif section.settings.menu_spacing == 'maximum' %}
                        is-justify-start
                      {% endif %}
                    "
                  >
                    {% for link in main_menu.links %}
                      {% if forloop.index0 < menu_breakpoint %}
                        {% if link.links == blank %}
                          <div
                            class="navbar-item header__item {% if link.active or link.child_active %}is-active{% endif %}"
                            data-navlink-handle="{{ link.title | handleize }}"
                          >
                            <label for="mega-{{ link.title | handleize }}">
                              <a
                                href="{{ link.url }}"
                                class="navbar-link header__link {% if link.active %}is-active{% endif %} is-arrowless"
                              >
                                {{ link.title }}
                              </a>
                            </label>
                          </div>
                        {% else %}
                          <div
                            class="navbar-item header__item has-dropdown has-dropdown--{{ settings.dropdown_style }} is-hoverable {% if link.active or link.child_active %}is-active{% endif %}"
                            aria-haspopup="true"
                            aria-expanded="false"
                            data-navlink-handle="{{ link.title | handleize }}"
                          >
                            <label for="dropdown-{{ link.title | handleize }}">
                              <a
                                class="navbar-link header__link {% if link.active or link.child_active %}active{% endif %}"
                                {% unless link.url == 'http://'
                                  or link.url == ''
                                  or link.url == 'https://'
                                  or link.url == '#'
                                %}
                                  href="{{ link.url }}"
                                {% endunless %}
                              >
                                {{ link.title }}
                              </a>
                            </label>

                            {% render 'header__dropdown-menu', link: link, index: forloop.index %}
                          </div>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>

                {% comment %} Logo {% endcomment %}
                {{ logo }}

                {% comment %} Menu (second half) {% endcomment %}
                <div class="header__menu header__menu--2">
                  <div
                    class="
                      header__menu-items
                      is-flex
                      is-flex-wrap
                      {% if section.settings.menu_spacing == 'default' %}
                        is-justify-start
                      {% elsif section.settings.menu_spacing == 'minimum' %}
                        is-justify-center
                      {% elsif section.settings.menu_spacing == 'maximum' %}
                        is-justify-end
                      {% endif %}
                    "
                  >
                    {% for link in main_menu.links %}
                      {% if forloop.index0 >= menu_breakpoint %}
                        {% if link.links == blank %}
                          <div
                            class="navbar-item header__item {% if link.active or link.child_active %}is-active{% endif %}"
                            data-navlink-handle="{{ link.title | handleize }}"
                          >
                            <label for="mega-{{ link.title | handleize }}">
                              <a
                                href="{{ link.url }}"
                                class="navbar-link header__link {% if link.active %}is-active{% endif %} is-arrowless"
                              >
                                {{ link.title }}
                              </a>
                            </label>
                          </div>
                        {% else %}
                          <div
                            class="navbar-item header__item has-dropdown has-dropdown--{{ settings.dropdown_style }} is-hoverable {% if link.active or link.child_active %}is-active{% endif %}"
                            aria-haspopup="true"
                            aria-expanded="false"
                            data-navlink-handle="{{ link.title | handleize }}"
                          >
                            <label for="dropdown-{{ link.title | handleize }}">
                              <a
                                class="navbar-link header__link {% if link.active or link.child_active %}active{% endif %}"
                                {% unless link.url == 'http://'
                                  or link.url == ''
                                  or link.url == 'https://'
                                  or link.url == '#'
                                %}
                                  href="{{ link.url }}"
                                {% endunless %}
                              >
                                {{ link.title }}
                              </a>
                            </label>

                            {% render 'header__dropdown-menu', link: link, index: forloop.index %}
                          </div>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </nav> {% endcomment %}
            {% comment %} Only visible on sticky scroll {% endcomment %}
            {% render 'header__action-icons',
              display_search: section.settings.display_search,
              header_icon_class: 'header__icons--sticky',
              right_menu: linklists[section.settings.right_side_linklist]
            %}
          </div>
    </div>
    {%- comment -%}
    <nav class="sticky-menu-wrapper">
      {% comment %} Sticky menu {% endcomment %}
      <div class="sticky-header__menu">
        <div
          class="
            header__menu-items
            is-flex
            is-flex-wrap
            dropdown-click--{{ section.settings.dropdown_click }}
            {% if section.settings.logo_position == 'above' %}
              {% if section.settings.menu_spacing == 'default' %}
                is-justify-center
              {% elsif section.settings.menu_spacing == 'minimum' %}
                is-justify-space-around
              {% elsif section.settings.menu_spacing == 'maximum' %}
                is-justify-space-between
              {% endif %}
            {% elsif section.settings.logo_position == 'between' %}
              is-justify-center
            {% endif %}
          "
        >
          {% for link in main_menu.links %}
            {% if link.links == blank %}
              <div
                class="navbar-item header__item {% if link.active or link.child_active %}is-active{% endif %}"
                data-navlink-handle="{{ link.title | handleize }}"
              >
                <label for="mega-{{ link.title | handleize }}">
                  <a
                    href="{{ link.url }}"
                    class="navbar-link header__link {% if link.active %}is-active{% endif %} is-arrowless"
                  >
                    {{ link.title }}
                  </a>
                </label>
              </div>
            {% else %}
              <div
                class="navbar-item header__item has-dropdown has-dropdown--{{ settings.dropdown_style }} is-hoverable {% if link.active or link.child_active %}is-active{% endif %}"
                aria-haspopup="true"
                aria-expanded="false"
                data-navlink-handle="{{ link.title | handleize }}"
              >
                <label for="dropdown-{{ link.title | handleize }}">
                  <a
                    class="navbar-link header__link {% if link.active or link.child_active %}is-active{% endif %}"
                    {% unless link.url == 'http://' or link.url == '' or link.url == 'https://' or link.url == '#' %}
                      href="{{ link.url }}"
                    {% endunless %}
                  >
                    {{ link.title }}
                  </a>
                </label>

                {% render 'header__dropdown-menu', link: link, index: forloop.index, prefix: 'sticky-' %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </nav>
    {%- endcomment -%}
  </header>

  {% render 'mobile-header' %}

  {% if settings.search_display_style == 'overlay' %}
    {% render 'search-overlay' %}
  {% endif %}
</div>

{% comment %}JavaScript{% endcomment %}
<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-data
>
  {
    "enable_overlay": {{ section.settings.enable_overlay | json }},
    "enable_sticky": {{ section.settings.enable_sticky | json }},
    "header_layout": {{ settings.header_layout | json }},
    "dropdown_click": {{ section.settings.dropdown_click | json }}
  }
  
</script>
<script src="{{ 'z__jsHeader.js' | asset_url }}"></script>
<script>
  {% assign default_collection = collections[section.settings.default_search_collection] %}
  
{% if default_collection != blank and default_collection.products_count > 0 %}
const defaultSearchHeading = {{ section.settings.default_search_heading | default: '' | json }};
  const sampleProducts = [
  {% for product in default_collection.products limit: 50 %}
  {
    id: "{{ product.id }}",
    title: {{ product.title | json }},
    handle: "{{ product.handle }}",
    price: "{{ product.selected_or_first_available_variant.price | default: 0 | money }}",
    rating: "{{ product.metafields.reviews.rating.value | default: '0' }}",
    reviews: "{{ product.metafields.reviews.rating_count | default: 0 }} review(s)",
    starRatingSnippet: {{ product.metafields.okendo.StarRatingSnippet.value | default: '' | json }},

   imgSrc: "{% if product.featured_image %}{{ settings.speedsize_url_pfx_https -}}{{ product.featured_image | image_url: width: 600 }}{% else %}{{ 'https://cdn.shopify.com/s/files/1/1164/4258/files/no_image.svg' }}{% endif %}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
];
