function initSearchaniseCustomizations() {
  const $ = window.Searchanise ? window.Searchanise.$ : (window.jQuery || window.$);

  if ($) {
    // 1. Unbind default hide/close behavior
    $(window).off("blur.autocomplete");
    $(document).off("click.autocomplete touchstart.autocomplete mousedown.autocomplete");
    $('input[name="q"], .mm-search > input[type="text"]').off("blur.autocomplete blur");

    // 2. Listen for search updates (when user types or results re-render)
    $(document).on('Searchanise.AutocompleteUpdated Searchanise.ResultsUpdated', function(event, container) {
      appendCustomData();
    });
  }

  {% comment %} // Override close methods directly on Searchanise object
  if (window.Searchanise) {
    window.Searchanise.AutocompleteClose = function() {};
    window.Searchanise.AutocompleteCloseAll = function() {};
  } {% endcomment %}

  // Initial execution if results are already in DOM
  appendCustomData();
}

// Function to replace empty state items with 5 sample products
function appendCustomData() {

  
const productLists = document.querySelectorAll("#snize-ac-items-container-4");

if (!productLists) return;

// Prevent duplicate insertion
if (document.querySelector("#snize-ac-items-container-5")) return;

// Generate product HTML
const productsHTML = sampleProducts
  .map((product, index) => {
    const oddEvenClass = index % 2 === 0 ? "snize-odd" : "snize-even";

    return `
      <li class="snize-product snize-product-in-stock snize-product-vendor-gf-js snize-product-vendor-gf snize-product-tag-bundle-parent snize-product-tag-is-not-setting-only ${oddEvenClass}"
          data-original-product-id="${product.id}"
          id="snize-ac-product-${product.id}"
          role="button"
          aria-label="${product.title}">

        <a href="/products/${product.handle}" class="snize-item" aria-label="${product.title}">

          <div class="snize-thumbnail">
            <img src="${product.imgSrc}" class="snize-item-image" alt="${product.title}">
          </div>

          <span class="snize-title">${product.title}</span>

          <span class="snize-description snize-hidden"></span>

          <div class="snize-price-list snize-compare-price-right">
            <span class="snize-price money">${product.price}</span>
          </div>

          <span class="snize-reviews">
          
           
            <div class="okendo-custom-star-rating">
      ${product.starRatingSnippet}
    </div>
          </span>

          <div class="snize-labels-wrapper"></div>
          <div class="snize-add-to-cart-container"></div>

        </a>
      </li>
    `;
  })
  .join("");
  

// Create new UL after existing UL
productLists.forEach((productList, index) => {

  // Prevent duplicate insertion
  if (productList.nextElementSibling?.id === `snize-ac-items-container-5-${index}`) {
    setTimeout(function () {
      if (productList.nextElementSibling?.id === `snize-ac-items-container-5-${index}`) {
  productList.nextElementSibling.classList.remove("snize-hidden");
      }

  }, 100); 
    return;
  }
const input = document.querySelector('input[name="q"]');

// Optional chaining safely accesses .value only if the input element exists
const value = input?.value?.trim();

if (value) {
    document.querySelectorAll("#snize-ac-items-container-4").forEach(element => {
            element.classList.remove('hidden');
        });
} else {
    document.querySelectorAll("#snize-ac-items-container-4").forEach(element => {
            element.classList.add('hidden');
        });
}
  productList.insertAdjacentHTML(
    "afterend",
    `
    <ul
      class="snize-ac-results-multicolumn-list snize-ac-results-list-last snize-ac-results-list-last-js"
      id="snize-ac-items-container-5-${index}"
      aria-labelledby="snize-products-label"
      role="group">
    <li id="snize-products-label" class="snize-label" aria-hidden="true">${defaultSearchHeading}</li>
      ${productsHTML}

    </ul>
    `
  );
  
  setTimeout(function () {
   console.log(productList.nextElementSibling)
      if (productList.nextElementSibling?.id === `snize-ac-items-container-5-${index}`) {
  productList.nextElementSibling.classList.remove("snize-hidden");
      }

  }, 500); 


});
}

// Check if Searchanise is ALREADY loaded or wait for its event
if (window.Searchanise && window.Searchanise.Loaded) {
  initSearchaniseCustomizations();
} else {
  document.addEventListener('Searchanise.Loaded', function() {
    initSearchaniseCustomizations();
  });
}
  {% endif %}
 </script> 


