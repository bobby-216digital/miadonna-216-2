{% comment %}
  ** Image with text **
{% endcomment %}
<style>
    .cta-table table td,.cta-table table th {
      padding: 2em;
      text-align: center;
  }

  .cta-table {
      font-family: Montserrat,sans-serif;
      font-weight: 500;
      overflow-x: auto;
      text-align: center;
      text-transform: uppercase;
      width: 100%;
  }

  .cta-table table th {
      background: #e2e2e2;
      color: #000;
      text-transform: uppercase;
      border: 1px solid #fff;
  }

  .cta-table table tr:nth-child(2n) td {
      background: #f4f4f4;
      border: 1px solid #fff;
  }

  .cta-table table tr:nth-child(odd) td {
      background: #f9f9f9;
      border: 1px solid #fff;
  }
</style>
{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .plyr__video-embed {
    width: 100%;
  }
  #shopify-section-{{ section.id }} .image-with-text__heading {
    font-weight: 500;
    line-height: 40px;
    letter-spacing: 1.4px;
  }
  #shopify-section-{{ section.id }} .image-with-text__text > p {
    line-height: 24px;
    letter-spacing: 0.35px;
  }
  #shopify-section-{{ section.id }} .image-with-text__text > p a {
    font-weight: 600;
    text-decoration: underline;
  }
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'video' %}
    {% assign hasVideoBlock = 'has-video-block' %}
  {% endif %}
{% endfor %}

{% comment %} HTML markup {% endcomment %}
<section
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
    {{ hasVideoBlock  }}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="container is-align-center"
    style="background: #f5f5f5;"
  >
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% if block.type == 'text' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block.settings.text -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block.settings.background | color_extract: 'alpha' -%}
          {%- assign text_alpha = block.settings.text_color | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ block.id }} {
                background-color: {%- if background_alpha != 0 -%}{{ block.settings.background }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: block.id
            %}
          {% endstyle %}

          <div
            class="
              image-with-text__text-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                two-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex
              is-flex-wrap
              is-justify-{{ block.settings.alignment }}
              is-align-{{ block.settings.vertical_position }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            <div class="image-with-text__wrapper">
              {% if block.settings.title != blank %}
                <h3 class="image-with-text__heading text-align-{{ block.settings.alignment }} is-{{ block.settings.heading_size }}">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block.settings.alignment }} content">
                  {{ text }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="buttons is-{{ block.settings.alignment }}">
                  {% render 'button',
                    label: block.settings.button_label,
                    href: block.settings.link,
                    style: block.settings.button_style,
                    type: 'link'
                  %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block.type == 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = block.settings.image -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              image-with-text__image-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                three-fifths
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              is-flex
              is-align-center
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            {% if block.settings.image_link %}
              <a class="image-with-text__link" href="{{ block.settings.image_link }}">
            {% endif %}
            {% if image != blank %}
              {%
                render 'image-element',
                image: image,
                alt: image.alt,
                stretch_width: true,
                additional_classes: 'image-with-text__image',
                focal_point: image.presentation.focal_point,
              %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block.settings.image_link %}
              </a>
            {% endif %}
          </div>
        {% elsif block.type == 'table' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = block.settings.image -%}
          {%- assign iframe_video = block.settings.iframe_video -%}
          {% comment %} End content settings {% endcomment %}

          <div
            class="
              one-half
              medium-down--one-whole
              column
              is-align-center
              {% if iframe_video %}column-has-video{% endif %}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
            style="position: relative;"
          >
            <div class="cta-table">
              <style>
                .cta-table table td {
                  width: 50%;
                  padding: 1em;
                }
                .cta-table table tr:nth-child(odd) td {
                  border: 1px solid #212121;
                }
                .cta-table table tr:nth-child(2n) td {
                  border: 1px solid #212121;
                }
                .cta-table table tr td {
                  background: transparent !important;
                }
                .cta-table table tr td:last-child {
                  background: #ffffff !important;
                }
              </style>
              <table style="width: 100%;">
                <tbody>
                  <tr>
                    <td>{{ block.settings.r1v1 }}</td>
                    <td>{{ block.settings.r1v2 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.r2v1 }}</td>
                    <td><s>{{ block.settings.r2v2 }}</s>&nbsp;{{ block.settings.r2v3 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.r3v1 }}</td>
                    <td>{{ block.settings.r3v2 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.r4v1 }}</td>
                    <td>{{ block.settings.r4v2 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.r5v1 }}</td>
                    <td>{{ block.settings.r5v2 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.r6v1 }}</td>
                    <td>{{ block.settings.r6v2 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.r7v1 }}</td>
                    <td>{{ block.settings.r7v2 }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        {% elsif block.type == 'video' %}
          <div
            class="
              image-with-text__video-column
              image-with-text__column
              {% if forloop.length == 1 %}
                one-whole
              {% elsif forloop.length == 2 %}
                one-half
              {% elsif forloop.length == 3 %}
                one-third
              {% endif %}
              medium-down--one-whole
              column
              is-flex
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            {%- assign iframe_video = block.settings.iframe_video -%}
            {% if iframe_video != blank %}
              <div
                class="plyr__video-embed video-{{ block.id }}"
                style="{% if block.settings.aspect_ratio == '1:1' %}padding-bottom: 100%;{% elsif block.settings.aspect_ratio == '4:3' %}padding-bottom: 76.8%;{% else %}padding-bottom: 63.5%;{% endif %}"
              >
                <div class="lazyframe" data-ratio="{{ block.settings.aspect_ratio }}">
                  {% if block.settings.aspect_ratio == '16:9' %}
                    <style>
                      .lazyframe[data-ratio="16:9"]:before {
                        padding-top: 63.5%;
                      }
                    </style>
                  {% elsif block.settings.aspect_ratio == '4:3' %}
                    <style>
                      .lazyframe[data-ratio="4:3"]:before {
                        padding-top: 0;
                        padding-bottom: 76.8%;
                      }
                    </style>
                  {% endif %}
                  {% if iframe_video.type == 'youtube' %}
                    <iframe
                      src="https://www.youtube.com/embed/{{ iframe_video.id  }}?origin=https://plyr.io&amp;autoplay=true&amp;mute=true&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                      allowfullscreen
                      allowtransparency
                      allow="autoplay"
                    ></iframe>
                  {% elsif iframe_video.type == 'vimeo' %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;pip=0&amp;controls=0&amp;autoplay=1&amp;muted=1&amp;byline=false&amp;portrait=false&amp;title=false&amp;speed=true&amp;transparent=0&amp;gesture=media"
                      allowfullscreen
                      allowtransparency
                      allow="autoplay"
                      width="100%"
                      height="100%"
                    ></iframe>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "video with table",
  "class": "image-with-text image-with-text-1",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
      {
      "type": "table",
      "name": "Table",
      "settings": [

          {
          "type": "text",
          "id": "r1v1",
          "label": "Row1 Value1"
        },
           {
          "type": "text",
          "id": "r1v2",
          "label": "Row1 Value2"
        },

              {
          "type": "text",
          "id": "r2v1",
          "label": "Row2 Value1"
        },
           {
          "type": "text",
          "id": "r2v2",
          "label": "Row2 Value2"
        },
     {
          "type": "text",
          "id": "r2v3",
          "label": "Row2 Value3"
        },
              {
          "type": "text",
          "id": "r3v1",
          "label": "Row3 Value1"
        },
           {
          "type": "text",
          "id": "r3v2",
          "label": "Row3 Value2"
        },

              {
          "type": "text",
          "id": "r4v1",
          "label": "Row4 Value1"
        },
           {
          "type": "text",
          "id": "r4v2",
          "label": "Row4 Value2"
        },
           {
          "type": "text",
          "id": "r5v1",
          "label": "Row5 Value1"
        },
           {
          "type": "text",
          "id": "r5v2",
          "label": "Row5 Value2"
        },
          {
          "type": "text",
          "id": "r6v1",
          "label": "Row6 Value1"
        },
            {
          "type": "text",
          "id": "r6v2",
          "label": "Row6 Value2"
        },
           {
          "type": "text",
          "id": "r7v1",
          "label": "Row7 Value1"
        },
           {
          "type": "text",
          "id": "r7v2",
          "label": "Row7 Value2"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1024 x 1024px recommended"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "header",
          "content": "Video"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio",
          "options": [
            {
              "value": "16:9",
              "label": "16:9"
            },
            {
              "value": "4:3",
              "label": "4:3"
            },
            {
              "value": "1:1",
              "label": "1:1"
            }
          ],
          "default": "16:9"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay video",
          "info": "Limited browser support for autoplaying video. [Learn more](https:\/\/help.outofthesandbox.com\/hc\/en-us\/articles\/360000661568)",
