{% style %}
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.width == 'wide' %}
        width: 100%;
      {% endif %}
      {% if section.settings.hide_mobile %}
        @media screen and (max-width: 798px){
          display: none;
        }
      {% endif %}
    }
    p.offset-cell.text-style-title {
      color: #fff;
      font-weight: 500;
      font-size: 30px;
      padding-top: 60px;
      line-height: 1.3;
      margin-bottom: 20px;
  }
  .quotes-slider .one-whole{
    display: flex;
    align-items: center;
    /* flex-wrap: wrap; */
  }

  .one-thirds.column img {
      padding: 60px 40px;
      width: 360px;

  }

  .readability-insets span {
      color: #e6c799;
      font-family: Montserrat,sans-serif;
      font-size: 19px;
      font-weight: 500;
  }
  .quotes-slider .two-thirds.column {
      padding: 40px 20px 40px 20px;
  }
  p.offset-cell.text-style-title:before {
      content: open-quote;
      display: block;
      font-size: 70px;
      font-style: italic;
      left: -6px;
      line-height: 1;
      position: absolute;
      top: 0;
  }

  p.offset-cell.text-style-title{

      quotes: "\201c" "\201d" "\201c" "\201d";
  }
    p.offset-cell.text-style-title:before {
      font-size: 108px;
      left: 10px;
      font-weight: 600;
      top: 40px;
  }
  .quotes-slider .flickity-page-dots .dot {
      display: inline-block;
      width: 60px;
      height: 4px;
      margin: 0px 4px;
      background: #333;
      border-radius: 0;
      cursor: pointer;
    opacity:1;
  }
  .quotes-slider  li.dot.is-selected {
      background: #fff;
  }
  .quotes-slider    ol.flickity-page-dots {
      bottom: 0;
  }

  .container.quotes-slider {
      margin-bottom: 40px;
  }

  element.style {
      flex-wrap: nowrap;
  }
  .container.quotes-slider.flickity-enabled.is-draggable.flickity-resize {
      padding-top: 70px;
      padding-bottom: 40px;
      margin-bottom: 50px;
  }
      @media screen and (max-width:992px){
      #shopify-section-{{ section.id }} .container .column{
          width: 100% !important;
          display: inline-block;        
      }
      #shopify-section-{{ section.id }} .one-thirds{
        text-align: center;
      }
      #shopify-section-{{ section.id }} .one-thirds img{
        max-width: 150px;
        padding: 20px;
      }
    }
{% endstyle %}
<section
  class="
    section
    section-collection-blocks
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
>
  <div
    class="container quotes-slider {% if section.blocks.size <= 1 %}no-slider{% endif %}"
    style="flex-wrap: nowrap;"
    data-products-per-slide="1"
    data-products-limit="{% if section.blocks.size > 1 %}15{% else %}1{% endif %}"
    data-products-available="{% if section.blocks.size > 1 %}15{% else %}1{% endif %}"
  >
    {% for block in section.blocks %}
      <div class="body-cell layout-table one-whole column">
        <div class="two-thirds column">
          <div class="readability-insets">
            <h2 class="text-style-subtitle">{{ block.settings.title }}</h2>
            <p class="offset-cell text-style-title">{{ block.settings.quote }}</p>
            <span>{{ block.settings.author }}</span>
          </div>
        </div>
        <div class="one-thirds column">
          <img src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | img_url:'original' }}" width="" height="" loading="lazy" alt="slide">
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsQuotesSlider.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Testimonials",
    "class": "quotes-slider jsQuotesSlider",

  "settings": [
      {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
          {
          "type": "image_picker",
          "label": "Image",
          "id": "image"
        },
         {
          "type": "text",
          "label": "title",
          "id": "title"
        },
        {
          "type": "text",
          "label": "Quote",
          "id": "quote"
        },
        {
          "type": "text",
          "label": "Author",
          "id": "author"
        }
      ]
    }
  ],
  "presets": [
     {
      "name": "testimonial slider"
    }
  ]
}
{% endschema %}
