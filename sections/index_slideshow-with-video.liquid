{% comment %} <script>
  document.addEventListener('DOMContentLoaded', function () {

    var videos = document.querySelectorAll('.video-herobanner');

    function initVideos() {
      videos.forEach(function(video) {

        if (video.dataset.loaded) return;

        var isMobile = window.innerWidth <= 992;
        var src = isMobile ? video.dataset.mobileSrc : video.dataset.desktopSrc;

        if (!src) return;

        video.src = src;
        video.load();
        video.dataset.loaded = "true";
      });
    }

    function playVideos() {
      videos.forEach(function(video) {
        if (video.paused) {
          video.play().catch(function(){});
        }
      });
    }

    initVideos();

    ['touchstart', 'scroll', 'click'].forEach(function(event) {
      window.addEventListener(event, function once() {
        playVideos();
        window.removeEventListener(event, once);
      }, { passive: true });
    });

  });
</script> {% endcomment %}

<script>
document.querySelectorAll('.video-control-btn').forEach(button => {

    button.addEventListener('click', () => {

      const wrapper = button.closest('.video-element');
      const videos = wrapper.querySelectorAll('video');

      const paused = button.getAttribute('aria-pressed') === 'true';
      button.classList.toggle('is-paused', !paused);

      
      if (paused) {
        videos.forEach(v => v.play().catch(() => {}));
        button.setAttribute('aria-pressed', 'false');
        button.setAttribute('aria-label', 'Pause background video');
      } else {
        videos.forEach(v => v.pause());
        button.setAttribute('aria-pressed', 'true');
        button.setAttribute('aria-label', 'Play background video');
      }

    });
});
</script>


