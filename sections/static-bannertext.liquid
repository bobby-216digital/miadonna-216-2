{% assign bnrtxt_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .bannertext-section-{{ bnrtxt_gen_id }} {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  .bannertext-content-{{ bnrtxt_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .bannertext-heading-{{ bnrtxt_gen_id }} {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    font-style: normal;
  }

  .bannertext-subheading-{{ bnrtxt_gen_id }} {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0 0 {{ section.settings.subheading_spacing }}px;
    font-weight: {{ section.settings.subheading_weight }};
    letter-spacing: {{ section.settings.subheading_letter_spacing }}px;
  }

  .bannertext-description-{{ bnrtxt_gen_id }} {
    max-width: {{ section.settings.description_max_width }}px;
    margin: 0 auto;
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.6;
    letter-spacing: {{ section.settings.description_letter_spacing }}px;
  }

  .bannertext-description-{{ bnrtxt_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .bannertext-section-{{ bnrtxt_gen_id }} {
      padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px;
    }

    .bannertext-heading-{{ bnrtxt_gen_id }} {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .bannertext-subheading-{{ bnrtxt_gen_id }} {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    .bannertext-description-{{ bnrtxt_gen_id }} {
      font-size: {{ section.settings.mobile_description_size }}px;
    }
  }
{% endstyle %}

<div class="bannertext-section-{{ bnrtxt_gen_id }} {{ section.settings.class }}" {{ block.shopify_attributes }} {% if section.settings.arialabelledby != blank %}role="region" aria-labelledby="{{ section.settings.arialabelledby }}"{% endif %}>
  <div class="bannertext-content-{{ bnrtxt_gen_id }}">
    {% if section.settings.heading != blank %}
      <h1 class="bannertext-heading-{{ bnrtxt_gen_id }}"{% if section.settings.arialabelledby != blank %} id="{{ section.settings.arialabelledby }}"{% endif %}>{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="bannertext-subheading-{{ bnrtxt_gen_id }}">{{ section.settings.subheading }}</div>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="bannertext-description-{{ bnrtxt_gen_id }}">
        <!--speedsizeIgnore-->
        {{ section.settings.description }}
        <!--endSpeedsizeIgnore-->
      </div>
    {% endif %}
  </div>
</div>

