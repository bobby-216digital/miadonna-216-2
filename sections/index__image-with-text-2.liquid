{% comment %}
  ** Image with text **
{% endcomment %}

{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'index_image-with-text-2.css' | asset_url | stylesheet_tag }}</noscript>

{% comment %} Content settings {% endcomment %}
{%- assign blocks = section.blocks -%}
{% comment %} End content settings {% endcomment %}

{% comment %} Section specific CSS {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .plyr__video-embed{
    width: 100%;
    /* height: 100%; */
  }
  #shopify-section-{{ section.id }} .image-with-text__heading{
    margin-bottom: 1.5rem;
  }
  @media screen and (min-width: 1400px){
    #shopify-section-{{ section.id }} .image-with-text__heading{
      margin-bottom: 3rem;
    }
  }
  @media screen and (max-width: 1400px){
    #shopify-section-{{ section.id }} .image-with-text__text-column .breadcrumb.is-regular{
      top: 5px;
    }
  }
  .image-element__wrap.ifrem-content{
    width:100%;
  }
  @media screen and (max-width: 1400px){
    .image-element__wrap.ifrem-content iframe{
      height:450px;
    }
  }
  @media screen and (max-width: 798px){
    .image-with-text-2 .mob-textup .mb-ifrem-order.image-with-text__text-column{order:2; margin: 0 !important;}
    .image-element__wrap.ifrem-content iframe{
      height:350px;
    }
  }

  {% render 'css-loop',
    css: section.settings.custom_css,
    id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section
  id="{{ section.settings.id_sec }}"
  class="{{ section.settings.sectionid }} section-scroll 
    section 
    {{ section.settings.css_class }}
    {% if section.settings.text_style %}mob-textup{% endif %}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}
  "
  {% if section.settings.animation != 'none' %}
    data-scroll-class="{{ section.settings.animation }}"
  {% endif %}
  {% if section.settings.arialabelledby != blank %}role="region" aria-labelledby="{{ section.settings.arialabelledby }}"{% endif %}
>
  <div
    class="container"
  >
        {% assign  showpopup = false %}
    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {%- if block.type == 'custom' -%}
          <div
            class="
              {% if block.settings.class_ifrem != blank %}
                {{ block.settings.class_ifrem }}
              {% endif %}     

              image-with-text__text-column
              image-with-text__column
              one-third
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              is-flex

              is-justify-{{ block.settings.alignment }}
              is-align-{{ block.settings.vertical_position }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ block.id }}"
            {% endif %}
          >

            {% if block.settings.custom_ifrem != blank %}
              <div class="image-element__wrap ifrem-content radius-2" tabindex="0">
                {{ block.settings.custom_ifrem }}
              </div>
            {% endif %}  

            {% unless template == 'index' %}
              <div class="is-hidden-mobile-only">
                {% render 'breadcrumb' %}
              </div>
            {% endunless %}
            <div class="image-with-text__wrapper">
              {%- unless block.settings.title == blank -%}
                <h2
                    class="image-with-text__heading text-align-{{ block.settings.alignment }}" id="{{ section.settings.arialabelledby }}" tabindex="0">
                    {{ block.settings.title }}
                </h2>
              {%- endunless -%}

              {% if block.settings.custom_content != blank %}
                <div class="image-with-text__text text-align-{{ block.settings.alignment }} content" tabindex="0">
                  {{ block.settings.custom_content }}
                </div>
              {% endif %}
            </div>
          </div>
        {% elsif block.type != 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign text = block.settings.text -%}
          {% comment %} End content settings {% endcomment %}

          {% comment %} Is the color set to transparent? {% endcomment %}
          {%- assign background_alpha = block.settings.background | color_extract: 'alpha' -%}
          {%- assign text_alpha = block.settings.text_color | color_extract: 'alpha' -%}
          {% comment %} Block specific CSS {% endcomment %}
          {% capture block_css -%}

            .image-with-text__heading {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.heading_color }}{%- endif -%};
              font-style:normal;
            }

            .image-with-text__text {
              color: {%- if text_alpha != 0 -%}{{ block.settings.text_color }}{%- else -%}{{ settings.regular_color }}{%- endif -%};
            }
          {%- endcapture -%}

          {% style %}
            #shopify-section-{{ block.id }} {
                background-color: {%- if background_alpha != 0 -%}{{ block.settings.background }}{% endif %};
              }
            {% render 'css-loop',
                    css: block_css,
                    id: block.id
            %}
          {% endstyle %}

          <div
            class="
              image-with-text__text-column
              image-with-text__column
              one-third
              medium-down--one-whole
              column
              has-padding-left
              has-padding-right
              {% if background_alpha != 0 %}has-background {% endif %}
              is-flex

              is-justify-{{ block.settings.alignment }}
              is-align-{{ block.settings.vertical_position }}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }} id="shopify-section-{{ block.id }}"
            {% endif %}
          >
            {% unless template == 'index' %}
              <div class="is-hidden-mobile-only">
                {% render 'breadcrumb' %}
              </div>
            {% endunless %}
            <div class="image-with-text__wrapper">
              <{% if block.settings.heading_tag != blank %}{{ block.settings.heading_tag }}{% else %}h2{% endif %}
                  class="image-with-text__heading text-align-{{ block.settings.alignment }}" id="{{ section.settings.arialabelledby }}" tabindex="0">
                  
                  {{ block.settings.title }}
                  {{ block.settings.title2 }}

              </{% if block.settings.heading_tag != blank %}{{ block.settings.heading_tag }}{% else %}h2{% endif %}>

              {% if text != blank %}
                <div class="image-with-text__text text-align-{{ block.settings.alignment }} content" tabindex="0">
                  {%- capture replace_link -%}
                    <a href="javascript:void(0);" onclick="Chatra('openChat', true)" title="Contact Us">Connect</a>
                  {%- endcapture -%}
                   {%- capture book_link -%}
                     <a href="javascript:void(0);" class="popup-icon" data-class="bookpopup" title="Appointments" data-popup="https://my.setmore.com/bookingpage/67240127-4c0d-4292-9379-3ee1b681ab2a">Book Now</a>
                  {%- endcapture -%}
                  {{ text | replace:'<a href="/pages/contact-us" title="Contact Us">Connect</a>', replace_link | replace:'<a href="https://www.miadonna.com/pages/appointments" title="Book an Appointment">Book Now</a>', book_link }}
                </div>
                   {% if text contains 'Book Now' %}
                      {% assign  showpopup = true %}
                {% comment %} <script>
  
  document.querySelectorAll('.popup-icon').forEach(function(icon) {
  icon.addEventListener('click', function() {
    Fancybox.show(
      [{
        src: this.dataset.popup,
        type: "iframe"
      }],
      {
          mainClass: this.dataset.class,
        dragToClose: false,
        Carousel: {
          friction: 0,
          Panzoom: {
            touch: false
          }
        },
        on: {
          done: (fancybox) => {
            var content = fancybox.container.querySelector(".fancybox__content");
      
            if (content) {
              content.removeAttribute("style");
              var title = document.createElement("h2");
              title.className = "popup-title";
              title.textContent = icon.title;
              content.prepend(title);
            }
          }
        }
      }
    );
  });
});
</script>   {% endcomment %}
{%  endif  %} 
              {% endif %}

              {% if block.settings.button_label != blank or block.settings.button_label2 != blank %}
                <div class="button-section">
                  
                    {% if block.settings.button_label != blank %}
                          {% assign button_label1 = block.settings.button_label | downcase %}
                       
                      {% assign block_settings_link = block.settings.link %}
                       {% assign block_settings_button_style = block.settings.button_style %}
                         {% assign block_settings_data_class = '' %}
                         {% assign title = '' %}
                            {% assign block_settings_data_popup = '' %}
                       {% if button_label1 contains 'book' and block.settings.link =='#' %}
                         {% assign  showpopup = true %}
                        {% assign  showpopup = true %}
                        {% assign title = 'Appointments' %}
                         {% assign block_settings_link = 'javascript:void(0);' %}
                         {% assign block_settings_button_style = block.settings.button_style2 |append: ' popup-icon' %}
                         {% assign block_settings_data_class = 'bookpopup' %}
                         {% assign block_settings_data_popup = 'https://my.setmore.com/bookingpage/67240127-4c0d-4292-9379-3ee1b681ab2a' %}
                       {%  endif %}  
                      <div class="buttons is-{{ block.settings.alignment }}">
                          {% render 'button',
                            label: block.settings.button_label,
                             open_new_tab :  block.settings.open_new_new_tab_button_1_ink,
                            href: block_settings_link,
                            title:title
                            style: block_settings_button_style,
                             dataClass: block_settings_data_class,
                            dataPopup: block_settings_data_popup,
                            type: 'link'
                          %}
                      </div>
                    {% endif %}

                    {% if block.settings.button_label2 != blank %}
                        {% assign button_label2 = block.settings.button_label2 | downcase %}
                       
                      {% assign block_settings_link2 = block.settings.link2 %}
                       {% assign block_settings_button_style2 = block.settings.button_style2 %}
                         {% assign block_settings_data_class = '' %}
                         {% assign block_settings_data_popup = '' %}
                          {% assign title = '' %}
                       {% if button_label2 contains 'book' and block.settings.link =='#' %}
                         {% assign  showpopup = true %}
                         {% assign  showpopup = true %}
                           {% assign title = 'Appointments' %}
                         {% assign block_settings_link2 = 'javascript:void(0);' %}
                         {% assign block_settings_button_style2 = block.settings.button_style2 |append: ' popup-icon' %}
                         {% assign block_settings_data_class = 'bookpopup' %}
                         {% assign block_settings_data_popup = 'https://my.setmore.com/bookingpage/67240127-4c0d-4292-9379-3ee1b681ab2a' %}
                       {%  endif %} 
                      <div class="buttons is-{{ block.settings.alignment }}">
                          {% render 'button',
                            label: block.settings.button_label2,
                            href: block_settings_link2,
                            title:title
                             open_new_tab :  block.settings.open_new_new_tab_button__2_link,
                            style: block_settings_button_style2,
                             dataClass: block_settings_data_class,
                            dataPopup: block_settings_data_popup,
                            type: 'link'
                          %}
                      </div>
                    {% endif %}
                </div>
              {% endif %}
            </div>
          </div>

        {% elsif block.type == 'image' %}
          {% comment %} Content settings {% endcomment %}
          {%- assign image = block.settings.image -%}
          {%- assign mobileImage = block.settings.mobile_image -%}
          {%- assign iframe_video = block.settings.iframe_video -%}
          {% comment %} End content settings {% endcomment %}

          <div tabindex="0"
            class="
              image-with-text__image-column
              image-with-text__column
              two-thirds
              medium-down--one-whole
              column
              is-flex
              is-align-center
              {% if iframe_video %}column-has-video{% endif %}
            "
            {% if type != 'block' %}
              {{ block.shopify_attributes }}
              id="shopify-section-{{ block.id }}"
            {% endif %}
            style="position: relative;"
          >
            {% if block.settings.image_link %}
              <a class="image-with-text__link" href="{{ block.settings.image_link }}">
            {% endif %}

            {% if iframe_video != blank %}
              <div class="plyr__video-embed video-{{ block.id }}" data-video-element>
                {% if iframe_video.type == 'youtube' %}
                  <iframe
                    src="https://www.youtube.com/embed/{{ iframe_video.id  }}?origin=https://plyr.io&amp;autoplay=true&amp;mute=true&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;showinfo=0&amp;rel=0&amp;enablejsapi=1"
                    allowfullscreen
                    allowtransparency
                    allow="autoplay"
                  ></iframe>
                {% elsif iframe_video.type == 'vimeo' %}
                  <iframe
                    src="https://player.vimeo.com/video/{{ iframe_video.id  }}?loop=1&amp;autoplay=1&amp;muted=1&amp;controls=1&amp;portrait=false&amp;transparent=1"
                    allowfullscreen
                    allowtransparency
                    allow="autoplay"
                  ></iframe>
                {% endif %}
              </div>
            {% else %}
              {% if image != blank %}
                {% if mobileImage != blank %}
                  <div class="is-hidden-mobile-only" style="width: 100%;">
                {% endif %}
                {%
                  render 'image-element',
                  image: image,
                  alt: image.alt,
                  stretch_width: true,
                  additional_classes: 'image-with-text__image',
                  focal_point: image.presentation.focal_point,
                %}
                {% if mobileImage != blank %}
                  </div>
                {% endif %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              {% if mobileImage != blank %}
                <div class="is-hidden-desktop-only">
                  {%
                    render 'image-element',
                    image: mobileImage,
                    alt: mobileImage.alt,
                    stretch_width: true,
                    additional_classes: 'image-with-text__image',
                    focal_point: image.presentation.focal_point,
                  %}
                </div>
              {% endif %}
            {% endif %}
            {% if block.settings.image_link %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>
{%  if showpopup  %}          
  <script>
                      
         
document.querySelectorAll('.popup-icon').forEach(function(icon) {
  icon.addEventListener('click', function() {
    Fancybox.show(
      [{
        src: this.dataset.popup,
        type: "iframe"
      }],
      {
          mainClass: this.dataset.class,
        dragToClose: false,
        Carousel: {
          friction: 0,
          Panzoom: {
            touch: false
          }
        },
        on: {
          done: (fancybox) => {
            var content = fancybox.container.querySelector(".fancybox__content");
      
            if (content) {
              content.removeAttribute("style");
              var title = document.createElement("h2");
              title.className = "popup-title";
              title.textContent = icon.title;
              content.prepend(title);
            }
          }
        }
      }
    );
  });
});

                    </script>  
                  {%  endif %} 
{% schema %}
{
  "name": "Index image with text 2",
  "class": "image-with-text image-with-text-2",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "text_style",
      "label": "Mobile text postion",
      "default": false
    },
    {
      "type": "text",
      "id": "sectionid",
      "label": "scroll id class"
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "arialabelledby",
      "label": "aria labelledby"
    },
    {
      "type": "text",
      "id": "id_sec",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type":"custom",
      "name": "Custom",
      "settings": [
        {
          "type":"text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "liquid",
          "id": "custom_content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "class_ifrem",
          "label": "class add for ifrem"
        },
        {
          "type": "liquid",
          "id": "custom_ifrem",
          "label": "Content ifrem"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "vertical_position",
          "label": "Vertical position",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "end",
              "label": "Bottom"
            }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1024 x 1024px recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "1024 x 1024px recommended"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Video"
        },
        {
          "type": "video_url",
          "id": "iframe_video",
          "label": "YouTube or Vimeo video URL",
          "accept": ["youtube", "vimeo"]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "default": "h2",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Heading text here"
        },
        {
          "type": "textarea",
          "id": "title2",
          "label": "Heading",
          "default": "Heading text here"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "button--primary",
              "label": "Primary"
            },
            {
              "value": "button--secondary",
              "label": "Secondary"
            },
            {
              "value": "button--link-style",
              "label": "Link style"
            }
          ],
          "default": "button--primary"
        },
        {
          "type": "checkbox",
          "id": "open_new_new_tab_button_1_ink",
          "label": "Open New Tab  Button  Link",
          "default": false
       },
        {
          "type": "text",
          "id": "button_label2",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link2",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style2",
          "label": "Button style",
          "options": [
            {
              "value": "button--primary",
              "label": "Primary"
            },
            {
              "value": "button--secondary",
              "label": "Secondary"
            },
            {
              "value": "button--link-style",
              "label": "Link style"
            }
          ],
          "default": "button--primary"
        },
         {
          "type": "checkbox",
          "id": "open_new_new_tab_button__2_link",
          "label": "Open New Tab  Button  Link",
          "default": false
       },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "vertical_position",
          "label": "Vertical position",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "end",
              "label": "Bottom"
            }
          ],
          "default": "center"
