.pure-table {
    border-collapse: collapse;
    border-spacing: 0;
    empty-cells: show;
    border: 1px solid #cbcbcb
}

.pure-table caption {
    color: #000;
    font: italic 85%/1 arial,sans-serif;
    padding: 1em 0;
    text-align: center
}

.pure-table td,.pure-table th {
    border-left: 1px solid #cbcbcb;
    border-width: 0 0 0 1px;
    font-size: inherit;
    margin: 0;
    overflow: visible;
    padding: .5em 1em
}

.pure-table td:first-child,.pure-table th:first-child {
    border-left-width: 0
}

.pure-table thead {
    background-color: #e0e0e0;
    color: #000;
    text-align: left;
    vertical-align: bottom
}

.pure-table td {
    background-color: transparent
}

.pure-table-odd td {
    background-color: #f2f2f2
}

.pure-table-striped tr:nth-child(2n-1) td {
    background-color: #f2f2f2
}

.pure-table-bordered td {
    border-bottom: 1px solid #cbcbcb
}

.pure-table-bordered tbody>tr:last-child>td {
    border-bottom-width: 0
}

.pure-table-horizontal td,.pure-table-horizontal th {
    border-width: 0 0 1px;
    border-bottom: 1px solid #cbcbcb
}

.pure-table-horizontal tbody>tr:last-child>td {
    border-bottom-width: 0
}
/* How We Give */
.custom-green-heading {
  margin-bottom: 0px !important;
  line-height: 1.2;
}

.green-btn {
  cursor: pointer;
}

.how-we-give-container > section {
  margin: 7rem 0 !important;
}
.the-result {
  background-color: #C2EDD5; }

.result-block {
  padding: 1em; }
  .result-block h2 {
    margin: 1rem 0; height:166px;overflow:hidden}
@media screen and (max-width:768px){
  .result-block h2 { height:auto;}
}

  #shopify-section-{{ section.id }} {
      {%- if section.settings.background -%}
          background-color: {{section.settings.background}};
      {%- endif -%}
       color:{{ section.settings.text_color | default: '#000' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.width == 'wide' %}
      width: 100%;
    {% endif %}
  }
  .result-block h2{
    font-family: Playfair Display,serif;
    position: relative;
  }
  
  .result-block p{
    font-family: Playfair Display,serif;
    margin-top: 30px;
  }
  .result-block h2:after{
    position: absolute;
    content: '';
    bottom: 0;
    left: 0;
    height: 3px;
    width: 80px;
    background-color: #fff;
  }
  @media screen and (max-width: 767px){
     #shopify-section-{{ section.id }} {
      padding-top: 30px;
      padding-bottom: 30px;
    }
  }
{% endstyle %}
<section id="{{ section.settings.id_sec }}"
  class="
    section
    {{ section.settings.css_class }}
    is-width-{{ section.settings.width }}
    {% if section.settings.show_gutter == false %}
      has-no-side-gutter
      has-background
    {% else %}
      has-gutter-enabled
    {% endif %}
    {% if section.settings.width == 'wide' %}
      equal-columns--outside-trim
    {% endif %}"
  >
	<div class="body-cell">
		<h2 class="left-align text-style-title content-subtitle">{{ section.settings.heading }}</h2>
		<div class="pure-g">
          {% for block in section.blocks %}
			<div class="pure-u-1 pure-u-md-1-2 pure-u-lg-1-4 result-block"><img src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | img_url:'original' }}" alt="Survive and Thrive" loading="lazy" />
				<h2>{{ block.settings.title }}</h2>
				<p class="left-align">{{ block.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</p>
			</div>
          {% endfor %}
			
		</div>
	</div>
</section>
{% schema %}
  {
    "name": "Result Block",
    "max_blocks": 4,
    
    "settings": [
       {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gutter",
      "label": "Show gutter",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
      {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "rgba(0,0,0,0)"
        },
      {
            "type": "text",
            "id": "heading",
            "label": "Section Heading"
          }
    ],
      "blocks": [
      {
        "type": "Image",
        "name": "Image Text",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description Text"
          }
        ]
      }
     ],
        "presets": [
    {
      "name": "Result Block",
      "category": "ImageText"
    }
  ]
  }
{% endschema %}

