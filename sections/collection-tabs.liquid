{% comment %} Section specific CSS {% endcomment %}

{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}

<script src="{{ 'image-convenience-collection-tab.js' | asset_url }}"></script>

<noscript>{{ 'setting-tabs.css' | asset_url | stylesheet_tag }}</noscript>

<style>
  #shopify-section-{{ section.id }} .section-heading{
    margin-bottom: 30px;
  }
  #shopify-section-{{ section.id }} .section-heading .section--title{
    margin-top: 0;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .section-heading .main-subheading{
    font-size: 16px;
    font-style: italic;
    line-height: 28.71px;
    letter-spacing: 0.35px;
    font-family: 'Playfair Display';
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section.id }} .section-heading .section--title{
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .section-heading .main-subheading{
      font-size: 14px;
    }
  }
</style>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    {% if section.settings.width == 'wide' -%}
      width: 100%;
    {%- elsif section.settings.width == 'half' -%}
      width: 50%;
    {%- endif %}
  }
  #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons{
    gap: 0;
    margin-bottom: 1rem;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button{
    border: 0;
    font-size: 16px;
    padding: 0 2rem;
    outline: none;
    box-shadodow: none;
    letter-spacing: .1em;
    background: transparent!important;
  }
  #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button:first-child{
    padding-left: 0;
  }
  #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button:last-child{
    padding-right: 0;
  }
  #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button:not(:last-child) {
    border-right: 2px solid #000;
  }
  #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button.button-active {
    text-decoration: underline;
  }
  #shopify-section-{{ section.id }} .product-content-wrapper{
    display:block;
  }
  #shopify-section-{{ section.id }} .product-content-wrapper .image-element__wrap{
    max-width: 100% !important;
  }
  #shopify-section-{{ section.id }} .flickity-prev-next-button{
    background-color: transparent;
  }
  @media screen and (max-width: 1300px){
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons{
      flex-wrap: nowrap;
      overflow: auto;
      padding: 0 1rem 1rem;
      justify-content: flex-start;
    }
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button{
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-1,
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-2,
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-3{
      justify-content: center;
    }
  }
  @media screen and (max-width: 991px){
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-1,
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-2,
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tabs-buttons.tab-buttons-3{
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section.id }} .setting-tabs-wrapper .setting-tab-button{
      font-size: 14px;
    }
  }
  {% render 'css-loop',
          css: section.settings.custom_css,
          id: section.id
  %}
{% endstyle %}

{% comment %} HTML markup {% endcomment %}
<section class="common-spacing home-collection-prd" role="region" aria-labelledby="trending-styles-heading">
 <div class="contanier-nw"> 
  <div class="slider-wrapper">
    <h2 class="common-hd" id="trending-styles-heading">{{ section.settings.main_heading }}</h2>

    {% assign buttonTextEmpty = false %}
    {% assign buttonCount = 0 %}
    {%- for block in section.blocks -%}
      {% if block.settings.button_text == blank %}
        {% assign buttonTextEmpty = true %}
      {% endif %}
      {% if block.settings.button_text != blank %}
        {% assign buttonCount = buttonCount | plus: 1 %}
      {% endif %}
    {% endfor %}
      {% unless buttonTextEmpty == true %}
        <div class="setting-tabs-buttons tab-buttons-{{ buttonCount }}">
          {%- for block in section.blocks -%}
            {% assign buttonID = block.settings.button_text | replace: ' ', '-' | downcase %}
            <button
              id="{{ buttonID }}"
              class="setting-tab-button {{ buttonID }}{% if forloop.first %} button-active{% endif %}"
            >
              {{ block.settings.button_text }}
            </button>
          {% endfor %}
        </div>
      {% endunless %}

      {%- for block in section.blocks -%}
        {% assign buttonID = block.settings.button_text | replace: ' ', '-' | downcase %}
          <div
            class="product-content-wrapper sl-space slick-cls collection-tab-slider{%- comment -%} products-slider{%- endcomment -%}"
            {%- comment -%}data-products-per-slide="6"
            data-products-limit="10"
            data-products-available="10"{%- endcomment -%}
            data-products-per-slide="{{ section.settings.slides }}"
          >
            {% for product in block.settings.collection.products limit: 10 %}
              <div class="slide">
                <div class="product-item product-item-nw custom-collection-tab sl-spacebox  {{ slide_class }}" id="{{ product.handle }}-main">
                  {%- assign collection = block.settings.collection -%}
                  {% assign attributes_basic_builder = product.metafields.attributes.basic_builder | plus: 0 %}
                  {% assign attributes_center_stone_count = product.metafields.attributes.center_stone_count | plus: 0 %}
                  <textarea
                              aria-label="{{ product.options }}"
                              style="display: none;"
                              class="swatch-collection-selected white active"
                              data-product-handle="{{ product.handle }}"
                              data-metal-carat="14K White Gold"
                              data-metal="White Gold"
                              data-default-metal="{% if activeMetal == activeMetalValue %}{{ product.metafields.attributes.collection_page_default_metal }}{% endif %}"
                              data-default-shape="{% if collection.metafields.custom.collection_shape != blank %}{{ collection.metafields.custom.collection_shape }}{% else %}{{ product.metafields.attributes.collection_page_default_shape }}{% endif %}"
                              data-default-position="{{ product.metafields.attributes.collection_page_default_position }}"
                              data-default-hover-position="{{ product.metafields.attributes.collection_page_hover_position }}"
                              data-default-extension="{{ product.metafields.attributes.image_convention_extension  }}"
                              data-option-price="{% if attributes_basic_builder == 1 and product.variants.size > 1 %}0{% else %}{{metalWeightPrice | times: 100}}{% endif %}"
                              data-option-compare-at-price="{% if attributes_basic_builder == 1 and product.variants.size > 1 %}0{% else %}{{metalWeightPrice | times: 100}}{% endif %}"
                              data-basic-builder="{{attributes_basic_builder}}"
                              data-product-variants="{{ product.variants.size }}"
                              data-materials-count="{{product.metafields.attributes.materials.size}}"
                              data-metals-count="{{product.metafields.attributes.metals.size}}"
                              data-attributes-center-stone-count="{{attributes_center_stone_count}}"
                              data-side-stone-shapes="{{product.metafields.attributes.side_stone_shapes}}"
                              data-side-stone-count="{{product.metafields.attributes.side_stone_count}}"
                          >{{ product.options_with_values | json }}</textarea>
                  <a href="{{ product.url | within: collection }}" tabindex="-1">
                    {%
                      render 'image-element',
                      image: product.featured_media.preview_image,
                      alt: product.featured_media.preview_image.alt,
                    %}
                    <h3>
                      {{ product.title }}
                    </h3>
                  </a>
                  {%- if section.settings.show_price -%}
                    <p>
                      {% render 'price-element', price: product.selected_or_first_available_variant.price, product: product %}
                      {% if product.metafields.attributes.collection_product_price == blank %}
                        {% assign is_show_setting_only = 'yes' %}
                        {%- if product.tags contains 'Is Not Setting Only' -%}
                          {% assign is_show_setting_only = 'no' %}
                        {% endif %}
                        {% if is_show_setting_only == 'yes' and product.metafields.attributes.customizable == '1' %}
                          <span class="prd-smalltext">(Setting Only)</span>
                        {% endif %}
                      {% endif %}
                    </p>
                  {%- endif -%}
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="progress-container" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Slider progress">
            <div class="progress-bar progress-bar-tabslider" style="width: 10%;"></div>
          </div>
      {% endfor %}
  </div>
 </div>
</section>
<script data-theme-editor-load-script src="{{ 'z__jsCollectionTabs.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Collection tabs",
  "class": "collection-tabs jsCollectionTabs",
  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },
         {
      "type": "text",
      "label": "Main Heading",
      "id": "main_heading"
    },
    {
      "type": "richtext",
      "label": "Main Subheading",
      "id": "main_subheading"
    },
    {
      "type": "select",
      "id": "slides",
      "label": "No. of Slides",
      "default": "4",
      "options": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "type": "radio",
      "id": "show_price",
      "label": "Show Price?",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "No"
        },
        {
          "value": "true",
          "label": "Yes"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "standard",
      "options": [
        {
          "value": "half",
          "label": "Half"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left spacing",
      "min": 0,
      "max": 80,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right spacing",
      "default": 0,
      "min": 0,
      "max": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInDown",
          "label": "Fade in down"
        },
        {
          "value": "fadeInLeft",
          "label": "Fade in left"
        },
        {
          "value": "fadeInRight",
          "label": "Fade in right"
        },
        {
          "value": "slideInLeft",
          "label": "Slide in left"
        },
        {
          "value": "slideInRight",
          "label": "Slide in right"
        },
        {
          "value": "zoomIn",
          "label": "Zoom in"
        }
      ]
    },
    {
      "type": "header",
      "content": "Advanced",
      "info": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "header",
          "content": "Tab content"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tabs"
    }
  ]
}
{% endschema %}
