{% for block in section.blocks %}
  {% if block.settings.faqs_menu != blank and block.settings.faq_schema != blank %}
    {{ block.settings.faq_schema }}
  {% endif %}
{% endfor %}

{{ 'lab-diamonds-sub-footer-faq.css' | asset_url | stylesheet_tag }}
<style>
   div#faq-section header {
      width: 100%;
      padding-top: 20px;
      padding-bottom: 15px;
      padding-left: 10px;
  }
   div#faq-section {
      background: {{ section.settings.background }};
  }
</style>
<div class="about-links bgclick-sl bgselectboxmob" role="navigation" aria-label="Faq navigation">
  <div class="faq-categorycontainer">
    <div class="faq-categorydropdown">
        <button class="faq-selectCategory" id="faqSelectCategory" aria-expanded="false" aria-haspopup="listbox">All FAQs <span class="faq-arrow">{% render 'icon-down-arrow' %}</span></button>
        <ul class="faq-categorylist" id="faqCategory" role="listbox" aria-labelledby="faqSelectCategory">
           {% for block in section.blocks %}
          {% assign default_faq_handle = block.settings.faqs_menu__title | handle %}
            {% unless default_faq_handle == 'popular-faqs' %}
            <li role="option" href="#{{ block.settings.faqs_menu__title | handle }}"  class="faq-categorybox aboutnav-link {% if default_faq_handle == 'all-faqs'%} faq-selected {% endif %}">{{ block.settings.faqs_menu__title }}</li>
               {% endunless %} 
             {% endfor %}
        </ul>
    </div>
  </div>
  <div class="contanier-nw mob-hide">
        <div class="scrollnav-slider slick-cls  sl-space">
          {% for block in section.blocks %}
            {% assign default_faq_handle = block.settings.faqs_menu__title | handle %}
            {% unless default_faq_handle == 'popular-faqs' %}
            <div class="slide">
              <div class="scrollnav-slide-text slide-cls sl-spacebox">
                  <a href="#{{ block.settings.faqs_menu__title | handle }}"  class="aboutnav-link {% if default_faq_handle == 'all-faqs'%} active {% endif %}">{{ block.settings.faqs_menu__title }}</a>
              </div>
            </div>
            {% endunless %}
          {% endfor %}
        </div>
    </div>
  </div>
<div id="faq-section" class="sub_footer-faq section is-width-wide sub_footer-faq section-js {{ section.settings.class }}">
  <div class="container">
    {% if section.settings.title != blank %}
      <header class="{% if default_faq_handle == 'popular-faqs'%}faq_main_title hide{% endif %}"">
        <h2>
          <span>{{ section.settings.title }}</span>
        </h2>
      </header>
    {% endif %}
    {% for block in section.blocks %}
      {% capture lastFAQ %}
        {% for link in block.settings.faqs_menu.links %}
          {% if forloop.last %}
            <div
              class="sub_footer-faq-item one-whole"
            >
              <button class="sub_footer-accordion-title">
                <span>{{- link.title | escape -}}</span>
                {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
              </button>
              <p class="sub_footer-accordion-content">
                {% for childLink in link.links %}
                  {% if childLink.links == blank %}
                    {% if childLink.url != routes.root_url %}
                      <a href="{{ childLink.url }}" style="text-decoration:underline;">
                    {% endif %}
                    {{ childLink.title | remove: '<br>' | escape -}}
                    {%- if childLink.title == '<br>' -%}
                      <br>
                    {% elsif childLink.title == '<br><br>' -%}
                      <br>
                      <br>
                    {% endif %}
                    {% if childLink.url != routes.root_url %}
                      </a>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </p>
            </div>
          {% endif %}
        {% endfor %}
      {% endcapture %}
      {% assign default_faq_handle1 = block.settings.faqs_menu__title | handle %}

      <div
        class="sub_footer-faq-items one-half medium-down--one-whole column faq-content-js all-faqs {{ block.settings.faqs_menu__title | handle }}"
      >
        {% comment %} <h2>{{ block.settings.faqs_menu__title }}</h2> {% endcomment %}
        <header class="{% if default_faq_handle1 == 'all-faqs'%} faq_main_title hide {% endif %}">
          <h2>
            <span>{{ block.settings.faqs_menu__title }}</span>
          </h2>
          <i class="ornamental-break -dark"></i>
          </header>
        {% assign blockSizeLast = block.settings.faqs_menu.links.size | modulo: 2 %}
        {% assign blockSize = block.settings.faqs_menu.links.size | divided_by: 2 %}

        {% for link in block.settings.faqs_menu.links %}
          <div
            class="sub_footer-faq-item one-whole"
          >
            <button class="sub_footer-accordion-title">
              <span>{{- link.title | escape -}}</span>
              {% render 'icon', name: 'plus', icon_class: 'icon-plus' %}
            </button>
            <p class="sub_footer-accordion-content">
              {% for childLink in link.links %}
                {% if childLink.links == blank %}
                  {% if childLink.url != routes.root_url %}
                    <a href="{{ childLink.url }}" style="text-decoration:underline;">
                  {% endif %}
                  {{ childLink.title | remove: '<br>' | escape -}}
                  {%- if childLink.title == '<br>' -%}
                    <br>
                  {% elsif childLink.title == '<br><br>' -%}
                    <br>
                    <br>
                  {% endif %}
                  {% if childLink.url != routes.root_url %}
                    </a>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </p>
          </div>
        {% endfor %}
      
      </div>
    
    {% endfor %}
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% assign first_question = true %}
    {% for block in section.blocks %}
      {% for link in block.settings.faqs_menu.links %}
        {% unless first_question %},{% endunless %}
        {% assign first_question = false %}
        {
          "@type": "Question",
          "name": "{{ link.title | strip_html | escape }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{% for childLink in link.links %}{{ childLink.title | strip_html | escape }}{% unless forloop.last %} {% endunless %}{% endfor %}"
          }
        }
      {% endfor %}
    {% endfor %}
  ]
}
</script>
 <script>
    $(document).ready(function() {
      // Initialize all sliders
      $('.scrollnav-slider').each(function() {
        const $slider = $(this);
        
        // Initialize Slick Slider
        $slider.slick({
        slidesToShow: 10, 
      slidesToScroll: 1,
      swipeToSlide: true,
      touchThreshold: 50,
      adaptiveHeight: false,
      variableWidth: true,
      arrows: true,
      autoplay: false,
      dots: false,
      accessibility: true,
      infinite: false,
      prevArrow: `<button type="button" class="slick-prev custom-arrow" aria-label="Previous Slide">
                    {% render 'icon-slick-left2' %}</button>`,
      nextArrow: `<button type="button" class="slick-next custom-arrow" aria-label="Next Slide">
                    {% render 'icon-slick-right2' %}</button>`,
      responsive: [
        { breakpoint: 1599, settings: { slidesToShow: 6, slidesToScroll: 1 } },
        { breakpoint: 1299, settings: { slidesToShow: 4, slidesToScroll: 1 } },
        { breakpoint: 1025, settings: { slidesToShow: 3, slidesToScroll: 1 } }
      ]
        });

        // Function to check if all items are visible
        function checkItemsVisibility() {
         
            const $slickList = $slider.find('.slick-list');
            const $slickTrack = $slider.find('.slick-track');
            
            const listWidth = $slickList.width();
            const trackWidth = $slickTrack.outerWidth(true);
            
            // Calculate total width of all slides including margins
            let totalSlidesWidth = 0;
            $slider.find('.slick-slide').each(function() {
              if (!$(this).hasClass('slick-cloned')) {
                totalSlidesWidth += $(this).outerWidth(true);
              }
            });
            
            // Check if scrollable (has overflow)
            const isOverflowing = totalSlidesWidth > listWidth || trackWidth > listWidth;
            
            console.log('List Width:', listWidth);
            console.log('Track Width:', trackWidth);
            console.log('Total Slides Width:', totalSlidesWidth);
            console.log('Is Overflowing?:', isOverflowing);
            console.log('Should Center?:', !isOverflowing);
            
            // First remove all classes
            $slider.removeClass('center-items all-visible');
            
            // Add classes only if NOT overflowing
            if (!isOverflowing) {
              console.log('Adding center classes - all items visible');
              $slider.addClass('center-items all-visible');
              $slider.find('.slick-cloned').each(function() {
                 $(this).attr("style", "display: none !important");
              });
            } else {
              console.log('Not centering - items are overflowing/scrollable');
              $slider.find('.slick-cloned').each(function() {
                 $(this).attr("style", "");
              });
            }
         
        }

        // Check on load, after init, and resize
        checkItemsVisibility();
        
        $slider.on('init reInit', function() {
          checkItemsVisibility();
        });
         $slider.on('afterChange', function() {
          rebindevent();
        });
        
        $(window).on('resize', function() {
          checkItemsVisibility();
        });
      });


    });
</script>

